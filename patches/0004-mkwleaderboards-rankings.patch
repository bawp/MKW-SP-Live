+// hle/storage/sdio.cpp, before it opens the SD card image: the ghosts My Times imported go to
+// /mkw-sp/ghosts/mkwlb on it (MKW-SP lists the ghosts there at boot).
+void ApplySdImports(const std::filesystem::path& image) {
+    std::error_code ec;
+    std::vector<std::filesystem::path> files;
+    for (const auto& e : std::filesystem::directory_iterator(MtImportDir(), ec))
+        if (e.is_regular_file(ec) && e.path().extension() == ".RKG") files.push_back(e.path());
+    if (files.empty()) return;
+    // The first time: a copy of the card as it was (WiiSD.raw.bak), in case anything goes wrong.
+    if (auto backup = image; !std::filesystem::exists(backup += ".bak", ec)) std::filesystem::copy_file(image, backup, ec);
+    Fat32 fs;
+    if (!fs.Open(image)) {
+        std::cout << "[mytimes] the SD card image isn't a FAT32 image; imported ghosts not placed" << std::endl;
+        return;
+    }
+    const uint32_t sp = fs.Dir(fs.root, "MKW-SP     ");
+    const uint32_t ghosts = sp ? fs.Dir(sp, "GHOSTS     ") : 0;
+    const uint32_t dir = ghosts ? fs.Dir(ghosts, "MKWLB      ") : 0;
+    int placed = 0;
+    for (const auto& path : files) {
+        std::ifstream in(path, std::ios::binary);
+        const std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), {});
+        in.close();
+        const std::string stem = path.stem().string();
+        if (!dir || stem.size() > 8 || data.empty()) continue;
+        char name[12];
+        std::snprintf(name, sizeof name, "%-8s%-3s", stem.c_str(), "RKG");
+        for (char& ch : name) ch = static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+        if (!fs.PutFile(dir, name, data)) break;
+        std::filesystem::remove(path, ec);
+        ++placed;
+    }
+    fs.Flush();
+    std::cout << "[mytimes] " << placed << " imported ghost(s) placed in /mkw-sp/ghosts/mkwlb on the SD card" << std::endl;
+}
