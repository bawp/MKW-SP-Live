+// RankingDetailPage (0xAF) vtable +0x48, called every frame while the page is shown (was a blr).
+extern "C" void TopTenUpdate_HLE_8060b1fc(CpuContext* ctx) {
+    const uint32_t page = ctx->gpr[3];
+    const uint32_t manager = Memory::Read32(kSectionManager);
+    const uint32_t holder = manager ? Memory::Read32(manager + kSectionPadHolder) : 0;
+    if (!holder || !Memory::Contains(holder + kHolderUiButtons, 2)) return;
+    const uint16_t buttons = Memory::Read16(holder + kHolderUiButtons);
+    const auto now = Clock::now();
+    const bool fresh = page != g_topTenPage || now - g_topTenSeen > std::chrono::milliseconds(250);
+    g_topTenSeen = now;
+    if (fresh) { g_topTenPage = page; g_topTenRow = -1; g_topTenButtons = buttons; return; }
+    const uint16_t pressed = buttons & ~g_topTenButtons;
+    g_topTenButtons = buttons;
+
+    int rows = 0;
+    while (rows < 10 && Memory::Read8(page + kTopTenRows + rows * kTopTenRowSize + kRowEmpty) == 0) ++rows;
+    const uint32_t back = page + kTopTenBack;
+    const uint32_t buttonManager = Memory::Read32(back + kButtonManager);
+    const int before = g_topTenRow;
+    if ((pressed & kUiDown) && g_topTenRow + 1 < rows) ++g_topTenRow;
+    else if ((pressed & kUiUp) && g_topTenRow >= 0) --g_topTenRow;
+
+    if (g_topTenRow >= 0 && Memory::Read32(buttonManager + kManagerHolders) == back + kButtonManipulator) {
+        CallWith(ctx, func_805F0DA0, {buttonManager, 0, 0, 0xFFFFFFFF});   // Back loses focus: A no longer presses it
+        CallWith(ctx, func_805BE130, {back, 0});
+    }
+    if (g_topTenRow != before) {
+        if (before >= 0) ShowRowSelected(ctx, page, before, false);
+        if (g_topTenRow >= 0) ShowRowSelected(ctx, page, g_topTenRow, true);
+        else CallWith(ctx, func_805BDAF0, {back, 0});
+        CallWith(ctx, func_80602CF8, {page, kSoundSelect, 0xFFFFFFFF});
+        return;
+    }
+    if ((pressed & kUiA) && g_topTenRow >= 0) {
+        const int row = g_topTenRow;
+        ShowRowSelected(ctx, page, row, false);
+        g_topTenRow = -1;
+        PickTopTenGhost(ctx, page, row);
+    }
+}
