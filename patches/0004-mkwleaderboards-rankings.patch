+// A list row's glass, as the standings' (the cursor's in the gold frame).
+void EsDrawRow(EsCanvas& r, float L, float R, float y, float rowH, bool selected, float a, float t) {
+    if (selected) {
+        r.Gradient(L, y, R, y + rowH, Rgba(0x1450F0, r.alpha), Rgba(0x1E5CFF, r.alpha), Rgba(0x02137A, r.alpha), Rgba(0x011066, r.alpha));
+        r.Gradient(L, y, R, y + rowH * 0.45f, Rgba(0xFFFFFF, r.alpha * 0.30f), Rgba(0xFFFFFF, r.alpha * 0.18f), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+        const float pulse = 0.75f + 0.25f * std::sin(t * 5.0f);
+        r.Frame(L - 1.5f, y - 1.5f, R + 1.5f, y + rowH + 1.5f, Rgba(0xFF8C00, r.alpha * pulse), 4.0f, 3.0f);
+        r.Frame(L - 0.5f, y - 0.5f, R + 0.5f, y + rowH + 0.5f, Rgba(0xFFF27A, r.alpha), 2.0f, 2.0f);
+    } else {
+        r.Gradient(L, y, R, y + rowH, Rgba(0x0A2470, r.alpha * 0.82f * a), Rgba(0x061A5A, r.alpha * 0.82f * a), Rgba(0x040F3C, r.alpha * 0.86f * a), Rgba(0x06164C, r.alpha * 0.86f * a));
+        r.Gradient(L, y, R, y + rowH * 0.45f, Rgba(0xFFFFFF, r.alpha * 0.16f * a), Rgba(0xFFFFFF, r.alpha * 0.06f * a), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+        r.Rect(L, y, R, y + 1.2f, Rgba(0xFFFFFF, r.alpha * 0.45f * a));
+    }
+}
