+// After the spans: every course's crowd of this board / area, one course at a time.
+void PrefetchCrowds(uint8_t area, std::string category, uint32_t first, bool ghostNames) {
+    for (uint32_t k = 0; k < kCourseCount; ++k) {
+        const GraphKey key{(first + k) % kCourseCount, area, category};
+        std::shared_ptr<const AxisSpan> span;
+        {
+            std::lock_guard lock(g_axisMutex);
+            if (const auto it = g_axisSpans.find(key); it != g_axisSpans.end()) span = it->second;
+        }
+        if (span && ClaimCrowd(key, ghostNames)) BuildCrowd(key, span, ghostNames);
