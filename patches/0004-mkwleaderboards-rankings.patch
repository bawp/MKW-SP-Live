+        toadsRoster.error = s.error;
+        roster = &toadsRoster;
+        if (const auto m = s.members.find(team.entryId); m != s.members.end())
+            for (const auto& member : m->second) {
+                EsPlayer player;
+                player.playerId = member.statsId;
+                player.toadsId = member.toadsId;
