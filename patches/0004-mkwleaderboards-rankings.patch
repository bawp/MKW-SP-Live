+        if (g_esPlayerScroll > 0.05f) c.Text((rx + R) * 0.5f, rowTop - 18, 22, 0xFFFFFF, "\xE2\x96\xB2", 0.5f, 0.8f);
+        if (g_esPlayerScroll < static_cast<float>(count - visible) - 0.05f) moreBelow = ImVec2((rx + R) * 0.5f, rowBottom - 2);
+    }
+    // Room below the roster is left for more (matches).
+    c.list->PopClipRect();
+    const std::string hints = std::string(EsButtonIcons().a) + " Player Page   " + kIconDpad + " Select";
+    EsDrawHints(c, W, hints);
+    // Y: hide / show the Inactive players (the game's fonts have no Y icon: a grey button like theirs).
+    if (showStatus && (anyInactive || g_esHideInactive)) {
