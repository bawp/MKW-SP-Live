+void SaveCrowd(const GraphKey& key, bool ghostNames, const std::vector<CrowdMii>& crowd) {
+    std::error_code ec;
+    std::filesystem::create_directories(CrowdFile(key, ghostNames).parent_path(), ec);
+    std::vector<uint8_t> out{'C', 'R', 'W', 'D', 0, 0, 0, 0};
+    PutBe32(out, 4, static_cast<uint32_t>(crowd.size()));
+    for (const auto& c : crowd) {
