+const char* EsGlobeMiiCountry() { return g_esGlobeCountry.load(); }
+
+void EsGlobeMii(CpuContext* ctx) {
+    static uint64_t s_frame = ~0ull;
+    static std::string s_shown;   // whose Mii stands on the globe (EsMiiKey), empty: none
+    static bool s_displayed = false;
+    static uint32_t s_mode = 0;   // the globe's mode before
+    if (s_frame == g_mtFrame) return;   // once a frame (every page draws)
+    s_frame = g_mtFrame;
+    try {
+        const uint32_t globe = Memory::Read32(kGlobeMgr);
+        if (!globe || !Memory::Contains(globe + kGlobeMode, 4)) {
+            s_shown.clear();
+            g_esGlobeCountry = nullptr;
+            return;
+        }
+        std::string want, name, iso;
+        std::optional<std::array<uint8_t, kMiiSize>> mii;
+        if (CurrentSectionId() == kSectionChannelId && EsFlag() == kEsPlayer) {
+            std::lock_guard lock(g_esMutex);
+            const std::string key = EsMiiKey(g_esPlayerShown, g_esTeamShown);
+            if (const auto it = g_esMiis.find(key); it != g_esMiis.end() && !it->second.file.empty()) {
+                const auto info = g_esPlayerInfo.find(g_esPlayerShown.playerId);
+                name = info != g_esPlayerInfo.end() && !info->second.name.empty() ? info->second.name : g_esPlayerShown.name;
+                mii = EsFittedMii(it->second.file, name);
+                iso = it->second.iso;
+                if (mii && EsCountryPlaceOf(iso)) want = key;
+            }
+        }
+        if (want == s_shown) {
+            if (!s_shown.empty() && !s_displayed) {
+                const uint32_t earth = Memory::Read32(globe + kGlobeEarth);
+                if (earth && Memory::Read8(earth + kGlobeMiiEnabled)) {
+                    uint32_t saved[13];
+                    for (int k = 0; k < 13; ++k) saved[k] = ctx->gpr[k];
+                    CallWith(ctx, func_807509B4, {globe});
+                    for (int k = 0; k < 13; ++k) ctx->gpr[k] = saved[k];
+                    s_displayed = true;
+                    g_esGlobeCountry = EsCountryPlaceOf(iso)->name;
+                    std::cout << "[esports] globe: " << name << "'s Mii shown" << std::endl;
+                }
+            }
+            return;
+        }
+        g_esGlobeCountry = nullptr;
+        uint32_t saved[13];
+        for (int k = 0; k < 13; ++k) saved[k] = ctx->gpr[k];
+        const double savedF1 = ctx->fpr[1].d, savedF2 = ctx->fpr[2].d;
+        if (!s_shown.empty()) {   // the last one down, the globe as it was
+            CallWith(ctx, func_807509D0, {globe});
+            ctx->fpr[2].d = 0.0;
+            CallWith(ctx, func_80750808, {globe, s_mode}, 0.0);
+            s_shown.clear();
+        }
+        if (!want.empty()) {
+            const uint32_t context = Memory::Read32(Memory::Read32(kSectionManager) + kGlobalContext);
+            const uint32_t group = context ? context + kGlobeMiiGroup : 0;
+            const uint32_t slots = group && Memory::Contains(group, 8) ? Memory::Read32(group + 4) : 0;
+            if (slots && Memory::Contains(slots, 4)) {
+                // the RFLStoreData on the guest stack, below the frame LoadMii is called with
+                const uint32_t sp = ctx->gpr[1], data = (sp - 0x60) & ~7u;
+                for (size_t b = 0; b < kMiiSize; ++b) Memory::Write8(data + static_cast<uint32_t>(b), (*mii)[b]);
+                ctx->gpr[1] = data - 0x40;
+                CallWith(ctx, func_805FA610, {group, 0, data});
+                ctx->gpr[1] = sp;
+                const uint32_t object = Memory::Read32(slots);
+                if (object) {
+                    const EsCountryPlace* place = EsCountryPlaceOf(iso);
+                    s_mode = Memory::Read32(globe + kGlobeMode);
+                    CallWith(ctx, func_807509D0, {globe});
+                    CallWith(ctx, func_807509A0, {globe, object});
+                    ctx->fpr[2].d = place->longitude;
+                    CallWith(ctx, func_80750808, {globe, kGlobeFriend}, place->latitude);
+                    s_shown = want;
+                    s_displayed = false;
+                    std::cout << "[esports] globe: " << name << " (" << iso << "), the globe's mode was " << s_mode << std::endl;
+                } else {
+                    std::cout << "[esports] globe: the Mii group didn't take the Mii" << std::endl;
+                }
+            } else {
+                std::cout << "[esports] globe: no Mii group in the menus' context" << std::endl;
+            }
+        }
+        for (int k = 0; k < 13; ++k) ctx->gpr[k] = saved[k];
+        ctx->fpr[1].d = savedF1;
+        ctx->fpr[2].d = savedF2;
+    } catch (const Memory::AccessViolation&) {
+        s_shown.clear();
+        g_esGlobeCountry = nullptr;
+    }
+}
