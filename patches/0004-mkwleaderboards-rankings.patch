+// A player's matches in one season (regular season and playoffs), from the matches of each team
+// they played for that season (/api/matches?team=<tag>) and each match's details (/api/matches/<id>,
+// kept in UserData/Cache/esports/matches once the season's final is played).
+struct EsSeasonMatch {
+    int matchId = 0, number = 0, seriesMatch = 0;
+    std::string type, stage, opponentTag, result;
+    int teamScore = 0, opponentScore = 0, playerScore = 0;
+};
+struct EsPlayerSeason {
+    bool loading = false, loaded = false;
+    std::string error;
+    std::vector<EsSeasonMatch> matches;
+};
+std::map<std::pair<int, std::string>, EsPlayerSeason> g_esPlayerSeasons;   // { player, season } -> matches
+
+std::optional<Json> EsMatchDetail(int id, bool keep) {
+    const auto dir = EsCacheDir() / "matches";
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    const auto cached = dir / (std::to_string(id) + ".json");
+    if (const auto bytes = EsReadFile(cached); !bytes.empty())
+        if (auto json = JsonParser(std::string(bytes.begin(), bytes.end())).parse()) return json;
+    const auto res = HttpGet(std::string(kStatsBase) + "/api/matches/" + std::to_string(id));
+    if (!res.error.empty() || res.status != 200) return std::nullopt;
+    auto json = JsonParser(res.body).parse();
+    if (json && keep) std::ofstream(cached, std::ios::binary).write(res.body.data(), static_cast<std::streamsize>(res.body.size()));
+    return json;
+}
