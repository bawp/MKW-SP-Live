+std::filesystem::path GhostCacheDir() {
+    static const auto dir = [] {
+        auto d = RuntimeConfigFile::ApplicationDataDirectory() / "Cache" / "mkwleaderboards" / "ghosts";
+        std::error_code ec;
+        std::filesystem::create_directories(d, ec);
+        return d;
+    }();
+    return dir;
