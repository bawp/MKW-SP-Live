+// The extension font's cups (tt_kart_extension_font): gold, silver, bronze.
+// GSC roles by GP average: under 12.00 a bagger, else a runner; no GP average, no role.
+const char* EsRoleOf(double gpAverage) {
+    if (!(gpAverage > 0)) return nullptr;
+    return gpAverage < 12.0 ? "Bagger" : "Runner";
+}
+
+const char* EsCup(int place) {
+    return place == 1 ? "\xEF\x81\xAA" : place == 2 ? "\xEF\x81\xAB" : place == 3 ? "\xEF\x81\xAC" : nullptr;   // U+F06A..F06C
+}
+
+std::string Signed(int v) { return (v > 0 ? "+" : "") + std::to_string(v); }
+
+std::string Ordinal(int n) {
+    const int tens = n % 100;
+    const char* suffix = tens >= 11 && tens <= 13 ? "th" : n % 10 == 1 ? "st" : n % 10 == 2 ? "nd" : n % 10 == 3 ? "rd" : "th";
+    return std::to_string(n) + suffix;
+}
