+// Keeps a team page's data loading (under the lock).
+void EsRequestTeam() {
+    std::lock_guard lock(g_esMutex);
+    const auto now = Clock::now();
+    auto& info = g_esTeams[g_esTeamShown.teamId];
+    auto due = [&](bool loading, bool loaded, const std::string& error, Clock::time_point fetched) {
+        return !loading && ((loaded && now - fetched > kEsportsTtl) || (!loaded && (error.empty() || now - fetched > std::chrono::seconds(10))));
+    };
+    if (g_esTeamShown.teamId < 0) {
+        info.loaded = true;   // only on Toad's Factory: no mkw-stats overview
+    } else if (due(info.loading, info.loaded, info.error, info.fetched)) {
+        info.loading = true;
+        EsLoadTeam(g_esTeamShown.teamId);
+    }
+    if (g_esTeamShown.teamId > 0 && !EsToadsSeason(kEsSeasons[g_esTeamSeason].id)) {
+        auto& roster = info.rosters[kEsSeasons[g_esTeamSeason].id];
+        if (due(roster.loading, roster.loaded, roster.error, roster.fetched)) {
+            roster.loading = true;
+            EsLoadRoster(g_esTeamShown.teamId, kEsSeasons[g_esTeamSeason].id);
+        }
+    }
+    for (const auto& a : info.appearances) EsRequestStandings(a.season, a.division);
+    for (const auto& def : kEsSeasons) if (def.toadsDivision) EsRequestStandings(def.id, kEsLeague.division);   // the team's earlier seasons
+    EsRequestStandings(kEsSeasons[g_esTeamSeason].id, kEsLeague.division);
+    if (const int mkc = kEsSeasons[g_esTeamSeason].mkcTournament) {
+        auto& t = g_esMkc[mkc];
+        if (due(t.loading, t.loaded, t.error, t.fetched)) {
+            t.loading = true;
+            EsLoadMkc(mkc);
+        }
+    }
+}
