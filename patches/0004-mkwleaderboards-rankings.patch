+// The channel page as the Esports menu (open) or as itself, before it comes back.
+void EsShowChannelMode(CpuContext* ctx, uint32_t page, bool open) {
+    const uint8_t hidden = open ? 1 : 0;
+    Memory::Write8(page + kChannelRankings + kControlHidden, hidden);
+    const uint32_t children = Memory::Read32(page + kPageChildren);
+    if (Memory::Read32(page + kPageChildCount) > kChannelEsportsChild && children) {
+        if (const uint32_t esports = Memory::Read32(children + 4 * kChannelEsportsChild)) Memory::Write8(esports + kControlHidden, hidden);
+    }
+    if (Memory::Read32(page + kPageChildCount) > kChannelNotifyChild && children) {
+        if (const uint32_t bar = Memory::Read32(children + 4 * kChannelNotifyChild)) Memory::Write8(bar + kControlHidden, hidden);
+    }
+    CallWith(ctx, func_807E987C, {page + kChannelTitle, open ? kMsgEsports : kMsgChannelTitle, 0});
+}
