+// A crowd that is neither in memory nor being fetched: the saved one if any (claimed as complete;
+// returns true when it is stale and should be fetched again), else claimed for fetching (true).
+bool ClaimCrowd(const GraphKey& key, bool ghostNames) {
+    {
+        std::lock_guard lock(g_axisMutex);
+        if (g_crowdComplete.count(key) || g_crowdFetching.count(key)) return false;
+        g_crowdFetching.insert(key);
+    }
+    const auto [saved, fresh] = LoadCrowd(key, ghostNames);
+    std::lock_guard lock(g_axisMutex);
+    if (saved) {
+        g_crowds[key] = saved;
+        g_crowdComplete.insert(key);
+    }
+    if (saved && fresh) {
+        g_crowdFetching.erase(key);
+        return false;
+    }
+    return true;
+}
