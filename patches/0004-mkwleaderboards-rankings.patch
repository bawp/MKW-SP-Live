+}
+
+// Page::draw: the My Times row is a button, not a choice: its UpDownControl's arrows are hidden (the
+// settings page reuses its 6 rows for each sheet, so only what was hidden here is shown again).
+constexpr uint32_t kSettingsPageVtables[] = {0x80815220 + 8 + kSpPayloadShift, 0x80815294 + 8 + kSpPayloadShift, 0x80815308 + 8 + kSpPayloadShift};
+constexpr uint32_t kSettingRows = 0x13E0, kSettingRowSize = 0x5C8, kUpDownId = 0x20C, kUpDownButtons = 0x2B4, kUpDownButtonSize = 0x188;
+void MtSettingsArrows(uint32_t page) {
+    static bool s_hidden[6] = {};
+    if (!Memory::Contains(page, 4)) return;
+    const uint32_t vt = Memory::Read32(page);
+    if (std::find(std::begin(kSettingsPageVtables), std::end(kSettingsPageVtables), vt) == std::end(kSettingsPageVtables)) return;
+    if (!Memory::Contains(page + kSettingRows, 6 * kSettingRowSize)) return;
+    for (uint32_t i = 0; i < 6; ++i) {
+        const uint32_t row = page + kSettingRows + i * kSettingRowSize;
+        const bool mine = (Memory::Read32(row + kUpDownId) >> 16) == kMyTimesSettingSlot;
+        if (!mine && !s_hidden[i]) continue;
+        for (uint32_t b = 0; b < 2; ++b) Memory::Write8(row + kUpDownButtons + b * kUpDownButtonSize + kControlHidden, mine ? 1 : 0);
+        s_hidden[i] = mine;
+    }
+}
+
+// Page::CheckActions while My Times is open (once a frame, guest thread).
+void MyTimesInput(CpuContext* ctx, uint32_t page) {
+    const uint32_t manager = Memory::Read32(kSectionManager);
+    const uint32_t holder = manager ? Memory::Read32(manager + kSectionPadHolder) : 0;
+    const uint16_t buttons = holder && Memory::Contains(holder + kHolderUiButtons, 2) ? Memory::Read16(holder + kHolderUiButtons) : 0;
+    const uint16_t pressed = buttons & ~g_mt.buttons;
+    g_mt.buttons = buttons;
+    const auto now = Clock::now();
+    // D-pad, repeating while held
+    uint16_t dir = pressed & (kEsUp | kEsDown | kEsLeft | kEsRight);
+    if (dir) g_mt.repeatAt = now + std::chrono::milliseconds(380);
+    else if ((buttons & (kEsUp | kEsDown | kEsLeft | kEsRight)) && now >= g_mt.repeatAt) {
+        dir = buttons & (kEsUp | kEsDown | kEsLeft | kEsRight);
+        g_mt.repeatAt = now + std::chrono::milliseconds(110);
+    }
+
+    if (g_mt.state == MtState::Busy) return;
+    if (g_mt.state == MtState::Menu) {
+        const auto items = MtMenuItems();
+        if (pressed & kEsB) { MtClose(ctx, page); return; }
+        if (dir & (kEsUp | kEsDown)) {
+            g_mt.cursor = (g_mt.cursor + ((dir & kEsUp) ? -1 : 1) + static_cast<int>(items.size())) % static_cast<int>(items.size());
+            MtSound(ctx, page, kSoundMove);
+        }
+        if (pressed & kEsA) {
+            const std::string item = items[std::min<size_t>(g_mt.cursor, items.size() - 1)];
+            MtSound(ctx, page, item == "Back" ? kSoundBack : kSoundOk);
+            if (item == "Back") { MtClose(nullptr, page); return; }
+            if (item == "Log In" || item == "Log In Again") { g_mt.message.clear(); g_mt.verified = false; MtOpenKeyboard(MtField::Username); }
+            else if (item == "Unlink") {
+                g_mt.account = {};
+                MtSaveAccount();
+                std::error_code ec;
+                std::filesystem::remove_all(MtPbRoot(), ec);
+                g_mtPbsChanged = true;
+                g_mt.cursor = 0;
+                g_mt.message = "Your account is no longer linked.";
+                g_mt.messageColor = 0xFFFFFF;
+            } else if (item == "Import My Times") {
+                {
+                    std::lock_guard lock(g_mtMutex);
+                    g_mtResult = {};
+                }
+                g_mt.state = MtState::Busy;
+                g_mt.busy = "Importing your times";
+                g_mt.message.clear();
+                MtStartImport(g_mt.account.playerId);
+            }
+        }
+        return;
+    }
+    // keyboard
+    if (dir & kEsUp) g_mt.row = (g_mt.row + 4) % 5;
+    if (dir & kEsDown) g_mt.row = (g_mt.row + 1) % 5;
+    if (dir & (kEsLeft | kEsRight)) {
+        if (g_mt.row == kMtSpecialRow) {
+            const int k = (MtSpecialAt(g_mt.col) + ((dir & kEsLeft) ? 3 : 1)) % 4;
+            g_mt.col = kMtSpecial[k].from;
+        } else {
+            g_mt.col = (g_mt.col + ((dir & kEsLeft) ? kMtCols - 1 : 1)) % kMtCols;
+        }
+    }
+    if (dir) MtSound(ctx, page, kSoundMove);
+    if (pressed & kEsOption) { g_mt.shift = !g_mt.shift; MtSound(ctx, page, kSoundMove); }
+    if (pressed & kEsB) {
+        if (g_mt.text.empty()) {   // back out
+            g_mt.state = MtState::Menu;
+            g_mt.verified = false;
+            MtSound(ctx, page, kSoundBack);
+        } else {
+            g_mt.text.pop_back();
+            MtSound(ctx, page, kSoundMove);
+        }
+        return;
+    }
+    if (pressed & kEsStart) { MtSound(ctx, page, kSoundOk); MtSubmit(); return; }
+    if (pressed & kEsA) {
+        if (g_mt.row == kMtSpecialRow) {
+            const int k = MtSpecialAt(g_mt.col);
+            if (k == 0) g_mt.shift = !g_mt.shift;
+            else if (k == 1 && g_mt.text.size() < 64) g_mt.text += ' ';
+            else if (k == 2 && !g_mt.text.empty()) g_mt.text.pop_back();
+            else if (k == 3) { MtSound(ctx, page, kSoundOk); MtSubmit(); return; }
+        } else if (g_mt.text.size() < 64) {
+            g_mt.text += kMtRows[g_mt.shift ? 1 : 0][g_mt.row][g_mt.col];
+        }
+        MtSound(ctx, page, kSoundMove);
+    }
+}
