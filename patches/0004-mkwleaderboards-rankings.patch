+            if (cup) c.Text(placeRight - c.TextWidth(size, place) - 2 - c.TextWidth(size, cup), y, size, 0xFFFFFF, cup);
+            c.Text(recordRight, y, size, gone ? grey : 0xA8C0F0, record, 1.0f);
+        }
+        if (static_cast<int>(done.size()) > shown)
+            c.Text(lx + 10 + (shown % 2) * cellW + cellW * 0.5f - 3, top + (shown / 2) * pitch, size, 0xC8D2F0, "+" + std::to_string(done.size() - shown) + " more", 0.5f, 0.8f);
