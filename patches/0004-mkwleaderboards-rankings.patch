+std::optional<Json> EsFetch(const std::string& path, std::string& error) {
+    const auto res = HttpGet(std::string(kStatsBase) + path);
+    if (!res.error.empty() || res.status != 200) {
+        error = res.error.empty() ? "HTTP " + std::to_string(res.status) : res.error;
+        return std::nullopt;
+    }
+    auto json = JsonParser(res.body).parse();
+    if (!json) error = "bad data";
+    return json;
+}
