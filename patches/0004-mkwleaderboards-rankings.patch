+// requestTopTen(client, course, 0, world, dest)
+// ---------------------------------------------------------------------------------------------
+// Settings > Rankings > Continental Region (Americas / Europe / Asia / Oceania, default Oceania).
+// tools/rankings.js adds the Rankings settings category and leaves this setting's names and
+// message IDs in a block after the champion slot; slot 52 (RoomVehicles, which only served the
+// offline mkw-sp.com rooms) is turned into the setting here, before settings.ini is read. The
+// region picks the Continental rankings' players and the place the globe turns to.
+// The Rankings settings take the Room slots 49-53 in the order the page lists them: My Times,
+// Player Names, Category, Continental Region, Sub-Region (settings.ini keeps values by name).
+
+namespace {
+constexpr uint32_t kSpPayloadShift = 0x010A0000;
+constexpr uint32_t kSpSettingEntries = 0x80850048 + kSpPayloadShift;   // SP::ClientSettings::entries[67]
+constexpr uint32_t kSpSettingEntrySize = 52, kSpSettingCount = 67, kRegionSettingSlot = 52;
+constexpr uint32_t kSpSaveSettingValues = 0x2500C, kSpSaveCurrentLicense = 0x25654, kSpSaveLicenseLoaded = 0x25655;
+constexpr uint32_t kSpSaveManager = 0x809BD748;
+constexpr uint32_t kSettingsBlock = 0x819656C0;   // tools/rankings.js SETTINGS_BLOCK / RANKINGS_SETTINGS
+constexpr uint32_t kSettingsMagic = 0x524B5331;  // 'RKS1' at +0x1FC
+constexpr uint32_t kRankingsCategory = 9, kRegionDefault = 3, kRegionCount = 4;
+constexpr uint32_t kMsgRegionTitle = 0x2F11;
+enum : int { kRegionAmericas, kRegionEurope, kRegionAsia, kRegionOceania };
+constexpr uint8_t kRegionAreaByte[kRegionCount] = {2, 3, 1, 4};   // matching area + 1 (ContinentOfArea)
+constexpr uint32_t kRegionArea[kRegionCount] = {1, 2, 0, 3};      // the game's per-area default places
+const char* const kRegionFileName[kRegionCount] = {"americas", "europe", "asia", "oceania"};
+bool g_regionSettingInstalled = false;
+
+int ContinentalRegion() {
+    if (!g_regionSettingInstalled) return kRegionDefault;
+    const uint32_t save = Memory::Read32(kSpSaveManager);
+    uint32_t value = kRegionDefault;
+    if (save && Memory::Contains(save + kSpSaveLicenseLoaded, 1) && Memory::Read8(save + kSpSaveLicenseLoaded)) {
+        const uint32_t license = Memory::Read8(save + kSpSaveCurrentLicense);
+        value = Memory::Read32(save + kSpSaveSettingValues + (license * kSpSettingCount + kRegionSettingSlot) * 4);
+    }
+    return value < kRegionCount ? static_cast<int>(value) : static_cast<int>(kRegionDefault);
+}
+
+uint8_t ContinentalAreaByte() { return kRegionAreaByte[ContinentalRegion()]; }
+
+// The current license's value of a Rankings setting whose default is its first value (that until a
+// license is loaded or when the setting could not be installed).
+int SettingValue(bool installed, uint32_t slot, uint32_t count) {
+    if (!installed) return 0;
+    const uint32_t save = Memory::Read32(kSpSaveManager);
+    if (!save || !Memory::Contains(save + kSpSaveLicenseLoaded, 1) || !Memory::Read8(save + kSpSaveLicenseLoaded)) return 0;
+    const uint32_t license = Memory::Read8(save + kSpSaveCurrentLicense);
+    const uint32_t value = Memory::Read32(save + kSpSaveSettingValues + (license * kSpSettingCount + slot) * 4);
+    return value < count ? static_cast<int>(value) : 0;
+}
+int TwoValueSetting(bool installed, uint32_t slot) { return SettingValue(installed, slot, 2); }
