+// Cuts text to `width` with "...".
+std::string Fit(const EsCanvas& c, float size, std::string text, float width) {
+    if (c.TextWidth(size, text) <= width) return text;
+    while (!text.empty()) {
+        do text.pop_back(); while (!text.empty() && (static_cast<unsigned char>(text.back()) & 0xC0) == 0x80);
+        if (c.TextWidth(size, text + "...") <= width) return text + "...";
+    }
+    return text;
+}
