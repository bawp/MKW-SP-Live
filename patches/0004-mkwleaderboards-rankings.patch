+        picked = std::move(order);
+        std::set<std::vector<uint8_t>> seen;   // each Mii once (its look and ids, not its name)
+        auto crowd = std::make_shared<std::vector<CrowdMii>>();
+        std::vector<std::future<std::optional<std::vector<uint8_t>>>> ghosts;
+        const uint32_t course = std::get<0>(key);
+        constexpr size_t kBatch = 32;   // downloads at a time; the crowd so far is shown after each batch
+        for (size_t at = 0; at < picked.size(); at += kBatch) {
+            ghosts.clear();
+            for (size_t k = at; k < std::min(at + kBatch, picked.size()); ++k)
+                ghosts.push_back(std::async(std::launch::async, [&r = picked[k], course] { return RunGhost(r, course); }));
+            for (size_t k = at; k < std::min(at + kBatch, picked.size()); ++k) {
+                const auto ghost = ghosts[k - at].get();
+                if (!ghost) continue;
+                CrowdMii c{picked[k].timeMs, MiiOf(*ghost)};
+                if (!seen.insert(std::vector<uint8_t>(c.mii.begin() + 0x16, c.mii.begin() + 0x36)).second) continue;
+                if (!ghostNames) SetMiiName(c.mii, picked[k].name);
+                crowd->push_back(c);
+            }
+            auto sofar = std::make_shared<std::vector<CrowdMii>>(*crowd);
+            std::sort(sofar->begin(), sofar->end(), [](const CrowdMii& a, const CrowdMii& b) { return a.timeMs < b.timeMs; });
+            std::lock_guard lock(g_axisMutex);
