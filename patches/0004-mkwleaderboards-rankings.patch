+                g_mt.verified = true;
+                MtOpenKeyboard(MtField::PlayerName);
+                g_mt.message = g_mtResult.message.empty() ? "Logged in. Which player is yours on mkwleaderboards.com?" : g_mtResult.message;
+                g_mt.messageColor = g_mtResult.message.empty() ? 0xFFFFFF : 0xFF9A9A;
+            } else {
+                g_mt.state = MtState::Menu;
+                g_mt.message = g_mtResult.message;
+                g_mt.messageColor = 0xFF9A9A;
+            }
+        }
+    }
+
+    ImVec2 origin, size;
+    EsGameRect(origin, size);
+    const float alpha = std::clamp(std::chrono::duration<float>(Clock::now() - g_mt.openedAt).count() / 0.15f, 0.0f, 1.0f);
+    EsCanvas c{ImGui::GetBackgroundDrawList(), origin, size.y / 480.0f, alpha};
+    const float W = size.x / c.u, cx = W * 0.5f;
+    const float t = AnimSeconds();
+    c.Rect(-2000, -100, W + 2000, 600, Rgba(0x000010, alpha * 0.55f));
+    const float x0 = cx - 262, x1 = cx + 262, y0 = 74, y1 = 398;
+    auto glass = [&](float a0, float b0, float a1, float b1, float a) {
+        c.Gradient(a0, b0, a1, b1, Rgba(0x0A2470, alpha * 0.92f * a), Rgba(0x061A5A, alpha * 0.92f * a), Rgba(0x040F3C, alpha * 0.95f * a), Rgba(0x06164C, alpha * 0.95f * a));
+        c.Gradient(a0, b0, a1, b0 + std::min(24.0f, (b1 - b0) * 0.45f), Rgba(0xFFFFFF, alpha * 0.14f * a), Rgba(0xFFFFFF, alpha * 0.05f * a), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+        c.Rect(a0, b0, a1, b0 + 1.2f, Rgba(0xFFFFFF, alpha * 0.45f * a));
+    };
+    auto selectedRow = [&](float a0, float b0, float a1, float b1) {
+        c.Gradient(a0, b0, a1, b1, Rgba(0x1450F0, alpha), Rgba(0x1E5CFF, alpha), Rgba(0x02137A, alpha), Rgba(0x011066, alpha));
+        c.Gradient(a0, b0, a1, b0 + (b1 - b0) * 0.45f, Rgba(0xFFFFFF, alpha * 0.30f), Rgba(0xFFFFFF, alpha * 0.18f), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+        const float pulse = 0.75f + 0.25f * std::sin(t * 5.0f);
+        c.Frame(a0 - 1.5f, b0 - 1.5f, a1 + 1.5f, b1 + 1.5f, Rgba(0xFF8C00, alpha * pulse), 4.0f, 3.0f);
+        c.Frame(a0 - 0.5f, b0 - 0.5f, a1 + 0.5f, b1 + 0.5f, Rgba(0xFFF27A, alpha), 2.0f, 2.0f);
+    };
+    glass(x0, y0, x1, y1, 1.0f);
+    c.Frame(x0, y0, x1, y1, Rgba(0xFFFFFF, alpha * 0.35f), 1.5f, 4.0f);
+    c.Text(cx, y0 + 8, 32, 0xFFF07A, "My Times", 0.5f);
+    c.Text(cx, y0 + 42, 17, 0xA8C0F0, "mkwleaderboards.com", 0.5f);
+
+    std::string hints;
+    if (g_mt.state == MtState::Keyboard) {
+        static const char* const kPrompts[] = {"Your mkwleaderboards.com username", "Your password", "Your player name on mkwleaderboards.com"};
+        c.Text(cx, y0 + 66, 20, 0xFFFFFF, kPrompts[static_cast<int>(g_mt.field)], 0.5f);
+        const float bx0 = x0 + 24, bx1 = x1 - 24, by0 = y0 + 92, by1 = by0 + 36;
+        c.Rect(bx0, by0, bx1, by1, Rgba(0x000820, alpha * 0.75f), 4.0f);
+        c.Frame(bx0, by0, bx1, by1, Rgba(0xA8C0F0, alpha * 0.8f), 1.5f, 4.0f);
+        std::string shown = g_mt.field == MtField::Password ? std::string() : g_mt.text;
+        if (g_mt.field == MtField::Password) for (size_t k = 0; k < g_mt.text.size(); ++k) shown += "\xE2\x80\xA2";   // •
+        shown = Fit(c, 26, shown, bx1 - bx0 - 24);
+        c.Text(bx0 + 10, by0 + 5, 26, 0xFFFFFF, shown);
+        if (std::fmod(t, 1.0f) < 0.6f) c.Rect(bx0 + 11 + c.TextWidth(26, shown), by0 + 7, bx0 + 13 + c.TextWidth(26, shown), by1 - 7, Rgba(0xFFF07A, alpha));
+        // keys
+        const float kw = 38, kh = 32, gap = 3, gx0 = cx - (kMtCols * kw + (kMtCols - 1) * gap) * 0.5f, gy0 = by1 + 14;
+        for (int r = 0; r < 4; ++r)
+            for (int k = 0; k < kMtCols; ++k) {
+                const float kx = gx0 + k * (kw + gap), ky = gy0 + r * (kh + gap);
+                const bool sel = g_mt.row == r && g_mt.col == k;
+                if (sel) selectedRow(kx, ky, kx + kw, ky + kh);
+                else { glass(kx, ky, kx + kw, ky + kh, 1.0f); c.Frame(kx, ky, kx + kw, ky + kh, Rgba(0xFFFFFF, alpha * 0.25f), 1.0f, 3.0f); }
+                const char key[2] = {kMtRows[g_mt.shift ? 1 : 0][r][k], 0};
+                c.Text(kx + kw * 0.5f, ky + 3, 24, sel ? 0xFFF27A : 0xFFFFFF, key, 0.5f);
+            }
+        for (int k = 0; k < 4; ++k) {
+            const MtSpecial& sp = kMtSpecial[k];
+            const float kx = gx0 + sp.from * (kw + gap), kx1 = gx0 + sp.to * (kw + gap) - gap, ky = gy0 + 4 * (kh + gap);
+            const bool sel = g_mt.row == kMtSpecialRow && MtSpecialAt(g_mt.col) == k;
+            if (sel) selectedRow(kx, ky, kx1, ky + kh);
+            else { glass(kx, ky, kx1, ky + kh, 1.0f); c.Frame(kx, ky, kx1, ky + kh, Rgba(0xFFFFFF, alpha * 0.25f), 1.0f, 3.0f); }
+            const uint32_t color = sel ? 0xFFF27A : (k == 0 && g_mt.shift) ? 0x8CFFA8 : 0xFFFFFF;
+            c.Text((kx + kx1) * 0.5f, ky + 5, 21, color, sp.label, 0.5f);
+        }
+        hints = std::string(EsButtonIcons().a) + " Type   " + EsButtonIcons().b + " Delete";
+    } else if (g_mt.state == MtState::Busy) {
+        static const char* const kDots[] = {"", ".", "..", "..."};
+        c.Text(cx, y0 + 150, 28, 0xFFFFFF, g_mt.busy + kDots[static_cast<int>(t * 3.0f) % 4], 0.5f);
+    } else {
+        // status
+        if (g_mt.account.playerId > 0) {
+            c.Text(cx, y0 + 74, 18, 0xA8C0F0, "Linked to", 0.5f);
+            c.Text(cx, y0 + 92, 32, 0xFFFFFF, Fit(c, 32, g_mt.account.playerName, x1 - x0 - 40), 0.5f);
+            c.Text(cx, y0 + 126, 17, 0xA8C0F0, "Account: " + g_mt.account.username, 0.5f);
+        } else {
+            c.Text(cx, y0 + 80, 28, 0xFFFFFF, "Not linked", 0.5f);
+            c.Text(cx, y0 + 114, 18, 0xA8C0F0, "Log in to import your times and ghosts.", 0.5f);
+        }
+        const auto items = MtMenuItems();
+        g_mt.cursor = std::clamp(g_mt.cursor, 0, static_cast<int>(items.size()) - 1);
+        const float rx0 = cx - 170, rx1 = cx + 170, ry0 = y0 + 156, rh = 34, rgap = 6;
+        for (size_t k = 0; k < items.size(); ++k) {
+            const float ry = ry0 + k * (rh + rgap);
+            const bool sel = static_cast<int>(k) == g_mt.cursor;
+            if (sel) selectedRow(rx0, ry, rx1, ry + rh);
+            else { glass(rx0, ry, rx1, ry + rh, 1.0f); c.Frame(rx0, ry, rx1, ry + rh, Rgba(0xFFFFFF, alpha * 0.25f), 1.0f, 3.0f); }
+            c.Text(cx, ry + 4, 25, sel ? 0xFFF27A : 0xFFFFFF, items[k], 0.5f);
+        }
+        hints = std::string(EsButtonIcons().a) + " Select   " + EsButtonIcons().b + " Back";
+    }
+    if (!g_mt.message.empty()) c.Text(cx, y1 - 30, 19, g_mt.messageColor, Fit(c, 19, g_mt.message, x1 - x0 - 30), 0.5f);
+    if (!hints.empty()) EsDrawHints(c, W, hints);
