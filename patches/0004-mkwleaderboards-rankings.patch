+// The schedule's rows: the played matches (newest first), then the regular season's matches still to
+// play (each pair of teams meets `meetings` times), marked upcoming.
+struct EsScheduleRow { EsMatch match; bool played = true; };
+std::vector<EsScheduleRow> EsScheduleRows(const EsStandings& standings) {
+    std::vector<EsMatch> played;
+    if (standings.toads) {
+        auto tagOf = [&](int entry) { for (const auto& t : standings.teams) if (t.entryId == entry) return t.tag; return std::string("?"); };
+        int number = 0;
+        for (const auto& m : standings.matches) {
+            EsMatch match;
+            match.number = ++number;
+            match.home = tagOf(m.home);
+            match.away = tagOf(m.away);
+            match.homeScore = m.homeScore;
+            match.awayScore = m.awayScore;
+            match.stage = m.stage;
+            played.push_back(match);
+        }
+    } else {
+        played = standings.schedule;
+    }
+    std::vector<EsScheduleRow> rows;
+    for (auto it = played.rbegin(); it != played.rend(); ++it) rows.push_back({*it, true});
+    if (!standings.finished && !standings.toads) {
+        std::vector<const EsTeam*> active;
+        for (const auto& t : standings.teams) if (t.status != "dropped" && t.status != "disqualified") active.push_back(&t);
+        for (int round = 0; round < standings.meetings; ++round)
+            for (size_t i = 0; i < active.size(); ++i)
+                for (size_t j = i + 1; j < active.size(); ++j) {
+                    const std::string& a = active[i]->tag;
+                    const std::string& b = active[j]->tag;
+                    const auto met = std::count_if(played.begin(), played.end(), [&](const EsMatch& m) {
+                        return m.stage == 1 && ((m.home == a && m.away == b) || (m.home == b && m.away == a));
+                    });
+                    if (met > round) continue;
+                    EsScheduleRow row;
+                    row.played = false;
+                    row.match.home = round % 2 ? b : a;
+                    row.match.away = round % 2 ? a : b;
+                    rows.push_back(row);
+                }
+    }
+    return rows;
+}
+
+// The players' GP averages: runners (or baggers), best first; mkw-stats' players need 3 GPs in
+// that role (fewer is too small a sample for an average).
+// Finished seasons' runners need a GP average of 8: lower ones are baggers whose roster role says
+// otherwise (Toad's Factory's player_role).
+constexpr double kEsMinAverageGps = 3.0, kEsMinRunnerAverage = 8.0;
+std::vector<EsPlayerAverage> EsAverageRows(const EsStandings& standings, bool baggers) {
+    std::vector<EsPlayerAverage> rows;
+    if (standings.toads) {
+        for (const auto& [entry, roster] : standings.members) {
+            std::string tag, teamName;
+            uint32_t color = 0xFFFFFF;
+            for (const auto& t : standings.teams) if (t.entryId == entry) { tag = t.tag; color = t.color; teamName = t.name; }
+            for (const auto& m : roster) {
+                if (!(m.gpAverage > 0) || m.bagger != baggers) continue;
+                EsPlayerAverage a;
+                a.playerId = m.statsId;
+                a.toadsId = m.toadsId;
+                a.name = m.name;
+                a.tag = tag;
+                a.team = teamName;
+                a.color = color;
+                (baggers ? a.bagger : a.runner) = m.gpAverage;
+                rows.push_back(a);
+            }
+        }
+    } else {
+        for (const auto& a : standings.averages)
+            if ((baggers ? a.bagger : a.runner) > 0 && (baggers ? a.baggerGps : a.runnerGps) >= kEsMinAverageGps - 1e-6) rows.push_back(a);
+    }
+    if (!baggers && standings.finished)
+        rows.erase(std::remove_if(rows.begin(), rows.end(), [](const EsPlayerAverage& a) { return a.runner < kEsMinRunnerAverage; }), rows.end());
+    std::stable_sort(rows.begin(), rows.end(), [baggers](const auto& a, const auto& b) { return (baggers ? a.bagger : a.runner) > (baggers ? b.bagger : b.runner); });
+    return rows;
+}
+
+// The button that switches runners / baggers: the GameCube's Y, else the option button (-).
+const char* EsOptionLabel() {
+    const uint32_t manager = Memory::Read32(kSectionManager);
+    const uint32_t id = manager && Memory::Contains(manager + kPadControllerId, 4) ? Memory::Read32(manager + kPadControllerId) & 0xFF : 0x24;
+    return id == 0x24 ? "Y" : "-";
+}
+
+std::string EsFixed(double v, int places = 2) {
+    char text[32];
+    std::snprintf(text, sizeof text, "%.*f", places, v);
+    return text;
+}
+
+// A player's flag (the game's, from Globe.szs) after text at (x, y): its width with a gap, 0 when
+// their country isn't known (yet).
+float EsDrawFlag(EsCanvas& c, float x, float y, float h, int country, float a = 1.0f) {
+    if (!country || !g_esGlyphs.count(kGlyphFlag + country)) return 0.0f;
+    const float w = h * 1.5f;
+    c.Rect(x - 0.8f, y - 0.8f, x + w + 0.8f, y + h + 0.8f, Rgba(0x000000, c.alpha * a * 0.5f), 1.5f);
+    c.Image(kGlyphFlag + country, x, y, x + w, y + h, Rgba(0xFFFFFF, c.alpha * a));
+    return w + 7.0f;
+}
+
+// A scrolled list's frame: keeps `cursor` in view (gliding), returns the first row shown.
+float EsFollow(float& scroll, int cursor, int count, int visible) {
+    float target = std::clamp(scroll, static_cast<float>(cursor - visible + 1), static_cast<float>(cursor));
+    target = std::clamp(target, 0.0f, static_cast<float>(std::max(0, count - visible)));
+    scroll += (target - scroll) * 0.35f;
+    if (std::fabs(target - scroll) < 0.01f) scroll = target;
+    return scroll;
+}
+
+const EsTeam* EsTeamByTag(const EsStandings& standings, const std::string& tag) {
+    for (const auto& t : standings.teams) if (t.tag == tag) return &t;
+    return nullptr;
+}
+
+void EsDrawSchedule(EsCanvas& c, float W, float L, float R, float rowTop, float rowBottom, const EsStandings& standings, float t,
+                    std::optional<std::pair<EsCanvas, ImVec2>>& moreBelow) {
+    const auto rows = EsScheduleRows(standings);
+    const float headerY = kEsSectionTop;
+    c.Gradient(L, headerY, R, headerY + 22, Rgba(0x000820, c.alpha * 0.55f), Rgba(0x000820, c.alpha * 0.55f), Rgba(0x00163E, c.alpha * 0.55f), Rgba(0x00163E, c.alpha * 0.55f));
+    const float mid = (L + R) * 0.5f;
+    c.Text(L + 14, headerY, 24, 0xB8C8F0, "Match");
+    c.Text(mid, headerY, 24, 0xB8C8F0, "Score", 0.5f);
+    if (rows.empty()) {
+        const bool loading = !standings.loaded || (!standings.toads && !standings.scheduleLoaded);
+        c.Text(W * 0.5f, rowTop + 110, 30, 0xFFFFFF, loading ? "Loading matches..." : "No matches yet.", 0.5f);
+        return;
+    }
+    const int count = static_cast<int>(rows.size());
+    const float pitch = 34.0f, rowH = 30.0f;
+    const int visible = std::max(1, static_cast<int>((rowBottom - rowTop + 4.0f) / pitch));
+    g_esSchedCursor = std::clamp(g_esSchedCursor, 0, count - 1);
+    const float scroll = EsFollow(g_esSchedScroll, g_esSchedCursor, count, visible);
+    c.list->PushClipRect(c.P(-c.dx, rowTop - 3), c.P(W - c.dx, rowBottom + 3), true);
+    for (int k = 0; k < count; ++k) {
+        const float y = rowTop + (static_cast<float>(k) - scroll) * pitch;
+        if (y + rowH < rowTop - pitch || y > rowBottom + pitch) continue;
+        const EsScheduleRow& row = rows[k];
+        const EsMatch& m = row.match;
+        const bool selected = k == g_esSchedCursor;
+        EsDrawRow(c, L, R, y, rowH, selected, row.played ? 1.0f : 0.7f, t);
+        const uint32_t textColor = selected ? 0xFFF27A : 0xFFFFFF;
+        std::string what = !row.played ? "Upcoming" : m.stage == 3 ? "Final" : m.stage == 2 ? "Semifinal" : "M" + std::to_string(m.number);
+        c.Text(L + 14, y + 3, 22, row.played ? textColor : 0xA8C0F0, what);
+        // home team right-aligned before the score, away after it: colour bar, logo, name
+        const EsTeam* home = EsTeamByTag(standings, m.home);
+        const EsTeam* away = EsTeamByTag(standings, m.away);
+        auto team = [&](const EsTeam* team, const std::string& tag, bool left, bool won) {
+            const float logoX = left ? mid - 74 : mid + 74;
+            const ImVec2 center = c.P(logoX, y + rowH * 0.5f);
+            const float radius = (rowH * 0.5f - 2.0f) * c.u;
+            c.list->AddCircleFilled(center, radius + 1.5f * c.u, Rgba(0xFFFFFF, c.alpha * 0.8f));
+            ImVec2 ls;
+            if (team) {
+                if (const ImTextureID logo = EsLogoTexture(team->logoUrl, ls, team->name, team->tag))
+                    c.list->AddImageRounded(logo, ImVec2(center.x - radius, center.y - radius), ImVec2(center.x + radius, center.y + radius), ImVec2(0, 0), ImVec2(1, 1), Rgba(0xFFFFFF, c.alpha), radius);
+                else c.list->AddCircleFilled(center, radius, Rgba(team->color, c.alpha));
+            } else c.list->AddCircleFilled(center, radius, Rgba(0x0A1030, c.alpha));
+            const std::string name = Fit(c, 22, team ? team->name : tag, (R - L) * 0.5f - 230);
+            const uint32_t color = row.played && !won ? (selected ? 0xE0D48A : 0xC0C8E0) : textColor;
+            if (left) c.Text(logoX - 22, y + 3, 22, color, name, 1.0f);
+            else c.Text(logoX + 22, y + 3, 22, color, name);
+        };
+        team(home, m.home, true, m.homeScore >= m.awayScore);
+        team(away, m.away, false, m.awayScore >= m.homeScore);
+        if (row.played) {
+            c.Text(mid - 8, y + 1, 26, m.homeScore > m.awayScore ? 0xFFF07A : textColor, std::to_string(m.homeScore), 1.0f);
+            c.Text(mid, y + 1, 26, textColor, "-", 0.5f);
+            c.Text(mid + 8, y + 1, 26, m.awayScore > m.homeScore ? 0xFFF07A : textColor, std::to_string(m.awayScore));
+        } else {
+            c.Text(mid, y + 3, 22, 0xA8C0F0, "vs", 0.5f);
+        }
+    }
+    c.list->PopClipRect();
+    if (scroll > 0.05f) c.Text(W * 0.5f, rowTop - 20, 22, 0xFFFFFF, "\xE2\x96\xB2", 0.5f, 0.8f);
+    if (scroll < static_cast<float>(count - visible) - 0.05f) moreBelow.emplace(c, ImVec2(W * 0.5f, rowBottom - 4));
+}
+
+void EsDrawAverages(EsCanvas& c, float W, float L, float R, float rowTop, float rowBottom, const EsStandings& standings, float t,
+                    std::optional<std::pair<EsCanvas, ImVec2>>& moreBelow) {
+    const auto rows = EsAverageRows(standings, g_esAvgBaggers);
+    // as wide as its text: rank, Mii, name, team, GPs, average
+    float nameW = c.TextWidth(24, g_esAvgBaggers ? "Bagger" : "Runner"), teamW = c.TextWidth(24, "Team");
+    for (const auto& a : rows) {
+        nameW = std::max(nameW, c.TextWidth(22, a.name) + 40);   // + a cup
+        teamW = std::max(teamW, c.TextWidth(19, a.tag + (a.eligible ? "" : "  (not eligible)")));
+    }
+    nameW = std::min(nameW, 260.0f);
+    teamW = std::min(teamW, 200.0f);
+    const bool gps = !standings.toads;
+    const float width = 66 + 34 + 28 + nameW + 24 + teamW + 24 + (gps ? 70 : 0) + 96;
+    const float l = std::max(L, (L + R) * 0.5f - width * 0.5f), r = std::min(R, l + width);
+    const float miiX = l + 66, flagX = miiX + 34, nameX = flagX + 28, teamX = nameX + nameW + 24, avgX = r - 14, gpsX = avgX - 96;
+    const float headerY = kEsSectionTop;
+    c.Gradient(l, headerY, r, headerY + 22, Rgba(0x000820, c.alpha * 0.55f), Rgba(0x000820, c.alpha * 0.55f), Rgba(0x00163E, c.alpha * 0.55f), Rgba(0x00163E, c.alpha * 0.55f));
+    c.Text(l + 14, headerY, 24, 0xB8C8F0, "#");
+    c.Text(nameX, headerY, 24, 0xB8C8F0, g_esAvgBaggers ? "Bagger" : "Runner");
+    c.Text(teamX, headerY, 24, 0xB8C8F0, "Team");
+    if (gps) c.Text(gpsX, headerY, 24, 0xB8C8F0, "GPs", 1.0f);
+    c.Text(avgX, headerY, 24, 0xB8C8F0, "GP Avg", 1.0f);
+    if (rows.empty()) {
+        c.Text(W * 0.5f, rowTop + 110, 30, 0xFFFFFF, !standings.loaded ? "Loading players..." : g_esAvgBaggers ? "No baggers yet." : "No runners yet.", 0.5f);
+        return;
+    }
+    const int count = static_cast<int>(rows.size());
+    const float pitch = 30.0f, rowH = 26.0f;
+    const int visible = std::max(1, static_cast<int>((rowBottom - rowTop + 4.0f) / pitch));
+    g_esAvgCursor = std::clamp(g_esAvgCursor, 0, count - 1);
+    const float scroll = EsFollow(g_esAvgScroll, g_esAvgCursor, count, visible);
+    c.list->PushClipRect(c.P(-c.dx, rowTop - 3), c.P(W - c.dx, rowBottom + 3), true);
+    for (int k = 0; k < count; ++k) {
+        const float y = rowTop + (static_cast<float>(k) - scroll) * pitch;
+        if (y + rowH < rowTop - pitch || y > rowBottom + pitch) continue;
+        const EsPlayerAverage& a = rows[k];
+        const bool selected = k == g_esAvgCursor;
+        const float dim = a.eligible ? 1.0f : 0.6f;
+        EsDrawRow(c, l, r, y, rowH, selected, dim, t);
+        c.Rect(l + 2, y + 3, l + 6, y + rowH - 3, Rgba(a.color, c.alpha * dim), 1.5f);
+        const uint32_t textColor = selected ? 0xFFF27A : 0xFFFFFF;
+        c.Text(l + 14, y + 1, 22, textColor, Ordinal(k + 1), 0.0f, dim);
+        // the Mii, in a round frame as the rosters'
+        const ImVec2 center = c.P(miiX + 14, y + rowH * 0.5f);
+        const float radius = (rowH * 0.5f - 0.5f) * c.u;
+        c.list->AddCircleFilled(center, radius + 1.5f * c.u, Rgba(0xFFFFFF, c.alpha * 0.85f * dim));
+        c.list->AddCircleFilled(center, radius, Rgba(0x0A1030, c.alpha * dim));
+        EsPlayer player;
+        player.playerId = a.playerId;
+        player.toadsId = a.toadsId;
+        player.toadsRoster = a.toadsId != 0;
+        player.name = a.name;
+        EsTeam team;
+        team.name = a.team;
+        team.tag = a.tag;
+        if (const ImTextureID mii = EsMiiTexture(player, team))
+            c.list->AddImageRounded(mii, ImVec2(center.x - radius, center.y - radius), ImVec2(center.x + radius, center.y + radius), ImVec2(0, 0), ImVec2(1, 1), Rgba(0xFFFFFF, c.alpha * dim), radius);
+        else
+            c.Image(kGlyphDefaultMii, miiX + 14 - rowH * 0.5f + 1, y + 1, miiX + 14 + rowH * 0.5f - 1, y + rowH - 1, Rgba(0xFFFFFF, c.alpha * dim));
+        const char* cup = EsCup(k + 1);
+        EsDrawFlag(c, flagX, y + 6.5f, 13.0f, EsPlayerCountry(player, team), dim);   // a column of its own
+        const std::string name = Fit(c, 22, a.name, nameW - (cup ? 34 : 4));
+        c.Text(nameX, y + 1, 22, textColor, name, 0.0f, dim);
+        if (cup) c.Text(nameX + c.TextWidth(22, name) + 6, y + 1, 22, 0xFFFFFF, cup, 0.0f, dim);
+        c.Text(teamX, y + 3, 19, 0xA8C0F0, Fit(c, 19, a.tag + (a.eligible ? "" : "  (not eligible)"), teamW), 0.0f, dim);
+        if (gps) c.Text(gpsX, y + 1, 22, textColor, EsFixed(g_esAvgBaggers ? a.baggerGps : a.runnerGps, 1), 1.0f, dim);
+        c.Text(avgX, y, 24, selected ? 0xFFF27A : 0xFFF07A, EsFixed(g_esAvgBaggers ? a.bagger : a.runner), 1.0f, dim);
+    }
+    c.list->PopClipRect();
+    if (scroll > 0.05f) c.Text(W * 0.5f, rowTop - 20, 22, 0xFFFFFF, "\xE2\x96\xB2", 0.5f, 0.8f);
+    if (scroll < static_cast<float>(count - visible) - 0.05f) moreBelow.emplace(c, ImVec2(W * 0.5f, rowBottom - 4));
+}
