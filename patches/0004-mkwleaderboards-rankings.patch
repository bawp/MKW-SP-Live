+// ---- The game's font and icons ----------------------------------------------------------------
+// kart_kanji_font.brfnt (the menus' outlined font: Latin, Greek, kana, symbols), the controller
+// icons of tt_kart_extension_font.brfnt and the D-pad of Race.szs (fm_handle_juji.tpl), drawn from
+// their sheets as the game draws them: the texture pack's HD sheets when it has them (as the rest of
+// the game's text), else the disc's. A Windows font draws anything they lack.
+
+uint32_t Be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+uint16_t Be16(const uint8_t* p) { return static_cast<uint16_t>(p[0] << 8 | p[1]); }
+
+std::vector<uint8_t> EsReadFile(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return {};
+    return std::vector<uint8_t>(std::istreambuf_iterator<char>(in), {});
+}
+
+std::vector<uint8_t> EsYaz0(const std::vector<uint8_t>& in) {
+    if (in.size() < 16 || std::memcmp(in.data(), "Yaz0", 4) != 0) return in;
+    const uint32_t size = Be32(&in[4]);
+    std::vector<uint8_t> out(size);
+    size_t s = 16, d = 0;
+    while (d < size && s < in.size()) {
+        const uint8_t head = in[s++];
+        for (int bit = 7; bit >= 0 && d < size && s < in.size(); --bit) {
+            if (head & (1 << bit)) {
+                out[d++] = in[s++];
+                continue;
+            }
+            if (s + 1 >= in.size()) return {};
+            const uint8_t b1 = in[s++], b2 = in[s++];
+            const size_t dist = ((static_cast<size_t>(b1 & 15) << 8) | b2) + 1;
+            size_t len = b1 >> 4;
+            if (len == 0) {
+                if (s >= in.size()) return {};
+                len = static_cast<size_t>(in[s++]) + 0x12;
+            } else {
+                len += 2;
+            }
+            if (dist > d) return {};
+            for (size_t k = 0; k < len && d < size; ++k, ++d) out[d] = out[d - dist];
+        }
+    }
+    return out;
+}
+
+// The file of a U8 archive whose path ends with `suffix`: { offset, size }.
+std::optional<std::pair<size_t, size_t>> EsU8Find(const std::vector<uint8_t>& arc, const std::string& suffix) {
+    if (arc.size() < 0x20 || Be32(arc.data()) != 0x55AA382D) return std::nullopt;
+    const uint32_t root = Be32(&arc[4]);
+    if (static_cast<size_t>(root) + 12 > arc.size()) return std::nullopt;
+    const uint32_t count = Be32(&arc[root + 8]);
+    const size_t strings = root + static_cast<size_t>(count) * 12;
+    if (strings > arc.size()) return std::nullopt;
+    auto name = [&](uint32_t off) {
+        std::string s;
+        for (size_t k = strings + off; k < arc.size() && arc[k]; ++k) s += static_cast<char>(arc[k]);
+        return s;
+    };
+    std::vector<std::pair<uint32_t, std::string>> dirs{{count, ""}};
+    for (uint32_t i = 1; i < count; ++i) {
+        while (dirs.size() > 1 && i >= dirs.back().first) dirs.pop_back();
+        const uint8_t* e = &arc[root + static_cast<size_t>(i) * 12];
+        const std::string path = dirs.back().second + "/" + name(Be32(e) & 0xFFFFFF);
+        if (e[0] == 1) {
+            dirs.push_back({Be32(e + 8), path});
+        } else if (path.size() >= suffix.size() && path.compare(path.size() - suffix.size(), suffix.size(), suffix) == 0) {
+            const uint32_t at = Be32(e + 4), size = Be32(e + 8);
+            if (static_cast<size_t>(at) + size <= arc.size()) return std::pair<size_t, size_t>{at, size};
+        }
+    }
+    return std::nullopt;
+}
+
+// GX texture data (IA4, IA8, RGB5A3) to RGBA.
+bool EsDecodeTexture(uint32_t format, int w, int h, const uint8_t* data, size_t available, std::vector<uint8_t>& rgba) {
+    int bw = 4, bh = 4, bits = 16;
+    if (format == 2) { bw = 8; bits = 8; }
+    else if (format != 3 && format != 5) return false;
+    const size_t need = static_cast<size_t>((w + bw - 1) / bw) * ((h + bh - 1) / bh) * bw * bh * bits / 8;
+    if (w <= 0 || h <= 0 || need > available) return false;
+    rgba.assign(static_cast<size_t>(w) * h * 4, 0);
+    size_t p = 0;
+    for (int by = 0; by < h; by += bh) {
+        for (int bx = 0; bx < w; bx += bw) {
+            for (int y = 0; y < bh; ++y) {
+                for (int x = 0; x < bw; ++x) {
+                    uint8_t r, g, b, a;
+                    if (format == 2) {
+                        const uint8_t v = data[p++];
+                        a = static_cast<uint8_t>((v >> 4) * 17);
+                        r = g = b = static_cast<uint8_t>((v & 15) * 17);
+                    } else if (format == 3) {
+                        a = data[p];
+                        r = g = b = data[p + 1];
+                        p += 2;
+                    } else {
+                        const uint16_t c = Be16(data + p);
+                        p += 2;
+                        if (c & 0x8000) {
+                            r = static_cast<uint8_t>(((c >> 10) & 31) * 255 / 31);
+                            g = static_cast<uint8_t>(((c >> 5) & 31) * 255 / 31);
+                            b = static_cast<uint8_t>((c & 31) * 255 / 31);
+                            a = 255;
+                        } else {
+                            a = static_cast<uint8_t>(((c >> 12) & 7) * 255 / 7);
+                            r = static_cast<uint8_t>(((c >> 8) & 15) * 17);
+                            g = static_cast<uint8_t>(((c >> 4) & 15) * 17);
+                            b = static_cast<uint8_t>((c & 15) * 17);
+                        }
+                    }
+                    const int px = bx + x, py = by + y;
+                    if (px < w && py < h) {
+                        uint8_t* o = &rgba[(static_cast<size_t>(py) * w + px) * 4];
+                        o[0] = r; o[1] = g; o[2] = b; o[3] = a;
+                    }
+                }
+            }
+        }
+    }
+    return true;
+}
