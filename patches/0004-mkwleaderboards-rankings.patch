+// Top-10 ghosts: picking a row of the top-10 list (0xAF) asks for that rank's ghost through the same
+// champion ghost pages (0xAC -> 0xAD). g_pickedRank is set by the list and taken by 0xAE's next-page
+// query, g_requestRank by the ghost request; g_shownRank is the rank of the ghost last downloaded.
+std::atomic<int> g_pickedRank{-1}, g_requestRank{-1};
+// Your own card on the ranking graph, with a PB imported by My Times: its ghost comes through the
+// same pages as the champion's (MtRouteOwnGhost), served from the import (MtPbGhost).
+std::atomic<bool> g_requestOwn{false};
+bool g_shownOwn = false;
+std::vector<uint8_t> MtPbGhost(uint32_t course, const std::string& board);   // My Times (further down)
+bool MtHasPb(uint32_t course);
+int g_shownRank = 0;
+uint32_t g_shownCourse = 0;
+bool g_shownWorld = true, g_ghostRetitled = true;
+bool g_keepChampionRecords = false;   // a top-10 ghost was downloaded: the game must not store it as the champion
+bool g_topTenGhostForgotten = true;   // the downloaded top-10 ghost was dropped from the GhostManager
