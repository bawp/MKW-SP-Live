+// nw4r::lyt::Pane::Pane(const res::Pane*) (0x80078980), as the game's, then the bar fix above.
+extern "C" void LytPaneCtor_HLE_80078980(CpuContext* ctx) {
+    const uint32_t pane = ctx->gpr[3], block = ctx->gpr[4];
+    Memory::Write32(pane + 0x00, kPaneVtable);
+    Memory::Write32(pane + 0x04, 0);
+    Memory::Write32(pane + 0x08, 0);
+    Memory::Write32(pane + 0x0C, 0);
+    Memory::Write32(pane + 0x10, 0);
+    Memory::Write32(pane + 0x14, pane + 0x14);   // child list (empty)
+    Memory::Write32(pane + 0x18, pane + 0x14);
+    Memory::Write32(pane + 0x1C, 0);
+    Memory::Write32(pane + 0x20, pane + 0x20);   // animation list (empty)
+    Memory::Write32(pane + 0x24, pane + 0x20);
+    Memory::Write32(pane + 0x28, 0);
+    Memory::Write32(pane + 0xB4, 0);
+    Memory::Write8(pane + 0xD6, 0);
+    Memory::Write8(pane + 0xBA, Memory::Read8(block + 0x09));   // origin
+    CopyName(pane + kPaneName, block + 0x0C, 16);
+    Memory::Write8(pane + 0xCC, 0);
+    CopyName(pane + kPaneUserData, block + 0x1C, 8);
+    Memory::Write8(pane + 0xD5, 0);
+    for (uint32_t k = 0; k < 10; ++k) Memory::Write32(pane + 0x2C + 4 * k, Memory::Read32(block + 0x24 + 4 * k));   // translate, rotate, scale, size
+    const uint8_t alpha = Memory::Read8(block + 0x0A);
+    Memory::Write8(pane + 0xB8, alpha);
+    Memory::Write8(pane + 0xB9, alpha);
+    Memory::Write8(pane + 0xBB, Memory::Read8(block + 0x08));   // flags
+    ctx->gpr[3] = pane;
+
+    char name[17] = {};
+    for (uint32_t k = 0; k < 16; ++k) name[k] = static_cast<char>(Memory::Read8(pane + kPaneName + k));
+    if (std::strcmp(name, "obi_base_l") == 0) {
+        auto f32 = [](uint32_t at) { const uint32_t v = Memory::Read32(at); float f; std::memcpy(&f, &v, 4); return f; };
+        const float w = f32(pane + kPaneSize), h = f32(pane + kPaneSize + 4);
+        if (h == 133.0f && (w == 269.0f || w == 272.0f)) {
+            const float wider = w + 0.5f;
+            uint32_t v;
+            std::memcpy(&v, &wider, 4);
+            Memory::Write32(pane + kPaneSize, v);
+        }
+    }
+}
