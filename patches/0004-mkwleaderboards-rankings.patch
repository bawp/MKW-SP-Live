+            else
+                c.Image(kGlyphDefaultMii, mx, my, mx + ms, my + ms, Rgba(0xFFFFFF, alpha));
+            const uint32_t textColor = selected ? 0xFFF27A : 0xFFFFFF;
+            const float flagW = 19.5f, flagH = 13.0f;
+            const int country = EsPlayerCountry(p, team);
+            const bool flag = country && g_esGlyphs.count(kGlyphFlag + country);
+            const std::string shown = Fit(c, 23, p.name, nameMax - (flag ? flagW + 8 : 0));
+            c.Text(nameX, y - 2, 23, textColor, shown);
+            if (flag) {
+                const float fx = nameX + c.TextWidth(23, shown) + 7, fy = y + 3.5f;
+                c.Rect(fx - 0.8f, fy - 0.8f, fx + flagW + 0.8f, fy + flagH + 0.8f, Rgba(0x000000, alpha * 0.5f), 1.5f);
+                c.Image(kGlyphFlag + country, fx, fy, fx + flagW, fy + flagH, Rgba(0xFFFFFF, alpha));
+            }
+            const bool guess = p.role == "projected";
+            const char* role = guess ? "Projected" : EsRoleOf(p.races != 0 ? p.pointsPerRace * 4.0 : 0.0);
+            if (role) c.Text(nameX + 1, y + rowH - 16, 15, guess ? 0x9DE8C8 : role[0] == 'B' ? 0xFFC27A : 0xA8C0F0, role);
+            char gp[16];
+            std::snprintf(gp, sizeof gp, "%.2f", p.pointsPerRace * 4.0);   // a GP is 4 races
+            const std::string values[] = {guess || p.pointsPerRace < 0 ? "-" : gp, guess || p.races < 0 ? "-" : std::to_string(p.races)};
+            if (showStatus && p.status >= 0) {
+                static constexpr std::pair<const char*, uint32_t> kStatus[] = {{"Active", 0x3CDC5A}, {"Idle", 0xFFD02E}, {"Inactive", 0xFF4646}};
+                const auto& [word, color] = kStatus[std::min(p.status, 2)];
+                const ImVec2 dot = c.P(statusX + 6, y + rowH * 0.5f);
+                c.list->AddCircleFilled(dot, 3.4f * c.u, Rgba(0x000000, alpha * 0.45f));
+                c.list->AddCircleFilled(dot, 2.5f * c.u, Rgba(color, alpha));
+                c.list->AddCircleFilled(ImVec2(dot.x - 0.7f * c.u, dot.y - 0.7f * c.u), 0.8f * c.u, Rgba(0xFFFFFF, alpha * 0.55f));
+                c.Text(statusX + 11, y + (rowH - 19) * 0.5f, 19, selected ? 0xFFF27A : 0xFFFFFF, word);
+            }
+            for (size_t i = 0; i < cols.size(); ++i) {
