+// The button hints, right-aligned in the bottom bar's dip. With `credit`, the data source goes to their
+// left when it fits there (returns true); else the caller keeps it above the bar.
+bool EsDrawHints(EsCanvas& c, float W, const std::string& hints, const char* credit = nullptr) {
+    c.Text(W - 22, kEsHintY, 28, 0xFFFFFF, hints, 1.0f);
+    if (!credit) return true;
+    const float right = W - 22 - c.TextWidth(28, hints) - 26;
+    if (right - c.TextWidth(17, credit) < kEsBarCurveEnd) return false;
+    c.Text(right, kEsHintY + 7, 17, 0xC8D2F0, credit, 1.0f, 0.8f);
+    return true;
+}
