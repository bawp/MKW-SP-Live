+            c.Image(kGlyphFlag + flagCode, fx, fy, fx + flagW, fy + flagH, Rgba(0xFFFFFF, alpha));
+        }
+        edged(right - std::max(whereW, labelW) * 0.5f - whereW * 0.5f, y + 16, where);
+    }
+    EsDrawHints(c, W, std::string(kIconDpad) + " Season / Scroll");
+}
