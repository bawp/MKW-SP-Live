+void EsLoadTeam(int team) {
+    std::thread([team] {
+        std::string error;
+        EsTeamInfo info;
+        if (const auto json = EsFetch("/api/teams/" + std::to_string(team) + "/overview?league=" + kEsLeague.id, error)) {
+            const Json* identity = json->get("identity");
+            const Json* list = identity ? identity->get("appearances") : nullptr;
+            if (const auto* arr = list ? std::get_if<Json::Array>(&list->v) : nullptr) {
+                for (const auto& a : *arr)
+                    info.appearances.push_back({a.str("season"), a.str("division"), a.str("name"), a.str("tag"), a.str("competition_status"),
+                                                static_cast<int>(a.num("team_season_entry_id"))});
+                std::stable_sort(info.appearances.begin(), info.appearances.end(),
+                                 [](const EsAppearance& x, const EsAppearance& y) { return SeasonNumber(x.season) > SeasonNumber(y.season); });
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& t = g_esTeams[team];
+        t.loading = false;
+        t.fetched = Clock::now();
+        t.error = error;
+        if (error.empty()) {
+            t.loaded = true;
+            t.appearances = std::move(info.appearances);
+        }
+    }).detach();
+}
