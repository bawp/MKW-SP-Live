+
+// Dolphin's names for custom textures: tex1_<w>x<h>_<XXH64 of the texture data>_<format>.
+uint64_t EsXxh64(const uint8_t* p, size_t n) {
+    constexpr uint64_t P1 = 11400714785074694791ULL, P2 = 14029467366897019727ULL, P3 = 1609587929392839161ULL;
+    constexpr uint64_t P4 = 9650029242287828579ULL, P5 = 2870177450012600261ULL;
+    auto rotl = [](uint64_t x, int r) { return (x << r) | (x >> (64 - r)); };
+    auto rd64 = [](const uint8_t* q) { uint64_t v; std::memcpy(&v, q, 8); return v; };
+    auto rd32 = [](const uint8_t* q) { uint32_t v; std::memcpy(&v, q, 4); return v; };
+    auto round = [&](uint64_t acc, uint64_t in) { acc += in * P2; acc = rotl(acc, 31); return acc * P1; };
+    auto merge = [&](uint64_t acc, uint64_t v) { acc ^= round(0, v); return acc * P1 + P4; };
+    const uint8_t* end = p + n;
+    uint64_t h;
+    if (n >= 32) {
+        uint64_t v1 = P1 + P2, v2 = P2, v3 = 0, v4 = 0 - P1;
+        while (p + 32 <= end) {
+            v1 = round(v1, rd64(p)); v2 = round(v2, rd64(p + 8)); v3 = round(v3, rd64(p + 16)); v4 = round(v4, rd64(p + 24));
+            p += 32;
+        }
+        h = rotl(v1, 1) + rotl(v2, 7) + rotl(v3, 12) + rotl(v4, 18);
+        h = merge(h, v1); h = merge(h, v2); h = merge(h, v3); h = merge(h, v4);
+    } else {
+        h = P5;
+    }
+    h += n;
+    while (p + 8 <= end) { h ^= round(0, rd64(p)); h = rotl(h, 27) * P1 + P4; p += 8; }
+    if (p + 4 <= end) { h ^= static_cast<uint64_t>(rd32(p)) * P1; h = rotl(h, 23) * P2 + P3; p += 4; }
+    while (p < end) { h ^= *p * P5; h = rotl(h, 11) * P1; ++p; }
+    h ^= h >> 33; h *= P2; h ^= h >> 29; h *= P3; h ^= h >> 32;
+    return h;
+}
+
+// The texture pack the game uses (UserData/texture_replacements), by file name.
+const std::unordered_map<std::string, std::filesystem::path>& EsTexturePack() {
+    static const auto index = [] {
+        std::unordered_map<std::string, std::filesystem::path> files;
+        std::error_code ec;
+        const auto root = RuntimeConfigFile::ApplicationDataDirectory() / "texture_replacements";
+        for (auto it = std::filesystem::recursive_directory_iterator(root, ec); !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+            if (!it->is_regular_file(ec)) continue;
+            std::string name = it->path().filename().string();
+            for (char& c : name) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+            if (name.size() > 4 && name.compare(name.size() - 4, 4, ".dds") == 0) files.emplace(name.substr(0, name.size() - 4), it->path());
+        }
+        return files;
+    }();
+    return index;
+}
+
+// The pack's replacement of a texture (BC1 / BC3 / BC7 or RGBA8 DDS), if it has one.
+std::optional<EsTextureData> EsReplacement(uint32_t w, uint32_t h, uint32_t format, const uint8_t* data, size_t size) {
+    char name[64];
+    std::snprintf(name, sizeof name, "tex1_%ux%u_%016llx_%u", w, h, static_cast<unsigned long long>(EsXxh64(data, size)), format);
+    const auto& pack = EsTexturePack();
+    const auto it = pack.find(name);
+    if (it == pack.end()) return std::nullopt;
+    const auto dds = EsReadFile(it->second);
+    if (dds.size() < 128 || std::memcmp(dds.data(), "DDS ", 4) != 0) return std::nullopt;
+    auto le32 = [&](size_t at) { uint32_t v; std::memcpy(&v, &dds[at], 4); return v; };
+    EsTextureData t;
+    t.height = le32(12);
+    t.width = le32(16);
+    size_t at = 128;
+    const char* fourcc = reinterpret_cast<const char*>(&dds[84]);
+    if (std::memcmp(fourcc, "DX10", 4) == 0) {
+        if (dds.size() < 148) return std::nullopt;
+        const uint32_t dxgi = le32(128);
+        at = 148;
+        if (dxgi == 98 || dxgi == 99) { t.format = wgpu::TextureFormat::BC7RGBAUnorm; t.blockBytes = 16; }
+        else if (dxgi == 71 || dxgi == 72) { t.format = wgpu::TextureFormat::BC1RGBAUnorm; t.blockBytes = 8; }
+        else if (dxgi == 77 || dxgi == 78) { t.format = wgpu::TextureFormat::BC3RGBAUnorm; t.blockBytes = 16; }
+        else if (dxgi != 28 && dxgi != 29) return std::nullopt;
+    } else if (std::memcmp(fourcc, "DXT1", 4) == 0) {
+        t.format = wgpu::TextureFormat::BC1RGBAUnorm; t.blockBytes = 8;
+    } else if (std::memcmp(fourcc, "DXT5", 4) == 0) {
+        t.format = wgpu::TextureFormat::BC3RGBAUnorm; t.blockBytes = 16;
+    } else if (le32(88) == 32 && le32(92) == 0x00FF0000) {   // uncompressed BGRA
+        const size_t n = static_cast<size_t>(t.width) * t.height * 4;
+        if (dds.size() < at + n) return std::nullopt;
+        t.data.assign(dds.begin() + at, dds.begin() + at + n);
+        for (size_t k = 0; k < n; k += 4) std::swap(t.data[k], t.data[k + 2]);
+        return t;
+    } else {
+        return std::nullopt;
+    }
+    const size_t n = t.blockBytes ? static_cast<size_t>((t.width + 3) / 4) * ((t.height + 3) / 4) * t.blockBytes : static_cast<size_t>(t.width) * t.height * 4;
+    if (!t.width || !t.height || dds.size() < at + n) return std::nullopt;
+    if (t.blockBytes && (t.width % 4 || t.height % 4)) return std::nullopt;
+    t.data.assign(dds.begin() + at, dds.begin() + at + n);
+    return t;
+}
+
+// A texture of the game's (GX data on the disc), or its HD replacement.
+std::optional<EsTextureData> EsGameTexture(uint32_t format, uint32_t w, uint32_t h, const uint8_t* data, size_t size, bool& hd, bool allowHd = true) {
+    hd = false;
+    if (allowHd) {
+        if (auto replacement = EsReplacement(w, h, format, data, size)) { hd = true; return replacement; }
+    }
+    EsTextureData t;
+    t.width = w;
+    t.height = h;
+    if (!EsDecodeTexture(format, static_cast<int>(w), static_cast<int>(h), data, size, t.data)) return std::nullopt;
+    return t;
+}
+
+// The glyphs of a BRFNT (RFNT) for the code points `want` accepts, with its sheets.
+template <typename Want>
+void EsAddFont(EsFontData& font, const uint8_t* f, size_t size, bool colored, Want want) {
+    if (size < 0x10 || std::memcmp(f, "RFNT", 4) != 0) return;
+    const uint8_t *finf = nullptr, *tglp = nullptr;
+    std::vector<const uint8_t*> cwdh, cmap;
+    size_t o = Be16(f + 0xC);
+    for (uint16_t k = 0, n = Be16(f + 0xE); k < n && o + 8 <= size; ++k) {
+        const uint8_t* s = f + o;
+        const uint32_t length = Be32(s + 4);
+        if (length < 8 || o + length > size) break;
+        if (!std::memcmp(s, "FINF", 4)) finf = s;
+        else if (!std::memcmp(s, "TGLP", 4)) tglp = s;
+        else if (!std::memcmp(s, "CWDH", 4)) cwdh.push_back(s);
+        else if (!std::memcmp(s, "CMAP", 4)) cmap.push_back(s);
+        o += length;
+    }
+    if (!finf || !tglp) return;
+    const int cellW = tglp[8], cellH = tglp[9], baseline = tglp[0xA];
+    const uint32_t sheetSize = Be32(tglp + 0xC), image = Be32(tglp + 0x1C);
+    const int sheets = Be16(tglp + 0x10), format = Be16(tglp + 0x12), cols = Be16(tglp + 0x14), rows = Be16(tglp + 0x16);
+    const int sheetW = Be16(tglp + 0x18), sheetH = Be16(tglp + 0x1A);
+    if (!cols || !rows || !sheetW || !sheetH) return;
+    const std::array<int, 3> fallback{static_cast<int8_t>(finf[0xC]), finf[0xD], static_cast<int8_t>(finf[0xE])};
+    std::map<uint32_t, std::array<int, 3>> widths;   // glyph -> left, width, advance
+    for (const uint8_t* c : cwdh) {
+        const uint16_t first = Be16(c + 8), last = Be16(c + 0xA);
+        for (uint32_t g = first; g <= last && c + 0x10 + (g - first + 1) * 3 <= f + size; ++g) {
+            const uint8_t* e = c + 0x10 + (g - first) * 3;
+            widths[g] = {static_cast<int8_t>(e[0]), e[1], static_cast<int8_t>(e[2])};
+        }
+    }
+    std::vector<std::pair<uint32_t, uint32_t>> codes;   // code point -> glyph
+    for (const uint8_t* c : cmap) {
+        const uint16_t lo = Be16(c + 8), hi = Be16(c + 0xA), method = Be16(c + 0xC);
+        const uint8_t* d = c + 0x14;
+        if (method == 0) {
+            for (uint32_t k = lo; k <= hi; ++k) codes.push_back({k, Be16(d) + k - lo});
+        } else if (method == 1) {
+            for (uint32_t k = lo; k <= hi && d + (k - lo + 1) * 2 <= f + size; ++k)
+                if (const uint16_t g = Be16(d + (k - lo) * 2); g != 0xFFFF) codes.push_back({k, g});
+        } else {
+            for (uint16_t k = 0, n = Be16(d); k < n && d + 6 + k * 4 <= f + size; ++k) codes.push_back({Be16(d + 2 + k * 4), Be16(d + 4 + k * 4)});
+        }
+    }
+    std::vector<int> sheetIndex(static_cast<size_t>(std::max(0, sheets)), -1);   // -> font.sheets, -2 failed
+    for (const auto& [code, g] : codes) {
+        if (!want(code)) continue;
+        const int sheet = static_cast<int>(g) / (cols * rows), cell = static_cast<int>(g) % (cols * rows);
+        if (sheet >= sheets || sheetIndex[sheet] == -2) continue;
+        if (sheetIndex[sheet] == -1) {
+            const size_t at = image + static_cast<size_t>(sheet) * sheetSize;
+            bool hd = false;
+            std::optional<EsTextureData> texture;
+            if (at + sheetSize <= size) texture = EsGameTexture(static_cast<uint32_t>(format), static_cast<uint32_t>(sheetW), static_cast<uint32_t>(sheetH), f + at, sheetSize, hd);
+            if (!texture) { sheetIndex[sheet] = -2; continue; }
+            font.hdSheets += hd ? 1 : 0;
+            sheetIndex[sheet] = static_cast<int>(font.sheets.size());
+            font.sheets.push_back(std::move(*texture));
+        }
+        const auto it = widths.find(g);
+        const auto& w = it != widths.end() ? it->second : fallback;
+        const float x0 = static_cast<float>((cell % cols) * (cellW + 1)), y0 = static_cast<float>((cell / cols) * (cellH + 1));
+        const float gw = static_cast<float>(std::clamp(w[1], 0, cellW));
+        EsGameGlyph glyph;
+        glyph.sheet = static_cast<uint16_t>(sheetIndex[sheet]);
+        glyph.u0 = x0 / sheetW; glyph.v0 = y0 / sheetH;
+        glyph.u1 = (x0 + gw) / sheetW; glyph.v1 = (y0 + cellH) / sheetH;
+        glyph.left = static_cast<float>(w[0]);
+        glyph.width = gw;
+        glyph.height = static_cast<float>(cellH);
+        glyph.baseline = static_cast<float>(baseline);
+        glyph.advance = static_cast<float>(w[2]);
+        glyph.colored = colored;
+        font.glyphs.emplace(code, glyph);
+    }
+}
+
+// A TPL's first image as one glyph (icons), centred on the font's icons. `allowHd`: whether the
+// texture pack's version may replace it.
+struct EsGlyphBox {
+    float width = 0, height = 0, baseline = 0;   // 0: the texture's size, on the icons' baseline
+    uint32_t mirroredCode = 0;                   // also as this code point, flipped left to right
+};
+// Every file of a U8 archive: fn(path, offset, size).
+template <typename Fn>
+void EsU8Each(const std::vector<uint8_t>& arc, Fn fn) {
+    if (arc.size() < 0x20 || Be32(arc.data()) != 0x55AA382D) return;
+    const uint32_t root = Be32(&arc[4]);
+    if (static_cast<size_t>(root) + 12 > arc.size()) return;
+    const uint32_t count = Be32(&arc[root + 8]);
+    const size_t strings = root + static_cast<size_t>(count) * 12;
+    if (strings > arc.size()) return;
+    auto name = [&](uint32_t off) {
+        std::string s;
+        for (size_t k = strings + off; k < arc.size() && arc[k]; ++k) s += static_cast<char>(arc[k]);
+        return s;
+    };
+    std::vector<std::pair<uint32_t, std::string>> dirs{{count, ""}};
+    for (uint32_t i = 1; i < count; ++i) {
+        while (dirs.size() > 1 && i >= dirs.back().first) dirs.pop_back();
+        const uint8_t* e = &arc[root + static_cast<size_t>(i) * 12];
+        const std::string path = dirs.back().second + "/" + name(Be32(e) & 0xFFFFFF);
+        if (e[0] == 1) dirs.push_back({Be32(e + 8), path});
+        else if (static_cast<size_t>(Be32(e + 4)) + Be32(e + 8) <= arc.size()) fn(path, Be32(e + 4), Be32(e + 8));
+    }
+}
+
+// CMPR (format 14): 8x8 blocks of four 4x4 DXT1 blocks, colours big-endian.
+bool EsDecodeCmpr(int w, int h, const uint8_t* data, size_t available, std::vector<uint8_t>& rgba) {
+    const size_t need = static_cast<size_t>((w + 7) / 8) * ((h + 7) / 8) * 32;
+    if (w <= 0 || h <= 0 || need > available) return false;
+    rgba.assign(static_cast<size_t>(w) * h * 4, 0);
+    const uint8_t* b = data;
+    for (int by = 0; by < h; by += 8)
+        for (int bx = 0; bx < w; bx += 8)
+            for (int sub = 0; sub < 4; ++sub, b += 8) {
+                const uint16_t c0 = static_cast<uint16_t>(b[0] << 8 | b[1]), c1 = static_cast<uint16_t>(b[2] << 8 | b[3]);
+                uint8_t pal[4][4];
+                for (int k = 0; k < 2; ++k) {
+                    const uint16_t c = k ? c1 : c0;
+                    pal[k][0] = static_cast<uint8_t>((c >> 11) * 255 / 31);
+                    pal[k][1] = static_cast<uint8_t>(((c >> 5) & 63) * 255 / 63);
+                    pal[k][2] = static_cast<uint8_t>((c & 31) * 255 / 31);
+                    pal[k][3] = 255;
+                }
+                for (int k = 0; k < 3; ++k) {
+                    pal[2][k] = static_cast<uint8_t>(c0 > c1 ? (2 * pal[0][k] + pal[1][k]) / 3 : (pal[0][k] + pal[1][k]) / 2);
+                    pal[3][k] = static_cast<uint8_t>(c0 > c1 ? (pal[0][k] + 2 * pal[1][k]) / 3 : 0);
+                }
+                pal[2][3] = 255;
+                pal[3][3] = c0 > c1 ? 255 : 0;
+                const int sx = bx + (sub & 1) * 4, sy = by + (sub >> 1) * 4;
+                for (int y = 0; y < 4; ++y)
+                    for (int x = 0; x < 4; ++x)
+                        if (sx + x < w && sy + y < h) std::memcpy(&rgba[(static_cast<size_t>(sy + y) * w + sx + x) * 4], pal[(b[4 + y] >> (6 - 2 * x)) & 3], 4);
+            }
+    return true;
+}
+
+// A TPL's first image to RGBA: the formats above, CMPR, and the paletted C4 / C8 / C14X2 (palette
+// IA8, RGB565 or RGB5A3).
+bool EsDecodeTpl(const uint8_t* t, size_t n, std::vector<uint8_t>& rgba, uint32_t& w, uint32_t& h) {
+    if (n < 0x20 || Be32(t) != 0x0020AF30) return false;
+    const uint32_t table = Be32(t + 8);   // { image header, palette header } per image
+    if (static_cast<size_t>(table) + 8 > n) return false;
+    const uint32_t image = Be32(t + table), palette = Be32(t + table + 4);
+    if (static_cast<size_t>(image) + 12 > n) return false;
+    h = Be16(t + image);
+    w = Be16(t + image + 2);
+    const uint32_t format = Be32(t + image + 4), data = Be32(t + image + 8);
+    if (format == 14) return data < n && EsDecodeCmpr(static_cast<int>(w), static_cast<int>(h), t + data, n - data, rgba);
+    if (format != 8 && format != 9 && format != 10) {
+        const uint32_t bw = format == 2 ? 8 : 4, bits = format == 2 ? 8 : 16;
+        const size_t bytes = static_cast<size_t>((w + bw - 1) / bw * bw) * ((h + 3) / 4 * 4) * bits / 8;
+        return data + bytes <= n && EsDecodeTexture(format, static_cast<int>(w), static_cast<int>(h), t + data, bytes, rgba);
+    }
+    if (!palette || static_cast<size_t>(palette) + 12 > n) return false;
+    const uint32_t entries = Be16(t + palette), palFormat = Be32(t + palette + 4), palData = Be32(t + palette + 8);
+    if (static_cast<size_t>(palData) + entries * 2 > n) return false;
+    auto colour = [&](uint32_t index, uint8_t* o) {
+        if (index >= entries) { o[0] = o[1] = o[2] = o[3] = 0; return; }
+        const uint16_t c = Be16(t + palData + index * 2);
+        if (palFormat == 0) { o[0] = o[1] = o[2] = static_cast<uint8_t>(c & 0xFF); o[3] = static_cast<uint8_t>(c >> 8); }
+        else if (palFormat == 1) { o[0] = static_cast<uint8_t>((c >> 11) * 255 / 31); o[1] = static_cast<uint8_t>(((c >> 5) & 63) * 255 / 63); o[2] = static_cast<uint8_t>((c & 31) * 255 / 31); o[3] = 255; }
+        else if (c & 0x8000) { o[0] = static_cast<uint8_t>(((c >> 10) & 31) * 255 / 31); o[1] = static_cast<uint8_t>(((c >> 5) & 31) * 255 / 31); o[2] = static_cast<uint8_t>((c & 31) * 255 / 31); o[3] = 255; }
+        else { o[3] = static_cast<uint8_t>(((c >> 12) & 7) * 255 / 7); o[0] = static_cast<uint8_t>(((c >> 8) & 15) * 17); o[1] = static_cast<uint8_t>(((c >> 4) & 15) * 17); o[2] = static_cast<uint8_t>((c & 15) * 17); }
+    };
+    const uint32_t bw = format == 10 ? 4 : 8, bh = format == 8 ? 8 : 4, bits = format == 8 ? 4 : format == 9 ? 8 : 16;
+    const size_t bytes = static_cast<size_t>((w + bw - 1) / bw * bw) * ((h + bh - 1) / bh * bh) * bits / 8;
+    if (static_cast<size_t>(data) + bytes > n) return false;
+    rgba.assign(static_cast<size_t>(w) * h * 4, 0);
+    size_t at = 0;   // in pixels (C4: half bytes)
+    for (uint32_t by = 0; by < h; by += bh)
+        for (uint32_t bx = 0; bx < w; bx += bw)
+            for (uint32_t y = 0; y < bh; ++y)
+                for (uint32_t x = 0; x < bw; ++x, ++at) {
+                    uint32_t index;
+                    if (format == 8) { const uint8_t v = t[data + at / 2]; index = (at & 1) ? v & 15 : v >> 4; }
+                    else if (format == 9) index = t[data + at];
+                    else index = Be16(t + data + at * 2) & 0x3FFF;
+                    if (bx + x < w && by + y < h) colour(index, &rgba[((by + y) * w + bx + x) * 4]);
+                }
+    return true;
+}
+
+// National flags (60x40) as glyphs kGlyphFlag + Wii country code, all on one sheet: the game's
+// (Globe.szs globe/timg/<group>_<country>_<name>.tpl, 64 countries) or Extended Regions' (every
+// code, 1-254: <code>.tpl under ExtendedRegions/flags/ in MKW-SP's contents.arc, put there by
+// tools/extended-regions.js). A later call replaces the flags it has.
+void EsAddFlags(EsFontData& font, const std::vector<uint8_t>& globe) {
+    struct Flag { uint32_t country, w, h; std::vector<uint8_t> rgba; };
+    std::vector<Flag> flags;
+    EsU8Each(globe, [&](const std::string& path, uint32_t at, uint32_t size) {
+        const auto slash = path.rfind('/');
+        const std::string file = path.substr(slash + 1);
+        const bool extended = path.find("/ExtendedRegions/flags/") != std::string::npos && file.size() == 7 && file.compare(3, 4, ".tpl") == 0;
+        if (!extended && (path.find("/timg/") == std::string::npos || file.size() < 12 || file[3] != '_' || file[7] != '_')) return;
+        for (int k : extended ? std::initializer_list<int>{0, 1, 2} : std::initializer_list<int>{0, 1, 2, 4, 5, 6})
+            if (!std::isdigit(static_cast<unsigned char>(file[k]))) return;
+        Flag flag{static_cast<uint32_t>(std::stoi(file.substr(extended ? 0 : 4, 3))), 0, 0, {}};
+        if (flag.country > 0xFF || !EsDecodeTpl(globe.data() + at, size, flag.rgba, flag.w, flag.h)) return;
+        flags.push_back(std::move(flag));
+    });
+    if (flags.empty()) return;
+    constexpr uint32_t kCellW = 64, kCellH = 44, kPerRow = 8;   // 2 px apart, against bleeding
+    const uint32_t rows = static_cast<uint32_t>((flags.size() + kPerRow - 1) / kPerRow);
+    EsTextureData sheet;
+    sheet.width = kCellW * kPerRow;
+    sheet.height = kCellH * rows;
+    sheet.data.assign(static_cast<size_t>(sheet.width) * sheet.height * 4, 0);
+    const uint16_t index = static_cast<uint16_t>(font.sheets.size());
+    for (size_t k = 0; k < flags.size(); ++k) {
+        const Flag& f = flags[k];
+        const uint32_t ox = static_cast<uint32_t>(k % kPerRow) * kCellW + 2, oy = static_cast<uint32_t>(k / kPerRow) * kCellH + 2;
+        for (uint32_t y = 0; y < f.h && oy + y < sheet.height; ++y)
+            std::memcpy(&sheet.data[((oy + y) * sheet.width + ox) * 4], &f.rgba[y * f.w * 4], std::min(f.w, kCellW - 2) * 4);
+        EsGameGlyph glyph;
+        glyph.sheet = index;
+        glyph.u0 = (ox + 0.5f) / sheet.width;
+        glyph.v0 = (oy + 0.5f) / sheet.height;
+        glyph.u1 = (ox + f.w - 0.5f) / sheet.width;
+        glyph.v1 = (oy + f.h - 0.5f) / sheet.height;
+        glyph.width = static_cast<float>(f.w);
+        glyph.height = static_cast<float>(f.h);
+        glyph.baseline = glyph.height;
+        glyph.advance = glyph.width;
+        glyph.colored = true;
+        font.glyphs.insert_or_assign(kGlyphFlag + f.country, glyph);
+    }
+    font.sheets.push_back(std::move(sheet));
+}
+
+void EsAddTextureGlyph(EsFontData& font, const std::vector<uint8_t>& arc, const std::string& path, uint32_t code, bool allowHd, EsGlyphBox box = {}) {
+    const auto at = EsU8Find(arc, path);
+    if (!at || at->second < 0x20) return;
+    const uint8_t* t = arc.data() + at->first;
+    const size_t n = at->second;
+    if (Be32(t) != 0x0020AF30) return;
+    const uint32_t header = Be32(t + Be32(t + 8));
+    if (static_cast<size_t>(header) + 12 > n) return;
+    const uint32_t h = Be16(t + header), w = Be16(t + header + 2), format = Be32(t + header + 4), data = Be32(t + header + 8);
+    const uint32_t bw = format == 2 ? 8 : 4, bits = format == 2 ? 8 : 16;
+    const size_t bytes = static_cast<size_t>((w + bw - 1) / bw * bw) * ((h + 3) / 4 * 4) * bits / 8;
+    if (data + bytes > n) return;
+    bool hd = false;
+    auto texture = EsGameTexture(format, w, h, t + data, bytes, hd, allowHd);
+    if (!texture) return;
+    font.hdSheets += hd ? 1 : 0;
+    EsGameGlyph glyph;
+    glyph.sheet = static_cast<uint16_t>(font.sheets.size());
+    glyph.u1 = glyph.v1 = 1.0f;
+    glyph.left = 2.0f;
+    glyph.width = box.width ? box.width : static_cast<float>(w);
+    glyph.height = box.height ? box.height : static_cast<float>(h);
+    glyph.baseline = box.baseline ? box.baseline : glyph.height - 5.0f;
+    glyph.advance = glyph.width + 4.0f;
+    font.sheets.push_back(std::move(*texture));
+    font.glyphs.insert_or_assign(code, glyph);   // over a font glyph at the same code point
+    if (box.mirroredCode) {
+        std::swap(glyph.u0, glyph.u1);
+        font.glyphs.insert_or_assign(box.mirroredCode, glyph);
+    }
+}
+
+// Worker thread: the game's menu font (kart_kanji_font.brfnt), controller icons
+// (tt_kart_extension_font.brfnt) and D-pad (fm_handle_juji.tpl in Race.szs) from the disc, each sheet
+// replaced by the texture pack's HD version when it has one, and a Windows font for the rest.
+void EsLoadFont() {
+    std::thread([] {
+#ifdef _WIN32
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);   // behind the game's own loading
+#endif
+        EsFontData font;
+        try {
+            const auto ui = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "Scene" / "UI";
+            const auto fonts = EsYaz0(EsReadFile(ui / "Font.szs"));
+            if (const auto at = EsU8Find(fonts, "/kart_kanji_font.brfnt"))
+                EsAddFont(font, fonts.data() + at->first, at->second, false, [](uint32_t c) { return c >= 0x20 && c <= 0xFFFF; });
+            if (const auto at = EsU8Find(fonts, "/tt_kart_extension_font.brfnt"))
+                EsAddFont(font, fonts.data() + at->first, at->second, true, [](uint32_t c) { return c >= 0xF030 && c <= 0xF07C; });
+            EsAddTextureGlyph(font, EsYaz0(EsReadFile(ui / "Race.szs")), "/fm_handle_juji.tpl", kGlyphDpad, true);
+            // The ranking pages' arrow (drawn 30x20 there), for the season switch.
+            const auto channel = EsYaz0(EsReadFile(ui / "Channel.szs"));
+            EsAddTextureGlyph(font, channel, "/ranking/timg/tt_yajirushi_type1.tpl", kGlyphArrowLeft, true, {39.0f, 26.0f, 30.0f, kGlyphArrowRight});
+            // The game's default Mii face, for players without a Mii.
+            EsAddTextureGlyph(font, channel, "/tt_mii_matuoka_64x64.tpl", kGlyphDefaultMii, true);
+            // The WFC menus' Mii bubble (glass and rim), for the notification badge.
+            const auto multi = EsYaz0(EsReadFile(ui / "MenuMulti.szs"));
+            EsAddTextureGlyph(font, multi, "/tt_glass_sphere_sono3.tpl", kGlyphGlassSphere, true);
+            EsAddTextureGlyph(font, multi, "/tt_glass_sphere_waku_sono1.tpl", kGlyphGlassRim, true);
+            // The national flags, beside players' names: the game's, then Extended Regions' (all countries).
+            EsAddFlags(font, EsYaz0(EsReadFile(ui / "Globe.szs")));
+            EsAddFlags(font, EsReadFile(RuntimeNandPath::DiscoverNandRootPath() / "title" / "00010001" / "53505350" / "data" / "contents.arc"));
+        } catch (...) {
+            font.glyphs.clear();
+            font.sheets.clear();
+        }
+#ifdef _WIN32
+        const char* windir = std::getenv("WINDIR");
+        const std::filesystem::path dir = std::filesystem::path(windir ? windir : "C:\\Windows") / "Fonts";
+        static const ImWchar kFallback[] = {0x0020, 0x024F, 0x0370, 0x03FF, 0x0400, 0x04FF, 0x2010, 0x205E, 0x2190, 0x21FF, 0x25A0, 0x25FF, 0x2600, 0x26FF, 0};
+        static const ImWchar kKana[] = {0x3000, 0x30FF, 0xFF00, 0xFFEF, 0};
+        constexpr float kSize = 51.0f;   // the game font's line height
+        auto* atlas = IM_NEW(ImFontAtlas)();
+        ImFontConfig config;
+        config.OversampleH = 2;
+        config.OversampleV = 2;
+        for (const char* face : {"bahnschrift.ttf", "segoeuib.ttf", "arialbd.ttf"}) {
+            std::error_code ec;
+            if (std::filesystem::exists(dir / face, ec) && (font.fallback = atlas->AddFontFromFileTTF((dir / face).string().c_str(), kSize, &config, kFallback))) break;
+        }
+        if (!font.fallback) {
+            config.SizePixels = kSize;
+            font.fallback = atlas->AddFontDefault(&config);
+        }
+        ImFontConfig merge = config;
+        merge.MergeMode = true;
+        for (const char* face : {"YuGothB.ttc", "msgothic.ttc"}) {
+            std::error_code ec;
+            if (std::filesystem::exists(dir / face, ec) && atlas->AddFontFromFileTTF((dir / face).string().c_str(), kSize, &merge, kKana)) break;
+        }
+        if (atlas->Build()) {
+            unsigned char* pixels = nullptr;
+            int width = 0, height = 0;
+            atlas->GetTexDataAsRGBA32(&pixels, &width, &height);   // uploaded with the sheets
+            font.atlas = atlas;
+        } else {
+            IM_DELETE(atlas);
+            font.fallback = nullptr;
+        }
+#endif
+        std::cout << "[esports] game font: " << font.glyphs.size() << " glyphs, " << font.sheets.size() << " sheets (" << font.hdSheets << " HD)" << std::endl;
+        g_esFontData = std::move(font);
+        g_esFontState = 2;
+    }).detach();
+}
+
+ImTextureID EsUploadTexture(const EsTextureData& t) {
+    if (!t.blockBytes) return aurora_imgui_add_texture(t.width, t.height, t.data.data());
+    // Block-compressed: straight to the GPU (only with WebGPU and BC support, as the texture pack).
+    using namespace aurora::webgpu;
+    if (aurora::window::get_sdl_renderer() || !g_device || !g_bcTexturesSupported) return ImTextureID{};
+    const wgpu::Extent3D size{.width = t.width, .height = t.height, .depthOrArrayLayers = 1};
+    const wgpu::TextureDescriptor textureDescriptor{
+        .label = "esports font",
+        .usage = wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::CopyDst,
+        .dimension = wgpu::TextureDimension::e2D,
+        .size = size,
+        .format = t.format,
+        .mipLevelCount = 1,
+        .sampleCount = 1,
+    };
+    const wgpu::TextureViewDescriptor viewDescriptor{
+        .label = "esports font view",
+        .format = t.format,
+        .dimension = wgpu::TextureViewDimension::e2D,
+        .mipLevelCount = WGPU_MIP_LEVEL_COUNT_UNDEFINED,
+        .arrayLayerCount = WGPU_ARRAY_LAYER_COUNT_UNDEFINED,
+    };
+    auto texture = g_device.CreateTexture(&textureDescriptor);
+    if (!texture) return ImTextureID{};
+    auto view = texture.CreateView(&viewDescriptor);
+    // The upload goes to the render worker (as aurora's own ImGui textures do): since WiiCompiled 0.9.2
+    // it submits the GPU work on its own thread, and a write from this one could land mid-submit (the
+    // D3D12 / Vulkan device was lost now and then as the font's HD sheets went up).
+    const wgpu::TexelCopyBufferLayout layout{.bytesPerRow = t.width / 4 * t.blockBytes, .rowsPerImage = t.height / 4};
+    auto data = std::make_shared<std::vector<uint8_t>>(t.data);
+    aurora::gfx::render_worker::enqueue_work([texture, data, layout, size] {
+        const wgpu::TexelCopyTextureInfo destination{.texture = texture};
+        g_queue.WriteTexture(&destination, data->data(), data->size(), &layout, &size);
+    });
+    static std::vector<wgpu::Texture> s_keep;
+    s_keep.push_back(texture);
+    return reinterpret_cast<ImTextureID>(view.MoveToCHandle());
+}
+
+// Render thread: the loaded font's textures. Sheets that can't be used (no BC support) leave their
+// glyphs to the Windows font.
+void EsUploadFont() {
+    if (g_esFontState != 2) return;
+    auto& font = g_esFontData;
+    // One sheet a frame (the HD ones are several MB each), the glyphs once they are all up.
+    static std::vector<ImTextureID> s_sheets;
+    if (s_sheets.size() < font.sheets.size()) {
+        s_sheets.push_back(EsUploadTexture(font.sheets[s_sheets.size()]));
+        std::vector<uint8_t>().swap(font.sheets[s_sheets.size() - 1].data);
+        return;
+    }
+    for (const auto& [code, glyph] : font.glyphs)
+        if (glyph.sheet < s_sheets.size() && s_sheets[glyph.sheet]) g_esGlyphs.emplace(code, glyph);
+    g_esSheets = std::move(s_sheets);
+    if (font.atlas) {
+        unsigned char* pixels = nullptr;
+        int width = 0, height = 0;
+        font.atlas->GetTexDataAsRGBA32(&pixels, &width, &height);
+        if (const ImTextureID texture = aurora_imgui_add_texture(static_cast<uint32_t>(width), static_cast<uint32_t>(height), pixels)) {
+            font.atlas->SetTexID(texture);
+            font.atlas->ClearTexData();
+            g_esAtlas = font.atlas;
+            g_esFont = font.fallback;
+            g_esAscent = std::round(g_esFont->Ascent);
+        }
+    }
+    font.sheets.clear();
+    font.glyphs.clear();
+    g_esFontState = 3;
+}
