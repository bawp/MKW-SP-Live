+    };
+    auto same = [&](const std::string& a, const std::string& b) { const std::string x = nearly(a); return !x.empty() && x == nearly(b); };
+    // Loosely the same name or tag ("Lovers Posture" / "Lover's Posture"); when a season has more than
+    // one such entry (Jx. and Jx: in Season 3), the exact one.
+    std::vector<const EsAppearance*> history;
