+// curve), the bottom bar's at 407 on the left and 439 right of its curve (from x 280), where the
+// button hints go (kEsHintY, 28 high).
+constexpr float kEsTop = 70.0f, kEsBottom = 400.0f;
+constexpr float kEsPlateHalf = 80.0f;   // a player's page: the half width (at most) of the name under their Mii
+constexpr float kEsHintY = 404.0f, kEsBarCurveEnd = 285.0f;
+// Right of the top bar's curve its edge is higher (about 40): a team page's roster title starts there.
+constexpr float kEsRosterTitleY = 54.0f;
