+// setup(client, profile, region, flag): the request parameters, without the GameSpy database login.
+extern "C" void RankingClientSetup_HLE_806773c8(CpuContext* ctx) {
+    const uint32_t client = ctx->gpr[3], profile = ctx->gpr[4];
+    Memory::Write8(client + kClientRegion, static_cast<uint8_t>(ctx->gpr[5]));
+    Memory::Write32(client + kClientError, 0);
+    Memory::Write32(client + kClientProfile, Memory::Contains(profile + 0x1C, 4) ? Memory::Read32(profile + 0x1C) : 0);
+    Memory::Write32(client + kClientState, kStateReady);
+    Memory::Write8(client + kClientFlag, static_cast<uint8_t>(ctx->gpr[6]));
+    ctx->gpr[3] = 1;
+}
