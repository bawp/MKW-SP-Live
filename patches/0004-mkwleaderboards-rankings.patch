+// Page 0xAC skips the download when the GhostManager (0xA7) already holds a downloaded World /
+// Continental ghost of that course, and a champion and a top-10 ghost look the same there. Drop
+// those: before a top-10 ghost is asked for, and once the top-10 ghost's page is up (races and
+// replays take the ghost from the champion slot), so the champion card downloads its own again.
+constexpr uint32_t kPageGhostManager = 0xA7, kDownloadedGhosts = 0x64;
+constexpr uint32_t kGhostGroupCount = 0x04, kGhostGroupData = 0x0C, kGhostDataSize = 0xD8;
+constexpr uint32_t kGhostDataCourse = 0xB8, kGhostDataType = 0xC4;
+
+void ForgetDownloadedGhosts(uint32_t course) {
+    const uint32_t manager = SectionPage(kPageGhostManager);
+    if (!manager) return;
+    const uint32_t group = Memory::Read32(manager + kDownloadedGhosts);
+    if (!group || !Memory::Contains(group, 0x10)) return;
+    const uint32_t count = Memory::Read16(group + kGhostGroupCount), data = Memory::Read32(group + kGhostGroupData);
+    if (!data || !Memory::Contains(data, count * kGhostDataSize)) return;
+    for (uint32_t k = 0; k < count; ++k) {
+        const uint32_t ghost = data + k * kGhostDataSize;
+        const uint32_t type = Memory::Read32(ghost + kGhostDataType);
+        if (Memory::Read8(ghost) && (type == kGhostTypeWorld || type == kGhostTypeContinental) && Memory::Read32(ghost + kGhostDataCourse) == course)
+            Memory::Write8(ghost, 0);
+    }
+}
