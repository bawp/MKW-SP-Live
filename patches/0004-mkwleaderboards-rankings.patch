+void EsDrawMenu(const ImVec2& origin, const ImVec2& size, float alpha) {
+    std::lock_guard lock(g_esMutex);
+    EsCanvas c{ImGui::GetBackgroundDrawList(), origin, size.y / 480.0f, alpha};
+    std::optional<std::pair<EsCanvas, ImVec2>> moreBelow;   // "more below", drawn last over the button hints
+    const float W = size.x / c.u;   // 854 at 16:9, 640 at 4:3
+    c.dx = (1.0f - alpha) * 24.0f;
+    const float tw = std::min(W - 48.0f, 790.0f), L = (W - tw) * 0.5f, R = L + tw;
+    const bool wide = tw >= 700.0f;   // room for points for / against
+    const auto now = Clock::now();
+    const float t = AnimSeconds();
+
+    c.list->PushClipRect(c.P(-c.dx, kEsTop - 4), c.P(W - c.dx, kEsBottom + 4), true);
+
+    // The top 10 list's grid behind the table.
+    for (float gx = L + 4; gx <= R; gx += 47.0f) c.list->AddLine(c.P(gx, kEsTop), c.P(gx, kEsBottom), Rgba(0xFFFFFF, alpha * 0.06f), c.u);
+    for (float gy = kEsTop + 30; gy <= kEsBottom; gy += 47.0f) c.list->AddLine(c.P(L - 20, gy), c.P(R + 20, gy), Rgba(0xFFFFFF, alpha * 0.06f), c.u);
+
+    // Title: league logo, league, season and division.
+    ImVec2 logoSize;
+    float titleX = L + 4;
+    if (const ImTextureID logo = EsLogoTexture(kEsLeague.logo, logoSize)) {
+        const float h = 38, w = h * logoSize.x / std::max(1.0f, logoSize.y);
+        c.list->AddImage(logo, c.P(L, kEsTop + 2), c.P(L + w, kEsTop + 2 + h), ImVec2(0, 0), ImVec2(1, 1), Rgba(0xFFFFFF, alpha));
+        titleX = L + w + 8;
+    }
+    c.Text(titleX, kEsTop + 2, 38, 0xFFFFFF, kEsLeague.name);
+    // Season switch: < Season N >, then the division. An arrow dims at the end of the list and
+    // lights up (with a nudge) when used.
+    {
+        const float size = 30, y = kEsTop + 8;
+        const float pressed = 1.0f - std::clamp(std::chrono::duration<float>(now - g_esSwitchedAt).count() / 0.25f, 0.0f, 1.0f);
+        float x = R - c.TextWidth(size, kEsLeague.divisionName);
+        c.Text(x, y, size, 0xFFFFFF, kEsLeague.divisionName);
+        x -= 18;
+        auto arrow = [&](const char* icon, bool usable, bool lit, float side) {
+            x -= c.TextWidth(size, icon);
+            const float nudge = lit ? pressed * 4.0f * side : 0.0f;
+            c.Text(x + nudge, y, size, lit && pressed > 0 ? 0xFFF07A : 0xFFFFFF, icon, 0.0f, usable ? 1.0f : 0.3f);
+        };
+        arrow(kIconArrowRight, g_esSeason + 1 < kEsSeasonCount, g_esSwitchDir > 0, 1.0f);
+        x -= 6 + c.TextWidth(size, kEsSeasons[g_esSeason].name);
+        c.Text(x, y, size, 0xFFF07A, kEsSeasons[g_esSeason].name);
+        x -= 6;
+        arrow(kIconArrowLeft, g_esSeason > 0, g_esSwitchDir < 0, -1.0f);
+    }
+    const EsStandings& standings = EsTable(g_esSeason);
+    EsDrawTabs(c, L, R);
+    if (g_esSection != kEsStandingsSection || g_esResultMatch) {
+        const bool results = g_esResultMatch != 0;
+        std::string hints;
+        if (results) hints = std::string(EsButtonIcons().b) + " Back";
+        else if (g_esSection == kEsScheduleSection) hints = std::string(EsButtonIcons().a) + " Results   " + kIconDpad + " Select";
+        else hints = std::string(EsOptionLabel()) + " " + (g_esAvgBaggers ? "Runners" : "Baggers") + "   " + kIconDpad + " Select";
+        const char* credit = EsToadsSeason(kEsSeasons[g_esSeason].id) ? "Data: toadsfactory.mkw.gg" : "Data: mkw-stats.web.app";
+        const bool creditBelow = W - 22 - c.TextWidth(28, hints) - 26 - c.TextWidth(17, credit) >= kEsBarCurveEnd;
+        const float rowTop = kEsSectionTop + 26, rowBottom = kEsBottom - (creditBelow ? 4 : 14);
+        // after a section change the list slides in from that side
+        const float switched = std::clamp(std::chrono::duration<float>(now - g_esSectionAt).count() / 0.2f, 0.0f, 1.0f);
+        EsCanvas r = c;
+        r.dx += static_cast<float>(g_esSectionDir) * (1.0f - switched) * 40.0f;
+        r.alpha *= 0.25f + 0.75f * switched;
+        if (results) EsDrawResults(r, W, L, R, rowTop, rowBottom, moreBelow);
+        else if (g_esSection == kEsScheduleSection) EsDrawSchedule(r, W, L, R, rowTop, rowBottom, standings, t, moreBelow);
+        else EsDrawAverages(r, W, L, R, rowTop, rowBottom, standings, t, moreBelow);
+        if (!creditBelow) c.Text(R, kEsBottom - 14, 17, 0xC8D2F0, credit, 1.0f, 0.8f);
+        c.list->PopClipRect();
