+                c.Gradient(rx, y, R, y + rowH * 0.45f, Rgba(0xFFFFFF, alpha * 0.30f), Rgba(0xFFFFFF, alpha * 0.18f), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+                const float pulse = 0.75f + 0.25f * std::sin(t * 5.0f);
+                c.Frame(rx - 1.5f, y - 1.5f, R + 1.5f, y + rowH + 1.5f, Rgba(0xFF8C00, alpha * pulse), 4.0f, 3.0f);
+                c.Frame(rx - 0.5f, y - 0.5f, R + 0.5f, y + rowH + 0.5f, Rgba(0xFFF27A, alpha), 2.0f, 2.0f);
+            } else {
