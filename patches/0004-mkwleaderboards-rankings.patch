+            std::lock_guard lock(g_axisMutex);
+            if (!g_crowds.count(*key)) g_crowds[*key] = saved;
+        }
+    }
+    if (span && !span->players.empty() && ClaimCrowd(*key, ghostNames)) FetchCrowd(*key, span, ghostNames);
+    std::lock_guard lock(g_axisMutex);
+    const auto it = g_crowds.find(*key);
+    return it != g_crowds.end() ? it->second : nullptr;
+}
