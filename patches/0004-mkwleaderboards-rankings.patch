+// Page::GetNextPage (0x805BB278, the base page's: none). When the MKW-SP Channel page ends for the
+// Esports menu (or back from it), the page itself comes next, set up as the other one.
+extern "C" void PageGetNextPage_HLE_805bb278(CpuContext* ctx) {
+    const uint32_t page = ctx->gpr[3];
+    uint32_t next = 0xFFFFFFFF;
+    try {
+        if (Memory::Contains(page, 8) && Memory::Read32(page + kPageId) == kPageServicePackChannel) {
+            const uint32_t flag = EsFlag();
+            if (flag == kEsOpening || flag == kEsClosing) {
+                const bool open = flag == kEsOpening;
+                EsShowChannelMode(ctx, page, open);
+                Memory::Write32(kEsportsFlag, open ? kEsOpen : kEsClosed);
+                if (open) {
+                    g_esShownAt = Clock::now();
+                    g_esCursor = 0;
+                    g_esScroll = 0.0f;
+                    g_esSeason = kEsSeasonCount - 1;
+                    g_esSwitchDir = 0;
+                    g_esSection = kEsStandingsSection;
+                    g_esResultMatch = 0;
+                    const uint32_t manager = Memory::Read32(kSectionManager);
+                    const uint32_t holder = manager ? Memory::Read32(manager + kSectionPadHolder) : 0;
+                    g_esButtons = holder ? Memory::Read16(holder + kHolderUiButtons) : 0;   // the press that opened it
+                }
+                next = kPageServicePackChannel;
+            } else if (flag == kEsTeamOpening || flag == kEsTeamClosing) {   // standings <-> a team's page
+                const bool open = flag == kEsTeamOpening;
+                Memory::Write32(kEsportsFlag, open ? kEsTeam : kEsOpen);
+                g_esShownAt = Clock::now();
+                if (open) {
+                    g_esPlayerCursor = 0;
+                    g_esPlayerScroll = 0.0f;
+                }
+                next = kPageServicePackChannel;
+            } else if (flag == kEsPlayerOpening || flag == kEsPlayerClosing) {   // a team's page <-> a player's
+                Memory::Write32(kEsportsFlag, flag == kEsPlayerOpening ? kEsPlayer : kEsTeam);
+                g_esShownAt = Clock::now();
+                next = kPageServicePackChannel;
+            }
+        }
+    } catch (const Memory::AccessViolation&) {
+    }
+    ctx->gpr[3] = next;
+}
+
+// Page::CheckActions (0x80601C64), as the game's, except that the Esports menu takes the MKW-SP
+// Channel page's input (its input manager still updates, so no stale presses are left).
+extern "C" void PageCheckActions_HLE_80601c64(CpuContext* ctx) {
+    const uint32_t page = ctx->gpr[3];
+    const uint32_t state = Memory::Read32(page + 0x08);
+    const uint32_t input = Memory::Read32(page + 0x38);
+    auto virtualCall = [&](uint32_t object, uint32_t offset) {
+        ctx->gpr[3] = object;
+        InvokeIndirectCpu(Memory::Read32(Memory::Read32(object) + offset), ctx);
+    };
+    if (MyTimesActive()) {   // My Times takes the controller: the pages' input managers only update
+        if (state >= 2 && state <= 5) virtualCall(input, 0x2C);
+        if (g_mtInputFrame != g_mtFrame) {
+            g_mtInputFrame = g_mtFrame;
+            MyTimesInput(ctx, page);
+        }
+        return;
+    }
+    if (state == 2 || state == 3 || state == 5) {
+        virtualCall(input, 0x2C);
+    } else if (state == 4) {
+        virtualCall(input, 0x2C);
+        if (EsMenuPage(page)) {
+            EsMenuInput(ctx, page);
+            return;
+        }
+        const uint32_t device = Memory::Read32(Memory::Read32(Memory::Read32(0x80385FC8) + 0x54) + 0x24);
+        virtualCall(device, 0x0C);
+        if (ctx->gpr[3] == 1) virtualCall(input, 0x18);
+    }
+}
