+// lists the whole registered roster with a status: Active (has played this season, or is in the
+// projected lineup), Idle, Inactive (the rest); kEsStatusOverrides sets players by hand.
+constexpr const char* kMkcBase = "https://mkcentral.com";
+enum EsStatus { kEsActive = 0, kEsIdle = 1, kEsInactive = 2 };
