+        const EsStandings& division = g_esStandings[EsKey(season.id, kEsLeague.division)];
+        for (const auto& p : roster->players) {
+            bool ours = entries <= 1;   // the org's only entry: its whole roster
+            for (const auto& [id, entry] : division.players) ours = ours || (id == p.playerId && entry == team.entryId);
+            if (ours) players.push_back(p);
