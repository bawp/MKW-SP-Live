+    const float statsY = kEsTop + 130;
+    header(lx + 8, statsY, lr - 8);
+    c.Text(cx, statsY - 1, 22, 0xB8C8F0, std::string(kEsLeague.name) + " Career", 0.5f);
+    const bool known = info.loaded && played > 0;
+    const double averageDiff = known ? static_cast<double>(diff) / played : 0.0;
+    const std::string winRate = known ? std::to_string(static_cast<int>(std::lround(100.0 * wins / played))) + "%" : "-";
+    const std::string differential = known ? Signed(static_cast<int>(std::lround(averageDiff))) : "-";
+    const std::pair<const char*, std::string> stats[] = {{"Matches", info.loaded ? std::to_string(played) : "-"}, {"Win Rate", winRate}, {"Avg +/-", differential}};
+    for (int k = 0; k < 3; ++k) {
+        const float x = lx + lw * (1.0f + 2.0f * k) / 6.0f;
+        c.Text(x, statsY + 23, 16, 0xB8C8F0, stats[k].first, 0.5f);
+        c.Text(x, statsY + 36, 26, k == 2 ? (averageDiff > 0 ? 0x8CFFA8u : averageDiff < 0 ? 0xFF9A9Au : 0xFFFFFFu) : 0xFFFFFFu, stats[k].second, 0.5f);
+    }
+
+    // History: each finished GSC season and where the team placed, in two columns (newest first,
+    // reading across): season (and division when not 1), place with the playoffs' cup, record. A
+    // season the team dropped out of is greyed, with "Dropped" in red.
+    const float historyY = statsY + 72;
+    header(lx + 8, historyY, lr - 8);
+    c.Text(cx, historyY - 1, 22, 0xB8C8F0, "GSC History", 0.5f);
+    if (!info.loaded) {
+        c.Text(cx, historyY + 30, 22, 0xFFFFFF, info.error.empty() ? "Loading..." : "Couldn't reach mkw-stats.web.app.", 0.5f, 0.8f);
+    } else {
+        std::vector<const EsAppearance*> done;
+        for (const EsAppearance* a : history) if (g_esStandings[EsKey(a->season, a->division)].finished) done.push_back(a);
+        const float pitch = 20.0f, top = historyY + 26, cellW = (lw - 20) * 0.5f, size = 17;
+        const int rows = std::max(1, static_cast<int>((kEsBottom - 6 - top) / pitch)), cells = rows * 2;
+        const int shown = static_cast<int>(done.size()) > cells ? cells - 1 : static_cast<int>(done.size());
+        for (int k = 0; k < shown; ++k) {
+            const EsAppearance& a = *done[k];
+            const EsStandings& s = g_esStandings[EsKey(a.season, a.division)];
+            const EsTeam* row = rowOf(a);
+            const float x0 = lx + 10 + (k % 2) * cellW, x1 = x0 + cellW - 6, y = top + (k / 2) * pitch;
+            const bool gone = a.status == "dropped" || a.status == "disqualified";
+            const uint32_t grey = 0x8A93AE;
+            std::string seasonName = "S" + std::to_string(SeasonNumber(a.season));
+            if (SeasonNumber(a.division) != 1) seasonName += " D" + std::to_string(SeasonNumber(a.division));
+            std::string place = "...", record;
+            uint32_t color = 0xFFFFFF;
+            const char* cup = nullptr;
+            if (row) {
+                place = Ordinal(row->finalRank);
+                cup = s.playoffsDecided ? EsCup(row->finalRank) : nullptr;
+                record = std::to_string(row->wins) + "-" + std::to_string(row->losses) + (row->ties ? "-" + std::to_string(row->ties) : "");
+                color = row->finalRank == 1 ? 0xFFE66D : row->finalRank == 2 ? 0xE5F0FF : row->finalRank == 3 ? 0xF6A04D : 0xFFFFFF;
+            } else if (s.loaded) {
+                place = "-";
+            }
+            if (gone) { place = a.status == "dropped" ? "Dropped" : "DQ"; color = 0xFF7A7A; cup = nullptr; }
+            const float recordRight = x1, placeRight = x1 - 40;
+            if (k % 2) c.Rect(x0 - 3, y + 2, x0 - 2, y + pitch - 2, Rgba(0xFFFFFF, alpha * 0.15f));
+            c.Text(x0, y, size, gone ? grey : 0xFFFFFF, seasonName);
