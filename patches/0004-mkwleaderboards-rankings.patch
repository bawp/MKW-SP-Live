+        const float mx0 = std::max(rx, W * 0.5f + kEsPlateHalf * 0.65f), fs = wide ? 20.0f : 18.0f;
+        const auto seasons = EsPlayerSeasons(teams);
+        const auto at = std::find(seasons.begin(), seasons.end(), g_esPlayerSeason);
+        const bool older = at != seasons.end() && at + 1 != seasons.end(), newer = at != seasons.end() && at != seasons.begin();
+        header(mx0, y, R);
+        float hx = mx0 + 8;
+        c.Text(hx, y - 1, 22, 0xFFFFFF, kIconArrowLeft, 0.0f, older ? 1.0f : 0.3f);
+        hx += c.TextWidth(22, kIconArrowLeft) + 4;
+        const std::string title = "Season " + std::to_string(SeasonNumber(g_esPlayerSeason)) + " Matches";
+        c.Text(hx, y - 1, 22, 0xFFF07A, title);
+        hx += c.TextWidth(22, title) + 4;
