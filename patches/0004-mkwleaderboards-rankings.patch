+void EsLoadPlayerSeason(int player, const std::string& season, std::vector<EsPlayerTeam> teams, bool finished) {
+    std::thread([player, season, teams, finished] {
+        std::string error;
+        std::vector<EsSeasonMatch> matches;
+        for (const auto& t : teams) {
+            std::string tag;   // URL-encoded tag
+            for (unsigned char ch : t.teamTag) {
+                char b[4];
+                if (std::isalnum(ch) || ch == '-' || ch == '_' || ch == '.' || ch == '~') tag += static_cast<char>(ch);
+                else { std::snprintf(b, sizeof b, "%%%02X", ch); tag += b; }
+            }
+            const auto list = EsFetch(std::string("/api/matches?league=") + kEsLeague.id + "&season=" + season + "&division=" + t.division + "&team=" + tag + "&match_set=all", error);
+            const auto* arr = list ? std::get_if<Json::Array>(&list->v) : nullptr;
+            if (!arr) break;
+            for (const auto& m : *arr) {
+                const int id = static_cast<int>(m.num("match_id"));
+                const auto detail = EsMatchDetail(id, finished);
+                const Json* sides = detail ? detail->get("teams") : nullptr;
+                const auto* ts = sides ? std::get_if<Json::Array>(&sides->v) : nullptr;
+                if (!ts || ts->size() < 2) continue;
+                const Json *ours = nullptr, *theirs = nullptr;
+                int score = -1;
+                for (const auto& side : *ts) {
+                    bool here = false;
+                    if (const Json* ps = side.get("players"))
+                        if (const auto* pa = std::get_if<Json::Array>(&ps->v))
+                            for (const auto& p : *pa)
+                                if (static_cast<int>(p.num("player_id")) == player) { here = true; score = static_cast<int>(p.num("total")); }
+                    if (here) ours = &side;
+                }
+                if (!ours) continue;   // didn't play in it
+                for (const auto& side : *ts) if (&side != ours) theirs = &side;
+                EsSeasonMatch match;
+                match.matchId = id;
+                match.number = static_cast<int>(m.num("match_number"));
+                match.seriesMatch = static_cast<int>(m.num("series_match_number"));
+                match.type = m.str("match_type");
+                match.stage = m.str("playoff_stage");
+                match.teamScore = static_cast<int>(ours->num("final_score"));
+                match.opponentScore = theirs ? static_cast<int>(theirs->num("final_score")) : 0;
+                match.opponentTag = theirs ? theirs->str("tag") : "";
+                match.playerScore = std::max(0, score);
+                match.result = match.teamScore > match.opponentScore ? "win" : match.teamScore < match.opponentScore ? "loss" : "tie";
+                matches.push_back(std::move(match));
+            }
+        }
+        // The season in order: the regular season by match, then the playoffs' rounds.
+        auto order = [](const EsSeasonMatch& m) { return m.type != "playoff" ? 0 : m.stage == "quarterfinals" ? 1 : m.stage == "semifinals" ? 2 : 3; };
+        std::stable_sort(matches.begin(), matches.end(), [&](const EsSeasonMatch& a, const EsSeasonMatch& b) {
+            if (order(a) != order(b)) return order(a) < order(b);
+            return a.type == "playoff" ? a.seriesMatch < b.seriesMatch || (a.seriesMatch == b.seriesMatch && a.matchId < b.matchId) : a.number < b.number;
+        });
+        std::lock_guard lock(g_esMutex);
+        auto& s = g_esPlayerSeasons[{player, season}];
+        s.loading = false;
+        s.error = error;
+        s.loaded = error.empty();
+        if (s.loaded) s.matches = std::move(matches);
+    }).detach();
+}
+
+// The player's Toad's Factory id (theirs, or through the bridge).
+int EsPlayerToadsId(const EsPlayer& player) {
+    return player.toadsId ? player.toadsId : player.playerId ? EsToadsIdOfStats(player.playerId) : 0;
+}
+
+// The teams the player played for, newest first: mkw-stats' (with the overview) and Toad's
+// Factory's seasons (from their rosters).
+std::vector<EsPlayerTeam> EsPlayerTeams(const EsPlayer& player, const EsPlayerInfo* info) {
+    std::vector<EsPlayerTeam> teams;
+    if (info && info->loaded) teams = info->teams;
+    std::set<int> profiles;   // every Toad's Factory profile of the player
+    if (const int toads = EsPlayerToadsId(player)) profiles.insert(toads);
+    if (player.playerId) for (const auto& [ms, tf] : kEsPlayerBridge) if (ms == player.playerId) profiles.insert(tf);
+    if (!profiles.empty()) {
+        for (const auto& def : kEsSeasons) {
+            if (!def.toadsDivision) continue;
+            const EsStandings& s = g_esStandings[EsKey(def.id, kEsLeague.division)];
+            for (const auto& [entry, roster] : s.members)
+                for (const auto& m : roster) {
+                    if (!profiles.count(m.toadsId)) continue;
+                    const auto t = std::find_if(s.teams.begin(), s.teams.end(), [&](const EsTeam& x) { return x.entryId == entry; });
+                    if (t == s.teams.end()) continue;
+                    EsPlayerTeam pt;
+                    pt.season = def.id;
+                    pt.division = kEsLeague.division;
+                    pt.teamName = t->name;
+                    pt.teamTag = t->tag;
+                    pt.teamId = t->teamId;
+                    pt.entryId = entry;
+                    pt.gpAverage = m.gpAverage;
+                    teams.push_back(std::move(pt));
+                }
+        }
+    }
+    std::stable_sort(teams.begin(), teams.end(), [](const EsPlayerTeam& x, const EsPlayerTeam& y) { return SeasonNumber(x.season) > SeasonNumber(y.season); });
+    return teams;
+}
+
+// The seasons the player played, newest first.
+std::vector<std::string> EsPlayerSeasons(const std::vector<EsPlayerTeam>& teams) {
+    std::vector<std::string> seasons;
+    for (const auto& t : teams) if (std::find(seasons.begin(), seasons.end(), t.season) == seasons.end()) seasons.push_back(t.season);
+    return seasons;
+}
+
+int EsPlayerKey(const EsPlayer& player) { return player.playerId ? player.playerId : -EsPlayerToadsId(player); }
+
+// A Toad's Factory season's matches of the player's team(s): no player scores there (-1).
+void EsToadsSeasonMatches(const std::vector<EsPlayerTeam>& teams, const std::string& season, EsPlayerSeason& out) {
+    const EsStandings& s = g_esStandings[EsKey(season, kEsLeague.division)];
+    if (!s.loaded) return;
+    out.matches.clear();
+    for (const auto& t : teams) {
+        if (t.season != season || !t.entryId) continue;
+        int number = 0;
+        for (const auto& m : s.matches) {
+            if (m.home != t.entryId && m.away != t.entryId) continue;
+            const bool home = m.home == t.entryId;
+            const int other = home ? m.away : m.home;
+            const auto o = std::find_if(s.teams.begin(), s.teams.end(), [&](const EsTeam& x) { return x.entryId == other; });
+            EsSeasonMatch match;
+            match.type = m.stage >= 2 ? "playoff" : "regular";
+            match.stage = m.stage >= 3 ? "finals" : m.stage == 2 ? "semifinals" : "";
+            match.number = m.stage >= 2 ? 0 : ++number;
+            match.teamScore = home ? m.homeScore : m.awayScore;
+            match.opponentScore = home ? m.awayScore : m.homeScore;
+            match.opponentTag = o != s.teams.end() ? o->tag : "";
+            match.playerScore = -1;
+            match.result = match.teamScore > match.opponentScore ? "win" : match.teamScore < match.opponentScore ? "loss" : "tie";
+            out.matches.push_back(std::move(match));
+        }
+    }
+    std::stable_sort(out.matches.begin(), out.matches.end(), [](const EsSeasonMatch& a, const EsSeasonMatch& b) {
+        return (a.type == "playoff") != (b.type == "playoff") ? b.type == "playoff" : a.stage == "semifinals" && b.stage == "finals";
+    });
+    out.loaded = true;
+}
+
+std::string g_esPlayerSeason;   // the season whose matches the player's page shows
+int g_esMatchScroll = 0;
+
+// Keeps the player page's data loading (under the lock). A projected player has no mkw-stats id:
+// it is looked for, by name, in the team's rosters of its other seasons, then in every division. A
+// player of a Toad's Factory roster is who the bridge says (or only there).
+void EsRequestPlayer() {
+    std::lock_guard lock(g_esMutex);
+    const auto now = Clock::now();
+    auto& team = g_esTeams[g_esTeamShown.teamId];
+    for (const auto& def : kEsSeasons) if (def.toadsDivision) EsRequestStandings(def.id, kEsLeague.division);
+    if (!g_esPlayerShown.playerId && !g_esPlayerShown.toadsRoster) {
+        for (const auto& [season, roster] : team.rosters)
+            for (const auto& p : roster.players)
+                if (EsLower(p.name) == EsLower(g_esPlayerShown.name)) g_esPlayerShown.playerId = p.playerId;
+        bool rostersDone = true;
+        if (!g_esPlayerShown.playerId) {
+            for (const auto& a : team.appearances) {
+                auto& roster = team.rosters[a.season];
+                if (!roster.loaded && roster.error.empty()) rostersDone = false;
+                if (!roster.loading && !roster.loaded && roster.error.empty()) {
+                    roster.loading = true;
+                    EsLoadRoster(g_esTeamShown.teamId, a.season);
+                }
+            }
+        }
+        if (!g_esPlayerShown.playerId && rostersDone) {
+            if (!g_esNames.loaded && !g_esNames.loading) {
+                g_esNames.loading = true;
+                EsLoadNameIndex();
+            }
+            if (g_esNames.loaded) {
+                const auto it = g_esNames.ids.find(EsLower(g_esPlayerShown.name));
+                if (it != g_esNames.ids.end() && it->second.size() == 1) g_esPlayerShown.playerId = *it->second.begin();
+            }
+        }
+        if (!g_esPlayerShown.playerId) return;
+    }
+    EsPlayerInfo* info = nullptr;
+    if (g_esPlayerShown.playerId) {
+        info = &g_esPlayerInfo[g_esPlayerShown.playerId];
+        const bool due = !info->loading && ((info->loaded && now - info->fetched > kEsportsTtl) || (!info->loaded && (info->error.empty() || now - info->fetched > std::chrono::seconds(10))));
+        if (due) {
+            info->loading = true;
+            EsLoadPlayer(g_esPlayerShown.playerId);
+        }
+        if (!info->loaded) return;
+        for (const auto& t : info->teams) EsRequestStandings(t.season, t.division);   // the teams' logos, and whether a season is over
+    }
+    const auto teams = EsPlayerTeams(g_esPlayerShown, info);
+    const auto seasons = EsPlayerSeasons(teams);
+    if (seasons.empty()) return;
+    if (std::find(seasons.begin(), seasons.end(), g_esPlayerSeason) == seasons.end()) g_esPlayerSeason = seasons.front();
+    auto& s = g_esPlayerSeasons[{EsPlayerKey(g_esPlayerShown), g_esPlayerSeason}];
+    if (EsToadsSeason(g_esPlayerSeason)) {
+        if (!s.loaded) EsToadsSeasonMatches(teams, g_esPlayerSeason, s);
+        return;
+    }
+    if (info && !s.loading && !s.loaded && s.error.empty()) {
+        std::vector<EsPlayerTeam> teams;
+        bool finished = true;
+        for (const auto& t : info->teams)
+            if (t.season == g_esPlayerSeason) {
+                teams.push_back(t);
+                finished = finished && g_esStandings[EsKey(t.season, t.division)].playoffsDecided;
+            }
+        s.loading = true;
+        EsLoadPlayerSeason(g_esPlayerShown.playerId, g_esPlayerSeason, std::move(teams), finished);
+    }
+}
+
+// Left / Right on the player's page: the season whose matches are shown (Left: older, as the
+// standings' season switch).
+bool EsSwitchPlayerSeason(int step) {
+    std::lock_guard lock(g_esMutex);
+    const auto it = g_esPlayerInfo.find(g_esPlayerShown.playerId);
+    const auto seasons = EsPlayerSeasons(EsPlayerTeams(g_esPlayerShown, it != g_esPlayerInfo.end() ? &it->second : nullptr));   // newest first
+    const auto at = std::find(seasons.begin(), seasons.end(), g_esPlayerSeason);
+    const int k = static_cast<int>(at - seasons.begin()) + step;
+    if (at == seasons.end() || k < 0 || k >= static_cast<int>(seasons.size())) return false;
+    g_esPlayerSeason = seasons[k];
+    g_esMatchScroll = 0;
+    return true;
+}
+
+int g_esMatchRows = 0, g_esMatchCount = 0;   // the match list's rows shown / matches (for scrolling)
+
