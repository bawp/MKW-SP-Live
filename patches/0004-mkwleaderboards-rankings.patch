+        return;
+    }
+
+    // Columns, from the right: points, then the record.
+    struct Col { const char* name; float right; };
+    std::vector<Col> cols;
+    float x = R - 14;
+    for (const auto& [name, width] : std::initializer_list<std::pair<const char*, float>>{
+             {"PTS", 56}, {"+/-", 74}, {"PA", 66}, {"PF", 66}, {"BP", 44}, {"L", 36}, {"T", 36}, {"W", 36}, {"P", 40}}) {
+        if (!wide && (std::strcmp(name, "PA") == 0 || std::strcmp(name, "PF") == 0)) continue;
+        cols.push_back({name, x});
+        x -= width;
+    }
+    const float nameX = L + 108, nameMax = x - 12 - nameX;
+
+    const char* credit = EsToadsSeason(kEsSeasons[g_esSeason].id) ? "Data: toadsfactory.mkw.gg" : "Data: mkw-stats.web.app";
+    const std::string hints = std::string(EsButtonIcons().a) + " Team Page   " + kIconDpad + " Select";
+    const bool creditBelow = W - 22 - c.TextWidth(28, hints) - 26 - c.TextWidth(17, credit) >= kEsBarCurveEnd;
+    const float headerY = kEsSectionTop, rowTop = headerY + 24, rowBottom = kEsBottom - (creditBelow ? 4 : 14);
+    c.Gradient(L, headerY, R, headerY + 22, Rgba(0x000820, alpha * 0.55f), Rgba(0x000820, alpha * 0.55f), Rgba(0x00163E, alpha * 0.55f), Rgba(0x00163E, alpha * 0.55f));
+    c.Text(L + 14, headerY, 24, 0xB8C8F0, "#");
+    c.Text(nameX, headerY, 24, 0xB8C8F0, "Team");
+    for (const auto& col : cols) c.Text(col.right, headerY, 24, 0xB8C8F0, col.name, 1.0f);
+
+    std::string message;
+    if (!standings.loaded) message = standings.error.empty() ? "Loading standings..." : "Couldn't reach mkw-stats.web.app.";
+    else if (standings.teams.empty()) message = "No standings yet.";
+
+    // After a season change the table slides in from that side.
+    const float switched = std::clamp(std::chrono::duration<float>(now - g_esSwitchedAt).count() / 0.2f, 0.0f, 1.0f);
+    EsCanvas r = c;
+    r.dx += static_cast<float>(g_esSwitchDir) * (1.0f - switched) * 40.0f;
