+        int32_t lo = 0, hi = static_cast<int32_t>(Memory::Read16(mid)) - 1;
+        while (lo <= hi) {
+            const int32_t at = (lo + hi) >> 1;
+            const uint32_t v = Memory::Read32(mid + 8 + 4 * static_cast<uint32_t>(at));
+            if (v == want) return at;
+            if (v < want) lo = at + 1;
+            else hi = at - 1;
+        }
+        return -1;
+    };
+    int32_t index = -1;
+    if (id >= 6002 && id <= 6260 && SubregionSetting() != 0)
+        for (const auto& [from, to] : kRegionalTexts) if (from == id) index = find(to);
+    if (index < 0) index = find(id);
+    ctx->gpr[3] = static_cast<uint32_t>(index);
+}
