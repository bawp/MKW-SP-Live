+// ---- A player's Mii on the globe -----------------------------------------------------------------
+// A player's page stands their Mii on the globe at their country, as the WFC Friend Roster does for a
+// friend (Pages::Globe 0x805E50B4): the Mii goes into the menus' Mii group (GlobalContext +0x238,
+// slot 0, MiiGroup::LoadMii), GlobeMgr::SetMii takes it, SetPosition in mode 1 (a friend's place)
+// turns the globe there and enables the Mii (IsMiiEnabled), and DisplayMii brings it up, once.
+// Leaving the page takes it down (ResetGlobeMii) and gives the globe its mode back.
+// Toad's Factory only has pictures of the Miis (Mii Studio renders): tools/miifit fits a Wii Mii to
+// each league player's picture (esports_miis.inc, by picture file); players without one keep the
+// globe as it is.
+#include "esports_miis.inc"
+
+extern "C" void func_807509A0(CpuContext* ctx);   // GlobeMgr::SetMii(mgr, Mii*)
+extern "C" void func_807509B4(CpuContext* ctx);   // GlobeMgr::DisplayMii
+extern "C" void func_807509D0(CpuContext* ctx);   // GlobeMgr::ResetGlobeMii
+
+namespace {
+constexpr uint32_t kGlobeMiiGroup = 0x238, kGlobeFriend = 1;   // in the GlobalContext
+constexpr uint32_t kGlobeEarth = 20, kGlobeMiiEnabled = 249;   // GlobeMgr::IsMiiEnabled
+
+// The fitted Mii of a Toad's Factory picture, named, with its CRC.
+std::optional<std::array<uint8_t, kMiiSize>> EsFittedMii(const std::string& file, const std::string& name) {
+    for (const auto& f : kEsFittedMiis) {
+        if (file != f.file) continue;
+        std::array<uint8_t, kMiiSize> mii{};
+        for (size_t b = 0; b < kMiiDataSize; ++b) mii[b] = static_cast<uint8_t>(std::stoi(std::string(f.data + 2 * b, 2), nullptr, 16));
+        SetMiiName(mii, name);
+        return mii;
+    }
+    return std::nullopt;
+}
+
+const EsCountryPlace* EsCountryPlaceOf(const std::string& iso) {
+    for (const auto& c : kEsCountryPlaces)
+        if (iso.size() >= 2 && iso.compare(0, 2, c.iso) == 0) return &c;
+    return nullptr;
+}
