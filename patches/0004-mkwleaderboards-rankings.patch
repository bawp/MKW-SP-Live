+void DrawEsports() noexcept {
+    try {
+        ++g_mtFrame;
+        DrawMyTimes();
+        uint32_t flag = EsFlag();
+        if (flag != kEsClosed && CurrentSectionId() != kSectionChannelId) {
+            Memory::Write32(kEsportsFlag, kEsClosed);
+            flag = kEsClosed;
+        }
+        // The font loads once the channel has settled (about 2 s in), so it doesn't compete with the
+        // channel's own loading; at once if Esports is opened before that.
+        static int s_channelFrames = 0;
+        s_channelFrames = CurrentSectionId() == kSectionChannelId ? s_channelFrames + 1 : 0;
+        if (g_esFontState == 0 && (s_channelFrames > 120 || (flag != kEsClosed && s_channelFrames > 0))) {
+            g_esFontState = 1;
+            EsLoadFont();
+        }
+        EsUploadFont();
+        if (flag == kEsClosed) {
+            EsDrawNotifyDot();
+            return;
+        }
+        if (flag == kEsOpening || flag == kEsOpen || flag == kEsTeamClosing) EsRequestData();
+        if (flag == kEsTeamOpening || flag == kEsTeam || flag == kEsPlayerClosing) EsRequestTeam();
+        if (flag == kEsPlayerOpening || flag == kEsPlayer) EsRequestPlayer();
+        const auto now = Clock::now();
+        const float in = std::chrono::duration<float>(now - g_esShownAt).count() / 0.22f - 0.35f;
+        const float out = 1.0f - std::chrono::duration<float>(now - g_esClosingAt).count() / 0.15f;
+        // Which page is up (or going): the standings, a team's, a player's.
+        const bool player = flag == kEsPlayer || flag == kEsPlayerClosing;
+        const bool team = flag == kEsTeam || flag == kEsTeamClosing || flag == kEsPlayerOpening;
+        const bool coming = flag == kEsOpen || flag == kEsTeam || flag == kEsPlayer;
+        float alpha = coming ? in : flag == kEsOpening ? 0.0f : out;
+        alpha = std::clamp(alpha, 0.0f, 1.0f);
+        if (alpha <= 0.0f) return;
+        ImVec2 origin, size;
+        EsGameRect(origin, size);
+        if (player) EsDrawPlayer(origin, size, alpha);
+        else if (team) EsDrawTeam(origin, size, alpha);
+        else EsDrawMenu(origin, size, alpha);
+    } catch (const Memory::AccessViolation&) {
+    }
+}
