+
+// Continent (the game's region byte: matching area + 1) of a Wii country code; 0 = unknown.
+uint8_t RegionOfCountry(uint8_t wii) {
+    if (wii == 1) return 1;                                    // Japan
+    if (wii >= 8 && wii <= 52) return 2;                       // Americas
+    if (wii == 65 || wii == 95) return 4;                      // Australia / New Zealand
+    if (wii >= 64 && wii <= 121) return 3;                     // Europe and Africa (PAL)
+    if (wii == 136) return 5;                                  // Korea
+    if (wii == 128 || wii == 144 || wii == 145) return 6;      // Taiwan / Hong Kong / Macao
+    if (wii == 160) return 7;                                  // China
+    if (wii >= 152 && wii <= 156) return 4;                    // South-East Asia (PAL Australia)
+    if (wii >= 168 && wii <= 177) return 3;                    // Middle East / India (PAL)
+    return 0;
+}
+
+// Continental rankings use four continents rather than the Wii's matching areas (which put
+// South-East Asia with Australia, and Japan, Korea, Taiwan and China apart): Americas, Europe (with
+// Africa, as in PAL), Asia (East and South-East Asia, India and the Middle East) and Oceania
+// (Australia and New Zealand).
+enum class Continent : uint8_t { None, Americas, Europe, Asia, Oceania };
+
+Continent ContinentOfCountry(uint8_t wii) {
+    if (wii >= 8 && wii <= 52) return Continent::Americas;
+    if (wii == 65 || wii == 95) return Continent::Oceania;
+    if (wii >= 64 && wii <= 121) return Continent::Europe;
+    if (wii == 1 || (wii >= 128 && wii <= 177)) return Continent::Asia;
+    return Continent::None;
+}
+
+// The continent of the console's matching area (the game's region byte: area + 1).
+Continent ContinentOfArea(uint8_t region) {
+    switch (region) {
+    case 2: return Continent::Americas;
+    case 3: return Continent::Europe;
+    case 4: return Continent::Oceania;
+    case 1: case 5: case 6: case 7: return Continent::Asia;
+    default: return Continent::None;
+    }
+}
