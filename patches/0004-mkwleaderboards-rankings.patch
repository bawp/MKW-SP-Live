+}
+
+// The menu's sections (the standings' input is the menu's own, below): L / R switch section; the
+// schedule's Up / Down move over the matches, A opens a played one's results table (Up / Down scroll
+// it, B closes it); the players': Up / Down move, Y / option switch runners and baggers. Returns
+// true when it took the input.
+bool EsSectionInput(CpuContext* ctx, uint32_t page, uint16_t pressed, uint16_t buttons, bool padL, bool padR, bool padY,
+                    Clock::time_point now) {
+    auto sound = [&](uint32_t id) { CallWith(ctx, func_80602CF8, {page, id, 0xFFFFFFFF}); };
+    // Up / Down, repeating while held (the standings keep their own)
+    auto upDown = [&] {
+        int step = 0;
+        if (pressed & (kEsUp | kEsDown)) {
+            step = (pressed & kEsUp) ? -1 : 1;
+            g_esRepeatAt = now + std::chrono::milliseconds(380);
+        } else if ((buttons & (kEsUp | kEsDown)) && now >= g_esRepeatAt) {
+            step = (buttons & kEsUp) ? -1 : 1;
+            g_esRepeatAt = now + std::chrono::milliseconds(110);
+        }
+        return step;
+    };
+    if (g_esResultMatch) {
+        const int step = upDown();   // the results table
+        if (pressed & kEsB) { sound(kSoundBack); g_esResultMatch = 0; return true; }
+        if (step) {
+            std::lock_guard lock(g_esMutex);
+            g_esResultScroll = std::clamp(g_esResultScroll + static_cast<float>(step), 0.0f, static_cast<float>(std::max(0, g_esResultRows - g_esResultVisible)));
+        }
+        return true;
+    }
+    if (padL || padR) {
+        g_esSectionDir = padR ? 1 : -1;
+        g_esSection = (g_esSection + g_esSectionDir + kEsSectionCount) % kEsSectionCount;
+        g_esSectionAt = now;
+        sound(kSoundMove);
+        return true;
+    }
+    if (g_esSection == kEsStandingsSection) return false;
+    if (pressed & kEsB) return false;   // back to the channel, as from the standings
+    const int step = upDown();
+    if (pressed & (kEsLeft | kEsRight)) {   // the season, as the standings'
+        const int season = g_esSeason + ((pressed & kEsRight) ? 1 : -1);
+        if (season >= 0 && season < kEsSeasonCount) {
+            g_esSwitchDir = season > g_esSeason ? 1 : -1;
+            g_esSeason = season;
+            g_esSwitchedAt = now;
+            g_esSchedCursor = g_esAvgCursor = 0;
+            g_esSchedScroll = g_esAvgScroll = 0.0f;
+            sound(kSoundMove);
+        }
+        return true;
+    }
+    std::lock_guard lock(g_esMutex);
+    const EsStandings& standings = EsTable(g_esSeason);
+    if (g_esSection == kEsScheduleSection) {
+        const auto rows = EsScheduleRows(standings);
+        if ((pressed & kEsA) && g_esSchedCursor < static_cast<int>(rows.size())) {
+            const EsScheduleRow& row = rows[g_esSchedCursor];
+            if (row.played && row.match.id) {
+                g_esResultMatch = row.match.id;
+                g_esResultScroll = 0.0f;
+                auto& d = g_esMatchDetails[row.match.id];
+                if (!d.loaded && !d.loading) { d.loading = true; EsLoadMatchDetail(row.match.id); }
+                sound(kSoundOk);
+            }
+            return true;
+        }
+        if (step) {
+            const int next = std::clamp(g_esSchedCursor + step, 0, std::max(0, static_cast<int>(rows.size()) - 1));
+            if (next != g_esSchedCursor) { g_esSchedCursor = next; sound(kSoundMove); }
+        }
+        return true;
+    }
+    if ((pressed & kEsOption) || padY) {
+        g_esAvgBaggers = !g_esAvgBaggers;
+        g_esAvgCursor = 0;
+        g_esAvgScroll = 0.0f;
+        sound(kSoundMove);
+        return true;
+    }
+    if (step) {
+        const int count = static_cast<int>(EsAverageRows(standings, g_esAvgBaggers).size());
+        const int next = std::clamp(g_esAvgCursor + step, 0, std::max(0, count - 1));
+        if (next != g_esAvgCursor) { g_esAvgCursor = next; sound(kSoundMove); }
+    }
+    return true;
+}
+
+// The menu's input (the page's own is skipped). Standings: Up / Down move the cursor (repeating
+// while held), Left / Right switch season, A opens the team's page, B goes back to the channel. A
+// team's page: Up / Down move over the roster, A opens the player's page, B goes back to the
+// standings. A player's page: B goes back to the team's.
+void EsMenuInput(CpuContext* ctx, uint32_t page) {
+    const uint32_t manager = Memory::Read32(kSectionManager);
+    const uint32_t holder = manager ? Memory::Read32(manager + kSectionPadHolder) : 0;
+    const uint16_t buttons = holder && Memory::Contains(holder + kHolderUiButtons, 2) ? Memory::Read16(holder + kHolderUiButtons) : 0;
+    const uint16_t pressed = buttons & ~g_esButtons;
+    g_esButtons = buttons;
+    const uint16_t raw = holder && Memory::Contains(holder + kHolderUiButtons + 2, 2) ? Memory::Read16(holder + kHolderUiButtons + 2) : 0;
+    const bool gamecube = manager && Memory::Contains(manager + kPadControllerId, 4) && (Memory::Read32(manager + kPadControllerId) & 0xFF) == 0x24;
+    const bool padY = gamecube && (raw & kEsPadY) && !(g_esRawButtons & kEsPadY);
+    const bool padL = gamecube && (raw & kEsPadL) && !(g_esRawButtons & kEsPadL);
+    const bool padR = gamecube && (raw & kEsPadR) && !(g_esRawButtons & kEsPadR);
+    g_esRawButtons = raw;
+    const auto now = Clock::now();
+    const uint32_t flag = EsFlag();
+    const bool teamPage = flag == kEsTeam, playerPage = flag == kEsPlayer;
+    if (!teamPage && !playerPage && EsSectionInput(ctx, page, pressed, buttons, padL, padR, padY, now)) return;
+    if (pressed & kEsB) {
+        CallWith(ctx, func_80602CF8, {page, kSoundBack, 0xFFFFFFFF});
+        Memory::Write32(kEsportsFlag, playerPage ? kEsPlayerClosing : teamPage ? kEsTeamClosing : kEsClosing);
+        g_esClosingAt = now;
+        CallWith(ctx, func_80602488, {page, 1}, 0.0);   // Page::startReplace(Anim::Prev)
+        return;
+    }
+    if (playerPage) {   // Left / Right: season; Up / Down: scroll the matches
+        const int season = (pressed & kEsLeft) ? 1 : (pressed & kEsRight) ? -1 : 0;
+        if (season && EsSwitchPlayerSeason(season)) {
+            CallWith(ctx, func_80602CF8, {page, kSoundMove, 0xFFFFFFFF});
+            return;
+        }
+        int step = 0;
+        if (pressed & (kEsUp | kEsDown)) {
+            step = (pressed & kEsUp) ? -1 : 1;
+            g_esRepeatAt = now + std::chrono::milliseconds(380);
+        } else if ((buttons & (kEsUp | kEsDown)) && now >= g_esRepeatAt) {
+            step = (buttons & kEsUp) ? -1 : 1;
+            g_esRepeatAt = now + std::chrono::milliseconds(110);
+        }
+        if (step) {
+            std::lock_guard lock(g_esMutex);
+            g_esMatchScroll = std::clamp(g_esMatchScroll + step, 0, std::max(0, g_esMatchCount - g_esMatchRows));
+        }
+        return;
+    }
+    if (teamPage && ((pressed & kEsOption) || padY) && kEsSeasons[g_esTeamSeason].mkcTournament) {
+        {
+            std::lock_guard lock(g_esMutex);
+            g_esHideInactive = !g_esHideInactive;
+        }
+        CallWith(ctx, func_80602CF8, {page, kSoundMove, 0xFFFFFFFF});
+        return;
+    }
+    if (teamPage && (pressed & kEsA)) {
+        bool found = false;
+        {
+            std::lock_guard lock(g_esMutex);
+            if (g_esPlayerCursor >= 0 && g_esPlayerCursor < static_cast<int>(g_esPlayersShown.size())) {
+                g_esPlayerShown = g_esPlayersShown[g_esPlayerCursor];
+                // A player known only by name (registered on MK Central): the Toad's Factory profile
+                // their Mii came from, and its mkw-stats player, so their earlier seasons show.
+                if (!g_esPlayerShown.playerId && !g_esPlayerShown.toadsId)
+                    if (const int toads = EsPlayerToadsProfile(g_esPlayerShown, g_esTeamShown)) {
+                        g_esPlayerShown.toadsId = toads;
+                        g_esPlayerShown.playerId = EsStatsIdOfToads(toads);
+                    }
+                g_esPlayerSeason = kEsSeasons[g_esTeamSeason].id;   // the season the team page shows
+                g_esMatchScroll = 0;
+                found = true;
+            }
+        }
+        if (found) {
+            CallWith(ctx, func_80602CF8, {page, kSoundOk, 0xFFFFFFFF});
+            Memory::Write32(kEsportsFlag, kEsPlayerOpening);
+            g_esClosingAt = now;
+            CallWith(ctx, func_80602488, {page, 0}, 0.0);   // Page::startReplace(Anim::Next)
+        }
+        return;
+    }
+    if (!teamPage && (pressed & kEsA)) {
+        bool found = false;
+        {
+            std::lock_guard lock(g_esMutex);
+            const auto& teams = EsTable(g_esSeason).teams;
+            if (g_esCursor >= 0 && g_esCursor < static_cast<int>(teams.size()) && teams[g_esCursor].teamId != 0) {
+                g_esTeamShown = teams[g_esCursor];
+                g_esTeamSeason = g_esSeason;
+                found = true;
+            }
+        }
+        if (found) {
+            CallWith(ctx, func_80602CF8, {page, kSoundOk, 0xFFFFFFFF});
+            Memory::Write32(kEsportsFlag, kEsTeamOpening);
+            g_esClosingAt = now;
+            CallWith(ctx, func_80602488, {page, 0}, 0.0);   // Page::startReplace(Anim::Next)
+        }
+        return;
+    }
+    if (!teamPage) {
+        if (const int season = g_esSeason + ((pressed & kEsRight) ? 1 : (pressed & kEsLeft) ? -1 : 0);
+            season != g_esSeason && season >= 0 && season < kEsSeasonCount) {
+            g_esSwitchDir = season > g_esSeason ? 1 : -1;
+            g_esSeason = season;
+            g_esSwitchedAt = now;
+            g_esCursor = 0;
+            g_esScroll = 0.0f;
+            CallWith(ctx, func_80602CF8, {page, kSoundMove, 0xFFFFFFFF});
+            return;
+        }
+    }
+    int step = 0;
+    if (pressed & (kEsUp | kEsDown)) {
+        step = (pressed & kEsUp) ? -1 : 1;
+        g_esHeldSince = now;
+        g_esRepeatAt = now + std::chrono::milliseconds(380);
+    } else if ((buttons & (kEsUp | kEsDown)) && now >= g_esRepeatAt) {
+        step = (buttons & kEsUp) ? -1 : 1;
+        g_esRepeatAt = now + std::chrono::milliseconds(110);
+    }
+    if (!step) return;
+    int count = 0;
+    {
+        std::lock_guard lock(g_esMutex);
+        if (teamPage) {
+            count = g_esPlayerCount;
+        } else {
+            count = static_cast<int>(EsTable(g_esSeason).teams.size());
+        }
+    }
+    int& cursor = teamPage ? g_esPlayerCursor : g_esCursor;
+    const int next = std::clamp(cursor + step, 0, std::max(0, count - 1));
+    if (next != cursor) {
+        cursor = next;
+        CallWith(ctx, func_80602CF8, {page, kSoundMove, 0xFFFFFFFF});
+    }
