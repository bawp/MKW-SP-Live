+
+extern "C" void LicenseGetLdbEntry_HLE_80548e30(CpuContext* ctx) {
+    const uint32_t license = ctx->gpr[3], rank = ctx->gpr[4], course = ctx->gpr[5];
+    CallWith(ctx, func_80552D90, {course});
+    const int32_t index = static_cast<int16_t>(ctx->gpr[3]);
+    if (index < 0) { ctx->gpr[3] = 0; return; }
+    const uint32_t entry = license + rank * 3200 + static_cast<uint32_t>(index) * 100 + 0xE20;
+    ctx->gpr[3] = entry;
+    if (rank != 0 || course >= g_mtPbs.size() || !Memory::Contains(entry, 100)) return;
+    MtLoadPbs();
+    const auto& pb = g_mtPbs[course];
+    // A record that is the PB put here before (another board's) is replaced, or cleared when this
+    // board has none; the license's own records stay unless the PB beats them.
+    const bool valid = Memory::Read8(entry + 86) != 0;
+    const uint32_t stored = valid ? (Memory::Read16(entry + 80) * 60u + Memory::Read8(entry + 82)) * 1000u + Memory::Read16(entry + 84) : 0;
+    const bool ours = valid && g_mtPbWritten[course] != 0 && stored == g_mtPbWritten[course];
+    if (!pb.set) {
+        if (ours) { Memory::Write8(entry + 86, 0); g_mtPbWritten[course] = 0; }
+        return;
+    }
+    if (valid && !ours && stored <= pb.timeMs) return;
+    g_mtPbWritten[course] = pb.timeMs;
