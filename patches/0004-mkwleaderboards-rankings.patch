+// Every player of the league's divisions by name (the standings' leaderboards), for projected
+// players their team's rosters don't have (a player new to the team, such as Fox, from Lazarus to
+// Vitality). Loaded once, when needed.
+struct EsNameIndex {
+    bool loading = false, loaded = false;
+    std::unordered_map<std::string, std::unordered_set<int>> ids;   // lower-case name -> player ids
+};
+EsNameIndex g_esNames;
+
+void EsLoadNameIndex() {
+    std::thread([] {
+        std::unordered_map<std::string, std::unordered_set<int>> ids;
+        for (const auto& season : kEsSeasons) {
+            if (season.toadsDivision) continue;
+            std::string error;
+            const auto divisions = EsFetch(std::string("/api/divisions?league=") + kEsLeague.id + "&season=" + season.id, error);
+            const auto* list = divisions ? std::get_if<Json::Array>(&divisions->v) : nullptr;
+            if (!list) continue;
+            for (const auto& d : *list) {
+                const auto json = EsFetch(std::string("/api/standings?league=") + kEsLeague.id + "&season=" + season.id + "&division=" + d.str("division"), error);
+                const Json* board = json ? json->get("leaderboard") : nullptr;
+                if (const auto* arr = board ? std::get_if<Json::Array>(&board->v) : nullptr)
+                    for (const auto& p : *arr) ids[EsLower(p.str("name"))].insert(static_cast<int>(p.num("player_id")));
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        g_esNames.ids = std::move(ids);
+        g_esNames.loading = false;
+        g_esNames.loaded = true;
+    }).detach();
+}
