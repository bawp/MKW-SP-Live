+// The ranking graph's time axis. RankingGraphControlTimeAttack builds it from a per-course record
+// (WC24's, or the defaults the game ships with when there is none): 0x8061A650(axis, record, world)
+// sets the slow and fast ends (axis +8 / +12, from the record's two race times at +12 / +24), lets
+// 0x80619FE8 pad them, takes the record's 100-bucket histogram of players along it (+124, how dense
+// the crowd of Miis is) and the crowd's size (from the record's +0). The defaults are years old (DK
+// Mountain's spans 2:10-4:10), which put today's times at the far right edge. On the Continental /
+// Worldwide graphs the axis is the course's board instead: from just ahead of the record to the
+// board's median time (at least 10 s behind the record), with the board's players as the histogram and the Top 10 button at the 10th place (Settings > Rankings >
+// Times picks the board). Boards are fetched on a worker; until one is in, the graph is vanilla's.
+extern "C" void func_80619FE8(CpuContext* ctx);   // the axis: pad its ends
+namespace {
+constexpr uint32_t kAxisGraphArea = 0x1B74, kAxisGraphCourse = 0x1B78, kAxisContinental = 1, kAxisWorld = 2;   // RankingGraph page
+constexpr uint32_t kAxisSlow = 8, kAxisFast = 12, kAxisPaddedSlow = 16, kAxisItems = 52, kAxisItemCount = 60;
+constexpr uint32_t kAxisHistogram = 192, kAxisCrowd = 292, kRecordHistogram = 124;
+constexpr uint32_t kItemKind = 372, kItemTime = 388, kItemKindTopTen = 6;
+struct AxisSpan { uint32_t fast = 0, slow = 0, tenth = 0; std::vector<uint32_t> times; std::vector<Run> players; };
+std::mutex g_axisMutex;
+std::map<std::tuple<uint32_t, uint8_t, std::string>, std::shared_ptr<const AxisSpan>> g_axisSpans;   // (course, area, board)
+std::set<std::pair<uint8_t, std::string>> g_axisFetching;
+
+std::shared_ptr<const AxisSpan> SpanOf(const std::vector<Run>& standings) {
+    auto span = std::make_shared<AxisSpan>();
+    const uint32_t record = standings.front().timeMs;
+    // to the board's median time (the faster half of its players in view), at least 10 s
+    const uint32_t width = std::max<uint32_t>(10000, standings[standings.size() / 2].timeMs - record);
+    span->fast = record - std::max<uint32_t>(300, width / 25);
+    span->slow = record + width;
+    span->tenth = standings[std::min<size_t>(9, standings.size() - 1)].timeMs;
+    for (const auto& r : standings) span->times.push_back(r.timeMs);
+    span->players = standings;
+    return span;
+}
+
+// Spans kept on disk too (Cache/mkwleaderboards/spans), so the first graph after a boot is the
+// board's at once; the boards are fetched again in the background each session.
+// { "SPAN", u32 fast, slow, tenth, count, count x u32 time }.
+std::filesystem::path SpanFile(uint32_t course, uint8_t area, const std::string& board) {
+    char name[64];
+    std::snprintf(name, sizeof name, "%02u-%u-%s-median.bin", course, area, board.c_str());
+    return GhostCacheDir().parent_path() / "spans" / name;
+}
+
+void SaveSpan(uint32_t course, uint8_t area, const std::string& board, const AxisSpan& span) {
+    std::error_code ec;
+    std::filesystem::create_directories(SpanFile(course, area, board).parent_path(), ec);
+    std::vector<uint8_t> out(20 + 4 * span.times.size());
+    std::memcpy(out.data(), "SPAN", 4);
+    PutBe32(out, 4, span.fast);
+    PutBe32(out, 8, span.slow);
+    PutBe32(out, 12, span.tenth);
+    PutBe32(out, 16, static_cast<uint32_t>(span.times.size()));
+    for (size_t k = 0; k < span.times.size(); ++k) PutBe32(out, 20 + 4 * k, span.times[k]);
+    std::ofstream(SpanFile(course, area, board), std::ios::binary | std::ios::trunc).write(reinterpret_cast<const char*>(out.data()), static_cast<std::streamsize>(out.size()));
+}
+
+// A saved span (without its players, so it cannot fetch a crowd), or nullptr.
+std::shared_ptr<const AxisSpan> LoadSpan(uint32_t course, uint8_t area, const std::string& board) {
+    std::ifstream in(SpanFile(course, area, board), std::ios::binary);
+    const std::vector<uint8_t> d((std::istreambuf_iterator<char>(in)), {});
+    if (d.size() < 20 || std::memcmp(d.data(), "SPAN", 4) != 0 || d.size() != 20 + 4 * static_cast<size_t>(Be32(d, 16))) return nullptr;
+    auto span = std::make_shared<AxisSpan>();
+    span->fast = Be32(d, 4);
+    span->slow = Be32(d, 8);
+    span->tenth = Be32(d, 12);
+    for (size_t k = 0; k < Be32(d, 16); ++k) span->times.push_back(Be32(d, 20 + 4 * k));
+    return span;
+}
+
+std::set<std::pair<uint8_t, std::string>> g_axisFetched;   // boards fetched (or being fetched) this session
+
+void PrefetchCrowds(uint8_t area, std::string category, uint32_t first, bool ghostNames);   // (below)
+void FetchAxisSpans(uint8_t area, std::string category, uint32_t first, bool ghostNames) {
+    std::thread([area, category, first, ghostNames] {
+        for (uint32_t k = 0; k < kCourseCount; ++k) {
+            const uint32_t course = (first + k) % kCourseCount;
+            const auto key = std::make_tuple(course, area, category);
+            {
+                std::lock_guard lock(g_axisMutex);
+                if (const auto it = g_axisSpans.find(key); it != g_axisSpans.end() && !it->second->players.empty()) continue;
+            }
+            Job job;
+            job.course = course;
+            job.region = area;
+            job.category = category;
+            std::string error;
+            const auto standings = LoadStandings(job, 100000, error);
+            if (!standings || standings->empty()) continue;
+            const auto span = SpanOf(*standings);
+            SaveSpan(course, area, category, *span);
+            std::lock_guard lock(g_axisMutex);
+            g_axisSpans[key] = span;
+        }
+        {
+            std::lock_guard lock(g_axisMutex);
+            g_axisFetching.erase({area, category});
+        }
+        PrefetchCrowds(area, category, first, ghostNames);
+    }).detach();
+}
+
+using GraphKey = std::tuple<uint32_t, uint8_t, std::string>;   // (course, area, board)
+std::optional<GraphKey> CurrentGraphKey() {
+    if (CurrentSectionId() != kSectionRankings) return std::nullopt;
+    const uint32_t graph = SectionPage(kPageRanking);
+    if (!graph || !Memory::Contains(graph + kAxisGraphArea, 8)) return std::nullopt;
+    const uint32_t area = Memory::Read32(graph + kAxisGraphArea), course = Memory::Read32(graph + kAxisGraphCourse);
+    if ((area != kAxisContinental && area != kAxisWorld) || course >= kCourseCount) return std::nullopt;
+    return GraphKey{course, area == kAxisWorld ? 0 : RankingAreaByte(), WantedCategory()};
+}
+
+std::shared_ptr<const AxisSpan> GraphAxisSpan() {
+    const auto key = CurrentGraphKey();
+    if (!key) return nullptr;
+    const auto& [course, region, category] = *key;
+    std::lock_guard lock(g_axisMutex);
+    // this session's boards: fetched once in the background (saved spans are used meanwhile)
+    if (g_axisFetched.insert({region, category}).second && g_axisFetching.insert({region, category}).second)
+        FetchAxisSpans(region, category, course, GhostMiiNames());
+    if (const auto it = g_axisSpans.find({course, region, category}); it != g_axisSpans.end()) return it->second;
+    if (auto saved = LoadSpan(course, region, category)) {
+        g_axisSpans[{course, region, category}] = saved;
+        return saved;
+    }
+    return nullptr;
+}
+
+void PutFloat(uint32_t at, float v) { uint32_t u; std::memcpy(&u, &v, 4); Memory::Write32(at, u); }
+float GetFloat(uint32_t at) { const uint32_t u = Memory::Read32(at); float v; std::memcpy(&v, &u, 4); return v; }
+void CrowdNewGraph(uint32_t axis, bool haveSpan, bool world);   // the graph's crowd of real players (below)
+uint32_t RaceTimeMs(uint32_t at) { return (Memory::Read16(at) * 60u + Memory::Read8(at + 2)) * 1000u + Memory::Read16(at + 4); }
+} // namespace
+
+extern "C" void GraphAxisFromRecord_HLE_8061a650(CpuContext* ctx) {
+    const uint32_t axis = ctx->gpr[3], record = ctx->gpr[4], world = ctx->gpr[5];
+    const auto span = GraphAxisSpan();
+    PutFloat(axis + kAxisSlow, static_cast<float>(span ? span->slow : RaceTimeMs(record + 12)));
+    PutFloat(axis + kAxisFast, static_cast<float>(span ? span->fast : RaceTimeMs(record + 24)));
+    CallWith(ctx, func_80619FE8, {axis});
+    if (span) {
+        // The histogram as 0x80619CBC reads it: bucket 100 * (time - padded slow end) / (fast - padded slow).
+        const float slow = GetFloat(axis + kAxisPaddedSlow), fast = GetFloat(axis + kAxisFast);
