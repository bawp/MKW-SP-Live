+    {"Italy", "italy", "ITA", " IT ", 42.5f, 12.5f},
+    {"UK & Ireland", "ukire", "UK&I", " GB IE ", 54.0f, -4.5f},
+    {"Germany & Austria", "deat", "GER&AUT", " DE AT ", 50.0f, 11.5f},
+    {"Nordic", "nordic", "Nordic", " DK FI NO SE IS FO GL AX ", 62.0f, 15.0f},
+    {"Benelux", "benelux", "Benelux", " BE NL LU ", 51.2f, 5.0f},
+    {"Latin America", "latam", "LatAm", " MX GT BZ SV HN NI CR PA CU DO HT CO VE EC PE BO BR PY UY AR CL GY SR GF ", -8.0f, -62.0f, false},
+    {"Iberian", "iberian", "Iberian", " ES PT ", 40.0f, -5.0f},
+};
+constexpr uint32_t kSubregionCount = static_cast<uint32_t>(std::size(kSubregions));
+constexpr uint8_t kSubregionByte = 0x20;   // + 1-based sub-region
+
+const Subregion* SubregionOf(uint8_t region) {
+    return region > kSubregionByte && region <= kSubregionByte + kSubregionCount ? &kSubregions[region - kSubregionByte - 1] : nullptr;
+}
+
+bool InRegion(const std::string& iso, uint8_t region) {
+    if (region == 0) return true;
+    if (const Subregion* sub = SubregionOf(region)) {
+        if (iso.size() != 2) return false;
+        std::string code = " ";
+        for (char c : iso) code += static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+        return std::strstr(sub->countries, (code + " ").c_str()) != nullptr;
+    }
+    return ContinentOfCountry(WiiCountry(iso)) == ContinentOfArea(region);
+}
+
+const char* RegionName(uint8_t region) {
+    if (region == 0) return "Worldwide";
+    if (const Subregion* sub = SubregionOf(region)) return sub->name;
+    switch (ContinentOfArea(region)) {
+    case Continent::Americas: return "Americas";
+    case Continent::Europe: return "Europe";
+    case Continent::Asia: return "Asia";
+    case Continent::Oceania: return "Oceania";
+    default: return "?";
+    }
+}
