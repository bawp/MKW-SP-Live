+// Names and tags compared without case, spaces or punctuation, with the degree and ordinal signs as o
+// ("&ºrz" is "&°rz", "Luke_GB" is "LukeGB"); other non-ASCII (the star) is kept.
+std::string EsNameKey(const std::string& s) {
+    std::string out;
+    for (size_t i = 0; i < s.size(); ++i) {
+        const unsigned char ch = static_cast<unsigned char>(s[i]);
+        if (ch == 0xC2 && i + 1 < s.size() && (static_cast<unsigned char>(s[i + 1]) == 0xB0 || static_cast<unsigned char>(s[i + 1]) == 0xBA)) {
+            out += 'o';
+            ++i;
+        } else if (ch >= 0x80 || std::isalnum(ch)) {
+            out += static_cast<char>(std::tolower(ch));
+        }
+    }
+    return out;
+}
