+            g_esMatchRows = rows;
+            g_esMatchCount = count;
+            g_esMatchScroll = std::clamp(g_esMatchScroll, 0, std::max(0, count - rows));
+            for (int k = g_esMatchScroll; k < count && k < g_esMatchScroll + rows; ++k) {
+                const EsSeasonMatch& m = matches->matches[k];
+                const bool playoff = m.type == "playoff";
+                if (playoff) c.Rect(mx0, y - 1, R, y + 22, Rgba(0xFFC83A, alpha * 0.12f), 2.0f);
+                std::string label;
+                if (!playoff) label = "M" + std::to_string(m.number);
+                else label = (m.stage == "finals" ? "Final" : m.stage == "semifinals" ? "Semi" : m.stage == "quarterfinals" ? "Quarter" : "Playoff") +
+                             std::string(m.seriesMatch ? " G" + std::to_string(m.seriesMatch) : m.playerScore < 0 ? " (series)" : "");
+                const bool win = m.result == "win", loss = m.result == "loss";
+                const float vsX = mx0 + (wide ? 84.0f : 66.0f), resultX = R - (wide ? 128.0f : 110.0f);
+                c.Text(mx0 + 6, y, fs, playoff ? 0xFFD24A : 0xFFF07A, Fit(c, fs, label, vsX - mx0 - 10));
+                c.Text(vsX, y, fs, 0xFFFFFF, Fit(c, fs, "vs " + m.opponentTag, resultX - vsX - 18));
+                c.Text(resultX, y, fs, win ? 0x8CFFA8 : loss ? 0xFF9A9A : 0xFFFFFF, win ? "W" : loss ? "L" : "T", 1.0f);
+                c.Text(R - (wide ? 50.0f : 44.0f), y, fs, 0xA8C0F0, std::to_string(m.teamScore) + " - " + std::to_string(m.opponentScore), 1.0f);
+                c.Text(R - 10, y, fs, 0xFFFFFF, m.playerScore < 0 ? "-" : std::to_string(m.playerScore), 1.0f);
