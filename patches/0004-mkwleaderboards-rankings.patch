+// ---------------------------------------------------------------------------------------------
+// Ghost files
+
+uint32_t Be32(const std::vector<uint8_t>& b, size_t at) {
+    return (uint32_t(b[at]) << 24) | (uint32_t(b[at + 1]) << 16) | (uint32_t(b[at + 2]) << 8) | b[at + 3];
+}
+void PutBe32(std::vector<uint8_t>& b, size_t at, uint32_t v) {
+    b[at] = uint8_t(v >> 24); b[at + 1] = uint8_t(v >> 16); b[at + 2] = uint8_t(v >> 8); b[at + 3] = uint8_t(v);
+}
+
+uint32_t Crc32(const uint8_t* p, size_t n) {
+    static const auto table = [] {
+        std::array<uint32_t, 256> t{};
+        for (uint32_t i = 0; i < 256; ++i) {
+            uint32_t c = i;
+            for (int k = 0; k < 8; ++k) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            t[i] = c;
+        }
+        return t;
+    }();
+    uint32_t c = 0xFFFFFFFFu;
+    for (size_t i = 0; i < n; ++i) c = table[(c ^ p[i]) & 0xFF] ^ (c >> 8);
+    return c ^ 0xFFFFFFFFu;
+}
+
+// RFL::CalcCRC16 (CRC-16/XMODEM); the Mii's last two bytes make the whole block's CRC zero.
+uint16_t Crc16(const uint8_t* p, size_t n) {
+    uint16_t c = 0;
+    for (size_t i = 0; i < n; ++i) {
+        c ^= uint16_t(p[i]) << 8;
+        for (int k = 0; k < 8; ++k) c = (c & 0x8000) ? uint16_t((c << 1) ^ 0x1021) : uint16_t(c << 1);
+    }
+    return c;
+}
+
+// Vanilla RKG: header (0x88) + inputs (Yaz1 block with its u32 size, or raw) + CRC-32. CTGP ghosts
+// add a footer ("CKGD") before the final CRC; it is dropped and the CRC recomputed.
+std::optional<std::vector<uint8_t>> NormalizeRkg(std::vector<uint8_t> b, uint32_t course) {
+    if (b.size() < 0x90 || std::memcmp(b.data(), "RKGD", 4) != 0) return std::nullopt;
+    size_t len;
+    if (std::memcmp(b.data() + 0x8C, "Yaz1", 4) == 0) len = 0x8C + Be32(b, 0x88);
+    else len = 0x88 + ((size_t(b[0x0E]) << 8) | b[0x0F]);
+    if (len + 4 > b.size() || len + 4 > kGhostBufferSize) return std::nullopt;
+    if ((b[0x07] >> 2) != course) return std::nullopt;
+    b.resize(len + 4);
+    PutBe32(b, len, Crc32(b.data(), len));
+    return b;
+}
+
+void RefreshRkgCrc(std::vector<uint8_t>& rkg) {
+    PutBe32(rkg, rkg.size() - 4, Crc32(rkg.data(), rkg.size() - 4));
+}
+
+std::u16string Utf16(const std::string& s) {
+    std::u16string out;
+    for (size_t i = 0; i < s.size();) {
+        const uint8_t c = uint8_t(s[i]);
+        uint32_t cp = 0;
+        size_t n = 1;
+        if (c < 0x80) cp = c;
+        else if ((c >> 5) == 6 && i + 1 < s.size()) { cp = ((c & 0x1F) << 6) | (uint8_t(s[i + 1]) & 0x3F); n = 2; }
+        else if ((c >> 4) == 14 && i + 2 < s.size()) { cp = ((c & 0x0F) << 12) | ((uint8_t(s[i + 1]) & 0x3F) << 6) | (uint8_t(s[i + 2]) & 0x3F); n = 3; }
+        else if ((c >> 3) == 30 && i + 3 < s.size()) { cp = 0xFFFD; n = 4; }   // outside the Wii fonts
+        else cp = 0xFFFD;
+        i += n;
+        out += cp > 0xFFFF ? u'?' : static_cast<char16_t>(cp == 0xFFFD ? u'?' : cp);
+    }
+    return out;
+}
+
+void SetMiiName(std::array<uint8_t, kMiiSize>& mii, const std::string& name) {
+    std::u16string n = Utf16(name);
+    if (n.size() > 10) n.resize(10);
+    for (size_t k = 0; k < 10; ++k) {
+        const char16_t ch = k < n.size() ? n[k] : 0;
+        mii[2 + k * 2] = uint8_t(ch >> 8);
+        mii[3 + k * 2] = uint8_t(ch);
+    }
+    const uint16_t crc = Crc16(mii.data(), kMiiDataSize);
+    mii[kMiiDataSize] = uint8_t(crc >> 8);
+    mii[kMiiDataSize + 1] = uint8_t(crc);
+}
+
+// A plain Mii (Mii Channel default features) for runs whose ghost cannot be downloaded.
+std::array<uint8_t, kMiiSize> DefaultMii(int64_t playerId, const std::string& name) {
+    std::array<uint8_t, kMiiSize> m{};
+    auto put16 = [&](size_t at, uint32_t v) { m[at] = uint8_t(v >> 8); m[at + 1] = uint8_t(v); };
+    auto put32 = [&](size_t at, uint32_t v) { m[at] = uint8_t(v >> 24); m[at + 1] = uint8_t(v >> 16); m[at + 2] = uint8_t(v >> 8); m[at + 3] = uint8_t(v); };
+    put16(0x00, (1u << 10) | (1u << 5) | (5u << 1));                  // Jan 1st, favourite colour blue
+    m[0x16] = 64;                                                       // height
+    m[0x17] = 64;                                                       // weight
+    const uint32_t h = static_cast<uint32_t>(playerId * 2654435761u);
+    put32(0x18, 0x80000000u | (h & 0x1FFFFFFFu));                      // Mii ID: normal Mii, not temporary
+    put32(0x1C, 0x4D4B4C42u);                                           // system id "MKLB"
+    put16(0x22, (33u << 9) | (1u << 6));                                // hair 33, colour 1
+    put32(0x24, (6u << 27) | (6u << 22) | (1u << 13) | (4u << 9) | (10u << 4) | 2u);   // eyebrows
+    put32(0x28, (2u << 26) | (4u << 21) | (12u << 16) | (4u << 9) | (2u << 5));         // eyes
+    put16(0x2C, (1u << 12) | (4u << 8) | (9u << 3));                    // nose
+    put16(0x2E, (23u << 11) | (4u << 5) | 13u);                         // mouth
+    put16(0x30, (4u << 5) | 10u);                                       // glasses: none
+    put16(0x32, (4u << 5) | 10u);                                       // facial hair: none
+    put16(0x34, (4u << 11) | (20u << 6) | (2u << 1));                   // mole: off
+    const char16_t creator[] = u"MKWLB";
+    for (size_t k = 0; k < 5; ++k) put16(0x36 + k * 2, creator[k]);
+    SetMiiName(m, name);
+    return m;
+}
+
+std::string GhostFileUrl(const Run& r) {
+    const std::string& u = r.ghostUrl;
+    auto ends = [&](std::string_view suffix) { return u.size() >= suffix.size() && u.compare(u.size() - suffix.size(), suffix.size(), suffix) == 0; };
+    if (u.find("chadsoft.co.uk/time-trials/rkgd/") != std::string::npos && ends(".html")) return u.substr(0, u.size() - 5) + ".rkg";
+    if (!r.ctgpId.empty() && r.ctgpId.size() == 40)
+        return "https://chadsoft.co.uk/time-trials/rkgd/" + r.ctgpId.substr(0, 2) + "/" + r.ctgpId.substr(2, 2) + "/" + r.ctgpId.substr(4) + ".rkg";
+    if (u.rfind("/api/leaderboards/runs/", 0) == 0) return GetSettings().baseUrl + "/api/leaderboards/runs/" + std::to_string(r.id) + "/file";
+    if ((u.rfind("https://", 0) == 0 || u.rfind("http://", 0) == 0) && ends(".rkg")) return u;
+    return {};
+}
