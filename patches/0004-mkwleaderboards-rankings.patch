+void EsLoadRoster(int team, const std::string& season) {
+    std::thread([team, season] {
+        std::string error;
+        std::vector<EsPlayer> players;
+        for (const char* role : {"runner", "bagger"}) {
+            const auto json = EsFetch("/api/teams/" + std::to_string(team) + "/roster?league=" + kEsLeague.id + "&season=" + season + "&role=" + role, error);
+            if (!json) break;
+            const Json* list = json->get("players");
+            const auto* arr = list ? std::get_if<Json::Array>(&list->v) : nullptr;
+            if (!arr) continue;
+            for (const auto& p : *arr) {
+                EsPlayer player;
+                player.playerId = static_cast<int>(p.num("player_id"));
+                player.name = p.str("name");
+                player.role = role;
+                if (const Json* codes = p.get("friend_codes"))
+                    if (const auto* fcs = std::get_if<Json::Array>(&codes->v))
+                        for (const auto& fc : *fcs)
+                            if (const auto* s = std::get_if<std::string>(&fc.v)) player.friendCodes.push_back(*s);
+                player.matches = static_cast<int>(p.num("matches"));
+                if (const Json* m = p.get("metrics")) {
+                    player.races = static_cast<int>(m->num("races"));
+                    player.wins = static_cast<int>(m->num("wins"));
+                    player.podiums = static_cast<int>(m->num("podiums"));
+                    player.pointsPerRace = m->num("points_per_race");
+                    player.averagePlacement = m->num("average_placement");
+                }
+                players.push_back(std::move(player));
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& r = g_esTeams[team].rosters[season];
+        r.loading = false;
+        r.fetched = Clock::now();
+        r.error = error;
+        if (error.empty()) {
+            r.loaded = true;
+            r.players = std::move(players);
+        }
+    }).detach();
