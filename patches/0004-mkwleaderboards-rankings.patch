+extern "C" void RankingClientRequestTopTen_HLE_806776b0(CpuContext* ctx) {
+    const uint32_t client = ctx->gpr[3], course = ctx->gpr[4], dest = ctx->gpr[7];
+    const bool world = ctx->gpr[6] == 1;
+    const uint8_t region = world ? 0 : RankingAreaByte();
+    Memory::Write32(client + kClientDest, dest);
+    Memory::Write32(client + kClientKind, kKindTopTen);
+    Memory::Write32(client + kClientResult, 0);
+    Memory::Write32(client + kClientState, kStateBusy);
+    g_keepChampionRecords = false;
+    Start(client, kKindTopTen, course, region);
+    ctx->gpr[3] = 1;
+}
+
+// requestGhost(client, course, world, buf, sizePtr): the World / Continental Champion's ghost.
+extern "C" void RankingClientRequestGhost_HLE_80677758(CpuContext* ctx) {
+    const uint32_t client = ctx->gpr[3], course = ctx->gpr[4] & 0xFF, buf = ctx->gpr[6], sizePtr = ctx->gpr[7];
+    const bool world = ctx->gpr[5] == 1;
+    const uint8_t region = world ? 0 : RankingAreaByte();
+    Memory::Write32(client + kClientDest, buf);
+    Memory::Write32(client + kClientSizePtr, sizePtr);
+    Memory::Write32(client + kClientKind, kKindGhost);
+    Memory::Write32(client + kClientResult, 0);
+    Memory::Write32(client + kClientState, kStateBusy);
+    const int rank = std::max(0, g_requestRank.exchange(-1));
+    const bool own = g_requestOwn.exchange(false);
+    g_shownRank = rank;
+    g_shownOwn = own;
+    g_shownCourse = course;
+    g_shownWorld = world;
+    g_ghostRetitled = rank == 0 && !own;
+    g_keepChampionRecords = rank > 0 || own;
+    g_topTenGhostForgotten = rank == 0 && !own;
+    Start(client, kKindGhost, course, region, static_cast<size_t>(rank), own);
+    ctx->gpr[3] = 1;
+}
+
+// process(client): completes a finished request. Requests that still go through GameSpy (friends'
+// rankings, ghosts near your time) are not served and fail here instead of waiting forever.
+extern "C" void RankingClientProcess_HLE_80677240(CpuContext* ctx) {
+    const uint32_t client = ctx->gpr[3];
+    if (Memory::Read32(client + kClientState) != kStateBusy) return;
+    std::shared_ptr<Job> job;
+    {
+        std::lock_guard lock(g_jobMutex);
+        job = g_job;
+    }
+    if (!job || job->client != client || Memory::Read32(client + kClientKind) != job->kind) {
+        Finish(client, kResultError, kErrUnsupported);
+        return;
+    }
+    if (!job->done.load(std::memory_order_acquire)) return;
+    {
+        std::lock_guard lock(g_jobMutex);
+        if (g_job == job) g_job.reset();
+    }
+    if (job->error != 0) {
+        Finish(client, kResultError, job->error);
+        return;
+    }
+    if (job->kind == kKindTopTen) {
+        const uint32_t dest = Memory::Read32(client + kClientDest);
+        Memory::Write32(dest, static_cast<uint32_t>(job->entries.size()));
+        for (size_t k = 0; k < job->entries.size(); ++k) {
+            const TopEntry& e = job->entries[k];
+            const uint32_t at = dest + 4 + static_cast<uint32_t>(k) * 84;
+            Memory::Write32(at, e.timeMs);
+            for (size_t b = 0; b < kMiiSize; ++b) Memory::Write8(at + 4 + static_cast<uint32_t>(b), e.mii[b]);
+            Memory::Write8(at + 0x50, e.controller);
+            Memory::Write8(at + 0x51, e.region);
+            Memory::Write8(at + 0x52, 0);
+            Memory::Write8(at + 0x53, e.country);
+        }
+    } else {
+        const uint32_t buf = Memory::Read32(client + kClientDest), sizePtr = Memory::Read32(client + kClientSizePtr);
+        for (size_t b = 0; b < job->ghost.size(); ++b) Memory::Write8(buf + static_cast<uint32_t>(b), job->ghost[b]);
+        if (sizePtr) Memory::Write32(sizePtr, static_cast<uint32_t>(job->ghost.size()));
+        PrepareChampionRace(job->ghost);
+    }
+    Finish(client, kResultOk, 0);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Console country: the game picks the Continental area from SYSCONF's IPL.SADR (PAL: Europe, or
+// Australia when the country is Australia / New Zealand) through SCGetSimpleAddressData. The runtime
+// loads SYSCONF into the SC buffer but never builds SC's item table (SCCheckStatus is short-circuited),
+// so every SC item lookup fails and the area stays Europe. Read IPL.SADR from the loaded buffer
+// instead, with the SDK's own checks.
+
+namespace {
+constexpr uint32_t kScBuffer = 0x80348400, kScBufferSize = 0x4000;
+constexpr uint32_t kSadrSize = 0x1008;
+constexpr uint8_t kScBigArray = 1;
+
+// Address of the data of a SYSCONF item, or 0.
+uint32_t FindScItem(std::string_view name, uint8_t type, uint32_t size) {
+    if (!Memory::Contains(kScBuffer, kScBufferSize) || Memory::Read32(kScBuffer) != 0x53437630) return 0;   // "SCv0"
+    const uint32_t count = Memory::Read16(kScBuffer + 4);
+    for (uint32_t k = 0; k < count && 6 + 2 * k < kScBufferSize; ++k) {
+        const uint32_t item = kScBuffer + Memory::Read16(kScBuffer + 6 + 2 * k);
+        const uint8_t header = Memory::Read8(item);
+        const uint32_t nameLen = (header & 0x1F) + 1u;
+        if ((header >> 5) != type || nameLen != name.size()) continue;
+        bool match = true;
+        for (uint32_t c = 0; c < nameLen && match; ++c) match = Memory::Read8(item + 1 + c) == static_cast<uint8_t>(name[c]);
+        if (!match) continue;
+        const uint32_t data = item + 1 + nameLen;
+        if (type == kScBigArray && Memory::Read16(data) + 1u != size) return 0;
+        return data + 2;
+    }
+    return 0;
+}
+} // namespace
+
+// SCGetSimpleAddressData(dst): 1 with the 0x1008-byte IPL.SADR in dst, 0 when missing or unset.
+extern "C" uint32_t SCGetSimpleAddressData_HLE(uint32_t dst) {
+    const uint32_t sadr = FindScItem("IPL.SADR", kScBigArray, kSadrSize);
+    if (!sadr || !Memory::Contains(dst, kSadrSize)) return 0;
+    const uint32_t head = Memory::Read32(sadr);
+    const uint8_t country = head >> 24, region = (head >> 16) & 0xFF;
+    if (head == 0xFFFFFFFF || country == 0 || country == 0xFF || region == 0xFF) return 0;
+    for (uint32_t b = 0; b < kSadrSize; ++b) Memory::Write8(dst + b, region == 0 && b >= 4 ? 0 : Memory::Read8(sadr + b));
+    return 1;
+}
+
+PPC_NATIVE_OVERRIDE(801B2074, SCGetSimpleAddressData_HLE, uint32_t, (uint32_t dst), (dst));
+
+// ---------------------------------------------------------------------------------------------
+// Rankings frame: the fork's Rankings section shows TopMenuOverlay (page 0xAB) like vanilla, which
+// frames the top-10 list (0xAF) and the ghost data page (0xAD). The ranking graph (0xA8) draws its own
+// bottom bar, and in this widescreen port the two don't line up, so the overlay is only drawn while
+// 0xAF or 0xAD is on screen. Page::Draw is otherwise unchanged: draw the controls in states 3-5.
+
+extern "C" void func_805C2948(CpuContext* ctx);   // ControlGroup::Draw
+
+namespace {
+constexpr uint32_t kPageState = 0x08, kPageControls = 0x24;
+constexpr uint32_t kSectionPages = 0x08;
+constexpr uint32_t kPageRanking = 0xA8, kPageTopMenuOverlay = 0xAB, kPageGhostSelected = 0xAD, kPageTopTen = 0xAF;
+
+bool PageOnScreen(uint32_t page) {
+    if (page == 0 || !Memory::Contains(page + kPageState, 4)) return false;
+    const uint32_t state = Memory::Read32(page + kPageState);
+    return state >= 3 && state <= 5;
+}
+
+bool HideRankingsOverlay(uint32_t page) {
+    const uint32_t manager = Memory::Read32(kSectionManager);
+    if (!manager || !Memory::Contains(manager, 4)) return false;
+    const uint32_t section = Memory::Read32(manager);
+    if (!section || !Memory::Contains(section + kSectionPages, 4 * 0xB0)) return false;
+    auto pageAt = [&](uint32_t id) { return Memory::Read32(section + kSectionPages + 4 * id); };
+    if (page != pageAt(kPageTopMenuOverlay) || pageAt(kPageRanking) == 0) return false;
+    return !PageOnScreen(pageAt(kPageTopTen)) && !PageOnScreen(pageAt(kPageGhostSelected));
+}
+} // namespace
