+void DrawMyTimes() {
+    if (!g_mt.accountLoaded) MtLoadAccount();
+    // Settings > Rankings > My Times shows whether an account is linked.
+    if (g_myTimesInstalled) {
+        const uint32_t save = Memory::Read32(kSpSaveManager);
+        if (save && Memory::Contains(save + kSpSaveLicenseLoaded, 1) && Memory::Read8(save + kSpSaveLicenseLoaded)) {
+            const uint32_t license = Memory::Read8(save + kSpSaveCurrentLicense);
+            const uint32_t at = save + kSpSaveSettingValues + (license * kSpSettingCount + kMyTimesSettingSlot) * 4;
+            if (Memory::Contains(at, 4)) Memory::Write32(at, g_mt.account.playerId > 0 ? 1 : 0);
+        }
+    }
+    if (!Memory::Contains(kMyTimesFlag, 4)) return;
+    if (!g_mt.open && Memory::Read32(kMyTimesFlag) == 1) {
+        g_mt.open = true;
+        g_mt.section = CurrentSectionId();
+        g_mt.openedAt = Clock::now();
+        g_mt.state = MtState::Menu;
+        g_mt.cursor = 0;
+        g_mt.message.clear();
+        const uint32_t manager = Memory::Read32(kSectionManager);
+        const uint32_t holder = manager ? Memory::Read32(manager + kSectionPadHolder) : 0;
+        g_mt.buttons = holder ? Memory::Read16(holder + kHolderUiButtons) : 0;   // the press that opened it
+    }
+    if (!g_mt.open) return;
+    if (CurrentSectionId() != g_mt.section) { g_mt.open = false; Memory::Write32(kMyTimesFlag, 0); return; }
+
+    // The login worker's result.
+    {
+        std::lock_guard lock(g_mtMutex);
+        if (g_mtResult.done && g_mt.state == MtState::Busy) {
+            g_mtResult.done = false;
+            if (g_mtResult.import) {
+                g_mt.state = MtState::Menu;
+                g_mt.message = g_mtResult.message;
+                g_mt.messageColor = g_mtResult.ok ? 0x8CFFA8 : 0xFF9A9A;
