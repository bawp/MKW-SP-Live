+void EsGameRect(ImVec2& origin, ImVec2& size) {
+    const ImGuiIO& io = ImGui::GetIO();
+    u32 renderWidth = 0, renderHeight = 0;
+    AuroraGetRenderSize(&renderWidth, &renderHeight);
+    const float aspect = renderWidth && renderHeight ? float(renderWidth) / float(renderHeight) : io.DisplaySize.x / std::max(1.0f, io.DisplaySize.y);
+    size = io.DisplaySize;
+    if (size.x / std::max(1.0f, size.y) > aspect) size.x = size.y * aspect;
+    else size.y = size.x / aspect;
+    origin = ImVec2((io.DisplaySize.x - size.x) * 0.5f, (io.DisplaySize.y - size.y) * 0.5f);
+}
+
+uint32_t Utf8(const std::string& s, size_t& i) {
+    const unsigned char c = static_cast<unsigned char>(s[i++]);
+    if (c < 0x80) return c;
+    int extra = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : 0;
+    uint32_t code = c & (0x3Fu >> extra);
+    for (; extra > 0 && i < s.size() && (static_cast<unsigned char>(s[i]) & 0xC0) == 0x80; --extra) code = code << 6 | (static_cast<unsigned char>(s[i++]) & 0x3F);
+    return code;
+}
+
+// Seconds for animations: since the first use, wrapped every hour (a float of the clock's own count
+// is too coarse, its steps showed in the pulses).
+float AnimSeconds() {
+    static const auto start = Clock::now();
+    return static_cast<float>(std::fmod(std::chrono::duration<double>(Clock::now() - start).count(), 3600.0));
+}
+
+ImU32 Rgba(uint32_t rgb, float alpha) {
+    return IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, static_cast<int>(std::clamp(alpha, 0.0f, 1.0f) * 255));
+}
+
+// Drawing in the game's menu units: the image is 480 high (854 wide at 16:9). Text sizes are the
+// font's line height, as the game's text panes give them.
+struct EsCanvas {
+    ImDrawList* list;
+    ImVec2 origin;
+    float u;
+    float alpha;
+    float dx = 0.0f;   // the menu's slide while it comes and goes
+    ImVec2 P(float x, float y) const { return ImVec2(origin.x + (x + dx) * u, origin.y + y * u); }
+    float TextWidth(float size, const std::string& text) const { return Run(0, 0, size, 0, text, false); }
+    void Text(float x, float y, float size, uint32_t rgb, const std::string& text, float align = 0.0f, float a = 1.0f) const {
+        const float w = align != 0.0f ? TextWidth(size, text) * align : 0.0f;
+        Run(x - w, y, size, Rgba(rgb, alpha * a), text, true);
+    }
+    // Lays out (and draws) text: the game's glyphs from their sheets, the rest with the Windows font.
+    float Run(float x, float y, float size, ImU32 color, const std::string& text, bool draw) const {
+        const float s = size / 51.0f;   // the game font's cells are 51 high
+        ImFont* fallback = g_esFont ? g_esFont : ImGui::GetFont();
+        float pen = x;
+        for (size_t i = 0; i < text.size();) {
+            const size_t start = i;
+            const uint32_t code = Utf8(text, i);
+            if (const auto it = g_esGlyphs.find(code); it != g_esGlyphs.end()) {
+                const EsGameGlyph& g = it->second;
+                if (draw && g.width > 0) {
+                    const float x0 = pen + g.left * s, y0 = y + (g_esAscent - g.baseline) * s;
+                    list->AddImage(g_esSheets[g.sheet], P(x0, y0), P(x0 + g.width * s, y0 + g.height * s), ImVec2(g.u0, g.v0), ImVec2(g.u1, g.v1),
+                                   g.colored ? (color | 0x00FFFFFF) : color);   // icons keep their colours
+                }
+                pen += g.advance * s;
+                continue;
+            }
+            const std::string ch = text.substr(start, i - start);
+            if (draw) {
+                if (g_esFont) list->PushTextureID(g_esAtlas->TexID);
+                list->AddText(fallback, size * u, P(pen, y), color, ch.c_str());
+                if (g_esFont) list->PopTextureID();
+            }
+            pen += fallback->CalcTextSizeA(size * u, FLT_MAX, 0.0f, ch.c_str()).x / u;
+        }
+        return pen - x;
+    }
+    // One of the game's glyphs (icons) stretched over a rectangle.
+    bool Image(uint32_t code, float x0, float y0, float x1, float y1, ImU32 color) const {
+        const auto it = g_esGlyphs.find(code);
+        if (it == g_esGlyphs.end()) return false;
+        const EsGameGlyph& g = it->second;
+        list->AddImage(g_esSheets[g.sheet], P(x0, y0), P(x1, y1), ImVec2(g.u0, g.v0), ImVec2(g.u1, g.v1), color);
+        return true;
+    }
+    void Rect(float x0, float y0, float x1, float y1, ImU32 color, float rounding = 0.0f) const {
+        list->AddRectFilled(P(x0, y0), P(x1, y1), color, rounding * u);
+    }
+    void Gradient(float x0, float y0, float x1, float y1, ImU32 tl, ImU32 tr, ImU32 br, ImU32 bl) const {
+        list->AddRectFilledMultiColor(P(x0, y0), P(x1, y1), tl, tr, br, bl);
+    }
+    void Frame(float x0, float y0, float x1, float y1, ImU32 color, float thickness, float rounding = 0.0f) const {
+        list->AddRect(P(x0, y0), P(x1, y1), color, rounding * u, 0, thickness * u);
+    }
+};
