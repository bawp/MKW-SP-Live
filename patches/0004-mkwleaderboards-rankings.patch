+                  << " players' Miis" << std::endl;
+        std::sort(crowd->begin(), crowd->end(), [](const CrowdMii& a, const CrowdMii& b) { return a.timeMs < b.timeMs; });
+        if (!crowd->empty()) SaveCrowd(key, ghostNames, *crowd);
+        std::lock_guard lock(g_axisMutex);
+        g_crowds[key] = crowd;
+        g_crowdComplete.insert(key);
+        g_crowdFetching.erase(key);
+    }
+}
