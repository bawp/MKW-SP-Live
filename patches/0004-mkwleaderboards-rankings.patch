+// settings_overlay: every frame, inside the ImGui frame (guest thread).
+// The badge on the channel's notification box's top-right corner (as the 3DS's SpotPass light): the
+// WFC menus' Mii bubble (its glass and rim) filled with the menu buttons' yellow, pulsing while a
+// notification from the last 24 hours is shown (NotifyDraw).
+void EsDrawNotifyDot() {
+    const float a = g_notifyDotAlpha.load();
+    const int64_t ms = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count();
+    if (a <= 0.01f || ms - g_notifyDotAt.load() > 40 || CurrentSectionId() != kSectionChannelId) return;
+    ImVec2 origin, size;
+    EsGameRect(origin, size);
+    EsCanvas canvas{ImGui::GetBackgroundDrawList(), origin, size.y / 480.0f, a};
+    const float u = canvas.u, W = size.x / u;
+    const float t = AnimSeconds();
+    const float pulse = 0.5f + 0.5f * std::sin(t * 8.0f);   // brighter, then dimmer (the menus' pace)
+    // the box's top-right corner, moved with the bar (layout units: 456 high, y up)
+    constexpr float kLayoutToCanvas = 480.0f / 456.0f;
+    const float cx = W * 0.5f + 238.0f + g_notifyDotDx.load() * kLayoutToCanvas, cy = 91.0f - g_notifyDotDy.load() * kLayoutToCanvas, r = 13.0f;
+    ImDrawList* list = canvas.list;
+    const ImVec2 c = canvas.P(cx, cy);
+    const bool bubble = g_esGlyphs.count(kGlyphGlassSphere) && g_esGlyphs.count(kGlyphGlassRim);
+    // a soft glow around it, with the pulse
+    list->AddCircleFilled(c, (r + 3.0f + 4.0f * pulse) * u, Rgba(0xFFE24A, a * (0.08f + 0.20f * pulse)), 32);
+    // the yellow inside: the buttons' gold, lit up with the pulse
+    const float inner = bubble ? r * 0.86f : r;
+    list->AddCircleFilled(c, inner * u, Rgba(0xD89A00, a), 32);
+    list->AddCircleFilled(ImVec2(c.x, c.y - 0.6f * u), (inner - 1.6f) * u, Rgba(0xFFC400, a), 32);
+    list->AddCircleFilled(ImVec2(c.x - 0.5f * u, c.y - 1.2f * u), (inner - 4.0f) * u, Rgba(0xFFE45A, a * (0.45f + 0.55f * pulse)), 32);
+    if (bubble) {   // the bubble's glass (its highlights) and rim over it, as around a Mii
+        canvas.Image(kGlyphGlassSphere, cx - r, cy - r, cx + r, cy + r, Rgba(0xFFFFFF, a));
+        canvas.Image(kGlyphGlassRim, cx - r, cy - r, cx + r, cy + r, Rgba(0xFFFFFF, a));
+    } else {        // until the bubble's textures are in: a white rim and a glint
+        list->AddCircle(c, (r + 0.6f) * u, Rgba(0xFFFFFF, a), 32, 2.2f * u);
+        list->AddCircleFilled(ImVec2(c.x - 4.0f * u, c.y - 4.6f * u), 2.6f * u, Rgba(0xFFFFFF, a * (0.65f + 0.35f * pulse)), 16);
+    }
+}
