+// ---------------------------------------------------------------------------------------------
+// Notifications: the MKW-SP Channel's message bar (vanilla's Mario Kart Channel one, NotifyButton /
+// Notify, added as the page's fifth child by tools/rankings.js, never selectable) cycles through:
+//   * new Top 10 times: runs approved on mkwleaderboards.com in the last 7 days (on the board
+//     Settings > Rankings > Times picks) that are in their track's Worldwide or Continental (the
+//     chosen region) Top 10, ranked as the game's own Top 10 lists are;
+//   * the latest 5 Grand Star Cup Division 1 results of the current season (mkw-stats.web.app).
+// Fetched on a worker thread every 15 minutes. The text goes through message kMsgNotify ("{arg
+// string|0}", tools/rankings-ui.js) with a MessageInfo whose strings[0] is UTF-16 in the fork's
+// notification block. Between notifications the text fades out and in, as vanilla's did: its pane's
+// alpha (a PushButton loads only the button groups, not the bar's own Visible animations).
+constexpr uint32_t kNotifyBlock = 0x819658C0;            // tools/rankings.js NOTIFY
+constexpr uint32_t kNotifyInfo = kNotifyBlock + 0x20, kNotifyPanes = kNotifyBlock + 0x100;
+constexpr uint32_t kNotifyText = kNotifyBlock + 0x140, kNotifyTextChars = 0xFF;   // 0x200 bytes: My Times data follows
+// Pane names (written into the block), and where the bar goes: centred above the channel's buttons,
+// below the top bar (vanilla's Notify sits at y -125 below them); its text boxes, which leave room for
+// the GO capsule (x -20, 440 wide), centred on the bar and widened.
+constexpr const char* kNotifyPaneNames[] = {"capsul_null", "text", "text_light_01", "text_light_02"};
+constexpr float kNotifyY = 120.0f, kNotifyTextWidth = 490.0f;
+constexpr uint32_t kControlBaseY = 0x08, kPaneTransX = 0x2C, kPaneWidth = 0x4C;   // UIControl base position, nw4r::lyt::Pane
+constexpr uint32_t kMsgNotify = 0x2F25;
+constexpr uint32_t kInfoStrings = 0x9C;                  // UI::MessageInfo::strings
+constexpr uint32_t kControlLayout = 0xA8, kPaneAlpha = 0xB8;   // LayoutUIControl::m_mainLayout, nw4r::lyt::Pane alpha
+constexpr auto kNotifyShown = std::chrono::milliseconds(5000), kNotifyFade = std::chrono::milliseconds(350);
+constexpr auto kNotifyRefresh = std::chrono::minutes(15);
+constexpr int kNotifyDays = 7;
+constexpr size_t kNotifyResults = 5;
+
+// The community's track abbreviations, in the game's course order (CourseLabel).
+constexpr const char* kCourseShort[kCourseCount] = {
+    "MC", "MMM", "MG", "GV", "TF", "CM", "DKS", "WGM", "LC", "DC", "MH", "MT", "BC", "RR", "DDR", "KC",
+    "rPB", "rMC", "rWS", "rDKM", "rYF", "rDH", "rPG", "rDS", "rMC3", "rGV2", "rMR", "rSL", "rBC", "rDKJP", "rBC3", "rSGB",
+};
+
+struct Notifications {
+    std::vector<std::u16string> items;
+    std::vector<bool> recent;   // per item: happened in the last 24 hours (the chime and the blue dot)
+    bool loading = false, loaded = false;
+    Clock::time_point fetched{};
+    std::string key;   // the Times setting and region the items are for ("" while none)
+};
+std::mutex g_notifyMutex;
+Notifications g_notify;
+constexpr int64_t kNotifyRecentSeconds = 24 * 60 * 60;
+constexpr uint32_t kSoundEventInfo = 41;   // SE_UI_RANK_ENTER_FAMOUS: a special ghost arriving in the rankings
+// The badge by the bar (drawn by DrawEsports with ImGui): shown while a recent notification is, at the
+// text's alpha; NotifyDraw keeps it alive each frame. It moves with the bar (menu transitions slide
+// the bar in and out): the offset of the bar's text pane from where it rests, in layout units.
+std::atomic<float> g_notifyDotAlpha{0.0f};
+std::atomic<int64_t> g_notifyDotAt{0};   // last NotifyDraw (steady ms)
+std::atomic<float> g_notifyDotDx{0.0f}, g_notifyDotDy{0.0f};
+
+// "2026-10-24T02:22:38.494253+00:00" -> Unix time (UTC), 0 when unreadable.
+int64_t ParseIsoUtc(const std::string& text) {
+    int y, mo, d, h, mi, se;
+    if (std::sscanf(text.c_str(), "%d-%d-%dT%d:%d:%d", &y, &mo, &d, &h, &mi, &se) != 6) return 0;
+    std::tm tm{};
+    tm.tm_year = y - 1900; tm.tm_mon = mo - 1; tm.tm_mday = d; tm.tm_hour = h; tm.tm_min = mi; tm.tm_sec = se;
+    return static_cast<int64_t>(_mkgmtime(&tm));
+}
+
+std::string NotifyTime(uint32_t ms) {
+    char b[24];
+    std::snprintf(b, sizeof b, "%u:%02u.%03u", ms / 60000, ms / 1000 % 60, ms % 1000);
+    return b;
+}
+
+void NotifyLoad(std::string want, uint8_t regionArea, std::string regionName, std::string key) {
+    std::thread([want, regionArea, regionName, key] {
+        std::vector<std::pair<int64_t, std::string>> times;   // (date set, text), newest first
+        std::string error;
+        const int64_t since = static_cast<int64_t>(std::time(nullptr)) - kNotifyDays * 86400;
+        if (const auto json = FetchJson(GetSettings().baseUrl + "/api/leaderboards?set_after=" + std::to_string(since) + "&limit=5000", error)) {
+            struct Recent { int64_t id, date; int category; };
+            std::vector<Recent> recent;
+            if (const auto* arr = std::get_if<Json::Array>(&json->v))
+                for (const auto& o : *arr)
+                    if (o.str("status") == "approved")
+                        recent.push_back({static_cast<int64_t>(o.num("id")), static_cast<int64_t>(o.num("date_set")), static_cast<int>(o.num("category_id"))});
+            for (uint32_t course = 0; course < kCourseCount && !recent.empty(); ++course) {
+                const int track = kSiteTrack[course];
+                const auto category = CategoryOf(track, want, error);
+                if (!category) continue;
+                std::vector<int> boards{*category};
+                if (want == "unrestricted") {
+                    std::lock_guard lock(g_dataMutex);
+                    if (const auto it = g_boardsOfTrack.find(track); it != g_boardsOfTrack.end() && !it->second.empty()) boards = it->second;
+                }
+                std::vector<const Recent*> mine;
+                for (const auto& r : recent)
+                    if (std::find(boards.begin(), boards.end(), r.category) != boards.end()) mine.push_back(&r);
+                if (mine.empty()) continue;
+                Job job;
+                job.course = course;
+                job.category = want;
+                job.region = 0;
+                const auto world = LoadStandings(job, kTopTenMax, error);
+                job.region = regionArea;
+                const auto continental = LoadStandings(job, kTopTenMax, error);
+                for (const Recent* r : mine) {
+                    auto place = [&](const std::optional<std::vector<Run>>& top) -> const Run* {
+                        if (!top) return nullptr;
+                        for (const auto& run : *top) if (run.id == r->id) return &run;
+                        return nullptr;
+                    };
+                    const Run* w = place(world);
+                    const Run* c = place(continental);
+                    if (!w && !c) continue;
+                    const Run& run = w ? *w : *c;
+                    auto rank = [](const std::optional<std::vector<Run>>& top, const Run* x) { return std::to_string(x - top->data() + 1); };
+                    // A Worldwide Top 10 time says only that; the region's place only when it isn't one.
+                    const std::string where = w ? "WW #" + rank(world, w) : regionName + " #" + rank(continental, c);
+                    times.push_back({r->date, "New " + where + ": " + run.name + " " + NotifyTime(run.timeMs) + " on " + kCourseShort[course]});
+                }
+            }
+        } else {
+            std::cout << "[notify] recent runs: " << error << std::endl;
+        }
+        std::stable_sort(times.begin(), times.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+
+        std::vector<std::pair<int64_t, std::string>> results;   // (when the result came in, text)
+        const EsSeason& season = kEsSeasons[kEsSeasonCount - 1];
+        std::string esError;
+        if (const auto json = EsFetch(std::string("/api/matches?league=") + kEsLeague.id + "&season=" + season.id + "&division=" + kEsLeague.division + "&match_set=all", esError)) {
+            const Json::Array* arr = std::get_if<Json::Array>(&json->v);
+            if (!arr) if (const Json* m = json->get("matches")) arr = std::get_if<Json::Array>(&m->v);
+            std::vector<std::pair<int, std::string>> played;
+            if (arr)
+                for (const auto& m : *arr) {
+                    if (m.str("result_type") != "played") continue;
+                    const std::string teams = m.str("teams"), scores = m.str("scores");
+                    const auto vs = teams.find(" vs "), dash = scores.find(" - ");
+                    if (vs == std::string::npos || dash == std::string::npos) continue;
+                    played.push_back({static_cast<int>(m.num("match_id")), std::string("GSC ") + season.name + ": " + teams.substr(0, vs) + " " +
+                                                                           scores.substr(0, dash) + " - " + scores.substr(dash + 3) + " " + teams.substr(vs + 4)});
+                }
+            std::sort(played.begin(), played.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+            for (size_t k = 0; k < played.size() && k < kNotifyResults; ++k) {
+                // when it came in: the match's last update (its import)
+                std::string detailError;
+                int64_t at = 0;
+                if (const auto detail = EsFetch("/api/matches/" + std::to_string(played[k].first), detailError)) at = ParseIsoUtc(detail->str("last_update_at"));
+                results.push_back({at, played[k].second});
+            }
+        } else {
+            std::cout << "[notify] results: " << esError << std::endl;
+        }
+
+        // Mixed: a time, a result, a time, ... (the rest of the longer list after).
+        std::vector<std::u16string> items;
+        std::vector<bool> recent;
+        const int64_t now = static_cast<int64_t>(std::time(nullptr));
+        auto fresh = [now](int64_t at) { return at > 0 && now - at < kNotifyRecentSeconds; };
+        for (size_t k = 0; k < std::max(times.size(), results.size()); ++k) {
+            if (k < times.size()) { items.push_back(Utf16(times[k].second)); recent.push_back(fresh(times[k].first)); }
+            if (k < results.size()) { items.push_back(Utf16(results[k].second)); recent.push_back(fresh(results[k].first)); }
+        }
+        std::cout << "[notify] " << times.size() << " new Top 10 time(s), " << results.size() << " result(s)" << std::endl;
+        std::lock_guard lock(g_notifyMutex);
+        g_notify.loading = false;
+        if (key != g_notify.key) return;   // the settings changed meanwhile: a newer load follows
+        g_notify.items = std::move(items);
+        g_notify.recent = std::move(recent);
+        g_notify.loaded = true;
+        g_notify.fetched = Clock::now();
+    }).detach();
+}
+
+// Page::draw of the MKW-SP Channel page: keeps the bar's notification cycle going (guest thread).
+void NotifyDraw(CpuContext* ctx, uint32_t page) {
+    static uint32_t s_bar = 0;
+    static enum class Step { Start, Shown, Hiding, Revealing } s_step = Step::Start;
+    static Clock::time_point s_at;
+    static size_t s_index = 0;
+    static std::u16string s_text;
+    if (!Memory::Contains(page + kPageId, 4) || Memory::Read32(page + kPageId) != kPageServicePackChannel) return;
+    if (CurrentSectionId() != kSectionChannelId || !Memory::Contains(kNotifyText, kNotifyTextChars * 2 + 2)) return;
+    const uint32_t children = Memory::Read32(page + kPageChildren);
+    if (!children || Memory::Read32(page + kPageChildCount) <= kChannelNotifyChild) return;
+    const uint32_t bar = Memory::Read32(children + 4 * kChannelNotifyChild);
+    if (!bar || !Memory::Contains(bar, 0x174)) return;
+    const auto now = Clock::now();
+
+    std::vector<std::u16string> items;
+    std::vector<bool> recent;
+    {
+        std::lock_guard lock(g_notifyMutex);
+        // Settings > Rankings (Times, Continental Region) changed: drop what was for the old ones.
+        const std::string want = WantedCategory();
+        const std::string key = want + "|" + std::to_string(RankingRegion());
+        if (key != g_notify.key) {
+            g_notify.key = key;
+            g_notify.items.clear();
+            g_notify.loaded = false;
+        }
+        if (!g_notify.loading && (!g_notify.loaded || now - g_notify.fetched > kNotifyRefresh)) {
+            g_notify.loading = true;
+            static const char* const kRegionNames[kRegionCount] = {"Amer", "Eur", "Asia", "Oce"};
+            const int region = RankingRegion();
+            NotifyLoad(want, RankingAreaByte(), region < static_cast<int>(kRegionCount) ? kRegionNames[region] : kSubregions[region - kRegionCount].shortName, key);
+        }
+        items = g_notify.items;
+        recent = g_notify.recent;
+    }
+    if (items.empty()) items.push_back(g_notify.loaded ? u"No new Top 10 times or results this week." : u"Welcome to the Mario Kart Channel!");
+    recent.resize(items.size(), false);
+
+    uint32_t saved[13];
+    for (int k = 0; k < 13; ++k) saved[k] = ctx->gpr[k];
+    const double savedF1 = ctx->fpr[1].d;
+    auto fade = [&](float alpha) {   // the text pane's alpha, 0..1
+        CallWith(ctx, func_805E8368, {bar + kControlLayout, kNotifyPanes + 0x10});   // "text"
+        const uint32_t pane = ctx->gpr[3];
+        if (pane && Memory::Contains(pane + kPaneAlpha, 1)) Memory::Write8(pane + kPaneAlpha, static_cast<uint8_t>(std::clamp(alpha, 0.0f, 1.0f) * 255.0f + 0.5f));
+    };
+    const float t = std::chrono::duration<float>(now - s_at).count() / std::chrono::duration<float>(kNotifyFade).count();
+    static bool s_recent = false;
+    auto show = [&](const std::u16string& text) {
+        // a recent one: the news chime as it comes up, and the blue dot while it is shown
+        const auto at = std::find(items.begin(), items.end(), text);
+        s_recent = at != items.end() && recent[static_cast<size_t>(at - items.begin())];
+        // only while the bar is on screen (the Esports menu hides it, the cycle goes on underneath)
+        const bool onScreen = EsFlag() == kEsClosed && Memory::Read8(bar + kControlHidden) == 0;
+        if (s_recent && onScreen) CallWith(ctx, func_80602CF8, {page, kSoundEventInfo, 0xFFFFFFFF});   // Page::PlaySound
+        s_text = text;
+        const size_t n = std::min<size_t>(text.size(), kNotifyTextChars);
+        for (size_t k = 0; k < n; ++k) Memory::Write16(kNotifyText + static_cast<uint32_t>(2 * k), static_cast<uint16_t>(text[k]));
+        Memory::Write16(kNotifyText + static_cast<uint32_t>(2 * n), 0);
+        for (uint32_t b = 0; b < kTextInfoSize; b += 4) Memory::Write32(kNotifyInfo + b, 0);
+        for (uint32_t k = 0; k < 9; ++k) Memory::Write32(kNotifyInfo + 0x78 + 4 * k, 0xFFFFFFFF);
+        Memory::Write32(kNotifyInfo + kInfoStrings, kNotifyText);
+        CallWith(ctx, func_8063DDB4, {bar, kMsgNotify, kNotifyInfo});   // LayoutUIControl::SetMessage
+    };
+    // the page (re)built: place the bar, hide GO, centre the text, the first notification. A page
+    // rebuilt at the same address (after the Rankings or a settings change) has the bar back at its
+    // layout's place, so its position is checked too.
+    const uint32_t baseY = Memory::Read32(bar + kControlBaseY);
+    float baseYf;
+    std::memcpy(&baseYf, &baseY, 4);
+    if (bar != s_bar || baseYf != kNotifyY) {
+        s_bar = bar;
+        for (uint32_t n = 0; n < std::size(kNotifyPaneNames); ++n) {
+            const std::string name = kNotifyPaneNames[n];
+            for (uint32_t k = 0; k <= name.size(); ++k) Memory::Write8(kNotifyPanes + 0x10 * n + k, k < name.size() ? static_cast<uint8_t>(name[k]) : 0);
+        }
+        auto writeFloat = [](uint32_t at, float v) { uint32_t u; std::memcpy(&u, &v, 4); Memory::Write32(at, u); };
+        writeFloat(bar + kControlBaseY, kNotifyY);
+        CallWith(ctx, func_8063D3CC, {bar});                       // UIControl::PositionFromBasePosition
+        CallWith(ctx, func_8063E54C, {bar, kNotifyPanes, 0});      // LayoutUIControl::SetPaneVisibility("capsul_null", false)
+        for (uint32_t n = 1; n < std::size(kNotifyPaneNames); ++n) {
+            CallWith(ctx, func_805E8368, {bar + kControlLayout, kNotifyPanes + 0x10 * n});   // Layout::GetPaneByName
+            const uint32_t pane = ctx->gpr[3];
+            if (!pane || !Memory::Contains(pane, 0xD8)) continue;
+            writeFloat(pane + kPaneTransX, 0.0f);
+            writeFloat(pane + kPaneWidth, kNotifyTextWidth);
+        }
+        s_index = 0;
+        show(items[0]);
+        s_step = Step::Shown;
+        s_at = now;
+    } else if (s_step == Step::Shown && now - s_at >= kNotifyShown && (items.size() > 1 || items[s_index % items.size()] != s_text)) {
+        s_step = Step::Hiding;   // fade out, then the next one
+        s_at = now;
+    } else if (s_step == Step::Hiding) {
+        fade(1.0f - t);
+        if (t >= 1.0f) {
+            s_index = (s_index + 1) % items.size();
+            show(items[s_index]);
+            fade(0.0f);
+            s_step = Step::Revealing;
+            s_at = now;
+        }
+    } else if (s_step == Step::Revealing) {
+        fade(t);
+        if (t >= 1.0f) {
+            s_step = Step::Shown;
+            s_at = now;
+        }
+    }
+    // the badge follows the text's fade, and the bar: the text pane's global position (nw4r::lyt::Pane
+    // global matrix, translation at +0x90 / +0xA0) against where it rests, learnt while the page is
+    // active and the bar still; until then (the first entrance) the badge waits for the bar to rest.
+    // A pane not laid out yet this frame (a page just (re)built, the screen still black) has an empty
+    // matrix or no alpha: no badge then.
+    float shown = s_step == Step::Hiding ? 1.0f - std::clamp(t, 0.0f, 1.0f) : s_step == Step::Revealing ? std::clamp(t, 0.0f, 1.0f) : 1.0f;
+    {
+        static bool s_haveRest = false;
+        static float s_restX = 0, s_restY = 0, s_lastX = 0, s_lastY = 0;
+        static int s_still = 0;
+        CallWith(ctx, func_805E8368, {bar + kControlLayout, kNotifyPanes + 0x10});   // "text"
+        const uint32_t pane = ctx->gpr[3];
+        auto readFloat = [](uint32_t at) { const uint32_t u = Memory::Read32(at); float f; std::memcpy(&f, &u, 4); return f; };
+        const bool laidOut = pane && Memory::Contains(pane + 0x84, 0x36) && std::fabs(readFloat(pane + 0x84)) > 1e-4f &&
+                             std::fabs(readFloat(pane + 0x98)) > 1e-4f && Memory::Read8(pane + kPaneAlpha + 1) != 0;   // +0xB9: global alpha
+        if (!laidOut) shown = 0.0f;
+        else {
+            const float x = readFloat(pane + 0x90), y = readFloat(pane + 0xA0);
+            const bool active = Memory::Read32(page + kPageState) == 4;
+            s_still = active && std::fabs(x - s_lastX) < 0.01f && std::fabs(y - s_lastY) < 0.01f ? s_still + 1 : 0;
+            s_lastX = x;
+            s_lastY = y;
+            if (s_still >= 8) {
+                s_haveRest = true;
+                s_restX = x;
+                s_restY = y;
+            }
+            const float dx = x - s_restX, dy = y - s_restY;
+            if (!s_haveRest || std::fabs(dx) > 1000.0f || std::fabs(dy) > 600.0f) shown = 0.0f;   // off screen anyway
+            g_notifyDotDx = s_haveRest ? dx : 0.0f;
+            g_notifyDotDy = s_haveRest ? dy : 0.0f;
+        }
+    }
+    g_notifyDotAlpha = s_recent ? shown : 0.0f;
+    g_notifyDotAt = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count();
+    // GO stays hidden: the button's animations show its capsule again (WiiCompiled 0.9.2 on).
+    CallWith(ctx, func_8063E54C, {bar, kNotifyPanes, 0});   // LayoutUIControl::SetPaneVisibility("capsul_null", false)
+    for (int k = 0; k < 13; ++k) ctx->gpr[k] = saved[k];
+    ctx->fpr[1].d = savedF1;
+}
