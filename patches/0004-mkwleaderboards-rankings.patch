+        const auto sit = g_esPlayerSeasons.find({EsPlayerKey(player), g_esPlayerSeason});
+        const EsPlayerSeason* matches = sit != g_esPlayerSeasons.end() ? &sit->second : nullptr;
+        if (!matches || !matches->loaded) {
