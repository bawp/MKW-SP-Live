+// The logo's texture once ready (uploaded here, on the render thread); 0 while loading / when missing.
+// `team` / `tag`: a team's, for the Toad's Factory fallback.
+ImTextureID EsLogoTexture(const std::string& url, ImVec2& size, const std::string& team = {}, const std::string& tag = {}) {
+    if (url.empty() && team.empty()) return ImTextureID{};
+    const std::string key = url + "|" + team + "|" + tag;
+    auto& logo = g_esLogos[key];
+    if (logo.state == EsLogo::State::Idle) { logo.state = EsLogo::State::Loading; EsLoadLogo(key, url, team, tag); }
+    if (logo.state == EsLogo::State::Decoded) {
+        logo.texture = aurora_imgui_add_texture(logo.width, logo.height, logo.rgba.data());
+        logo.state = logo.texture ? EsLogo::State::Ready : EsLogo::State::Failed;
+        logo.rgba.clear();
+    }
+    if (logo.state != EsLogo::State::Ready) return ImTextureID{};
+    size = ImVec2(static_cast<float>(logo.width), static_cast<float>(logo.height));
+    return logo.texture;
+}
