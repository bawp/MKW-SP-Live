+            if (selected) {
+                r.Gradient(L, y, R, y + rowH, Rgba(0x1450F0, r.alpha), Rgba(0x1E5CFF, r.alpha), Rgba(0x02137A, r.alpha), Rgba(0x011066, r.alpha));
+                r.Gradient(L, y, R, y + rowH * 0.45f, Rgba(0xFFFFFF, r.alpha * 0.30f), Rgba(0xFFFFFF, r.alpha * 0.18f), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+                const float pulse = 0.75f + 0.25f * std::sin(t * 5.0f);
+                r.Frame(L - 1.5f, y - 1.5f, R + 1.5f, y + rowH + 1.5f, Rgba(0xFF8C00, r.alpha * pulse), 4.0f, 3.0f);
+                r.Frame(L - 0.5f, y - 0.5f, R + 0.5f, y + rowH + 0.5f, Rgba(0xFFF27A, r.alpha), 2.0f, 2.0f);
+            } else {
+                r.Gradient(L, y, R, y + rowH, Rgba(0x0A2470, r.alpha * 0.82f * a), Rgba(0x061A5A, r.alpha * 0.82f * a), Rgba(0x040F3C, r.alpha * 0.86f * a), Rgba(0x06164C, r.alpha * 0.86f * a));
+                r.Gradient(L, y, R, y + rowH * 0.45f, Rgba(0xFFFFFF, r.alpha * 0.16f * a), Rgba(0xFFFFFF, r.alpha * 0.06f * a), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+                r.Rect(L, y, R, y + 1.2f, Rgba(0xFFFFFF, r.alpha * 0.45f * a));
+            }
+            r.Rect(L, y + rowH + 1.5f, R, y + rowH + 2.5f, Rgba(0x9DB4FF, r.alpha * 0.25f));
+            r.Rect(L + 2, y + 3, L + 6, y + rowH - 3, Rgba(team.color, r.alpha * a), 1.5f);
+
+            const uint32_t textColor = selected ? 0xFFF27A : 0xFFFFFF;
+            const float rankSize = compact ? 28.0f : 34.0f;
+            r.Text(L + 14, y + (rowH - rankSize) * 0.5f, rankSize, textColor, Ordinal(team.finalRank), 0.0f, a);
+
+            // Logo in a round frame, as the list's Mii icons.
+            const ImVec2 center = r.P(L + 84, y + rowH * 0.5f);
+            const float radius = (rowH * 0.5f - 2.5f) * r.u;
+            r.list->AddCircleFilled(center, radius + 2.0f * r.u, Rgba(0xFFFFFF, r.alpha * 0.85f * a));
+            r.list->AddCircleFilled(center, radius, Rgba(0x0A1030, r.alpha * a));
+            ImVec2 ls;
+            if (const ImTextureID logo = EsLogoTexture(team.logoUrl, ls, team.name, team.tag))
+                r.list->AddImageRounded(logo, ImVec2(center.x - radius, center.y - radius), ImVec2(center.x + radius, center.y + radius), ImVec2(0, 0), ImVec2(1, 1), Rgba(0xFFFFFF, r.alpha * a), radius);
+            else
+                r.list->AddCircleFilled(center, radius * 0.92f, Rgba(team.color, r.alpha * 0.85f * a));
+
+            // Name, and the tag under it.
+            const std::string tagLine = team.tag + (team.status == "dropped" ? "   Dropped" : team.status == "disqualified" ? "   Disqualified" : "");
+            // The playoffs' top three get the game's cups (gold, silver, bronze) after their name.
+            const char* cup = standings.playoffsDecided ? EsCup(team.finalRank) : nullptr;
+            if (compact) {   // name, cup and tag on one line
+                const float nameSize = 24, tagSize = 17, ny = y + (rowH - nameSize) * 0.5f;
+                const float cupWidth = cup ? r.TextWidth(nameSize, cup) + 4 : 0.0f;
+                const float tagWidth = std::min(r.TextWidth(tagSize, tagLine) + 10, nameMax * 0.4f);
+                const std::string name = Fit(r, nameSize, team.name, nameMax - cupWidth - tagWidth);
+                float nx = nameX;
+                r.Text(nx, ny, nameSize, textColor, name, 0.0f, a);
+                nx += r.TextWidth(nameSize, name) + 4;
+                if (cup) { r.Text(nx, ny, nameSize, 0xFFFFFF, cup, 0.0f, a); nx += cupWidth; }
+                r.Text(nx + 6, ny + (nameSize - tagSize) * 0.7f, tagSize, out ? 0xFF9A9A : 0xA8C0F0, Fit(r, tagSize, tagLine, tagWidth - 6), 0.0f, a);
+            } else {
+                const float cupWidth = cup ? r.TextWidth(27, cup) + 6 : 0.0f;
+                const std::string name = Fit(r, 27, team.name, nameMax - cupWidth);
+                r.Text(nameX, y - 2, 27, textColor, name, 0.0f, a);
+                if (cup) r.Text(nameX + r.TextWidth(27, name) + 6, y - 2, 27, 0xFFFFFF, cup, 0.0f, a);
+                r.Text(nameX + 1, y + rowH - 20, 18, out ? 0xFF9A9A : 0xA8C0F0, Fit(r, 18, tagLine, nameMax), 0.0f, a);
+            }
+
+            // Record and points.
+            std::vector<std::pair<std::string, uint32_t>> values{{std::to_string(team.points), 0xFFF07A},
+                                                                  {Signed(team.diff), team.diff > 0 ? 0x8CFFA8u : team.diff < 0 ? 0xFF9A9Au : 0xFFFFFFu}};
+            if (wide) { values.push_back({std::to_string(team.pointsAgainst), 0xFFFFFF}); values.push_back({std::to_string(team.pointsFor), 0xFFFFFF}); }
+            for (int v : {team.bonus, team.losses, team.ties, team.wins, team.played}) values.push_back({v < 0 ? "-" : std::to_string(v), 0xFFFFFF});
+            for (size_t i = 0; i < values.size() && i < cols.size(); ++i) {
+                const float sizeV = (i == 0 ? 32.0f : 28.0f) - (compact ? 4.0f : 0.0f);
+                r.Text(cols[i].right, y + (rowH - sizeV) * 0.5f, sizeV, selected && i > 1 ? 0xFFF27A : values[i].second, values[i].first, 1.0f, a);
+            }
+        }
+        // The playoff line: the teams above it go to the playoffs.
+        if (standings.playoffTeams > 0 && standings.playoffTeams < count) {
+            const float line = rowTop + (static_cast<float>(standings.playoffTeams) - g_esScroll) * pitch - (pitch - rowH) * 0.5f;
+            r.Rect(L - 4, line - 2.2f, R + 4, line + 2.2f, Rgba(0xFF2020, r.alpha * 0.35f), 2.0f);
+            r.Rect(L - 2, line - 1.1f, R + 2, line + 1.1f, Rgba(0xFF3A3A, r.alpha), 1.0f);
+        }
+        r.list->PopClipRect();
+        // More teams above / below
+        if (g_esScroll > 0.05f) r.Text(W * 0.5f, rowTop - 20, 22, 0xFFFFFF, "\xE2\x96\xB2", 0.5f, 0.8f);
+        if (g_esScroll < static_cast<float>(count - visible) - 0.05f) moreBelow.emplace(r, ImVec2(W * 0.5f, rowBottom - 4));
+    }
+    if (!creditBelow) c.Text(R, kEsBottom - 14, 17, 0xC8D2F0, credit, 1.0f, 0.8f);
+    c.list->PopClipRect();
+    EsDrawHints(c, W, hints, creditBelow ? credit : nullptr);
+    if (moreBelow) moreBelow->first.Text(moreBelow->second.x, moreBelow->second.y, 22, 0xFFFFFF, "\xE2\x96\xBC", 0.5f, 0.8f);
+
+    // Controls, in the bottom bar's corner, with the game's D-pad icon (Back is the page's own button).
+}
+
+
+// A team's page (A on a team): logo, name and tag, GSC career and history on the left; the season's
+// roster with Miis on the right. Same look as the standings.
+void EsDrawTeam(const ImVec2& origin, const ImVec2& size, float alpha) {
+    std::lock_guard lock(g_esMutex);
+    EsCanvas c{ImGui::GetBackgroundDrawList(), origin, size.y / 480.0f, alpha};
+    std::optional<ImVec2> moreBelow;   // "more below", drawn last over the button hints
+    const float W = size.x / c.u;
+    c.dx = (1.0f - alpha) * 24.0f;
+    const float tw = std::min(W - 48.0f, 790.0f), L = (W - tw) * 0.5f, R = L + tw;
+    const bool wide = tw >= 700.0f;
+    const auto now = Clock::now();
+    const float t = AnimSeconds();
+    const EsTeam& team = g_esTeamShown;
+    g_esPlayerCount = 0;
+    const EsTeamInfo& info = g_esTeams[team.teamId];
+    const EsSeason& season = kEsSeasons[g_esTeamSeason];
+
+    c.list->PushClipRect(c.P(-c.dx, kEsRosterTitleY - 4), c.P(W - c.dx, kEsBottom + 4), true);
+    for (float gx = L + 4; gx <= R; gx += 47.0f) c.list->AddLine(c.P(gx, kEsTop), c.P(gx, kEsBottom), Rgba(0xFFFFFF, alpha * 0.06f), c.u);
+    for (float gy = kEsTop + 30; gy <= kEsBottom; gy += 47.0f) c.list->AddLine(c.P(L - 20, gy), c.P(R + 20, gy), Rgba(0xFFFFFF, alpha * 0.06f), c.u);
+
+    auto glass = [&](float x0, float y0, float x1, float y1, float a) {
+        c.Gradient(x0, y0, x1, y1, Rgba(0x0A2470, alpha * 0.82f * a), Rgba(0x061A5A, alpha * 0.82f * a), Rgba(0x040F3C, alpha * 0.86f * a), Rgba(0x06164C, alpha * 0.86f * a));
+        c.Gradient(x0, y0, x1, y0 + std::min(24.0f, (y1 - y0) * 0.45f), Rgba(0xFFFFFF, alpha * 0.14f * a), Rgba(0xFFFFFF, alpha * 0.05f * a), Rgba(0xFFFFFF, 0), Rgba(0xFFFFFF, 0));
+        c.Rect(x0, y0, x1, y0 + 1.2f, Rgba(0xFFFFFF, alpha * 0.45f * a));
+    };
+    auto header = [&](float x0, float y, float x1) {
+        c.Gradient(x0, y, x1, y + 22, Rgba(0x000820, alpha * 0.55f), Rgba(0x000820, alpha * 0.55f), Rgba(0x00163E, alpha * 0.55f), Rgba(0x00163E, alpha * 0.55f));
+    };
+
+    // Left: the team.
+    const float lw = wide ? 260.0f : 230.0f, lx = L, lr = L + lw, cx = L + lw * 0.5f;
+    glass(lx, kEsTop + 2, lr, kEsBottom - 6, 1.0f);
+    c.Rect(lx + 2, kEsTop + 6, lx + 6, kEsBottom - 10, Rgba(team.color, alpha), 1.5f);
+    {
+        const ImVec2 center = c.P(cx, kEsTop + 42);
+        const float radius = 32.0f * c.u;
+        c.list->AddCircleFilled(center, radius + 3.0f * c.u, Rgba(0xFFFFFF, alpha * 0.9f));
+        c.list->AddCircleFilled(center, radius, Rgba(0x0A1030, alpha));
+        ImVec2 ls;
+        if (const ImTextureID logo = EsLogoTexture(team.logoUrl, ls, team.name, team.tag))
+            c.list->AddImageRounded(logo, ImVec2(center.x - radius, center.y - radius), ImVec2(center.x + radius, center.y + radius), ImVec2(0, 0), ImVec2(1, 1), Rgba(0xFFFFFF, alpha), radius);
+        else
+            c.list->AddCircleFilled(center, radius * 0.92f, Rgba(team.color, alpha * 0.85f));
+    }
+    c.Text(cx, kEsTop + 78, 30, 0xFFFFFF, Fit(c, 30, team.name, lw - 20), 0.5f);
+    c.Text(cx, kEsTop + 105, 20, 0xA8C0F0, team.tag, 0.5f);
+
+    // This team's appearances: its own entry, and other seasons' entries of the same org with its
+    // name or tag (an org's other squads, as Jx: F5 next to Jx. Kt*, are not this team).
+    // With the team's Toad's Factory seasons (as that team, or as an mkw-stats team it is).
+    std::vector<EsAppearance> appearances = info.appearances;
+    for (const auto& def : kEsSeasons) {
+        if (!def.toadsDivision) continue;
+        const EsStandings& s = g_esStandings[EsKey(def.id, kEsLeague.division)];
+        for (const auto& t : s.teams) if (t.teamId == team.teamId) appearances.push_back({def.id, kEsLeague.division, t.name, t.tag, t.status, t.entryId});
+    }
+    std::stable_sort(appearances.begin(), appearances.end(), [](const EsAppearance& x, const EsAppearance& y) { return SeasonNumber(x.season) > SeasonNumber(y.season); });
+    // Names and tags as near-equal: case, spaces, apostrophes and the degree / ordinal sign ignored
+    // ("Lovers Posture" = "Lover's Posture", "&°rz" = "&ºrz"; Jx. and Jx: stay apart).
+    auto nearly = [](const std::string& text) {
+        std::string out;
+        for (size_t k = 0; k < text.size(); ++k) {
+            const unsigned char ch = static_cast<unsigned char>(text[k]);
+            if (ch == ' ' || ch == 0x27) continue;   // space, apostrophe
+            if (ch == 0xC2 && k + 1 < text.size() && (static_cast<unsigned char>(text[k + 1]) == 0xB0 || static_cast<unsigned char>(text[k + 1]) == 0xBA)) { out += 'o'; ++k; continue; }
