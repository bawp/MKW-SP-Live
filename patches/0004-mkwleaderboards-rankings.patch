+// The board to show: the in-game setting once it is installed, else mkwleaderboards.toml's category.
+std::string WantedCategory() {
+    if (!g_timesSettingInstalled) return GetSettings().category;
+    return TimesSetting() == kTimesUnrestricted ? "unrestricted" : "nonsc";
