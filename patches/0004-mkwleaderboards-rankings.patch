+// Settings > Rankings > Sub-Region: Off (0, default) or one of kSubregions, whose players then make
+// the Continental rankings (Top 10s, champions, graphs, notifications) and whose texts read
+// "Regional" (BMGHolder::GetMsgId). Slot 53 (RoomCodeHigh, which only served the offline mkw-sp.com
+// rooms); its names live in the Kamek overlay past the fork's blob (written here at boot), its texts
+// in Menu.bmg (tools/rankings.js, rankings-ui.js).
+constexpr uint32_t kSubregionSettingSlot = 53, kMsgSubregionTitle = 0x2F2B, kMsgSubregionValues = 0x2F2C, kMsgSubregionExplanations = 0x2F3A;
+constexpr uint32_t kSubregionData = 0x819F0000;   // MEM1_KAMEK_OVERLAY (0x81800000-0x81A00000); the blob ends at 0x81965CC0
+bool g_subregionInstalled = false;
+int SubregionSetting() { return SettingValue(g_subregionInstalled, kSubregionSettingSlot, kSubregionCount + 1); }
+
+// The region the Continental rankings show: 0-3 the Continental Region, 4... a sub-region.
+constexpr int kRankingRegionCount = static_cast<int>(kRegionCount + kSubregionCount);
+int RankingRegion() {
+    const int sub = SubregionSetting();
+    return sub ? static_cast<int>(kRegionCount) + sub - 1 : ContinentalRegion();
+}
+std::string RankingRegionFile(int region) {
+    return region < static_cast<int>(kRegionCount) ? kRegionFileName[region] : std::string("sub-") + kSubregions[region - kRegionCount].file;
+}
+// Its region byte (a continent's matching area + 1, or kSubregionByte + sub-region).
+uint8_t RankingAreaByte() {
+    const int sub = SubregionSetting();
+    return sub ? static_cast<uint8_t>(kSubregionByte + sub) : ContinentalAreaByte();
+}
+
+// Settings > Rankings > Category: No Shortcut (0, default) or Unrestricted (1); slot 51 (RoomClass).
+constexpr uint32_t kTimesSettingSlot = 51, kMsgTimesTitle = 0x2F1A;
+enum : int { kTimesNoShortcut, kTimesUnrestricted };
+bool g_timesSettingInstalled = false;
+int TimesSetting() { return TwoValueSetting(g_timesSettingInstalled, kTimesSettingSlot); }
+
+// Settings > Rankings > Player Names: the site's player names (0, default) or the ghosts' own Mii
+// names (1); slot 50 (RoomCourseSelection). Players without a ghost always show the site's name.
+constexpr uint32_t kNamesSettingSlot = 50, kMsgNamesTitle = 0x2F1F;
+bool g_namesSettingInstalled = false;
+// Settings > Rankings > My Times (slot 49, RoomRaceCount's; tools/rankings.js MY_TIMES_HOOK checks it):
+// whether an mkwleaderboards.com account is linked (kept by the runtime); A on it opens the My Times
+// page. Data in the notification block.
+constexpr uint32_t kMyTimesSettingSlot = 49, kMsgMyTimesTitle = 0x2F26, kMyTimesData = 0x200 + 0x340;
+bool g_myTimesInstalled = false;
+bool GhostMiiNames() { return TwoValueSetting(g_namesSettingInstalled, kNamesSettingSlot) == 1; }
