+extern "C" void StaticRProlog_RecompModInit_8055531c(CpuContext* ctx) {
+    RecompMod::RunMemoryInitializers();
+    RecompMod::ReapplyEarlyRelPatches();
+    // MKW-SP's static constructors have built its settings table by now; settings.ini is read later.
+    kill_feed::InstallSettingEntry();
+    mkwlb::InstallRankingsSettings();
+    MKW_GUEST_FUNC(8055531C)(ctx);
+    RecompMod::RunPostRelInitializers();
+    // MKW-SP skips the strap screen, whose input check is what normally dismisses the startup
+    // screen; dismiss it once the REL is running instead.
+    if (RecompMod::EarlyMemoryInitializersRan()) {
+        settings_overlay::NotifyStrapInputAccepted();
+    }
+}
