+// A match's results table: each team's players, their score in every race, the totals.
+void EsLoadMatchDetail(int id) {
+    std::thread([id] {
+        std::string error;
+        EsMatchDetail detail;
+        if (const auto json = EsFetch("/api/matches/" + std::to_string(id), error)) {
+            detail.label = json->str("label");
+            if (const double races = json->num("races_played"); races > 0) detail.races = static_cast<int>(races);
+            const Json* teams = json->get("teams");
+            const auto* arr = teams ? std::get_if<Json::Array>(&teams->v) : nullptr;
+            if (arr && arr->size() == 2) {
+                for (size_t k = 0; k < 2; ++k) {
+                    const Json& t = (*arr)[k];
+                    auto& team = detail.teams[k];
+                    team.name = t.str("name");
+                    team.score = static_cast<int>(t.num("final_score"));
+                    team.color = HexColor(t.str("hex_color"));
+                    if (const Json* pen = t.get("penalty")) team.penalty = static_cast<int>(pen->num("points"));
+                    if (const Json* players = t.get("players"))
+                        if (const auto* list = std::get_if<Json::Array>(&players->v))
+                            for (const auto& p : *list) {
+                                EsMatchDetail::Player player;
+                                player.name = p.str("name");
+                                player.playerId = static_cast<int>(p.num("player_id"));
+                                player.friendCode = p.str("friend_code");
+                                player.total = static_cast<int>(p.num("total"));
+                                if (const Json* sc = p.get("scores"))
+                                    if (const auto* scores = std::get_if<Json::Array>(&sc->v))
+                                        for (const auto& v : *scores) player.scores.push_back(std::holds_alternative<double>(v.v) ? static_cast<int>(std::get<double>(v.v)) : -1);
+                                if (const Json* out = p.get("subbed_out"); out && std::holds_alternative<bool>(out->v)) player.subbedOut = std::get<bool>(out->v);
+                                team.players.push_back(std::move(player));
+                            }
+                    std::stable_sort(team.players.begin(), team.players.end(), [](const auto& a, const auto& b) { return a.total > b.total; });
+                }
+                // the tags, from the label ("M1 YSL vs KG")
+                const std::string label = detail.label;
+                const size_t space = label.find(' '), vs = label.find(" vs ");
+                if (space != std::string::npos && vs != std::string::npos && vs > space) {
+                    detail.teams[0].tag = label.substr(space + 1, vs - space - 1);
+                    detail.teams[1].tag = label.substr(vs + 4);
+                }
+            } else {
+                error = "unexpected match";
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& d = g_esMatchDetails[id];
+        const bool ok = error.empty();
+        if (ok) d = std::move(detail);
+        d.loading = false;
+        d.loaded = ok;
+        d.error = error;
+    }).detach();
+}
+
+// Starts loading a season / division's standings when due (the caller holds g_esMutex).
+void EsRequestStandings(const std::string& season, const std::string& division) {
+    auto& s = g_esStandings[EsKey(season, division)];
+    if (s.loading) return;
+    const auto now = Clock::now();
+    const bool stale = s.loaded && !s.toads && now - s.fetched > kEsportsTtl;   // past seasons don't change
+    const bool retry = !s.loaded && (s.error.empty() || now - s.fetched > std::chrono::seconds(10));
+    if (stale || retry) {
+        s.loading = true;
+        EsLoadStandings(season, division);
+    }
+    // and its matches (mkw-stats seasons; Toad's Factory's come with its standings)
+    const EsSeason* def = EsSeasonOf(season);
+    if (!s.scheduleLoading && (!def || !def->toadsDivision) &&
+        (!s.scheduleLoaded ? now - s.scheduleFetched > std::chrono::seconds(10) : now - s.scheduleFetched > kEsportsTtl)) {
+        s.scheduleLoading = true;
+        EsLoadSchedule(season, division);
+    }
+}
