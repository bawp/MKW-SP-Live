+// ---------------------------------------------------------------------------------------------
+// Champion archive: when a top 10 or a champion ghost is downloaded, the game stores each course's
+// World / Continental champion (time and Mii, shown on the ranking graph's champion card) in the
+// save data after the licenses: 32 courses x { 80-byte record per area }, bit 31 of the first word
+// marking a record as set. MKW-SP doesn't keep that part of the save, so the card fell back to the
+// game's default champion after every restart. The block is kept in
+// UserData/Cache/mkwleaderboards/champions.bin instead: saved whenever it changes in the Rankings,
+// and put back (the records the file has) once per boot when the MKW-SP Channel or the Rankings
+// open, before the graph reads it.
+
+namespace {
+constexpr uint32_t kSaveManagerInstance = 0x809BD748;   // SaveManager::s_instance (vanilla RKSYS)
+constexpr uint32_t kSaveManagerRksys = 0x24FFC;         // RKSYS buffer
+constexpr uint32_t kChampionsBlock = 0x23308 + 0x2330;  // after the 4 licenses: champion records
+constexpr uint32_t kChampionRecord = 80, kChampionsSize = 32 * 2 * kChampionRecord;
+constexpr uint32_t kSectionChannel = 180, kSectionRankings = 181;   // MKW-SP Channel, Rankings
+
+bool g_championsRestored = false;
+std::vector<uint8_t> g_championsSnapshot;
+int g_championRegion = kRegionDefault;   // the region (RankingRegion) whose Continental champions are in the block
+int g_championTimes = kTimesNoShortcut;  // the board (Times setting) the block's champions are from
+constexpr uint32_t kCourseRecords = 2 * kChampionRecord;   // per course: Continental (area 0), World (1)
+
+// champions.bin: the block as last seen (World champions and one region's Continental ones) plus
+// that region (u32; files without it hold Oceania's). champions-<region>.bin: each region's
+// Continental champions (the block layout, only the Continental records used).
+// Unrestricted boards keep their own files (champions-unrestricted*.bin).
+std::filesystem::path ChampionsFile(int times = kTimesNoShortcut) {
+    return GhostCacheDir().parent_path() / (times == kTimesUnrestricted ? "champions-unrestricted.bin" : "champions.bin");
+}
+
+std::filesystem::path ContinentalChampionsFile(int times, int region) {
+    return GhostCacheDir().parent_path() /
+           ("champions-" + std::string(times == kTimesUnrestricted ? "unrestricted-" : "") + RankingRegionFile(region) + ".bin");
+}
+
+void WriteFileAtomically(const std::filesystem::path& file, const std::vector<uint8_t>& data) {
+    const std::filesystem::path tmp = file.string() + ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+        out.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
+        if (!out) return;
+    }
+    std::error_code ec;
+    std::filesystem::rename(tmp, file, ec);
+    if (ec) std::cout << "[mkwlb] champion archive: could not save " << file.filename().string() << " (" << ec.message() << ")" << std::endl;
+}
+
+void SaveChampions(const uint8_t* block, int times, int region) {
+    std::vector<uint8_t> all(block, block + kChampionsSize);
+    for (int b = 0; b < 4; ++b) all.push_back(static_cast<uint8_t>(static_cast<uint32_t>(region) >> (24 - 8 * b)));
+    WriteFileAtomically(ChampionsFile(times), all);
+    std::vector<uint8_t> continental(kChampionsSize, 0);
+    for (uint32_t c = 0; c < kChampionsSize; c += kCourseRecords) std::memcpy(continental.data() + c, block + c, kChampionRecord);
+    WriteFileAtomically(ContinentalChampionsFile(times, region), continental);
+}
+
+// Puts a board's saved World champions in the block (courses it has none for: unset).
+size_t LoadWorldChampions(uint8_t* block, int times) {
+    std::vector<uint8_t> saved(kChampionsSize, 0);
+    if (std::ifstream in(ChampionsFile(times), std::ios::binary); in) in.read(reinterpret_cast<char*>(saved.data()), kChampionsSize);
+    size_t loaded = 0;
+    for (uint32_t c = kChampionRecord; c < kChampionsSize; c += kCourseRecords) {
+        if (saved[c] & 0x80) { std::memcpy(block + c, saved.data() + c, kChampionRecord); ++loaded; }
+        else std::memset(block + c, 0, kChampionRecord);
+    }
+    return loaded;
+}
+
+// Puts a board's and region's saved Continental champions in the block (courses it has none for: unset).
+size_t LoadContinentalChampions(uint8_t* block, int times, int region) {
+    std::vector<uint8_t> saved(kChampionsSize, 0);
+    if (std::ifstream in(ContinentalChampionsFile(times, region), std::ios::binary); in) in.read(reinterpret_cast<char*>(saved.data()), kChampionsSize);
+    size_t loaded = 0;
+    for (uint32_t c = 0; c < kChampionsSize; c += kCourseRecords) {
+        if (saved[c] & 0x80) { std::memcpy(block + c, saved.data() + c, kChampionRecord); ++loaded; }
+        else std::memset(block + c, 0, kChampionRecord);
+    }
+    return loaded;
+}
+
+uint8_t* ChampionsBlock() {
+    const uint32_t manager = Memory::Read32(kSaveManagerInstance);
+    if (!manager || !Memory::Contains(manager + kSaveManagerRksys, 4)) return nullptr;
+    const uint32_t rksys = Memory::Read32(manager + kSaveManagerRksys);
+    if (!rksys || !Memory::Contains(rksys + kChampionsBlock, kChampionsSize)) return nullptr;
+    return static_cast<uint8_t*>(Memory::GetPointer(rksys + kChampionsBlock, kChampionsSize));
+}
+
+void ArchiveChampions(uint32_t sectionId) {
+    if (sectionId != kSectionChannel && sectionId != kSectionRankings) return;
+    uint8_t* block = ChampionsBlock();
+    if (!block) return;
+    const int region = RankingRegion(), times = TimesSetting();
+    if (!g_championsRestored) {
+        g_championsRestored = true;
+        std::vector<uint8_t> saved(kChampionsSize + 4);
+        size_t restored = 0;
+        int savedRegion = kRegionDefault;
+        if (std::ifstream in(ChampionsFile(), std::ios::binary); in && in.read(reinterpret_cast<char*>(saved.data()), kChampionsSize)) {
+            if (in.read(reinterpret_cast<char*>(saved.data()) + kChampionsSize, 4)) {
+                const uint32_t tag = static_cast<uint32_t>(saved[kChampionsSize]) << 24 | saved[kChampionsSize + 1] << 16 | saved[kChampionsSize + 2] << 8 | saved[kChampionsSize + 3];
+                if (tag < static_cast<uint32_t>(kRankingRegionCount)) savedRegion = static_cast<int>(tag);
+            }
+            for (uint32_t r = 0; r < kChampionsSize; r += kChampionRecord) {
+                if (!(saved[r] & 0x80)) continue;   // record not set in the file
+                std::memcpy(block + r, saved.data() + r, kChampionRecord);
+                ++restored;
+            }
+        }
+        g_championRegion = savedRegion;
+        g_championTimes = kTimesNoShortcut;   // champions.bin holds the No Shortcut board
+        if (region != savedRegion || times != kTimesNoShortcut) {
+            SaveChampions(block, kTimesNoShortcut, savedRegion);
+            if (times != kTimesNoShortcut) LoadWorldChampions(block, times);
+            LoadContinentalChampions(block, times, region);
+            g_championRegion = region;
+            g_championTimes = times;
+        }
+        g_championsSnapshot.assign(block, block + kChampionsSize);
+        std::cout << "[mkwlb] champion archive: " << restored << " records restored (" << (times ? "Unrestricted" : "No Shortcut")
+                  << ", Continental: " << RankingRegionFile(region) << ")" << std::endl;
+        return;
+    }
+    if ((region != g_championRegion || times != g_championTimes) && !g_keepChampionRecords) {   // changed in the settings
+        SaveChampions(g_championsSnapshot.data(), g_championTimes, g_championRegion);
+        if (times != g_championTimes) LoadWorldChampions(block, times);
+        const size_t loaded = LoadContinentalChampions(block, times, region);
+        g_championRegion = region;
+        g_championTimes = times;
+        g_championsSnapshot.assign(block, block + kChampionsSize);
+        SaveChampions(block, times, region);
+        std::cout << "[mkwlb] champion archive: " << (times ? "Unrestricted" : "No Shortcut") << " champions, Continental: "
+                  << RankingRegionFile(region) << " (" << loaded << " courses)" << std::endl;
+        return;
+    }
+    if (sectionId != kSectionRankings || std::memcmp(block, g_championsSnapshot.data(), kChampionsSize) == 0) return;
+    if (g_keepChampionRecords) {   // page 0xAC stored a top-10 ghost as the champion: put the champions back
+        std::memcpy(block, g_championsSnapshot.data(), kChampionsSize);
+        return;
+    }
+    g_championsSnapshot.assign(block, block + kChampionsSize);
