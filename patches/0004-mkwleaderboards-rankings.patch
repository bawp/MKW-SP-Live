+namespace mkwlb {
+void InstallRankingsSettings() noexcept {
+    try {
+        const uint32_t entry = kSpSettingEntries + kRegionSettingSlot * kSpSettingEntrySize;
+        auto nameIs = [](uint32_t e, std::string_view expected) {
+            if (Memory::Read32(e + 4) != expected.size()) return false;
+            const uint32_t text = Memory::Read32(e + 8);
+            for (size_t i = 0; i < expected.size(); ++i)
+                if (Memory::Read8(text + static_cast<uint32_t>(i)) != static_cast<uint8_t>(expected[i])) return false;
+            return true;
+        };
+        // the Room settings they replace, all checked before any is changed
+        const std::pair<uint32_t, std::string_view> kReplaced[] = {
+            {kMyTimesSettingSlot, "RoomRaceCount"}, {kNamesSettingSlot, "RoomCourseSelection"}, {kTimesSettingSlot, "RoomClass"},
+            {kRegionSettingSlot, "RoomVehicles"}, {kSubregionSettingSlot, "RoomCodeHigh"},
+        };
+        bool known = Memory::Read32(kSettingsBlock + 0x1FC) == kSettingsMagic && Memory::Contains(kSubregionData, 0x400);
+        for (const auto& [slot, was] : kReplaced) known = known && nameIs(kSpSettingEntries + slot * kSpSettingEntrySize, was);
+        if (!known) {
+            std::cout << "[mkwlb] MKW-SP settings layout not recognised; no Rankings settings (Continental Region stays Oceania)" << std::endl;
+            return;
+        }
+        const uint32_t fields[13] = {
+            kRankingsCategory,
+            17, kSettingsBlock + 0x090,                 // "ContinentalRegion"
+            kMsgRegionTitle,
+            kRegionDefault,
+            kRegionCount, 0,
+            kSettingsBlock + 0x0B0,                     // value names
+            kSettingsBlock + 0x0D0,                     // value messages
+            kSettingsBlock + 0x0E0,                     // value explanations
+            0, 0, 0,                                    // no vanilla-mode override, visible
+        };
+        for (uint32_t k = 0; k < 13; ++k) Memory::Write32(entry + 4 * k, fields[k]);
+        g_regionSettingInstalled = true;
+        std::cout << "[mkwlb] Settings > Rankings > Continental Region installed (setting slot " << kRegionSettingSlot << ")" << std::endl;
+
+        // Two-value settings in Room slots; data offsets match RANKINGS_SETTINGS.extra (tools/rankings.js).
+        auto installTwoValue = [&](uint32_t slot, std::string_view name, uint32_t data, uint32_t title, const char* label, bool& installed) {
+            const uint32_t e = kSpSettingEntries + slot * kSpSettingEntrySize;
+            const uint32_t f[13] = {
+                kRankingsCategory, static_cast<uint32_t>(name.size()), kSettingsBlock + data, title,
+                0, 2, 0,                                // default: the first value; two values
+                kSettingsBlock + data + 0x10,           // value names
+                kSettingsBlock + data + 0x20,           // value messages
+                kSettingsBlock + data + 0x28,           // value explanations
+                0, 0, 0,
+            };
+            for (uint32_t k = 0; k < 13; ++k) Memory::Write32(e + 4 * k, f[k]);
+            installed = true;
+            std::cout << "[mkwlb] Settings > Rankings > " << label << " installed (setting slot " << slot << ")" << std::endl;
+        };
+        installTwoValue(kTimesSettingSlot, "TimeCategory", 0x110, kMsgTimesTitle, "Category", g_timesSettingInstalled);
+        installTwoValue(kNamesSettingSlot, "PlayerNames", 0x160, kMsgNamesTitle, "Player Names", g_namesSettingInstalled);
+        installTwoValue(kMyTimesSettingSlot, "MyTimes", kMyTimesData, kMsgMyTimesTitle, "My Times", g_myTimesInstalled);
+
+        // Sub-Region: its names written here (value names as settings.ini has them).
+        const uint32_t e = kSpSettingEntries + kSubregionSettingSlot * kSpSettingEntrySize;
+        constexpr uint32_t kName = 0x000, kValueNames = 0x020, kValueMessages = 0x0A0, kExplanations = 0x0E0, kStrings = 0x120;
+        auto writeString = [](uint32_t at, std::string_view text) {
+            for (size_t k = 0; k < text.size(); ++k) Memory::Write8(at + static_cast<uint32_t>(k), static_cast<uint8_t>(text[k]));
+            Memory::Write8(at + static_cast<uint32_t>(text.size()), 0);
+        };
+        const std::string_view name = "SubRegion";
+        writeString(kSubregionData + kName, name);
+        uint32_t str = kSubregionData + kStrings;
+        for (uint32_t k = 0; k <= kSubregionCount; ++k) {
+            std::string value = k ? kSubregions[k - 1].name : "Off";   // settings.ini: letters only
+            value.erase(std::remove_if(value.begin(), value.end(), [](char c) { return !std::isalnum(static_cast<unsigned char>(c)); }), value.end());
+            Memory::Write32(kSubregionData + kValueNames + 8 * k, static_cast<uint32_t>(value.size()));
+            Memory::Write32(kSubregionData + kValueNames + 8 * k + 4, str);
+            writeString(str, value);
+            str += static_cast<uint32_t>(value.size()) + 1;
+            Memory::Write32(kSubregionData + kValueMessages + 4 * k, kMsgSubregionValues + k);
+            Memory::Write32(kSubregionData + kExplanations + 4 * k, kMsgSubregionExplanations + k);
+        }
+        const uint32_t f[13] = {
+            kRankingsCategory, static_cast<uint32_t>(name.size()), kSubregionData + kName, kMsgSubregionTitle,
+            0, kSubregionCount + 1, 0,                  // default Off
+            kSubregionData + kValueNames, kSubregionData + kValueMessages, kSubregionData + kExplanations,
+            0, 0, 0,
+        };
+        for (uint32_t k = 0; k < 13; ++k) Memory::Write32(e + 4 * k, f[k]);
+        g_subregionInstalled = true;
+        std::cout << "[mkwlb] Settings > Rankings > Sub-Region installed (setting slot " << kSubregionSettingSlot << ")" << std::endl;
+    } catch (const Memory::AccessViolation&) {
+        std::cout << "[mkwlb] could not install the Rankings settings" << std::endl;
+    }
+}
