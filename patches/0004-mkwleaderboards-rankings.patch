+// RKSYS::LicenseMgr::GetLdbEntry(CourseId) (0x80548E30): a license's time trial record (rank r4, 0 =
+// best) of course r5, a 100-byte LdbEntry { RFLStoreData mii; u16 minutes @80; u8 seconds @82;
+// u16 ms @84; u8 valid @86; u32 character @88, vehicle @92, controller @96 }. MKW-SP doesn't keep
+// these, so the ranking graph's own card read --:--.---: the best record answers the imported PB of
+// the course when it is faster (time, Mii and combo from its ghost).
+extern "C" void func_80552D90(CpuContext* ctx);   // courseIdToGhostIndex
+namespace {
+struct MtPb { bool set = false; uint32_t timeMs = 0; std::array<uint8_t, 0x4C> mii{}; uint8_t character = 0, vehicle = 0, controller = 0; };
+std::array<MtPb, 32> g_mtPbs;
+std::string g_mtPbsCategory;                 // the board g_mtPbs are from
+std::array<uint32_t, 32> g_mtPbWritten{};   // the time last put in the license's record per course
+
+void MtLoadPbs() {
+    const std::string category = WantedCategory() == "unrestricted" ? "unrestricted" : "nonsc";
+    if (!g_mtPbsChanged.exchange(false) && category == g_mtPbsCategory) return;
+    g_mtPbsCategory = category;
+    g_mtPbs = {};
+    std::error_code ec;
+    if (std::filesystem::exists(MtPbRoot() / "PB08.RKG", ec) || std::filesystem::exists(MtPbRoot() / "PB00.RKG", ec)) {
+        // An import from before both boards were kept: its PBs are No Shortcut's.
+        std::filesystem::create_directories(MtPbDir("nonsc"), ec);
+        for (const auto& e : std::filesystem::directory_iterator(MtPbRoot(), ec))
+            if (e.is_regular_file(ec)) std::filesystem::rename(e.path(), MtPbDir("nonsc") / e.path().filename(), ec);
+    }
+    for (uint32_t course = 0; course < g_mtPbs.size(); ++course) {
+        char name[16];
+        std::snprintf(name, sizeof name, "PB%02u.RKG", course);
+        std::ifstream in(MtPbDir(category) / name, std::ios::binary);
+        const std::vector<uint8_t> d((std::istreambuf_iterator<char>(in)), {});
+        if (d.size() < 0x88 || std::memcmp(d.data(), "RKGD", 4) != 0) continue;
+        auto& pb = g_mtPbs[course];
+        const uint32_t minutes = d[4] >> 1, seconds = (d[4] & 1) << 6 | d[5] >> 2, ms = (d[5] & 3) << 8 | d[6];
+        pb.timeMs = (minutes * 60 + seconds) * 1000 + ms;
+        pb.vehicle = d[8] >> 2;
+        pb.character = static_cast<uint8_t>((d[8] & 3) << 4 | d[9] >> 4);
+        pb.controller = d[0xB] & 0x0F;
+        std::memcpy(pb.mii.data(), &d[0x3C], pb.mii.size());
+        pb.set = pb.timeMs > 0;
+    }
+}
+
+bool MtHasPb(uint32_t course) {
+    MtLoadPbs();
+    return course < g_mtPbs.size() && g_mtPbs[course].set;
+}
+
+// (worker thread: the board is the request's, not the cache's)
+std::vector<uint8_t> MtPbGhost(uint32_t course, const std::string& board) {
+    char name[16];
+    std::snprintf(name, sizeof name, "PB%02u.RKG", course);
+    std::ifstream in(MtPbDir(board == "unrestricted" ? "unrestricted" : "nonsc") / name, std::ios::binary);
+    std::vector<uint8_t> d((std::istreambuf_iterator<char>(in)), {});
+    if (d.size() < 0x88 || std::memcmp(d.data(), "RKGD", 4) != 0) d.clear();
+    return d;
+}
