+// Settings (UserData/mkwleaderboards.toml)
+
+struct Settings {
+    std::string baseUrl = "https://mkwleaderboards.com";
+    std::string category = "default";   // default | nonsc | shortcut | unrestricted
+    int cacheMinutes = 10;
+};
+
+const Settings& GetSettings() {
+    static const Settings settings = [] {
+        Settings s;
+        const auto path = RuntimeConfigFile::ApplicationDataDirectory() / "mkwleaderboards.toml";
+        std::error_code ec;
+        if (!std::filesystem::exists(path, ec)) {
+            std::ofstream out(path);
+            out << "# MKW-SP Rankings: in-game Worldwide / Regional rankings from mkwleaderboards.com\n"
+                   "\n"
+                   "# Which leaderboard of each track to show: \"default\" (the one the site opens),\n"
+                   "# \"nonsc\" (No Shortcut), \"shortcut\" or \"unrestricted\". Tracks without that category\n"
+                   "# fall back to their default.\n"
+                   "category = \"default\"\n"
+                   "\n"
+                   "# Minutes before a track's leaderboard is downloaded again.\n"
+                   "cache_minutes = 10\n";
+            return s;
+        }
+        try {
+            const auto data = toml::parse(path);
+            if (data.contains("category")) s.category = toml::find<std::string>(data, "category");
+            if (data.contains("cache_minutes")) s.cacheMinutes = static_cast<int>(toml::find<int64_t>(data, "cache_minutes"));
+            if (data.contains("base_url")) s.baseUrl = toml::find<std::string>(data, "base_url");
+        } catch (const std::exception& e) {
+            std::cout << "[mkwlb] mkwleaderboards.toml: " << e.what() << " (using defaults)" << std::endl;
+        }
+        while (!s.baseUrl.empty() && s.baseUrl.back() == '/') s.baseUrl.pop_back();
+        return s;
+    }();
+    return settings;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Leaderboard data
+
+struct Run {
+    int64_t id = 0;
+    int64_t playerId = 0;
+    uint32_t timeMs = 0;
+    std::string name;
+    std::string country;
+    std::string ghostUrl;
+    std::string ctgpId;
+};
+
+struct Board {
+    std::vector<Run> runs;
+    std::string category;
+    Clock::time_point fetched;
+};
+
+std::mutex g_dataMutex;
+std::map<std::pair<int, std::string>, int> g_categoryOfTrack;   // (site track, wanted type) -> category id
+std::map<int, std::vector<int>> g_boardsOfTrack;                 // site track -> all its category ids
+std::map<int, std::string> g_categoryName;            // category id -> name
+std::map<int, Board> g_boards;                        // category id -> runs
+
+std::optional<Json> FetchJson(const std::string& url, std::string& error) {
+    const auto res = HttpGet(url);
+    if (!res.error.empty() || res.status != 200) {
+        error = res.error.empty() ? "HTTP " + std::to_string(res.status) : res.error;
+        return std::nullopt;
+    }
+    auto json = JsonParser(res.body).parse();
+    if (!json) error = "bad JSON";
+    return json;
+}
+
+// want: "default", "nonsc", "shortcut" or "unrestricted" (Settings > Rankings > Times, else the toml).
+std::optional<int> CategoryOf(int track, const std::string& want, std::string& error) {
+    {
+        std::lock_guard lock(g_dataMutex);
+        if (const auto it = g_categoryOfTrack.find({track, want}); it != g_categoryOfTrack.end()) return it->second;
+    }
+    const auto json = FetchJson(GetSettings().baseUrl + "/api/categories?track_id=" + std::to_string(track), error);
+    if (!json) return std::nullopt;
+    const auto* list = std::get_if<Json::Array>(&json->v);
+    if (!list || list->empty()) { error = "no categories"; return std::nullopt; }
+    int chosen = -1, fallback = -1;   // fallback: the site's default category (else the first one)
+    std::lock_guard lock(g_dataMutex);
+    auto& boards = g_boardsOfTrack[track];
+    boards.clear();
+    for (const auto& c : *list) {
+        const int id = static_cast<int>(c.num("id", -1));
+        if (id < 0) continue;
+        boards.push_back(id);
+        if (fallback < 0 || c.num("is_default") != 0) fallback = id;
+        if (want != "default" && c.str("category_type") == want) chosen = id;
+        g_categoryName[id] = c.str("category_name");
+    }
+    if (chosen < 0) chosen = fallback;
+    if (chosen < 0) { error = "no categories"; return std::nullopt; }
+    g_categoryOfTrack[{track, want}] = chosen;
+    return chosen;
+}
+
+std::optional<std::vector<Run>> RunsOf(int category, std::string& error) {
+    const auto ttl = std::chrono::minutes(std::max(0, GetSettings().cacheMinutes));
+    {
+        std::lock_guard lock(g_dataMutex);
+        if (const auto it = g_boards.find(category); it != g_boards.end() && Clock::now() - it->second.fetched < ttl) return it->second.runs;
+    }
+    const auto json = FetchJson(GetSettings().baseUrl + "/api/leaderboards/" + std::to_string(category) + "?limit=100000", error);
+    if (!json) return std::nullopt;
+    const auto* list = std::get_if<Json::Array>(&json->v);
+    if (!list) { error = "unexpected leaderboard format"; return std::nullopt; }
+    std::vector<Run> runs;
+    runs.reserve(list->size());
+    for (const auto& o : *list) {
+        if (o.str("status") != "approved") continue;
+        Run r;
+        r.id = static_cast<int64_t>(o.num("id"));
+        r.playerId = static_cast<int64_t>(o.num("player_id"));
+        r.timeMs = static_cast<uint32_t>(o.num("time_ms"));
+        r.name = o.str("display_name");
+        if (r.name.empty()) r.name = o.str("player_name");
+        r.country = o.str("country");
+        r.ghostUrl = o.str("ghost_file_url");
+        r.ctgpId = o.str("ctgp_id");
+        if (r.timeMs == 0) continue;
+        runs.push_back(std::move(r));
+    }
+    std::stable_sort(runs.begin(), runs.end(), [](const Run& a, const Run& b) { return a.timeMs < b.timeMs; });
+    std::lock_guard lock(g_dataMutex);
+    g_boards[category] = Board{runs, g_categoryName[category], Clock::now()};
+    return runs;
+}
+
+// Each player's best run, in time order, optionally limited to a region (a continent's matching
+// area, or a sub-region).
+std::vector<Run> Standings(const std::vector<Run>& runs, uint8_t region, size_t limit) {
+    std::vector<Run> out;
+    std::unordered_set<int64_t> seen;
+    for (const auto& r : runs) {
+        if (!seen.insert(r.playerId).second) continue;   // a player's later runs are slower
+        if (!InRegion(r.country, region)) continue;
+        out.push_back(r);
+        if (out.size() == limit) break;
+    }
+    return out;
+}
