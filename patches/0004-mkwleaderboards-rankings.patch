+// ---------------------------------------------------------------------------------------------
+// Menu top bars: obi_top.brlyt (and the option / present variants) builds the bar from obi_base_l,
+// then the curve (obi_base_c, centred) and the right part as its children, all at 0.7 scale. The
+// left part ends 0.12-0.26 layout units short of the curve (269 wide, the curve's left edge at
+// 269.26). On the Wii that is a fraction of a pixel; stretched to 16:9 at a PC's resolution it is a
+// pixel-wide line through the bar, the background showing through. The left part is one column of
+// the bar repeated, and the curve is drawn over it, so making it 0.5 wider closes the gap unseen.
+
+namespace {
+constexpr uint32_t kPaneVtable = 0x80273438;   // nw4r::lyt::Pane
+constexpr uint32_t kPaneName = 0xBC, kPaneUserData = 0xCD, kPaneSize = 0x4C;
+
+void CopyName(uint32_t to, uint32_t from, uint32_t n) {   // strncpy
+    uint32_t k = 0;
+    for (; k < n; ++k) {
+        const uint8_t c = Memory::Read8(from + k);
+        Memory::Write8(to + k, c);
+        if (!c) break;
+    }
+    for (; k < n; ++k) Memory::Write8(to + k, 0);
+}
+} // namespace
