+void EsLoadMkc(int tournament) {
+    std::thread([tournament] {
+        std::vector<EsMkcSquad> squads;
+        std::string error;
+        const auto res = HttpGet(std::string(kMkcBase) + "/api/tournaments/" + std::to_string(tournament) + "/registrations");
+        if (!res.error.empty() || res.status != 200) {
+            error = res.error.empty() ? "HTTP " + std::to_string(res.status) : res.error;
+        } else if (const auto json = JsonParser(res.body).parse()) {
+            if (const auto* arr = std::get_if<Json::Array>(&json->v))
+                for (const auto& s : *arr) {
+                    EsMkcSquad squad{s.str("tag"), s.str("name"), {}};
+                    const Json* players = s.get("players");
+                    if (const auto* list = players ? std::get_if<Json::Array>(&players->v) : nullptr)
+                        for (const auto& p : *list) {
+                            EsMkcPlayer player{p.str("name"), {}};
+                            const Json* codes = p.get("friend_codes");
+                            if (const auto* fcs = codes ? std::get_if<Json::Array>(&codes->v) : nullptr)
+                                for (const auto& fc : *fcs) if (fc.str("type") == "mkw") player.friendCodes.push_back(fc.str("fc"));
+                            squad.players.push_back(std::move(player));
+                        }
+                    squads.push_back(std::move(squad));
+                }
+        } else {
+            error = "bad data";
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& t = g_esMkc[tournament];
+        t.loading = false;
+        t.fetched = Clock::now();
+        t.error = error;
+        if (error.empty()) {
+            t.loaded = true;
+            t.squads = std::move(squads);
+        }
+    }).detach();
+}
