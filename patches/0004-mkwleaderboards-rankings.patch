+// ---- Team pages: overview (GSC appearances, career numbers), season rosters, players' Miis -----
+
+struct EsPlayer {
+    int playerId = 0;
+    int toadsId = 0;   // Toad's Factory player (projected lineups name it where needed)
+    bool toadsRoster = false;   // from a Toad's Factory season's roster (no name lookups)
+    std::string name, role;
+    std::vector<std::string> friendCodes;
+    int matches = 0, races = 0, wins = 0, podiums = 0;
+    double pointsPerRace = 0, averagePlacement = 0;
+    int status = -1;   // the season being played: EsStatus (-1: not shown)
+};
+EsPlayer g_esPlayerShown;                 // the player whose page is shown
+bool g_esHideInactive = false;            // team pages of the season being played: Y hides Inactive players
+uint16_t g_esRawButtons = 0;
