+// ---------------------------------------------------------------------------------------------
+// My Times: Settings > Rankings > My Times opens it (tools/rankings.js MY_TIMES hook raises the flag).
+// It links the player's mkwleaderboards.com account: they log in with the in-game keyboard, the site
+// checks the password (POST /login), and the player profile whose owner (`username` of
+// /api/players/<id>) is that account is the one linked, so no one can link another player's times.
+// Only the linked profile is kept (UserData/mkwleaderboards_account.txt); the password is never kept.
+// The page and its keyboard are drawn as the Esports menu is, over the settings page, and take the
+// controller's input meanwhile (Page::CheckActions below).
+constexpr uint32_t kMyTimesFlag = kNotifyBlock + 0x3FC;
+constexpr uint16_t kEsStart = 0x0004;   // the menu's Start (+) bit
+
+struct MtAccount {
+    std::string username, playerName;
+    int64_t playerId = 0;
+};
+
+enum class MtState { Menu, Keyboard, Busy };
+enum class MtField { Username, Password, PlayerName };
+
+struct MyTimes {
+    bool open = false;
+    uint32_t section = 0;
+    Clock::time_point openedAt;
+    MtState state = MtState::Menu;
+    int cursor = 0;
+    // keyboard
+    MtField field = MtField::Username;
+    std::string text;
+    int row = 1, col = 0;
+    bool shift = false;
+    // the login in progress
+    std::string username;   // as typed, kept until the profile is found
+    bool verified = false;  // the site accepted the password for `username`
+    std::string message;
+    uint32_t messageColor = 0xFFFFFF;
+    std::string busy;       // what the busy screen says
+    uint16_t buttons = 0;
+    Clock::time_point repeatAt;
+    bool accountLoaded = false;
+    MtAccount account;
+};
+MyTimes g_mt;
+std::mutex g_mtMutex;   // the login worker's result
+struct MtResult {
+    bool done = false, ok = false, needPlayer = false, import = false;
+    std::string message;
+    MtAccount account;
+};
+MtResult g_mtResult;
+uint64_t g_mtFrame = 0, g_mtInputFrame = 0;
+
+std::filesystem::path MtAccountFile() { return RuntimeConfigFile::ApplicationDataDirectory() / "mkwleaderboards_account.txt"; }
+
+void MtLoadAccount() {
+    g_mt.accountLoaded = true;
+    std::ifstream in(MtAccountFile());
+    std::string line;
+    while (std::getline(in, line)) {
+        const auto eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+        if (key == "username") g_mt.account.username = value;
+        else if (key == "player_name") g_mt.account.playerName = value;
+        else if (key == "player_id") g_mt.account.playerId = std::atoll(value.c_str());
+    }
+    if (g_mt.account.playerId <= 0 || g_mt.account.username.empty()) g_mt.account = {};
+}
+
+void MtSaveAccount() {
+    std::error_code ec;
+    if (g_mt.account.playerId <= 0) { std::filesystem::remove(MtAccountFile(), ec); return; }
+    std::ofstream out(MtAccountFile(), std::ios::trunc);
+    out << "# The mkwleaderboards.com account linked in Settings > Rankings > My Times (no password is kept).\n"
+        << "username=" << g_mt.account.username << "\n"
+        << "player_id=" << g_mt.account.playerId << "\n"
+        << "player_name=" << g_mt.account.playerName << "\n";
+}
+
+std::string JsonQuote(const std::string& v) {
+    std::string out = "\"";
+    for (const unsigned char ch : v) {
+        if (ch == '"' || ch == '\\') { out += '\\'; out += static_cast<char>(ch); }
+        else if (ch < 0x20) { char b[8]; std::snprintf(b, sizeof b, "\\u%04x", ch); out += b; }
+        else out += static_cast<char>(ch);
+    }
+    return out + "\"";
+}
+
+std::string UrlEncode(const std::string& v) {
+    std::string out;
+    for (const unsigned char ch : v) {
+        if (std::isalnum(ch) || ch == '-' || ch == '_' || ch == '.' || ch == '~') out += static_cast<char>(ch);
+        else { char b[4]; std::snprintf(b, sizeof b, "%%%02X", ch); out += b; }
+    }
+    return out;
+}
+
+// The player profile named `name` whose owner is the account `username` (none: id 0).
+MtAccount MtFindProfile(const std::string& username, const std::string& name, std::string& error) {
+    MtAccount found;
+    const auto list = FetchJson(GetSettings().baseUrl + "/api/players?name=" + UrlEncode(name), error);
+    const auto* arr = list ? std::get_if<Json::Array>(&list->v) : nullptr;
+    if (!arr) return found;
+    int checked = 0;
+    for (const auto& p : *arr) {
+        if (++checked > 20) break;
+        const int64_t id = static_cast<int64_t>(p.num("id"));
+        if (id <= 0) continue;
+        const auto player = FetchJson(GetSettings().baseUrl + "/api/players/" + std::to_string(id), error);
+        if (!player || EsLower(player->str("username")) != EsLower(username)) continue;
+        found.playerId = id;
+        found.username = player->str("username");
+        found.playerName = player->str("display_name");
+        if (found.playerName.empty()) found.playerName = player->str("player_name");
+        break;
+    }
+    return found;
+}
+
+void MtFinish(MtResult result) {
+    std::lock_guard lock(g_mtMutex);
+    result.done = true;
+    g_mtResult = std::move(result);
+}
+
+// Worker: the site checks the password; then the account's profile (named as the account, else
+// `playerName` once asked for).
+void MtStartLogin(std::string username, std::string password) {
+    std::thread([username, password]() mutable {
+        MtResult result;
+        const auto res = HttpPostJson(GetSettings().baseUrl + "/login", "{\"username\":" + JsonQuote(username) + ",\"password\":" + JsonQuote(password) + "}");
+        std::fill(password.begin(), password.end(), '\0');
+        if (!res.error.empty()) {
+            result.message = "Couldn't reach mkwleaderboards.com.";
+        } else if (res.status < 200 || res.status >= 300) {
+            result.message = res.status == 429 ? "Too many attempts. Please try again later." : "Wrong username or password.";
+        } else {
+            result.ok = true;   // verified
+            std::string error;
+            result.account = MtFindProfile(username, username, error);
+            result.needPlayer = result.account.playerId <= 0;
+        }
+        MtFinish(std::move(result));
+    }).detach();
+}
+
+void MtStartProfileLookup(std::string username, std::string playerName) {
+    std::thread([username, playerName] {
+        MtResult result;
+        std::string error;
+        result.account = MtFindProfile(username, playerName, error);
+        result.ok = result.account.playerId > 0;
+        if (!result.ok) result.message = error.empty() ? "No player named " + playerName + " belongs to this account." : "Couldn't reach mkwleaderboards.com.";
+        result.needPlayer = !result.ok && error.empty();
+        MtFinish(std::move(result));
+    }).detach();
+}
+
+// ---- Import: the linked player's best approved run of each track (on the board Settings > Rankings
+// > Times picks), its ghost waiting in UserData/mkwleaderboards_import as PBnn.RKG (course nn) until the
+// next start, when ApplySdImports puts them on the SD card (MKW-SP reads its ghosts once, at boot).
+std::filesystem::path MtImportDir() { return RuntimeConfigFile::ApplicationDataDirectory() / "mkwleaderboards_import"; }
+// The imported PBs as they stay, one folder per board of Settings > Rankings > Times ("nonsc",
+// "unrestricted"; PBnn.RKG): the Rankings show the current board's as your time (MtPbEntry, below).
+std::filesystem::path MtPbRoot() { return RuntimeConfigFile::ApplicationDataDirectory() / "mkwleaderboards_pbs"; }
+std::filesystem::path MtPbDir(const std::string& category) { return MtPbRoot() / category; }
+std::atomic<bool> g_mtPbsChanged{true};
+constexpr const char* kMtCategories[] = {"nonsc", "unrestricted"};
+
+void MtStartImport(int64_t playerId) {
+    std::thread([playerId] {
+        MtResult result;
+        result.import = true;
+        std::string error;
+        const auto json = FetchJson(GetSettings().baseUrl + "/api/leaderboards?player_id=" + std::to_string(playerId) + "&limit=100000", error);
+        const auto* arr = json ? std::get_if<Json::Array>(&json->v) : nullptr;
+        if (!arr) {
+            result.message = "Couldn't reach mkwleaderboards.com.";
+            MtFinish(std::move(result));
+            return;
+        }
+        struct Mine { Run run; int category; };
+        std::vector<Mine> runs;
+        for (const auto& o : *arr) {
+            if (o.str("status") != "approved" || static_cast<int64_t>(o.num("player_id")) != playerId) continue;
+            Mine m;
+            m.run.id = static_cast<int64_t>(o.num("id"));
+            m.run.playerId = playerId;
+            m.run.timeMs = static_cast<uint32_t>(o.num("time_ms"));
+            m.run.name = o.str("display_name");
+            if (m.run.name.empty()) m.run.name = o.str("player_name");
+            m.run.country = o.str("country");
+            m.run.ghostUrl = o.str("ghost_file_url");
+            m.run.ctgpId = o.str("ctgp_id");
+            m.category = static_cast<int>(o.num("category_id"));
+            if (m.run.timeMs) runs.push_back(std::move(m));
+        }
+        // Both boards: No Shortcut (the SD card's PBnn.RKG) and Unrestricted (UNnn.RKG, left off the
+        // card when it is the same run).
+        std::error_code ec;
+        std::filesystem::create_directories(MtImportDir(), ec);
+        std::filesystem::remove_all(MtPbRoot(), ec);
+        int tracks = 0, ghosts = 0, missing = 0;
+        std::map<int64_t, std::optional<std::vector<uint8_t>>> downloaded;   // run id -> its ghost
+        std::array<int64_t, kCourseCount> noShortcutRun{};
+        for (const std::string want : kMtCategories) {
+            const bool unrestricted = want == "unrestricted";
+            std::filesystem::create_directories(MtPbDir(want), ec);
+            for (uint32_t course = 0; course < kCourseCount; ++course) {
+                const int track = kSiteTrack[course];
+                const auto category = CategoryOf(track, want, error);
+                if (!category) continue;
+                std::vector<int> boards{*category};
+                if (unrestricted) {
+                    std::lock_guard lock(g_dataMutex);
+                    if (const auto it = g_boardsOfTrack.find(track); it != g_boardsOfTrack.end() && !it->second.empty()) boards = it->second;
+                }
+                const Mine* best = nullptr;
+                for (const auto& m : runs)
+                    if (std::find(boards.begin(), boards.end(), m.category) != boards.end() && (!best || m.run.timeMs < best->run.timeMs)) best = &m;
+                if (!best) continue;
+                ++tracks;
+                auto it = downloaded.find(best->run.id);
+                if (it == downloaded.end()) it = downloaded.emplace(best->run.id, RunGhost(best->run, course)).first;
+                const auto& rkg = it->second;
+                if (!rkg) { ++missing; continue; }
+                char name[16];
+                std::snprintf(name, sizeof name, "PB%02u.RKG", course);
+                std::ofstream(MtPbDir(want) / name, std::ios::binary | std::ios::trunc).write(reinterpret_cast<const char*>(rkg->data()), static_cast<std::streamsize>(rkg->size()));
+                if (!unrestricted) noShortcutRun[course] = best->run.id;
+                else if (noShortcutRun[course] == best->run.id) continue;   // already on the card as PBnn
+                char sdName[16];
+                std::snprintf(sdName, sizeof sdName, unrestricted ? "UN%02u.RKG" : "PB%02u.RKG", course);
+                std::ofstream(MtImportDir() / sdName, std::ios::binary | std::ios::trunc).write(reinterpret_cast<const char*>(rkg->data()), static_cast<std::streamsize>(rkg->size()));
+                ++ghosts;
+            }
+        }
+        result.ok = ghosts > 0 || tracks > missing;
+        if (!tracks) result.message = "No approved times found on your profile.";
+        else if (tracks == missing) result.message = "Your times have no ghost files to import.";
+        else result.message = "Imported your No Shortcut and Unrestricted times (" + std::to_string(ghosts) + (ghosts == 1 ? " ghost" : " ghosts") +
+                              (missing ? ", " + std::to_string(missing) + " without a ghost file" : "") + "). Restart the game to race them.";
+        g_mtPbsChanged = true;
+        std::cout << "[mytimes] import: " << tracks << " records, " << ghosts << " ghosts, " << missing << " without a ghost" << std::endl;
+        MtFinish(std::move(result));
+    }).detach();
+}
+
+bool MyTimesActive() { return g_mt.open; }
