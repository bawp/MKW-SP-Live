+std::string EsDigits(const std::string& s);
+
+// The season being played: `players` (those who have played, or the projected lineup) are Active,
+// the rest of the team's registered squad is added as Inactive; then the overrides, Active first.
+void EsAddRegistered(std::vector<EsPlayer>& players, const EsSeason& season, const EsTeam& team) {
+    for (auto& p : players) p.status = kEsActive;
+    const auto t = g_esMkc.find(season.mkcTournament);
+    const EsMkcSquad* squad = nullptr;
+    if (t != g_esMkc.end() && t->second.loaded) {
+        for (const auto& sq : t->second.squads) if (sq.tag == team.tag) squad = &sq;
+        if (!squad)
+            for (const auto& sq : t->second.squads) if (EsNameKey(sq.tag) == EsNameKey(team.tag)) squad = &sq;
+    }
+    if (squad) {
+        for (const auto& member : squad->players) {
+            std::string key = EsNameKey(member.name);
+            for (const auto& a : kEsMkcAliases)
+                if (season.id == std::string(a.season) && EsNameKey(team.tag) == EsNameKey(a.tag) && key == EsNameKey(a.registered)) key = EsNameKey(a.name);
+            const auto found = std::find_if(players.begin(), players.end(), [&](const EsPlayer& p) {
+                if (EsNameKey(p.name) == key) return true;
+                for (const auto& a : p.friendCodes)
+                    for (const auto& b : member.friendCodes) if (!EsDigits(a).empty() && EsDigits(a) == EsDigits(b)) return true;
+                return false;
+            });
+            if (found != players.end()) {
+                if (found->friendCodes.empty()) found->friendCodes = member.friendCodes;   // for its Mii
+                continue;
+            }
+            EsPlayer player;
+            player.name = member.name;
+            for (const auto& a : kEsMkcAliases)
+                if (season.id == std::string(a.season) && EsNameKey(team.tag) == EsNameKey(a.tag) && EsNameKey(member.name) == EsNameKey(a.registered)) player.name = a.name;
+            player.friendCodes = member.friendCodes;
+            player.races = -1;
+            player.pointsPerRace = -1;
+            player.status = kEsInactive;
+            players.push_back(std::move(player));
+        }
+    }
+    for (auto& p : players)
+        for (const auto& o : kEsStatusOverrides)
+            if (o.season && season.id == std::string(o.season) && EsNameKey(team.tag) == EsNameKey(o.tag) && EsNameKey(p.name) == EsNameKey(o.player)) p.status = o.status;
+    std::stable_sort(players.begin(), players.end(), [](const EsPlayer& a, const EsPlayer& b) { return a.status < b.status; });
+}
+
+std::string EsDigits(const std::string& s) {
+    std::string out;
+    for (char ch : s) if (ch >= '0' && ch <= '9') out += ch;
+    return out;
+}
+
+// Toad's Factory's players by name (loaded once on a Mii worker; the others wait for it).
+std::shared_ptr<const EsToadsIndex> EsToadsPlayers() {
+    static std::mutex mutex;
+    static std::shared_ptr<const EsToadsIndex> index;
+    static Clock::time_point failedAt;
+    std::lock_guard lock(mutex);
+    if (index) return index;
+    if (failedAt != Clock::time_point{} && Clock::now() - failedAt < std::chrono::seconds(30)) return nullptr;
+    const auto cached = EsCacheDir() / "toads_players.json";
+    std::error_code ec;
+    std::string body;
+    if (std::filesystem::exists(cached, ec)) {
+        const auto age = std::filesystem::file_time_type::clock::now() - std::filesystem::last_write_time(cached, ec);
+        if (!ec && age < std::chrono::hours(24)) {
+            const auto bytes = EsReadFile(cached);
+            body.assign(bytes.begin(), bytes.end());
+        }
+    }
+    if (body.empty()) {
+        const auto res = HttpGet(std::string(kToadsBase) + "/api/player");
+        if (res.error.empty() && res.status == 200) {
+            body = res.body;
+            std::ofstream(cached, std::ios::binary).write(body.data(), static_cast<std::streamsize>(body.size()));
+        } else {
+            const auto bytes = EsReadFile(cached);   // an old list beats none
+            body.assign(bytes.begin(), bytes.end());
+        }
+    }
+    const auto json = JsonParser(body).parse();
+    const Json* list = json ? json->get("players") : nullptr;
+    const auto* arr = list ? std::get_if<Json::Array>(&list->v) : nullptr;
+    if (!arr) {
+        failedAt = Clock::now();
+        std::cout << "[esports] Toad's Factory player list unavailable" << std::endl;
+        return nullptr;
+    }
+    auto built = std::make_shared<EsToadsIndex>();
+    for (const auto& p : *arr) {
+        const EsToadsPlayer player{static_cast<int>(p.num("player_id")), static_cast<int>(p.num("status", 9)), p.str("mii"), static_cast<int>(p.num("country_id")),
+                                   p.str("country_code")};
+        built->byName[EsLower(p.str("name"))].push_back(player);
+        built->byId[player.id] = player;
+    }
+    std::cout << "[esports] Toad's Factory: " << arr->size() << " players" << std::endl;
+    index = built;
+    return index;
+}
+
+// A Toad's Factory list kept for a day in the cache (an older copy when the site can't be reached).
+std::string EsToadsJson(const std::string& path, const std::string& file) {
+    const auto cached = EsCacheDir() / file;
+    std::error_code ec;
+    if (std::filesystem::exists(cached, ec)) {
+        const auto age = std::filesystem::file_time_type::clock::now() - std::filesystem::last_write_time(cached, ec);
+        if (!ec && age < std::chrono::hours(24)) {
+            const auto bytes = EsReadFile(cached);
+            if (!bytes.empty()) return std::string(bytes.begin(), bytes.end());
+        }
+    }
+    const auto res = HttpGet(std::string(kToadsBase) + path);
+    if (res.error.empty() && res.status == 200) {
+        std::ofstream(cached, std::ios::binary).write(res.body.data(), static_cast<std::streamsize>(res.body.size()));
+        return res.body;
+    }
+    const auto bytes = EsReadFile(cached);
+    return std::string(bytes.begin(), bytes.end());
+}
+
+std::string EsLoose(const std::string& s) {   // lower-case letters and digits only ("Lover's" = "Lovers")
+    std::string out;
+    for (unsigned char ch : s) if (std::isalnum(ch)) out += static_cast<char>(std::tolower(ch));
+    return out;
+}
+
+// Toad's Factory's teams ("clans"): the one an mkw-stats team is, by name (letters and digits), the
+// tag deciding between teams of the same name. Its members (with Miis) and logo.
+struct EsToadsClan {
+    int id = 0;
+    std::string logo;                                  // file under /resources/clans/
+    std::unordered_map<std::string, std::vector<EsToadsPlayer>> members;   // lower-case name -> players
+};
+
+std::shared_ptr<const EsToadsClan> EsToadsClanOf(const std::string& team, const std::string& tag) {
+    static std::mutex mutex;
+    static std::optional<Json> clans;
+    static std::map<int, std::shared_ptr<const EsToadsClan>> details;
+    std::lock_guard lock(mutex);
+    if (!clans) {
+        auto json = JsonParser(EsToadsJson("/api/clan?p=0&ps=5000&filters=%7B%7D", "toads_clans.json")).parse();
+        if (!json || !json->get("clans")) return nullptr;
+        clans = std::move(json);
+    }
+    const auto* list = std::get_if<Json::Array>(&clans->get("clans")->v);
+    if (!list) return nullptr;
+    int id = 0, byName = 0;
+    for (const auto& c : *list) {
+        if (EsLoose(c.str("name")) != EsLoose(team)) continue;
+        if (!byName) byName = static_cast<int>(c.num("clan_id"));
+        if (!id && EsLoose(c.str("tag")) == EsLoose(tag)) id = static_cast<int>(c.num("clan_id"));
+    }
+    if (!id) id = byName;
+    if (!id) return nullptr;
+    if (const auto it = details.find(id); it != details.end()) return it->second;
+    const auto json = JsonParser(EsToadsJson("/api/clan/" + std::to_string(id), "toads_clan_" + std::to_string(id) + ".json")).parse();
+    if (!json) return nullptr;
+    auto clan = std::make_shared<EsToadsClan>();
+    clan->id = id;
+    clan->logo = json->str("logo");
+    auto addMembers = [&](const Json& holder) {
+        const Json* members = holder.get("members");
+        if (const auto* arr = members ? std::get_if<Json::Array>(&members->v) : nullptr)
+            for (const auto& m : *arr) {
+                auto& same = clan->members[EsLower(m.str("name"))];
+                const int pid = static_cast<int>(m.num("player_id"));
+                if (std::none_of(same.begin(), same.end(), [&](const EsToadsPlayer& p) { return p.id == pid; })) same.push_back({pid, 0, m.str("mii"), 0});
+            }
+    };
+    addMembers(*json);
+    if (const Json* subs = json->get("sub_clans"))
+        if (const auto* arr = std::get_if<Json::Array>(&subs->v))
+            for (const auto& sub : *arr) addMembers(sub);
+    details[id] = clan;
+    return clan;
+}
+
+std::string EsToadsClanLogo(const std::string& team, const std::string& tag) {
+    const auto clan = EsToadsClanOf(team, tag);
+    if (!clan || clan->logo.empty()) return {};
+    return std::string(kToadsBase) + "/resources/clans/" + clan->logo;
+}
+
+// The Toad's Factory player behind a roster's player (its Mii file and country), when there's one to
+// be sure of.
+std::optional<EsToadsPlayer> EsToadsPlayerOf(int playerId, int toadsId, const std::string& name, const std::vector<std::string>& friendCodes,
+                                             const std::string& team, const std::string& tag) {
+    const auto index = EsToadsPlayers();
+    if (!index) return std::nullopt;
+    for (const auto& [ours, theirs] : kEsToadsPlayers) if (playerId && ours == playerId) toadsId = theirs;
+    if (!toadsId && playerId) toadsId = EsToadsIdOfStats(playerId);
+    if (!toadsId)
+        for (const auto& link : kEsToadsNameLinks)
+            if (EsNameKey(name) == EsNameKey(link.name) && (tag.empty() || EsNameKey(tag) == EsNameKey(link.tag))) toadsId = link.toadsId;
+    if (toadsId) {
+        const auto it = index->byId.find(toadsId);
+        return it != index->byId.end() ? std::optional<EsToadsPlayer>(it->second) : std::nullopt;
+    }
+    // A member of the team on Toad's Factory with that name (common names such as "Luke" are
+    // only certain there).
+    if (const auto clan = team.empty() ? nullptr : EsToadsClanOf(team, tag)) {
+        if (const auto it = clan->members.find(EsLower(name)); it != clan->members.end() && it->second.size() == 1 && !it->second.front().mii.empty()) {
+            EsToadsPlayer member = it->second.front();
+            if (const auto full = index->byId.find(member.id); full != index->byId.end()) {
+                member.country = full->second.country;
+                member.iso = full->second.iso;
+            }
+            return member;
+        }
+    }
+    std::vector<EsToadsPlayer> candidates;
+    auto add = [&](std::string part) {
+        while (!part.empty() && part.front() == ' ') part.erase(part.begin());
+        while (!part.empty() && part.back() == ' ') part.pop_back();
+        if (const auto it = index->byName.find(EsLower(part)); !part.empty() && it != index->byName.end())
+            for (const auto& p : it->second)
+                if (std::none_of(candidates.begin(), candidates.end(), [&](const EsToadsPlayer& c) { return c.id == p.id; })) candidates.push_back(p);
+    };
+    add(name);
+    if (name.find('/') != std::string::npos) {   // "A / B": each name
+        for (size_t at = 0; at <= name.size();) {
+            size_t slash = name.find('/', at);
+            if (slash == std::string::npos) slash = name.size();
+            add(name.substr(at, slash - at));
+            at = slash + 1;
+        }
+    }
+    if (candidates.empty()) return std::nullopt;
+    if (candidates.size() > 1) {   // the same name: the one with the player's friend code
+        std::unordered_set<std::string> codes;
+        for (const auto& fc : friendCodes) codes.insert(EsDigits(fc));
+        std::vector<EsToadsPlayer> leaguePlayers;
+        for (const auto& c : candidates) {
+            const auto res = HttpGet(std::string(kToadsBase) + "/api/player/" + std::to_string(c.id));
+            if (!res.error.empty() || res.status != 200) continue;
+            const auto json = JsonParser(res.body).parse();
+            if (!json) continue;
+            if (const Json* fcs = json->get("fcs"))
+                if (const auto* arr = std::get_if<Json::Array>(&fcs->v))
+                    for (const auto& fc : *arr)
+                        if (codes.count(EsDigits(fc.str("fc")))) return c;
+            if (const Json* league = json->get("played_in_league"))
+                if (const auto* b = std::get_if<bool>(&league->v); b && *b) leaguePlayers.push_back(c);
+        }
+        if (leaguePlayers.empty()) return std::nullopt;
+        std::sort(leaguePlayers.begin(), leaguePlayers.end(), [](const EsToadsPlayer& a, const EsToadsPlayer& b) { return a.status < b.status; });
+        if (leaguePlayers.size() > 1 && leaguePlayers[0].status == leaguePlayers[1].status) return std::nullopt;   // can't tell
+        return leaguePlayers.front();
+    }
+    return candidates.front();
+}
+
+void EsLoadMii(const std::string& key, int playerId, int toadsId, std::string name, std::vector<std::string> friendCodes, std::string team, std::string tag) {
+    std::thread([key, playerId, toadsId, name, friendCodes, team, tag] {
+        const auto dir = EsCacheDir() / "miis";
+        std::error_code ec;
+        std::filesystem::create_directories(dir, ec);
+        std::vector<uint8_t> png;
+        const auto toads = EsToadsPlayerOf(playerId, toadsId, name, friendCodes, team, tag);
+        const std::string file = toads ? toads->mii : std::string{};
+        const int country = toads ? toads->country : 0, toadsProfile = toads ? toads->id : 0;
+        const std::string iso = toads ? toads->iso : std::string{};
+        bool safe = !file.empty();
+        for (char ch : file) safe = safe && (std::isalnum(static_cast<unsigned char>(ch)) || ch == '-' || ch == '.' || ch == '_');
+        if (safe) {
+            const auto cached = dir / ("tf_" + file);
+            png = EsReadFile(cached);
+            if (png.empty()) {
+                const auto res = HttpGet(std::string(kToadsBase) + "/resources/mii/" + file);
+                if (res.error.empty() && res.status == 200 && res.body.size() > 8) {
+                    png.assign(res.body.begin(), res.body.end());
+                    std::ofstream(cached, std::ios::binary).write(res.body.data(), static_cast<std::streamsize>(res.body.size()));
+                }
+            }
+        }
+        std::vector<uint8_t> rgba;
+        uint32_t w = 0, h = 0;
+        const bool ok = !png.empty() && EsDecodeImage(png, rgba, w, h, 128);
+        std::lock_guard lock(g_esMutex);
+        auto& mii = g_esMiis[key];
+        mii.country = country;
+        mii.toadsId = toadsProfile;
+        mii.file = file;
+        mii.iso = iso;
+        if (ok) { mii.rgba = std::move(rgba); mii.width = w; mii.height = h; mii.state = EsMii::State::Decoded; }
+        else mii.state = EsMii::State::Missing;
+    }).detach();
+}
+
+// The player's Mii texture once ready (render thread, under the lock); 0 while loading / when missing.
+std::string EsMiiKey(const EsPlayer& player, const EsTeam& team) {
+    std::string key = team.name + "|" + player.name;
+    for (const auto& fc : player.friendCodes) key += "|" + fc;
+    return key;
+}
+
+// The Toad's Factory profile the player's Mii lookup settled on (0: none, or not done yet).
+int EsPlayerToadsProfile(const EsPlayer& player, const EsTeam& team) {
+    const auto it = g_esMiis.find(EsMiiKey(player, team));
+    return it != g_esMiis.end() ? it->second.toadsId : 0;
+}
+
+// The player's country (Wii country code) once their Mii's lookup is done; 0 when unknown.
+int EsPlayerCountry(const EsPlayer& player, const EsTeam& team) {
+    const auto it = g_esMiis.find(EsMiiKey(player, team));
+    return it != g_esMiis.end() ? it->second.country : 0;
+}
+
+ImTextureID EsMiiTexture(const EsPlayer& player, const EsTeam& team) {
+    const std::string key = EsMiiKey(player, team);
+    auto& mii = g_esMiis[key];
+    if (mii.state == EsMii::State::Idle) {
+        mii.state = EsMii::State::Loading;
+        EsLoadMii(key, player.playerId, player.toadsId, player.name, player.friendCodes, team.name, team.tag);
+    }
+    if (mii.state == EsMii::State::Decoded) {
+        mii.texture = aurora_imgui_add_texture(mii.width, mii.height, mii.rgba.data());
+        mii.state = mii.texture ? EsMii::State::Ready : EsMii::State::Missing;
+        mii.rgba.clear();
+    }
+    return mii.state == EsMii::State::Ready ? mii.texture : ImTextureID{};
+}
