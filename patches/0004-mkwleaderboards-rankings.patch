+std::mutex g_jobMutex;
+std::shared_ptr<Job> g_job;
+
+const char* CourseLabel(uint32_t course) {
+    static const char* names[kCourseCount] = {
+        "Mario Circuit", "Moo Moo Meadows", "Mushroom Gorge", "Grumble Volcano", "Toad's Factory", "Coconut Mall", "DK Summit", "Wario's Gold Mine",
+        "Luigi Circuit", "Daisy Circuit", "Moonview Highway", "Maple Treeway", "Bowser's Castle", "Rainbow Road", "Dry Dry Ruins", "Koopa Cape",
+        "GCN Peach Beach", "GCN Mario Circuit", "GCN Waluigi Stadium", "GCN DK Mountain", "DS Yoshi Falls", "DS Desert Hills", "DS Peach Gardens", "DS Delfino Square",
+        "SNES Mario Circuit 3", "SNES Ghost Valley 2", "N64 Mario Raceway", "N64 Sherbet Land", "N64 Bowser's Castle", "N64 DK's Jungle Parkway", "GBA Bowser Castle 3", "GBA Shy Guy Beach",
+    };
+    return course < kCourseCount ? names[course] : "competition";
+}
+
+// The site keeps each run on one board (No Shortcut, Alternate / shortcut, Unrestricted for the rest),
+// so Unrestricted rankings are every board of the track together; other choices are one board.
+std::optional<std::vector<Run>> LoadStandings(const Job& job, size_t limit, std::string& error) {
+    const int track = kSiteTrack[job.course];
+    const auto category = CategoryOf(track, job.category, error);
+    if (!category) return std::nullopt;
+    std::vector<int> boards{*category};
+    if (job.category == "unrestricted") {
+        std::lock_guard lock(g_dataMutex);
+        if (const auto it = g_boardsOfTrack.find(track); it != g_boardsOfTrack.end() && !it->second.empty()) boards = it->second;
+    }
+    std::vector<Run> all;
+    for (const int board : boards) {
+        const auto runs = RunsOf(board, error);
+        if (!runs) return std::nullopt;
+        all.insert(all.end(), runs->begin(), runs->end());
+    }
+    if (boards.size() > 1) std::stable_sort(all.begin(), all.end(), [](const Run& a, const Run& b) { return a.timeMs < b.timeMs; });
+    return Standings(all, job.region, limit);
+}
+
+void RunTopTen(Job& job) {
+    std::string error;
+    const auto top = LoadStandings(job, kTopTenMax, error);
+    if (!top) {
+        std::cout << "[mkwlb] top 10 " << CourseLabel(job.course) << ": " << error << std::endl;
+        job.error = kErrNetwork;
+        return;
+    }
+    // Ghosts (for the Miis) in parallel.
+    std::vector<std::future<std::optional<std::vector<uint8_t>>>> ghosts;
+    for (const auto& r : *top) ghosts.push_back(std::async(std::launch::async, [&r, course = job.course] { return RunGhost(r, course); }));
+    size_t withGhost = 0;
+    for (size_t k = 0; k < top->size(); ++k) {
+        const Run& r = (*top)[k];
+        TopEntry e;
+        e.timeMs = r.timeMs;
+        const auto ghost = ghosts[k].get();
+        if (ghost) {
+            e.mii = MiiOf(*ghost);
+            if (!job.ghostMiiNames) SetMiiName(e.mii, r.name);
+            e.controller = (*ghost)[0x0B] & 0x0F;
+            ++withGhost;
+        }
+        else e.mii = DefaultMii(r.playerId, r.name);
+        e.country = WiiCountry(r.country);
+        if (e.country == 0 && ghost) e.country = (*ghost)[0x34];
+        e.region = RegionOfCountry(e.country);
+        job.entries.push_back(e);
+    }
+    std::cout << "[mkwlb] top 10 " << CourseLabel(job.course) << " (" << RegionName(job.region) << "): " << job.entries.size()
+              << " players, " << withGhost << " Miis from ghosts";
+    if (!job.entries.empty()) {
+        const auto& r = top->front();
+        std::cout << "; #1 " << r.name << " " << r.timeMs / 60000 << ":" << (r.timeMs / 1000) % 60 << "." << r.timeMs % 1000;
+    }
+    std::cout << std::endl;
+}
+
+void RunGhostJob(Job& job) {
+    std::string error;
+    // The champion, or the fastest run of the board that has a ghost file.
+    const auto standings = LoadStandings(job, SIZE_MAX, error);
+    if (!standings) {
+        std::cout << "[mkwlb] champion ghost " << CourseLabel(job.course) << ": " << error << std::endl;
+        job.error = kErrNetwork;
+        return;
+    }
+    // When the champion's run has no downloadable ghost, the next fastest player of the top 10 who has one.
+    // A top-10 ghost (job.rank > 0) is that player's run only.
+    const Run* champion = nullptr;
+    std::optional<std::vector<uint8_t>> ghost;
+    const size_t first = job.rank, last = job.rank ? job.rank + 1 : kTopTenMax;
+    for (size_t k = first; k < std::min(standings->size(), last) && !ghost; ++k) {
+        champion = &(*standings)[k];
+        ghost = RunGhost(*champion, job.course);
+        if (!ghost) std::cout << "[mkwlb] champion ghost " << CourseLabel(job.course) << ": " << champion->name << " has no downloadable ghost" << std::endl;
+    }
+    if (!ghost) {
+        job.error = kErrNoGhost;
+        return;
+    }
+    auto mii = MiiOf(*ghost);
+    if (!job.ghostMiiNames) SetMiiName(mii, champion->name);
+    std::memcpy(ghost->data() + 0x3C, mii.data(), kMiiSize);
+    RefreshRkgCrc(*ghost);
+    job.ghost = std::move(*ghost);
+    std::cout << "[mkwlb] " << (job.rank ? "top-10 ghost #" + std::to_string(job.rank + 1) : std::string("champion ghost")) << " "
+              << CourseLabel(job.course) << " (" << RegionName(job.region) << "): " << champion->name << ", " << job.ghost.size() << " bytes" << std::endl;
+}
+
+std::string WantedCategory();   // Settings > Rankings > Times (below)
+bool GhostMiiNames();           // Settings > Rankings > Player Names (below)
+
+void Start(uint32_t client, uint32_t kind, uint32_t course, uint8_t region, size_t rank = 0, bool own = false) {
+    auto job = std::make_shared<Job>();
+    job->rank = rank;
+    job->own = own;
+    job->category = WantedCategory();
+    job->ghostMiiNames = GhostMiiNames();
+    job->client = client;
+    job->kind = kind;
+    job->course = course;
+    job->region = region;
+    {
+        std::lock_guard lock(g_jobMutex);
+        g_job = job;
+    }
+    std::thread([job] {
+        try {
+            if (job->course >= kCourseCount) job->error = kErrUnsupported;
+            else if (job->kind == kKindTopTen) RunTopTen(*job);
+            else if (job->own) {
+                job->ghost = MtPbGhost(job->course, job->category);
+                if (job->ghost.empty()) job->error = kErrBadData;
+            } else RunGhostJob(*job);
+        } catch (const std::exception& e) {
+            std::cout << "[mkwlb] request failed: " << e.what() << std::endl;
+            job->error = kErrBadData;
+        }
+        job->done.store(true, std::memory_order_release);
+    }).detach();
+}
+
+// Leaves the champion ghost in the fork's slot and sets up a one-ghost time trial: player 1 keeps the
+// character and vehicle last chosen (the champion's when none is set, as when the Rankings are the
+// first thing played), MKW-SP's setupTimeAttack() makes player 2 the ghost, the rest are cleared.
+void PrepareChampionRace(const std::vector<uint8_t>& rkg) {
+    const auto raw = DecompressRkg(rkg);
+    if (!raw || !Memory::Contains(kChampionSlot, 0x20 + kGhostBufferSize)) {
+        std::cout << "[mkwlb] champion ghost could not be prepared for racing" << std::endl;
+        return;
+    }
+    Memory::Write32(kChampionSlot, static_cast<uint32_t>(raw->size()));
+    for (size_t b = 0; b < kGhostBufferSize; ++b) Memory::Write8(kChampionRkg + static_cast<uint32_t>(b), b < raw->size() ? (*raw)[b] : 0);
+    const uint32_t scenario = Memory::Read32(kRaceConfig) + kMenuScenario;
+
+    const uint32_t context = Memory::Read32(Memory::Read32(kSectionManager) + kGlobalContext);
+    Memory::Write32(context + kContextGhostCount, 1);
+    Memory::Write32(context + kContextGhostIndex0, kChampionGhostMark);
+    const uint32_t players = scenario + kScenarioPlayers;
+    const uint32_t character = Memory::Read32(players + kPlayerCharacter), vehicle = Memory::Read32(players + kPlayerVehicle);
+    if (Memory::Read32(players + kPlayerType) != kPlayerLocal || character >= 0x30 || vehicle >= 0x24) {
+        Memory::Write32(players + kPlayerType, kPlayerLocal);
+        Memory::Write32(players + kPlayerVehicle, raw->at(0x08) >> 2);
+        Memory::Write32(players + kPlayerCharacter, ((raw->at(0x08) & 3) << 4) | (raw->at(0x09) >> 4));
+    }
+    for (uint32_t k = 1; k < 12; ++k) Memory::Write32(players + k * kPlayerSize + kPlayerType, kPlayerNone);
+}
+
+void Finish(uint32_t client, uint32_t result, int32_t error) {
+    Memory::Write32(client + kClientError, static_cast<uint32_t>(error));
+    Memory::Write32(client + kClientResult, result);
+    Memory::Write32(client + kClientState, kStateReady);
+}
