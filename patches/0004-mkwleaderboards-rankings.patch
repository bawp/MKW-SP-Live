+std::string EsToadsClanLogo(const std::string& team, const std::string& tag);   // below (Toad's Factory)
+
+// An image, from the logo cache or downloaded into it (a path on mkw-stats, or a full URL).
+std::vector<uint8_t> EsCachedImage(const std::string& url) {
+    std::string name;
+    for (char c : url) name += std::isalnum(static_cast<unsigned char>(c)) ? c : '_';
+    const auto cached = EsCacheDir() / "logos" / name;
+    std::vector<uint8_t> bytes;
+    if (std::ifstream in(cached, std::ios::binary); in) bytes.assign(std::istreambuf_iterator<char>(in), {});
+    if (bytes.empty()) {
+        const auto res = HttpGet(url.rfind("http", 0) == 0 ? url : std::string(kStatsBase) + url);
+        if (res.error.empty() && res.status == 200) {
+            bytes.assign(res.body.begin(), res.body.end());
+            std::ofstream(cached, std::ios::binary).write(res.body.data(), static_cast<std::streamsize>(res.body.size()));
+        }
+    }
+    return bytes;
+}
+
+// A logo: mkw-stats' (skipped when it is its placeholder), else, for a team, the team's logo on
+// Toad's Factory (its clan, by name and tag).
+void EsLoadLogo(const std::string& key, const std::string& url, const std::string& team, const std::string& tag) {
+    std::thread([key, url, team, tag] {
+        std::vector<uint8_t> rgba;
+        uint32_t w = 0, h = 0;
+        bool ok = false;
+        if (!url.empty() && url.find("placeholder") == std::string::npos) {
+            const auto bytes = EsCachedImage(url);
+            ok = !bytes.empty() && EsDecodeImage(bytes, rgba, w, h);
+        }
+        if (!ok && !team.empty()) {
+            if (const std::string fallback = EsToadsClanLogo(team, tag); !fallback.empty()) {
+                const auto bytes = EsCachedImage(fallback);
+                ok = !bytes.empty() && EsDecodeImage(bytes, rgba, w, h);
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& logo = g_esLogos[key];
+        if (ok) { logo.rgba = std::move(rgba); logo.width = w; logo.height = h; logo.state = EsLogo::State::Decoded; }
+        else logo.state = EsLogo::State::Failed;
+    }).detach();
+}
