+// ---- Player pages (A on a roster row): /api/players/<id>/overview --------------------------------
+
+struct EsPlayerTeam {   // a season the player played for a team
+    std::string season, division, teamName, teamTag;
+    int teamId = 0;
+    int entryId = 0;          // Toad's Factory seasons: the team's entry
+    double gpAverage = -1;    // Toad's Factory seasons: the player's GP average
+};
+
+struct EsPlayerMatch {
+    std::string season, label, result, opponentTag, opponentName;
+    int number = 0, playerScore = 0, teamScore = 0, opponentScore = 0;
+};
+
+struct EsPlayerInfo {
+    bool loading = false, loaded = false;
+    std::string error;
+    Clock::time_point fetched;
+    std::string name, role, friendCode;
+    std::vector<EsPlayerTeam> teams;   // newest season first
+    int matches = 0, races = 0, raceWins = 0, podiums = 0, bestGp = 0, bestMatch = 0;
+    int wins = 0, losses = 0, ties = 0;
+    double pointsPerRace = 0, averagePlacement = 0, podiumRate = 0;
+    std::vector<EsPlayerMatch> recent;
+};
+
+std::map<int, EsPlayerInfo> g_esPlayerInfo;   // mkw-stats player id -> overview
+
+void EsLoadPlayer(int id) {
+    std::thread([id] {
+        std::string error;
+        EsPlayerInfo info;
+        if (const auto json = EsFetch("/api/players/" + std::to_string(id) + "/overview?league=" + kEsLeague.id + "&match_set=all", error)) {
+            info.role = json->str("role");
+            if (const Json* identity = json->get("identity")) {
+                info.name = identity->str("name");
+                info.friendCode = identity->str("primary_friend_code");
+                if (const Json* list = identity->get("appearances"))
+                    if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                        for (const auto& a : *arr)
+                            info.teams.push_back({a.str("season"), a.str("division"), a.str("team_name"), a.str("team_tag"), static_cast<int>(a.num("team_id"))});
+                std::stable_sort(info.teams.begin(), info.teams.end(), [](const EsPlayerTeam& x, const EsPlayerTeam& y) {
+                    return SeasonNumber(x.season) != SeasonNumber(y.season) ? SeasonNumber(x.season) > SeasonNumber(y.season) : SeasonNumber(x.division) < SeasonNumber(y.division);
+                });
+            }
+            if (const Json* m = json->get("metrics")) {
+                info.matches = static_cast<int>(m->num("matches"));
+                info.races = static_cast<int>(m->num("races"));
+                info.raceWins = static_cast<int>(m->num("wins"));
+                info.podiums = static_cast<int>(m->num("podiums"));
+                info.bestGp = static_cast<int>(m->num("best_gp_score"));
+                info.bestMatch = static_cast<int>(m->num("best_match_score"));
+                info.pointsPerRace = m->num("points_per_race");
+                info.averagePlacement = m->num("average_placement");
+                info.podiumRate = m->num("podium_rate");
+            }
+            if (const Json* r = json->get("record")) {
+                info.wins = static_cast<int>(r->num("wins"));
+                info.losses = static_cast<int>(r->num("losses"));
+                info.ties = static_cast<int>(r->num("ties"));
+            }
+            if (const Json* list = json->get("recent_matches"))
+                if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                    for (const auto& m : *arr) {
+                        EsPlayerMatch match;
+                        match.season = m.str("season");
+                        match.label = m.str("label");
+                        match.result = m.str("result");
+                        match.number = static_cast<int>(m.num("match_number"));
+                        match.playerScore = static_cast<int>(m.num("player_score"));
+                        if (const Json* team = m.get("team")) match.teamScore = static_cast<int>(team->num("score"));
+                        if (const Json* opps = m.get("opponents"))
+                            if (const auto* os = std::get_if<Json::Array>(&opps->v); os && !os->empty()) {
+                                match.opponentTag = os->front().str("tag");
+                                match.opponentName = os->front().str("name");
+                                match.opponentScore = static_cast<int>(os->front().num("score"));
+                            }
+                        info.recent.push_back(std::move(match));
+                    }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& p = g_esPlayerInfo[id];
+        p.loading = false;
+        p.fetched = Clock::now();
+        p.error = error;
+        if (error.empty()) {
+            info.loaded = true;
+            info.fetched = p.fetched;
+            p = std::move(info);
+        }
+    }).detach();
+}
