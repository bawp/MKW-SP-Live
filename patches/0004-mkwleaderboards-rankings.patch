+// The saved crowd and whether it is still fresh (under a day old).
+std::pair<std::shared_ptr<std::vector<CrowdMii>>, bool> LoadCrowd(const GraphKey& key, bool ghostNames) {
+    const auto file = CrowdFile(key, ghostNames);
+    std::ifstream in(file, std::ios::binary);
+    const std::vector<uint8_t> d((std::istreambuf_iterator<char>(in)), {});
+    if (d.size() < 8 || std::memcmp(d.data(), "CRWD", 4) != 0) return {nullptr, false};
+    const uint32_t count = Be32(d, 4);
