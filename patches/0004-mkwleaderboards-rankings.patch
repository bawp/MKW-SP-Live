+void PickTopTenGhost(CpuContext* ctx, uint32_t page, int row) {
+    const uint32_t download = SectionPage(kPageTopTenDownload), ghostPage = SectionPage(kPageGhostDownload);
+    const uint32_t manager = Memory::Read32(kSectionManager);
+    if (!download || !ghostPage || !manager) return;
+    const uint32_t menu = Memory::Read32(manager + kMenuData);
+    const uint32_t save = Memory::Read32(kSaveManagerInstance);
+    Memory::Write32(menu + kGhostType, Memory::Read32(download + kTopTenArea) == 2 ? kGhostTypeWorld : kGhostTypeContinental);
+    Memory::Write32(menu + kGhostCourse, Memory::Read32(download + kTopTenCourse));
+    Memory::Write32(menu + kGhostLicense, static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(Memory::Read16(save + 0x36)))));
+    ForgetDownloadedGhosts(Memory::Read32(download + kTopTenCourse));
+    CallWith(ctx, func_805FA930, {page + kTopTenMiis, static_cast<uint32_t>(row)});
+    CallWith(ctx, func_8060DD94, {ghostPage, ctx->gpr[3]});
+    g_pickedRank = row;
+    CallWith(ctx, func_80602488, {page, 1});   // close the list; 0xAE then goes to 0xAC
+}
