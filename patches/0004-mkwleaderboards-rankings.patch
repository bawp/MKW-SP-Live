+namespace {
+// A FAT32 image without a partition table (WiiSD.raw), written while nothing has it open: just what
+// placing files in a directory needs (short 8.3 names, both FATs, FSInfo marked unknown).
+struct Fat32 {
+    std::fstream f;
+    uint32_t bps = 0, spc = 0, reserved = 0, fats = 0, fatSize = 0, root = 0, fsinfo = 0, clusters = 0;
+    uint64_t dataStart = 0;
+    std::vector<uint32_t> fat;
+
+    bool Open(const std::filesystem::path& image) {
+        f.open(image, std::ios::in | std::ios::out | std::ios::binary);
+        if (!f) return false;
+        uint8_t b[512];
+        f.read(reinterpret_cast<char*>(b), 512);
+        if (!f || b[0x1FE] != 0x55 || b[0x1FF] != 0xAA) return false;
+        auto le16 = [&](int o) { return static_cast<uint32_t>(b[o] | b[o + 1] << 8); };
+        auto le32 = [&](int o) { return le16(o) | le16(o + 2) << 16; };
+        bps = le16(0x0B); spc = b[0x0D]; reserved = le16(0x0E); fats = b[0x10];
+        fatSize = le32(0x24); root = le32(0x2C); fsinfo = le16(0x30);
+        const uint32_t total = le16(0x13) ? le16(0x13) : le32(0x20);
+        if (bps != 512 || !spc || !fats || !fatSize || root < 2 || le16(0x16) != 0) return false;   // FAT32 only
+        dataStart = reserved + static_cast<uint64_t>(fats) * fatSize;
+        clusters = static_cast<uint32_t>((total - dataStart) / spc) + 2;
+        fat.resize(static_cast<size_t>(fatSize) * bps / 4);
+        f.seekg(static_cast<std::streamoff>(reserved) * bps);
+        f.read(reinterpret_cast<char*>(fat.data()), static_cast<std::streamsize>(fat.size() * 4));
+        clusters = std::min<uint32_t>(clusters, static_cast<uint32_t>(fat.size()));
+        return static_cast<bool>(f);
+    }
+    uint32_t Bytes() const { return spc * bps; }
+    std::streamoff Offset(uint32_t c) const { return static_cast<std::streamoff>((dataStart + static_cast<uint64_t>(c - 2) * spc) * bps); }
+    uint32_t Next(uint32_t c) const { return fat[c] & 0x0FFFFFFF; }
+    static bool End(uint32_t c) { return c < 2 || c >= 0x0FFFFFF8; }
+    std::vector<uint8_t> Read(uint32_t c) {
+        std::vector<uint8_t> d(Bytes());
+        f.seekg(Offset(c));
+        f.read(reinterpret_cast<char*>(d.data()), static_cast<std::streamsize>(d.size()));
+        return d;
+    }
+    void Write(uint32_t c, const uint8_t* d, size_t n) {
+        std::vector<uint8_t> buf(Bytes(), 0);
+        std::memcpy(buf.data(), d, std::min<size_t>(n, buf.size()));
+        f.seekp(Offset(c));
+        f.write(reinterpret_cast<const char*>(buf.data()), static_cast<std::streamsize>(buf.size()));
+    }
+    uint32_t Alloc() {
+        for (uint32_t c = 3; c < clusters; ++c)
+            if ((fat[c] & 0x0FFFFFFF) == 0) { fat[c] = (fat[c] & 0xF0000000) | 0x0FFFFFFF; return c; }
+        return 0;
+    }
+    void Free(uint32_t c) {
+        for (int guard = 0; !End(c) && guard < 1 << 20; ++guard) { const uint32_t n = Next(c); fat[c] &= 0xF0000000; c = n; }
+    }
+    // The 32-byte entry `name` (11 chars, 8.3) of directory `dir`: its cluster and offset there.
+    bool Find(uint32_t dir, const char* name, uint32_t& atCluster, uint32_t& atOffset, std::array<uint8_t, 32>& entry) {
+        for (uint32_t c = dir, guard = 0; !End(c) && guard < 65536; c = Next(c), ++guard) {
+            const auto d = Read(c);
+            for (uint32_t o = 0; o < d.size(); o += 32) {
+                if (d[o] == 0x00) return false;
+                if (d[o] == 0xE5 || d[o + 11] == 0x0F || (d[o + 11] & 0x08)) continue;
+                bool same = true;
+                for (int k = 0; k < 11 && same; ++k) same = std::toupper(d[o + k]) == static_cast<uint8_t>(name[k]);
+                if (!same) continue;
+                atCluster = c; atOffset = o;
+                std::memcpy(entry.data(), &d[o], 32);
+                return true;
+            }
+        }
+        return false;
+    }
+    // A free entry in `dir`, growing it by a cluster when full.
+    bool FreeSlot(uint32_t dir, uint32_t& atCluster, uint32_t& atOffset) {
+        uint32_t last = dir;
+        for (uint32_t c = dir, guard = 0; !End(c) && guard < 65536; c = Next(c), ++guard) {
+            last = c;
+            const auto d = Read(c);
+            for (uint32_t o = 0; o < d.size(); o += 32)
+                if (d[o] == 0x00 || d[o] == 0xE5) { atCluster = c; atOffset = o; return true; }
+        }
+        const uint32_t grown = Alloc();
+        if (!grown) return false;
+        fat[last] = (fat[last] & 0xF0000000) | grown;
+        Write(grown, nullptr, 0);
+        atCluster = grown; atOffset = 0;
+        return true;
+    }
+    void PutEntry(uint32_t cluster, uint32_t offset, const std::array<uint8_t, 32>& entry) {
+        f.seekp(Offset(cluster) + offset);
+        f.write(reinterpret_cast<const char*>(entry.data()), 32);
+    }
+    static std::array<uint8_t, 32> Entry(const char* name, uint8_t attr, uint32_t cluster, uint32_t size) {
+        std::array<uint8_t, 32> e{};
+        std::memcpy(e.data(), name, 11);
+        e[11] = attr;
+        const std::time_t now = std::time(nullptr);
+        std::tm tm{};
+        localtime_s(&tm, &now);
+        const uint16_t time = static_cast<uint16_t>(tm.tm_hour << 11 | tm.tm_min << 5 | tm.tm_sec / 2);
+        const uint16_t date = static_cast<uint16_t>((tm.tm_year - 80) << 9 | (tm.tm_mon + 1) << 5 | tm.tm_mday);
+        auto put16 = [&](int o, uint32_t v) { e[o] = static_cast<uint8_t>(v); e[o + 1] = static_cast<uint8_t>(v >> 8); };
+        put16(14, time); put16(16, date); put16(18, date); put16(22, time); put16(24, date);
+        put16(20, cluster >> 16); put16(26, cluster & 0xFFFF);
+        put16(28, size & 0xFFFF); put16(30, size >> 16);
+        return e;
+    }
+    static uint32_t ClusterOf(const std::array<uint8_t, 32>& e) { return static_cast<uint32_t>(e[20] | e[21] << 8) << 16 | static_cast<uint32_t>(e[26] | e[27] << 8); }
+    // The subdirectory `name` of `parent`, made when missing (0: failed).
+    uint32_t Dir(uint32_t parent, const char* name) {
+        uint32_t ac, ao;
+        std::array<uint8_t, 32> e;
+        if (Find(parent, name, ac, ao, e)) return (e[11] & 0x10) ? ClusterOf(e) : 0;
+        const uint32_t c = Alloc();
+        if (!c || !FreeSlot(parent, ac, ao)) return 0;
+        std::vector<uint8_t> d(Bytes(), 0);
+        const auto dot = Entry(".          ", 0x10, c, 0), dotdot = Entry("..         ", 0x10, parent == root ? 0 : parent, 0);
+        std::memcpy(d.data(), dot.data(), 32);
+        std::memcpy(d.data() + 32, dotdot.data(), 32);
+        Write(c, d.data(), d.size());
+        PutEntry(ac, ao, Entry(name, 0x10, c, 0));
+        return c;
+    }
+    bool PutFile(uint32_t dir, const char* name, const std::vector<uint8_t>& data) {
+        uint32_t ac, ao;
+        std::array<uint8_t, 32> e;
+        if (Find(dir, name, ac, ao, e)) Free(ClusterOf(e));
+        else if (!FreeSlot(dir, ac, ao)) return false;
+        uint32_t first = 0, prev = 0;
+        for (size_t at = 0; at < data.size() || first == 0; at += Bytes()) {
+            const uint32_t c = Alloc();
+            if (!c) return false;
+            if (prev) fat[prev] = (fat[prev] & 0xF0000000) | c;
+            else first = c;
+            Write(c, data.data() + std::min(at, data.size()), at < data.size() ? data.size() - at : 0);
+            prev = c;
+            if (data.empty()) break;
+        }
+        PutEntry(ac, ao, Entry(name, 0x20, first, static_cast<uint32_t>(data.size())));
+        return true;
+    }
+    void Flush() {
+        for (uint32_t k = 0; k < fats; ++k) {
+            f.seekp(static_cast<std::streamoff>(reserved + static_cast<uint64_t>(k) * fatSize) * bps);
+            f.write(reinterpret_cast<const char*>(fat.data()), static_cast<std::streamsize>(fat.size() * 4));
+        }
+        if (fsinfo && fsinfo < reserved) {   // free count / next free: unknown (recounted)
+            const uint8_t unknown[8] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
+            f.seekp(static_cast<std::streamoff>(fsinfo) * bps + 0x1E8);
+            f.write(reinterpret_cast<const char*>(unknown), 8);
+        }
+        f.flush();
+    }
+};
+} // namespace
