+// A played match's results table: the two teams side by side, each player's score per GP (4 races)
+// and total, best first.
+void EsDrawResults(EsCanvas& c, float W, float L, float R, float rowTop, float rowBottom, std::optional<std::pair<EsCanvas, ImVec2>>& moreBelow) {
+    (void)moreBelow;
+    const auto it = g_esMatchDetails.find(g_esResultMatch);
+    if (it == g_esMatchDetails.end() || !it->second.loaded) {
+        const bool failed = it != g_esMatchDetails.end() && !it->second.loading && !it->second.error.empty();
+        c.Text(W * 0.5f, rowTop + 90, 30, 0xFFFFFF, failed ? "Couldn't load this match." : "Loading results...", 0.5f);
+        return;
+    }
+    const EsMatchDetail& d = it->second;
+    g_esResultRows = g_esResultVisible = 0;   // all on screen: nothing to scroll
+    const int gpCount = std::max(1, (std::max(1, d.races) + 3) / 4);
+    const float top = kEsSectionTop - 2, gap = 18, half = (R - L - gap) * 0.5f;
+    const std::string number = d.label.substr(0, d.label.find(' '));
+    size_t most = 1;
+    for (const auto& team : d.teams) most = std::max(most, team.players.size());
+    // rows: the team (name, total), the GPs' header, its players
+    const float pitch = std::clamp((rowBottom - top - 4) / static_cast<float>(most + 2), 22.0f, 34.0f);
+    const float size = std::clamp(pitch - 8.0f, 17.0f, 24.0f);
+    for (int k = 0; k < 2; ++k) {
+        const auto& team = d.teams[k];
+        const float l = L + k * (half + gap), r = l + half;
+        const bool won = team.score > d.teams[1 - k].score;
+        const float totalX = r - 10, gpW = std::min(54.0f, (half - 170) / (gpCount + 1)), gpX0 = totalX - 64 - gpW * gpCount;
+        // the team: colour bar, name, its total (the match's number before the first)
+        float y = top;
+        c.Gradient(l, y, r, y + pitch - 2, Rgba(team.color, c.alpha * 0.55f), Rgba(team.color, c.alpha * 0.25f), Rgba(team.color, c.alpha * 0.15f), Rgba(team.color, c.alpha * 0.40f));
+        c.Rect(l, y, l + 4, y + pitch - 2, Rgba(team.color, c.alpha), 1.5f);
+        const float nameX = l + 10 + (k == 0 ? c.TextWidth(size, number) + 10 : 0.0f);
+        if (k == 0) c.Text(l + 10, y + (pitch - 2 - size) * 0.5f, size, 0xB8C8F0, number);
+        const std::string score = std::to_string(team.score);
+        c.Text(nameX, y + (pitch - 2 - size) * 0.5f, size, won ? 0xFFF07A : 0xFFFFFF,
+               Fit(c, size, team.name + (team.penalty ? "  (-" + std::to_string(team.penalty) + ")" : ""), totalX - c.TextWidth(size + 4, score) - 12 - nameX));
+        c.Text(totalX, y + (pitch - 2 - size - 4) * 0.5f, size + 4, won ? 0xFFF07A : 0xFFFFFF, score, 1.0f);
+        y += pitch;
+        // the GPs' header
+        c.Gradient(l, y, r, y + pitch - 4, Rgba(0x000820, c.alpha * 0.55f), Rgba(0x000820, c.alpha * 0.55f), Rgba(0x00163E, c.alpha * 0.55f), Rgba(0x00163E, c.alpha * 0.55f));
+        c.Text(l + 16 + size * 0.9f, y + 1, size - 2, 0xB8C8F0, "Player");
+        for (int g = 0; g < gpCount; ++g) c.Text(gpX0 + gpW * (g + 0.5f), y + 1, size - 2, 0xB8C8F0, "GP" + std::to_string(g + 1), 0.5f);
+        c.Text(totalX, y + 1, size - 2, 0xB8C8F0, "Total", 1.0f);
+        y += pitch - 2;
+        for (size_t p = 0; p < team.players.size(); ++p, y += pitch) {
+            const auto& pl = team.players[p];
+            const float a = pl.subbedOut ? 0.6f : 1.0f;
+            EsDrawRow(c, l, r, y, pitch - 4, false, a, 0.0f);
+            // their flag after the name (the Mii lookup finds their country)
+            EsPlayer who;
+            who.playerId = pl.playerId;
+            who.name = pl.name;
+            if (!pl.friendCode.empty()) who.friendCodes.push_back(pl.friendCode);
+            EsTeam side;
+            side.name = team.name;
+            side.tag = team.tag;
+            EsMiiTexture(who, side);
+            const int country = EsPlayerCountry(who, side);
+            const float ty = y + (pitch - 4 - size) * 0.5f, flagH = size * 0.6f, nameX = l + 16 + flagH * 1.5f;
+            EsDrawFlag(c, l + 9, ty + (size - flagH) * 0.55f, flagH, country, a);   // a column of its own
+            c.Text(nameX, ty, size, 0xFFFFFF, Fit(c, size, pl.name, gpX0 - nameX - 6), 0.0f, a);
+            for (int g = 0; g < gpCount; ++g) {
+                int sum = 0;
+                bool any = false;
+                for (int race = g * 4; race < g * 4 + 4 && race < static_cast<int>(pl.scores.size()); ++race)
+                    if (pl.scores[race] >= 0) { sum += pl.scores[race]; any = true; }
+                if (any) c.Text(gpX0 + gpW * (g + 0.5f), y + (pitch - 4 - size) * 0.5f, size, 0xD8E0F8, std::to_string(sum), 0.5f, a);
+            }
+            c.Text(totalX, y + (pitch - 4 - size) * 0.5f, size, 0xFFF07A, std::to_string(pl.total), 1.0f, a);
+        }
+    }
+}
