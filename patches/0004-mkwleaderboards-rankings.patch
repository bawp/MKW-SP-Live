+// The section tabs under the title: L  Standings  Schedule  Players  R (the shown one lit).
+constexpr const char* kEsSectionNames[kEsSectionCount] = {"Standings", "Schedule", "Players"};
+constexpr float kEsTabsY = kEsTop + 40, kEsSectionTop = kEsTop + 68;
+void EsDrawTabs(EsCanvas& c, float L, float R) {
+    const float size = 22, gap = 26;
+    float total = 0;
+    for (const char* name : kEsSectionNames) total += c.TextWidth(size, name) + gap;
+    float x = (L + R) * 0.5f - (total - gap) * 0.5f;
+    c.Text(x - 18, kEsTabsY - 1, 24, 0xFFFFFF, "L", 1.0f);
+    for (int k = 0; k < kEsSectionCount; ++k) {
+        const float w = c.TextWidth(size, kEsSectionNames[k]);
+        const bool on = k == g_esSection;
+        c.Text(x, kEsTabsY, size, on ? 0xFFF07A : 0xB8C8F0, kEsSectionNames[k], 0.0f, on ? 1.0f : 0.75f);
+        if (on) c.Rect(x, kEsTabsY + 24, x + w, kEsTabsY + 26.5f, Rgba(0xFFF07A, c.alpha), 1.0f);
+        x += w + gap;
+    }
+    c.Text(x - gap + 18, kEsTabsY - 1, 24, 0xFFFFFF, "R");
+}
