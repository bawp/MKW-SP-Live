+    c.Text(rx, kEsRosterTitleY, 30, 0xFFF07A, season.name);
+    c.Text(rx + c.TextWidth(30, season.name) + 10, kEsRosterTitleY, 30, 0xFFFFFF, projected && !showStatus ? "Projected Lineup" : "Roster");
+    std::string message;
+    if (!roster || !roster->loaded) message = roster && !roster->error.empty() ? "Couldn't load the roster." : "Loading roster...";
+    else if (players.empty()) message = "No players this season yet.";
+    if (!message.empty()) {
+        c.Text((rx + R) * 0.5f, rowTop + 90, 26, 0xFFFFFF, message, 0.5f, 0.85f);
+    } else {
+        const int count = static_cast<int>(players.size());
+        const float pitch = 36.0f, rowH = 33.0f;
+        const int visible = std::max(1, static_cast<int>((rowBottom - rowTop + 4.0f) / pitch));
+        g_esPlayerCount = count;
+        g_esPlayersShown = players;
+        g_esPlayerCursor = std::clamp(g_esPlayerCursor, 0, count - 1);
+        float target = std::clamp(g_esPlayerScroll, static_cast<float>(g_esPlayerCursor - visible + 1), static_cast<float>(g_esPlayerCursor));
+        target = std::clamp(target, 0.0f, static_cast<float>(std::max(0, count - visible)));
+        g_esPlayerScroll += (target - g_esPlayerScroll) * 0.35f;
+        if (std::fabs(target - g_esPlayerScroll) < 0.01f) g_esPlayerScroll = target;
+        c.list->PushClipRect(c.P(-c.dx, rowTop - 3), c.P(W - c.dx, rowBottom + 3), true);
+        for (int k = 0; k < count; ++k) {
+            const float y = rowTop + (static_cast<float>(k) - g_esPlayerScroll) * pitch;
