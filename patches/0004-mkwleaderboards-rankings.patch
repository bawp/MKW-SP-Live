+// The keyboard: 4 rows of 12 keys, then Shift, Space, Delete, OK (3, 4, 3 and 2 columns wide).
+constexpr const char* kMtRows[2][4] = {
+    {"1234567890-_", "qwertyuiop@.", "asdfghjkl!#$", "zxcvbnm,?%&*"},
+    {"1234567890-_", "QWERTYUIOP@.", "ASDFGHJKL!#$", "ZXCVBNM,?%&*"},
+};
+constexpr int kMtCols = 12, kMtSpecialRow = 4;
+struct MtSpecial { const char* label; int from, to; };
+constexpr MtSpecial kMtSpecial[] = {{"Shift", 0, 3}, {"Space", 3, 7}, {"Delete", 7, 10}, {"OK", 10, 12}};
+int MtSpecialAt(int col) {
+    for (int k = 0; k < 4; ++k) if (col >= kMtSpecial[k].from && col < kMtSpecial[k].to) return k;
+    return 3;
+}
