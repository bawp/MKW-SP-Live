+struct Job {
+    uint32_t client = 0;
+    uint32_t kind = 0;
+    uint32_t course = 0;
+    uint8_t region = 0;   // 0 = worldwide
+    size_t rank = 0;      // ghost requests: 0 = the champion, else that place of the top 10
+    bool own = false;     // ghost requests: your imported PB (My Times)
+    std::string category = "default";   // the site board type (CategoryOf)
+    bool ghostMiiNames = false;          // keep the ghosts' Mii names (Settings > Rankings > Player Names)
+    std::atomic<bool> done{false};
+    int32_t error = 0;
+    std::vector<TopEntry> entries;
+    std::vector<uint8_t> ghost;
+};
