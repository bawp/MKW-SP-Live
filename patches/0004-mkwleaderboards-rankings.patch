+// The run's ghost as a vanilla RKG (cached on disk; ghost files of a run never change).
+std::optional<std::vector<uint8_t>> RunGhost(const Run& r, uint32_t course) {
+    const auto cached = GhostCacheDir() / (std::to_string(r.id) + ".rkg");
+    std::vector<uint8_t> bytes;
+    if (std::ifstream in(cached, std::ios::binary); in) {
+        bytes.assign(std::istreambuf_iterator<char>(in), {});
+    } else {
+        const std::string url = GhostFileUrl(r);
+        if (url.empty()) return std::nullopt;
+        const auto res = HttpGet(url);
+        if (!res.error.empty() || res.status != 200) {
+            std::cout << "[mkwlb] ghost of run " << r.id << " (" << url << "): " << (res.error.empty() ? "HTTP " + std::to_string(res.status) : res.error) << std::endl;
+            return std::nullopt;
+        }
+        bytes.assign(res.body.begin(), res.body.end());
+        if (!NormalizeRkg(bytes, course)) {
+            std::cout << "[mkwlb] ghost of run " << r.id << " is not a usable RKG for this course" << std::endl;
+            return std::nullopt;
+        }
+        std::ofstream(cached, std::ios::binary).write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    }
+    return NormalizeRkg(std::move(bytes), course);
+}
+
+// RKG inputs: Yaz1-compressed (u32 size, "Yaz1" block) after the 0x88-byte header -> uncompressed
+// RKG (header with the compressed flag cleared, raw inputs), the form RaceConfig's ghost buffers hold.
+std::optional<std::vector<uint8_t>> DecompressRkg(const std::vector<uint8_t>& rkg) {
+    if (rkg.size() < 0x9C || std::memcmp(rkg.data() + 0x8C, "Yaz1", 4) != 0) return rkg;   // already raw
+    const size_t outSize = Be32(rkg, 0x90);
+    if (0x88 + outSize + 4 > kGhostBufferSize) return std::nullopt;
+    std::vector<uint8_t> out(rkg.begin(), rkg.begin() + 0x88);
+    out.reserve(0x88 + outSize + 4);
+    size_t src = 0x8C + 0x10, end = 0x8C + Be32(rkg, 0x88);
+    uint8_t code = 0;
+    int bits = 0;
+    while (out.size() < 0x88 + outSize) {
+        if (bits == 0) {
+            if (src >= end) return std::nullopt;
+            code = rkg[src++];
+            bits = 8;
+        }
+        if (code & 0x80) {
+            if (src >= end) return std::nullopt;
+            out.push_back(rkg[src++]);
+        } else {
+            if (src + 2 > end) return std::nullopt;
+            const uint8_t b0 = rkg[src], b1 = rkg[src + 1];
+            src += 2;
+            const size_t dist = (size_t(b0 & 0x0F) << 8 | b1) + 1;
+            size_t len = b0 >> 4;
+            if (len == 0) {
+                if (src >= end) return std::nullopt;
+                len = size_t(rkg[src++]) + 0x12;
+            } else {
+                len += 2;
+            }
+            if (dist > out.size() - 0x88) return std::nullopt;
+            for (size_t k = 0; k < len && out.size() < 0x88 + outSize; ++k) out.push_back(out[out.size() - dist]);
+        }
+        code <<= 1;
+        --bits;
+    }
+    out[0x0C] &= ~0x08;   // not compressed
+    out.resize(out.size() + 4);
+    PutBe32(out, out.size() - 4, Crc32(out.data(), out.size() - 4));
+    return out;
+}
+
+std::array<uint8_t, kMiiSize> MiiOf(const std::vector<uint8_t>& rkg) {
+    std::array<uint8_t, kMiiSize> mii{};
+    std::memcpy(mii.data(), rkg.data() + 0x3C, kMiiSize);
+    return mii;
+}
