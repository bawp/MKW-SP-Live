+        const bool compact = count > 6 || (rowBottom - rowTop) / std::max(1, count) < 44.0f;
+        const float pitch = std::clamp((rowBottom - rowTop) / std::max(1, count), compact ? 26.0f : 38.0f, 46.0f), rowH = pitch - (compact ? 3.0f : 5.0f);
