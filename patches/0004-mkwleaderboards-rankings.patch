+// ---------------------------------------------------------------------------------------------
+// Minimal JSON (the site's API answers arrays of flat objects)
+
+struct Json {
+    using Array = std::vector<Json>;
+    using Object = std::vector<std::pair<std::string, Json>>;
+    std::variant<std::nullptr_t, bool, double, std::string, Array, Object> v;
+
+    const Json* get(std::string_view key) const {
+        if (const auto* o = std::get_if<Object>(&v)) {
+            for (const auto& [k, val] : *o) if (k == key) return &val;
+        }
+        return nullptr;
+    }
+    std::string str(std::string_view key) const {
+        const Json* j = get(key);
+        if (j) if (const auto* s = std::get_if<std::string>(&j->v)) return *s;
+        return {};
+    }
+    double num(std::string_view key, double fallback = 0.0) const {
+        const Json* j = get(key);
+        if (j) if (const auto* d = std::get_if<double>(&j->v)) return *d;
+        return fallback;
+    }
+};
+
+class JsonParser {
+public:
+    explicit JsonParser(std::string_view s) : s_(s) {}
+    std::optional<Json> parse() {
+        auto v = value();
+        ws();
+        if (!v || i_ != s_.size()) return std::nullopt;
+        return v;
+    }
+
+private:
+    std::string_view s_;
+    size_t i_ = 0;
+
+    void ws() { while (i_ < s_.size() && (s_[i_] == ' ' || s_[i_] == '\n' || s_[i_] == '\r' || s_[i_] == '\t')) ++i_; }
+    bool lit(std::string_view w) { if (s_.substr(i_, w.size()) == w) { i_ += w.size(); return true; } return false; }
+
+    std::optional<Json> value() {
+        ws();
+        if (i_ >= s_.size()) return std::nullopt;
+        const char c = s_[i_];
+        if (c == '{') return object();
+        if (c == '[') return array();
+        if (c == '"') { auto s = string(); if (!s) return std::nullopt; return Json{std::move(*s)}; }
+        if (lit("null")) return Json{nullptr};
+        if (lit("true")) return Json{true};
+        if (lit("false")) return Json{false};
+        return number();
+    }
+    std::optional<Json> number() {
+        const size_t start = i_;
+        while (i_ < s_.size() && std::strchr("+-0123456789.eE", s_[i_])) ++i_;
+        if (i_ == start) return std::nullopt;
+        try {
+            return Json{std::stod(std::string(s_.substr(start, i_ - start)))};
+        } catch (...) {
+            return std::nullopt;
+        }
+    }
+    static void put(std::string& out, uint32_t cp) {
+        if (cp < 0x80) out += static_cast<char>(cp);
+        else if (cp < 0x800) { out += static_cast<char>(0xC0 | (cp >> 6)); out += static_cast<char>(0x80 | (cp & 0x3F)); }
+        else if (cp < 0x10000) { out += static_cast<char>(0xE0 | (cp >> 12)); out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F)); out += static_cast<char>(0x80 | (cp & 0x3F)); }
+        else { out += static_cast<char>(0xF0 | (cp >> 18)); out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F)); out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F)); out += static_cast<char>(0x80 | (cp & 0x3F)); }
+    }
+    std::optional<uint32_t> hex4() {
+        if (i_ + 4 > s_.size()) return std::nullopt;
+        uint32_t v = 0;
+        for (int k = 0; k < 4; ++k) {
+            const char h = s_[i_++];
+            v <<= 4;
+            if (h >= '0' && h <= '9') v |= h - '0';
+            else if (h >= 'a' && h <= 'f') v |= h - 'a' + 10;
+            else if (h >= 'A' && h <= 'F') v |= h - 'A' + 10;
+            else return std::nullopt;
+        }
+        return v;
+    }
+    std::optional<std::string> string() {
+        ++i_;   // opening quote
+        std::string out;
+        while (i_ < s_.size()) {
+            const char c = s_[i_++];
+            if (c == '"') return out;
+            if (c != '\\') { out += c; continue; }
+            if (i_ >= s_.size()) return std::nullopt;
+            const char e = s_[i_++];
+            switch (e) {
+            case '"': out += '"'; break;
+            case '\\': out += '\\'; break;
+            case '/': out += '/'; break;
+            case 'b': out += '\b'; break;
+            case 'f': out += '\f'; break;
+            case 'n': out += '\n'; break;
+            case 'r': out += '\r'; break;
+            case 't': out += '\t'; break;
+            case 'u': {
+                auto cp = hex4();
+                if (!cp) return std::nullopt;
+                if (*cp >= 0xD800 && *cp < 0xDC00 && s_.substr(i_, 2) == "\\u") {
+                    i_ += 2;
+                    auto lo = hex4();
+                    if (!lo) return std::nullopt;
+                    *cp = 0x10000 + ((*cp - 0xD800) << 10) + (*lo - 0xDC00);
+                }
+                put(out, *cp);
+                break;
+            }
+            default: return std::nullopt;
+            }
+        }
+        return std::nullopt;
+    }
+    std::optional<Json> array() {
+        ++i_;
+        Json::Array a;
+        ws();
+        if (i_ < s_.size() && s_[i_] == ']') { ++i_; return Json{std::move(a)}; }
+        for (;;) {
+            auto v = value();
+            if (!v) return std::nullopt;
+            a.push_back(std::move(*v));
+            ws();
+            if (i_ < s_.size() && s_[i_] == ',') { ++i_; continue; }
+            if (i_ < s_.size() && s_[i_] == ']') { ++i_; return Json{std::move(a)}; }
+            return std::nullopt;
+        }
+    }
+    std::optional<Json> object() {
+        ++i_;
+        Json::Object o;
+        ws();
+        if (i_ < s_.size() && s_[i_] == '}') { ++i_; return Json{std::move(o)}; }
+        for (;;) {
+            ws();
+            if (i_ >= s_.size() || s_[i_] != '"') return std::nullopt;
+            auto k = string();
+            if (!k) return std::nullopt;
+            ws();
+            if (i_ >= s_.size() || s_[i_] != ':') return std::nullopt;
+            ++i_;
+            auto v = value();
+            if (!v) return std::nullopt;
+            o.emplace_back(std::move(*k), std::move(*v));
+            ws();
+            if (i_ < s_.size() && s_[i_] == ',') { ++i_; continue; }
+            if (i_ < s_.size() && s_[i_] == '}') { ++i_; return Json{std::move(o)}; }
+            return std::nullopt;
+        }
+    }
+};
