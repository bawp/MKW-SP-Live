+// The season ends with playoffs between the table's top teams (playoff_qualification: their seeds;
+// for GSC's Division 1, three: seed 1 waits in the final, 2 and 3 play the semifinal). Once a series
+// is played its loser is out at that stage, and the playoff teams are placed by how far they got,
+// then by seed: the final's winner 1st, its loser 2nd, the semifinals' losers next. The other teams
+// keep their table places. Until a series is played, the table's ranks are shown (ties included).
+void EsApplyPlayoffs(const Json& json, std::vector<EsTeam>& teams, int& playoffTeams, bool& decided) {
+    for (auto& t : teams) t.finalRank = t.rank;
+    std::map<int, int> seeds;   // entry -> seed
+    if (const Json* q = json.get("playoff_qualification")) {
+        playoffTeams = static_cast<int>(q->num("team_count"));
+        if (const Json* list = q->get("seeds"))
+            if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                for (const auto& seed : *arr) seeds[static_cast<int>(seed.num("team_season_entry_id"))] = static_cast<int>(seed.num("seed"));
+    }
+    if (seeds.empty()) return;
+    playoffTeams = std::max(playoffTeams, static_cast<int>(seeds.size()));
+    std::map<int, int> out;   // entry -> the stage it went out at (1: lost the final, 2: semifinal, ...)
+    int champion = 0;
+    bool played = false;
+    if (const Json* playoffs = json.get("playoffs"))
+        if (const Json* list = playoffs->get("series"))
+            if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                for (const auto& series : *arr) {
+                    if (series.str("status") != "complete") continue;
+                    const std::string stage = series.str("stage");
+                    const int level = stage == "finals" ? 1 : stage == "semifinals" ? 2 : stage == "quarterfinals" ? 3 : 4;
+                    const int winner = static_cast<int>(series.num("winner_team_season_entry_id"));
+                    played = true;
+                    if (level == 1) champion = winner;
+                    if (const Json* parts = series.get("participants"))
+                        if (const auto* ps = std::get_if<Json::Array>(&parts->v))
+                            for (const auto& part : *ps)
+                                if (const int entry = static_cast<int>(part.num("team_season_entry_id")); entry && entry != winner) out[entry] = level;
+                }
+    for (auto& t : teams) if (const auto it = seeds.find(t.entryId); it != seeds.end()) t.seed = it->second;
+    // The playoff teams first (by stage reached, then seed), then the rest as the table has them.
+    auto stage = [&](const EsTeam& t) { const auto it = out.find(t.entryId); return it != out.end() ? it->second : 0; };
+    std::stable_partition(teams.begin(), teams.end(), [](const EsTeam& t) { return t.seed > 0; });
+    const auto last = std::find_if(teams.begin(), teams.end(), [](const EsTeam& t) { return t.seed == 0; });
+    std::stable_sort(teams.begin(), last, [&](const EsTeam& a, const EsTeam& b) {
+        return stage(a) != stage(b) ? stage(a) < stage(b) : a.seed < b.seed;
+    });
+    decided = champion != 0;
+    if (!played) return;
+    int place = 0;
+    for (auto it = teams.begin(); it != last; ++it) it->finalRank = ++place;
+}
+
+uint32_t EsTagColor(const std::string& tag) {   // a team colour for teams that have none
+    static constexpr uint32_t kColors[] = {0xE84A4A, 0x4A8CFF, 0x3CC878, 0xF0B43C, 0xB45AF0, 0x3CC8D2, 0xF06EB4, 0xA0A0B4};
+    uint32_t h = 2166136261u;
+    for (unsigned char ch : tag) h = (h ^ ch) * 16777619u;
+    return kColors[h % std::size(kColors)];
+}
+
+// A Toad's Factory season (/api/division/<id>/standing, kept in UserData/Cache/esports for good:
+// the seasons are over): its table (wins, draws, losses, points; points for / against from its
+// matches), rosters with each player's GP average, matches, and playoffs (stage 2 semifinals,
+// stage 3 the final, as games won) placing the top teams as mkw-stats' do.
+void EsLoadToadsStandings(const std::string& season, const std::string& division, int toadsDivision) {
+    std::thread([season, division, toadsDivision] {
+        const auto cached = EsCacheDir() / ("toads_div_" + std::to_string(toadsDivision) + ".json");
+        std::string body;
+        {
+            std::ifstream in(cached, std::ios::binary);
+            if (in) body.assign(std::istreambuf_iterator<char>(in), {});
+        }
+        if (body.empty()) {
+            const auto res = HttpGet(std::string(kToadsSite) + "/api/division/" + std::to_string(toadsDivision) + "/standing");
+            if (res.error.empty() && res.status == 200) {
+                body = res.body;
+                std::ofstream(cached, std::ios::binary).write(body.data(), static_cast<std::streamsize>(body.size()));
+            }
+        }
+        std::vector<EsTeam> teams;
+        std::map<int, std::vector<EsToadsMember>> members;
+        std::vector<EsToadsMatch> matches;
+        int playoffTeams = 0;
+        bool decided = false;
+        const auto json = JsonParser(body).parse();
+        const Json* table = json ? json->get("clanStandings") : nullptr;
+        const auto* rows = table ? std::get_if<Json::Array>(&table->v) : nullptr;
+        if (rows) {
+            for (const auto& row : *rows) {
+                const Json* p = row.get("participant");
+                if (!p) continue;
+                EsTeam t;
+                t.entryId = -static_cast<int>(p->num("lcp_id"));
+                t.teamId = EsTeamOfToads(static_cast<int>(p->num("clan_id")), p->str("tag"));
+                t.rank = t.finalRank = static_cast<int>(teams.size()) + 1;
+                t.name = p->str("name");
+                t.tag = p->str("tag");
+                if (const std::string logo = p->str("logo"); !logo.empty()) t.logoUrl = std::string(kToadsSite) + "/resources/clans/" + logo;
+                t.color = EsTagColor(t.tag);
+                t.status = "active";
+                t.wins = static_cast<int>(row.num("wins"));
+                t.ties = static_cast<int>(row.num("draws"));
+                t.losses = static_cast<int>(row.num("losses"));
+                t.points = static_cast<int>(row.num("points"));
+                t.played = t.wins + t.ties + t.losses;
+                // GSC's points (3 a win, 2 a tie, 1 for a close loss); older seasons that counted
+                // otherwise show no bonus.
+                t.bonus = t.points - 3 * t.wins - 2 * t.ties;
+                if (t.bonus < 0 || t.bonus > t.losses) t.bonus = -1;
+                auto& roster = members[t.entryId];
+                if (const Json* list = p->get("members"))
+                    if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                        for (const auto& m : *arr) {
+                            const int id = static_cast<int>(m.num("player_id"));
+                            roster.push_back({id, EsStatsIdOfToads(id), m.str("name"), static_cast<int>(m.num("player_role")) == 2, -1});
+                        }
+                teams.push_back(std::move(t));
+            }
+            if (const Json* list = json->get("indivs"))
+                if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                    for (const auto& i : *arr) {
+                        const Json* pp = i.get("player_participant");
+                        if (!pp) continue;
+                        const int entry = -static_cast<int>(pp->num("lcp_id")), id = static_cast<int>(pp->num("player_id"));
+                        auto& roster = members[entry];
+                        auto it = std::find_if(roster.begin(), roster.end(), [&](const EsToadsMember& m) { return m.toadsId == id; });
+                        if (it == roster.end()) {
+                            roster.push_back({id, EsStatsIdOfToads(id), pp->str("name"), static_cast<int>(pp->num("player_role")) == 2, -1});
+                            it = roster.end() - 1;
+                        }
+                        if (const double average = i.num("average", -1); average > 0) it->gpAverage = average;
+                    }
+            // Each team's regular-season schedule and results (forfeits included), to check its row.
+            struct Record { int scheduled = 0, wins = 0, ties = 0, losses = 0; };
+            std::map<int, Record> records;
+            if (const Json* list = json->get("matches"))
+                if (const auto* arr = std::get_if<Json::Array>(&list->v))
+                    for (const auto& m : *arr) {
+                        const Json *home = m.get("participant_home"), *away = m.get("participant_away"), *result = m.get("result");
+                        const Json *hs = result ? result->get("points_home") : nullptr, *as = result ? result->get("points_away") : nullptr;
+                        const bool played = static_cast<int>(m.num("match_status")) == 2;
+                        if (home && away && m.num("stage_type", 1) < 2) {
+                            const int h = -static_cast<int>(home->num("lcp_id")), a = -static_cast<int>(away->num("lcp_id"));
+                            ++records[h].scheduled;
+                            ++records[a].scheduled;
+                            if (hs && as && (static_cast<int>(m.num("match_status")) != 1 || hs->num("score") != as->num("score"))) {
+                                const double x = hs->num("score"), y = as->num("score");
+                                for (auto [entry, win] : {std::pair{h, x > y}, std::pair{a, y > x}}) {
+                                    auto& r = records[entry];
+                                    if (x == y) ++r.ties;
+                                    else if (win) ++r.wins;
+                                    else ++r.losses;
+                                }
+                            }
+                        }
+                        if (!home || !away || !hs || !as) continue;
+                        // Played; a playoff series can also be settled by forfeit (a score, not marked played).
+                        if (!played && (m.num("stage_type", 1) < 2 || hs->num("score") == as->num("score"))) continue;
+                        matches.push_back({-static_cast<int>(home->num("lcp_id")), -static_cast<int>(away->num("lcp_id")),
+                                           static_cast<int>(hs->num("score")), static_cast<int>(as->num("score")), static_cast<int>(m.num("stage_type", 1))});
+                    }
+            // A row with more matches than the team was scheduled (Season 6's XI: 8-1-2 of 10) takes
+            // the record from the matches instead.
+            for (auto& t : teams) {
+                const auto it = records.find(t.entryId);
+                if (it == records.end() || t.played <= it->second.scheduled) continue;
+                t.wins = it->second.wins;
+                t.ties = it->second.ties;
+                t.losses = it->second.losses;
+                t.played = t.wins + t.ties + t.losses;
+                t.bonus = t.points - 3 * t.wins - 2 * t.ties;
+                if (t.bonus < 0 || t.bonus > t.losses) t.bonus = -1;
+            }
+            // Points for / against from the regular season.
+            for (const auto& m : matches) {
+                if (m.stage != 1) continue;
+                for (auto& t : teams) {
+                    if (t.entryId == m.home) { t.pointsFor += m.homeScore; t.pointsAgainst += m.awayScore; }
+                    if (t.entryId == m.away) { t.pointsFor += m.awayScore; t.pointsAgainst += m.homeScore; }
+                }
+            }
+            for (auto& t : teams) t.diff = t.pointsFor - t.pointsAgainst;
+            // Playoffs: the teams in them in table order (seeds); each series' loser out at its stage.
+            std::map<int, int> out;   // entry -> 1 lost the final, 2 a semifinal
+            std::set<int> in;
+            int champion = 0;
+            for (const auto& m : matches) {
+                if (m.stage < 2) continue;
+                in.insert(m.home);
+                in.insert(m.away);
+                const int winner = m.homeScore > m.awayScore ? m.home : m.away, loser = winner == m.home ? m.away : m.home;
+                const int level = m.stage >= 3 ? 1 : 2;
+                out[loser] = level;
+                if (level == 1) champion = winner;
+            }
+            if (!in.empty()) {
+                int seed = 0;
+                for (auto& t : teams) if (in.count(t.entryId)) t.seed = ++seed;
+                playoffTeams = seed;
+                auto stage = [&](const EsTeam& t) { const auto it = out.find(t.entryId); return it != out.end() ? it->second : 0; };
+                std::stable_partition(teams.begin(), teams.end(), [](const EsTeam& t) { return t.seed > 0; });
+                const auto last = std::find_if(teams.begin(), teams.end(), [](const EsTeam& t) { return t.seed == 0; });
+                std::stable_sort(teams.begin(), last, [&](const EsTeam& a, const EsTeam& b) { return stage(a) != stage(b) ? stage(a) < stage(b) : a.seed < b.seed; });
+                int place = 0;
+                for (auto it = teams.begin(); it != last; ++it) it->finalRank = ++place;
+                decided = champion != 0;
+            } else if (!teams.empty()) {
+                playoffTeams = teams.size() >= 8 ? 4 : 3;   // no playoffs recorded: GSC's usual cut
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& standings = g_esStandings[EsKey(season, division)];
+        standings.loading = false;
+        standings.fetched = Clock::now();
+        standings.toads = true;
+        standings.error = rows ? "" : "unexpected standings";
+        if (rows) {
+            standings.loaded = true;
+            standings.finished = true;
+            standings.teams = std::move(teams);
+            standings.members = std::move(members);
+            standings.matches = std::move(matches);
+            standings.playoffTeams = playoffTeams;
+            standings.playoffsDecided = decided;
+        }
+    }).detach();
+}
+
+void EsLoadStandings(const std::string& season, const std::string& division) {
+    if (const EsSeason* def = EsSeasonOf(season); def && def->toadsDivision) {
+        EsLoadToadsStandings(season, division, def->toadsDivision);
+        return;
+    }
+    const std::string path = std::string("/api/standings?league=") + kEsLeague.id + "&season=" + season + "&division=" + division;
+    std::thread([path, season, division] {
+        std::string error;
+        std::vector<EsTeam> teams;
+        std::vector<std::pair<int, int>> players;
+        std::vector<EsPlayerAverage> averages;
+        int meetings = 2;
+        int playoffTeams = 0;
+        bool playoffsDecided = false;
+        if (const auto json = EsFetch(path, error)) {
+            if (const Json* board = json->get("leaderboard"))
+                if (const auto* arr = std::get_if<Json::Array>(&board->v))
+                    for (const auto& p : *arr) {
+                        players.push_back({static_cast<int>(p.num("player_id")), static_cast<int>(p.num("team_season_entry_id"))});
+                        EsPlayerAverage a;
+                        a.playerId = static_cast<int>(p.num("player_id"));
+                        a.name = p.str("name");
+                        a.tag = p.str("team_tag");
+                        a.runnerGps = p.num("runner_gps_played");
+                        a.baggerGps = p.num("bagger_gps_played");
+                        a.gps = p.num("gps_played");
+                        if (a.runnerGps > 0) a.runner = p.num("runner_gp_average");
+                        if (a.baggerGps > 0) a.bagger = p.num("bagger_gp_average");
+                        const Json* eligible = p.get("eligible");
+                        a.eligible = !eligible || !std::holds_alternative<bool>(eligible->v) || std::get<bool>(eligible->v);
+                        averages.push_back(std::move(a));
+                    }
+            if (const Json* conf = json->get("conference_config"))
+                if (const double n = conf->num("same_conference_matches"); n > 0) meetings = static_cast<int>(n);
+            const Json* list = json->get("standings");
+            if (const auto* arr = list ? std::get_if<Json::Array>(&list->v) : nullptr) {
+                for (const auto& t : *arr) {
+                    EsTeam team;
+                    team.teamId = static_cast<int>(t.num("team_id"));
+                    team.entryId = static_cast<int>(t.num("team_season_entry_id"));
+                    team.rank = static_cast<int>(t.num("rank"));
+                    team.name = t.str("name");
+                    team.tag = t.str("tag");
+                    team.logoUrl = t.str("logo_url");
+                    team.status = t.str("status");
+                    team.color = HexColor(t.str("hex_color"));
+                    team.played = static_cast<int>(t.num("played"));
+                    team.wins = static_cast<int>(t.num("wins"));
+                    team.ties = static_cast<int>(t.num("ties"));
+                    team.losses = static_cast<int>(t.num("losses"));
+                    team.bonus = static_cast<int>(t.num("bonus_points"));
+                    team.points = static_cast<int>(t.num("standings_points"));
+                    team.pointsFor = static_cast<int>(t.num("points_for"));
+                    team.pointsAgainst = static_cast<int>(t.num("points_against"));
+                    team.diff = static_cast<int>(t.num("point_differential"));
+                    teams.push_back(std::move(team));
+                }
+                std::stable_sort(teams.begin(), teams.end(), [](const EsTeam& a, const EsTeam& b) { return a.rank < b.rank; });
+                EsApplyPlayoffs(*json, teams, playoffTeams, playoffsDecided);
+            } else {
+                error = "unexpected standings";
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& standings = g_esStandings[EsKey(season, division)];
+        standings.loading = false;
+        standings.fetched = Clock::now();
+        standings.error = error;
+        if (error.empty()) {
+            standings.loaded = true;
+            standings.teams = std::move(teams);
+            standings.players = std::move(players);
+            for (auto& a : averages)   // the team's colour and name
+                for (const auto& t : standings.teams) if (t.tag == a.tag) { a.color = t.color; a.team = t.name; }
+            standings.averages = std::move(averages);
+            standings.meetings = meetings;
+            standings.playoffTeams = playoffTeams;
+            standings.playoffsDecided = playoffsDecided;
+            standings.finished = playoffsDecided;
+            // a season still being played: everyone is eligible until it's over (mkw-stats judges
+            // eligibility on the games so far)
+            if (!standings.finished)
+                for (auto& a : standings.averages) a.eligible = true;
+        }
+        std::cout << "[esports] " << season << " " << division << " standings: " << (error.empty() ? std::to_string(standings.teams.size()) + " teams" : error) << std::endl;
+    }).detach();
+}
+
+// A season's played matches (mkw-stats): number, teams (tags) and scores, regular season and playoffs.
+void EsLoadSchedule(const std::string& season, const std::string& division) {
+    const std::string path = std::string("/api/matches?league=") + kEsLeague.id + "&season=" + season + "&division=" + division + "&match_set=all";
+    std::thread([path, season, division] {
+        std::string error;
+        std::vector<EsMatch> matches;
+        if (const auto json = EsFetch(path, error)) {
+            if (const auto* arr = std::get_if<Json::Array>(&json->v)) {
+                for (const auto& m : *arr) {
+                    if (m.str("result_type") != "played") continue;
+                    EsMatch match;
+                    match.id = static_cast<int>(m.num("match_id"));
+                    match.number = static_cast<int>(m.num("match_number"));
+                    const std::string teams = m.str("teams"), scores = m.str("scores");
+                    const size_t vs = teams.find(" vs "), dash = scores.find(" - ");
+                    if (vs == std::string::npos || dash == std::string::npos) continue;
+                    match.home = teams.substr(0, vs);
+                    match.away = teams.substr(vs + 4);
+                    match.homeScore = std::atoi(scores.substr(0, dash).c_str());
+                    match.awayScore = std::atoi(scores.substr(dash + 3).c_str());
+                    if (m.str("match_type") == "playoffs") match.stage = m.str("playoff_stage") == "final" ? 3 : 2;
+                    matches.push_back(std::move(match));
+                }
+            } else {
+                error = "unexpected matches";
+            }
+        }
+        std::lock_guard lock(g_esMutex);
+        auto& standings = g_esStandings[EsKey(season, division)];
+        standings.scheduleLoading = false;
+        standings.scheduleFetched = Clock::now();
+        if (error.empty()) {
+            standings.scheduleLoaded = true;
+            standings.schedule = std::move(matches);
+        }
+        std::cout << "[esports] " << season << " " << division << " matches: " << (error.empty() ? std::to_string(standings.schedule.size()) : error) << std::endl;
+    }).detach();
+}
