+    ImGui::SetNextItemWidth(160.0f);
+    int sensorBar = g_wiiSensorBarAbove ? 1 : 0;
+    if (ImGui::Combo("Sensor bar", &sensorBar, "Below TV\0Above TV\0")) {
+        g_wiiSensorBarAbove = sensorBar == 1;
