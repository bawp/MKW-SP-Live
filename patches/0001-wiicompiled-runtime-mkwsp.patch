+int32_t Sdio_HLE_Ioctl(uint32_t fd, uint32_t cmd, uint32_t inPtr, uint32_t inLen, uint32_t outPtr, uint32_t outLen);
+int32_t Sdio_HLE_Ioctlv(uint32_t fd, uint32_t cmd, uint32_t numIn, uint32_t numOut, uint32_t vectorPtr);
