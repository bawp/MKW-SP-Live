+// hook boot-time code). The game later loads and relinks StaticR over its embedded image, which
+// would undo the initializers' REL patches, so those bytes are recorded here and re-applied by
+// ReapplyEarlyRelPatches() from the StaticR prolog; the executable-write guard stays off between.
+void RunEarlyMemoryInitializers();
+void ReapplyEarlyRelPatches();
+bool EarlyMemoryInitializersRan();
+void RegisterPostRelInitializer(InitializerFn fn);
+void RunPostRelInitializers();
