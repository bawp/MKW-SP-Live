+    if (!path) {
+        LogNandError("IOS_Open", "null path");
+        return ISFS_EINVAL;
+    }
+    
+    // Handle special device paths
+    if (std::strncmp(path, "/dev/", 5) == 0) {
+        if (std::strcmp(path, "/dev/fs") == 0) {
+            return ISFS_DEV_FD;
+        }
+        if (std::strcmp(path, "/dev/es") == 0) {
+            return ES_DEV_FD;
