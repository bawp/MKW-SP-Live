-    // Seed FaceLib resources before the existence check so every open mode can
-    // still find them on a fresh managed NAND.
-    if (!PathExists(hostPath) && IsFaceLibResourcePath(path)) {
-        SeedFaceLibResource(hostPath);
-    }
