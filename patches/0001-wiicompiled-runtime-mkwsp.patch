-    auto& ranges = ExecutableRanges();
-    const auto duplicate = std::find_if(ranges.begin(), ranges.end(), [&](const ExecutableRange& range) {
-        return range.start == start && range.end == end && range.name == name;
-    });
-    if (duplicate != ranges.end()) {
