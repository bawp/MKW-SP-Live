+extern "C" int32_t NAND_IOS_Open_HLE(uint32_t pathPtr, uint32_t mode) {
+    const std::string pathStorage = ReadGuestCString(pathPtr);
+    const char* path = pathPtr == 0 ? nullptr : pathStorage.c_str();
