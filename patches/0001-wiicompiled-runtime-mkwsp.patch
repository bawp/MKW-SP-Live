diff --git a/runtime/src/hle/storage/sdio.cpp b/runtime/src/hle/storage/sdio.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/src/hle/storage/sdio.cpp
@@ -0,0 +1,345 @@
+// /dev/sdio/slot0 HLE: the Wii front SD slot, backed by a raw FAT image file.
+//
+// Implements the IOS SDIO interface used by libogc-style drivers (MKW-SP's Sdi.c): host controller
+// register access, card reset/status/OCR, and SD commands, with block transfers served from the
+// image. The image is looked up as <user data>/WiiSD.raw, then <nand root>/../Load/WiiSD.raw
+// (Dolphin's layout, so an existing Dolphin SD card works unchanged).
+
+#include "sdio.h"
+
+#include <array>
+#include <cstdio>
+#include <filesystem>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "memory.h"
+#include "nand_path.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+namespace {
+
+constexpr int32_t kSdioFd = 0x5D10;
+constexpr int32_t kOk = 0;
+constexpr int32_t kEinval = -4;    // IPC_EINVAL
+constexpr int32_t kEio = -6;
+
+// IOS SDIO ioctls
+constexpr uint32_t kIoctlWriteHcr = 0x01;
+constexpr uint32_t kIoctlReadHcr = 0x02;
+constexpr uint32_t kIoctlResetCard = 0x04;
+constexpr uint32_t kIoctlSetClock = 0x06;
+constexpr uint32_t kIoctlSendCmd = 0x07;
+constexpr uint32_t kIoctlGetStatus = 0x0B;
+constexpr uint32_t kIoctlGetOcr = 0x0C;
+
+// Status bits returned by GETSTATUS
+constexpr uint32_t kCardInserted = 0x00000001;
+constexpr uint32_t kCardInitialized = 0x00010000;
+constexpr uint32_t kCardSdhc = 0x00100000;
+
+// Host controller registers with side effects
+constexpr uint32_t kHcrClockControl = 0x2C;
+constexpr uint32_t kHcrSoftwareReset = 0x2F;
+
+constexpr uint32_t kRca = 0x9F62;
+constexpr uint32_t kR1Transfer = 0x00000900;   // READY_FOR_DATA | state=tran
+
+struct Request {
+    uint32_t command, type, responseType, arg, blockCount, blockSize, dmaAddress, isDma;
+};
+
+struct Slot {
+    std::mutex mutex;
+    std::FILE* image = nullptr;
+    uint64_t size = 0;
+    bool sdhc = false;
+    bool appCommand = false;
+    bool opened = false;
+    std::array<uint32_t, 0x40> hcr{};
+};
+
+}  // namespace
+
+namespace mkwlb {
+void ApplySdImports(const std::filesystem::path& image);   // mkwlb_rankings.cpp
+}
+
+namespace {
+
+Slot& State() {
+    static Slot slot;
+    return slot;
+}
+
+std::optional<std::filesystem::path> FindImage() {
+    std::error_code ec;
+    std::vector<std::filesystem::path> candidates;
+    candidates.push_back(RuntimeConfigFile::ApplicationDataDirectory() / "WiiSD.raw");
+    candidates.push_back(RuntimeNandPath::DiscoverNandRootPath().parent_path() / "Load" / "WiiSD.raw");
+    for (const auto& path : candidates) {
+        if (std::filesystem::is_regular_file(path, ec)) {
+            return path;
+        }
+    }
+    return std::nullopt;
+}
+
+void OpenImage(Slot& s) {
+    if (s.image) {
+        return;
+    }
+    const auto path = FindImage();
+    if (!path) {
+        RT_LOG(RT_TAG_NAND) << "sdio: no SD card image (WiiSD.raw) found; slot reports no card" << std::endl;
+        return;
+    }
+    mkwlb::ApplySdImports(*path);   // My Times' imported ghosts, while nothing has the image open
+    s.image = _wfopen(path->c_str(), L"r+b");
+    if (!s.image) {
+        RT_LOG(RT_TAG_NAND) << "sdio: could not open " << RuntimeConfigFile::PathToUtf8(*path) << std::endl;
+        return;
+    }
+    std::error_code ec;
+    s.size = std::filesystem::file_size(*path, ec);
+    s.sdhc = s.size > 0x80000000ull;   // cards above 2 GiB use block addressing
+    RT_LOG(RT_TAG_NAND) << "sdio: SD card image " << RuntimeConfigFile::PathToUtf8(*path) << " ("
+                        << (s.size >> 20) << " MiB, " << (s.sdhc ? "SDHC" : "SDSC") << ")" << std::endl;
+}
+
+Request ReadRequest(uint32_t ptr) {
+    Request r{};
+    uint32_t* fields[] = {&r.command, &r.type, &r.responseType, &r.arg, &r.blockCount, &r.blockSize, &r.dmaAddress, &r.isDma};
+    for (uint32_t i = 0; i < 8; ++i) {
+        *fields[i] = Memory::Read32(ptr + i * 4u);
+    }
+    return r;
+}
+
+void WriteResponse(uint32_t outPtr, uint32_t outLen, std::initializer_list<uint32_t> words) {
+    if (!outPtr) {
+        return;
+    }
+    uint32_t i = 0;
+    for (uint32_t w : words) {
+        if ((i + 1) * 4u > outLen || !Memory::Contains(outPtr + i * 4u, 4)) {
+            break;
+        }
+        Memory::Write32(outPtr + i * 4u, w);
+        ++i;
+    }
+}
+
+// CSD register for the image size (v1 for SDSC, v2 for SDHC), returned MSB word first.
+std::array<uint32_t, 4> Csd(const Slot& s) {
+    if (s.sdhc) {
+        const uint32_t cSize = static_cast<uint32_t>(s.size / (512ull * 1024ull)) - 1u;
+        return {0x400E0032u, 0x5B590000u | (cSize >> 16), (cSize << 16) | 0x7F80u, 0x0A400000u};
+    }
+    // v1: capacity = (C_SIZE+1) * 2^(C_SIZE_MULT+2) * 2^READ_BL_LEN, with READ_BL_LEN = 9
+    uint32_t mult = 0;
+    uint64_t blocks = s.size / 512ull;
+    while (mult < 7 && blocks / (1ull << (mult + 2)) > 4096ull) {
+        ++mult;
+    }
+    const uint32_t cSize = static_cast<uint32_t>(blocks / (1ull << (mult + 2))) - 1u;
+    return {0x007F0032u, 0x5F590000u | (cSize >> 2), ((cSize & 3u) << 30) | (mult << 15) | 0x3F8000u | 0x7F80u,
+            0x0A400000u};
+}
+
+int32_t Transfer(Slot& s, const Request& r, bool write) {
+    if (!s.image) {
+        return kEio;
+    }
+    const uint64_t offset = s.sdhc ? static_cast<uint64_t>(r.arg) * 512ull : r.arg;
+    const uint64_t length = static_cast<uint64_t>(r.blockCount) * r.blockSize;
+    if (length == 0 || offset + length > s.size || !Memory::Contains(r.dmaAddress, static_cast<size_t>(length))) {
+        RT_LOG(RT_TAG_NAND) << "sdio: rejected " << (write ? "write" : "read") << " offset=" << offset
+                            << " length=" << length << std::endl;
+        return kEio;
+    }
+    uint8_t* buffer = Memory::GetPointer(r.dmaAddress, static_cast<size_t>(length));
+    if (_fseeki64(s.image, static_cast<long long>(offset), SEEK_SET) != 0) {
+        return kEio;
+    }
+    const size_t done = write ? std::fwrite(buffer, 1, static_cast<size_t>(length), s.image)
+                              : std::fread(buffer, 1, static_cast<size_t>(length), s.image);
+    if (write) {
+        std::fflush(s.image);
+    }
+    return done == length ? kOk : kEio;
+}
+
+int32_t SendCommand(Slot& s, const Request& r, uint32_t outPtr, uint32_t outLen) {
+    const bool app = s.appCommand;
+    s.appCommand = false;
+    if (app) {
+        switch (r.command) {
+            case 6:  // ACMD6 SET_BUS_WIDTH
+                WriteResponse(outPtr, outLen, {kR1Transfer});
+                return kOk;
+            case 41:  // ACMD41 SD_SEND_OP_COND
+                WriteResponse(outPtr, outLen, {0x80FF8000u | (s.sdhc ? 0x40000000u : 0u)});
+                return kOk;
+            case 51:  // ACMD51 SEND_SCR (8 bytes of data)
+                if (r.dmaAddress && Memory::Contains(r.dmaAddress, 8)) {
+                    Memory::Write32(r.dmaAddress, 0x02350000u);
+                    Memory::Write32(r.dmaAddress + 4, 0);
+                }
+                WriteResponse(outPtr, outLen, {kR1Transfer});
+                return kOk;
+            default:
+                break;   // fall through to the regular command set
+        }
+    }
+    switch (r.command) {
+        case 0:   // GO_IDLE_STATE
+            return kOk;
+        case 2:   // ALL_SEND_CID
+        case 10:  // SEND_CID
+            WriteResponse(outPtr, outLen, {0x80114D1Cu, 0x80080000u, 0x8007B520u, 0x80080000u});
+            return kOk;
+        case 3:   // SEND_RELATIVE_ADDR
+            WriteResponse(outPtr, outLen, {kRca << 16});
+            return kOk;
+        case 7:   // SELECT/DESELECT_CARD
+        case 12:  // STOP_TRANSMISSION
+        case 16:  // SET_BLOCKLEN
+        case 13:  // SEND_STATUS
+            WriteResponse(outPtr, outLen, {kR1Transfer});
+            return kOk;
+        case 8:   // SEND_IF_COND: echo the check pattern and voltage
+            WriteResponse(outPtr, outLen, {r.arg});
+            return kOk;
+        case 9: { // SEND_CSD
+            const auto csd = Csd(s);
+            WriteResponse(outPtr, outLen, {csd[0], csd[1], csd[2], csd[3]});
+            return kOk;
+        }
+        case 17:  // READ_SINGLE_BLOCK
+        case 18:  // READ_MULTIPLE_BLOCK
+            WriteResponse(outPtr, outLen, {kR1Transfer});
+            return Transfer(s, r, false);
+        case 24:  // WRITE_BLOCK
+        case 25:  // WRITE_MULTIPLE_BLOCK
+            WriteResponse(outPtr, outLen, {kR1Transfer});
+            return Transfer(s, r, true);
+        case 55:  // APP_CMD
+            s.appCommand = true;
+            WriteResponse(outPtr, outLen, {kR1Transfer | 0x20u});
+            return kOk;
+        default:
+            RT_LOG(RT_TAG_NAND) << "sdio: unhandled command " << r.command << " arg=0x" << std::hex << r.arg << std::dec
+                                << std::endl;
+            WriteResponse(outPtr, outLen, {kR1Transfer});
+            return kOk;
+    }
+}
+
+uint32_t Status(const Slot& s) {
+    if (!s.image) {
+        return 0;
+    }
+    return kCardInserted | kCardInitialized | (s.sdhc ? kCardSdhc : 0u);
+}
+
+} // namespace
+
+bool Sdio_HLE_IsFd(uint32_t fd) {
+    return static_cast<int32_t>(fd) == kSdioFd;
+}
+
+int32_t Sdio_HLE_Open(const char* path) {
+    if (!path || std::string_view(path) != "/dev/sdio/slot0") {
+        return 0;
+    }
+    Slot& s = State();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    OpenImage(s);
+    s.opened = true;
+    return kSdioFd;
+}
+
+int32_t Sdio_HLE_Close(uint32_t) {
+    Slot& s = State();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.opened = false;
+    if (s.image) {
+        std::fflush(s.image);
+    }
+    return kOk;
+}
+
+int32_t Sdio_HLE_Ioctl(uint32_t, uint32_t cmd, uint32_t inPtr, uint32_t inLen, uint32_t outPtr, uint32_t outLen) {
+    Slot& s = State();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    switch (cmd) {
+        case kIoctlWriteHcr: {
+            if (inLen < 24 || !Memory::Contains(inPtr, 24)) {
+                return kEinval;
+            }
+            const uint32_t reg = Memory::Read32(inPtr) & 0xFF;
+            uint32_t value = Memory::Read32(inPtr + 16);
+            if (reg == kHcrClockControl && (value & 1u)) {
+                value |= 2u;   // internal clock stable
+            } else if (reg == kHcrSoftwareReset) {
+                value = 0;     // reset completes immediately
+            }
+            s.hcr[(reg >> 2) & 0x3F] = value;
+            return kOk;
+        }
+        case kIoctlReadHcr: {
+            if (inLen < 24 || !Memory::Contains(inPtr, 24)) {
+                return kEinval;
+            }
+            const uint32_t reg = Memory::Read32(inPtr) & 0xFF;
+            WriteResponse(outPtr, outLen, {s.hcr[(reg >> 2) & 0x3F]});
+            return kOk;
+        }
+        case kIoctlResetCard:
+            OpenImage(s);
+            WriteResponse(outPtr, outLen, {kRca << 16});
+            return kOk;
+        case kIoctlSetClock:
+            return kOk;
+        case kIoctlSendCmd:
+            if (inLen < 32 || !Memory::Contains(inPtr, 32)) {
+                return kEinval;
+            }
+            return SendCommand(s, ReadRequest(inPtr), outPtr, outLen);
+        case kIoctlGetStatus:
+            WriteResponse(outPtr, outLen, {Status(s)});
+            return kOk;
+        case kIoctlGetOcr:
+            WriteResponse(outPtr, outLen, {0x80FF8000u | (s.sdhc ? 0x40000000u : 0u)});
+            return kOk;
+        default:
+            RT_LOG(RT_TAG_NAND) << "sdio: unhandled ioctl " << cmd << std::endl;
+            return kEinval;
+    }
+}
+
+int32_t Sdio_HLE_Ioctlv(uint32_t, uint32_t cmd, uint32_t numIn, uint32_t numOut, uint32_t vectorPtr) {
+    if (cmd != kIoctlSendCmd || numIn < 1 || !vectorPtr || !Memory::Contains(vectorPtr, (numIn + numOut) * 8u)) {
+        return kEinval;
+    }
+    const uint32_t reqPtr = Memory::Read32(vectorPtr), reqLen = Memory::Read32(vectorPtr + 4);
+    if (reqLen < 32 || !Memory::Contains(reqPtr, 32)) {
+        return kEinval;
+    }
+    Request r = ReadRequest(reqPtr);
+    if (numIn >= 2) {   // data buffer vector: authoritative DMA target
+        r.dmaAddress = Memory::Read32(vectorPtr + 8);
+    }
+    uint32_t outPtr = 0, outLen = 0;
+    if (numOut >= 1) {
+        outPtr = Memory::Read32(vectorPtr + numIn * 8u);
+        outLen = Memory::Read32(vectorPtr + numIn * 8u + 4);
+    }
+    Slot& s = State();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    return SendCommand(s, r, outPtr, outLen);
+}
