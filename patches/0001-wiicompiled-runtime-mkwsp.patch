+constexpr uint32_t kEarlyRelStart = 0x805102E0u;   // StaticR image (header through .data)
+constexpr uint32_t kEarlyRelEnd = 0x808DD3E0u;
+std::vector<std::pair<uint32_t, uint8_t>>& EarlyRelPatchBytes() {
+    static std::vector<std::pair<uint32_t, uint8_t>> bytes;
+    return bytes;
+}
+bool& EarlyRelPatchesPending() {
+    static bool pending = false;
+    return pending;
+}
