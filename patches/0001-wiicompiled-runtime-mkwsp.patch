+            return netFd;
+        }
+        if (const int32_t btFd = Bluetooth_HLE_OpenDevice(path)) {
+            return btFd;
+        }
+        if (std::strcmp(path, "/dev/dolphin") == 0) {
+            return DOLPHIN_DEV_FD;
+        }
+        if (const int32_t sdFd = Sdio_HLE_Open(path)) {
+            return sdFd;
