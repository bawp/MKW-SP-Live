+
+void RunEarlyMemoryInitializers() {
+    const size_t length = kEarlyRelEnd - kEarlyRelStart;
+    std::vector<uint8_t> before(length);
+    std::memcpy(before.data(), Memory::GetPointer(kEarlyRelStart, length), length);
+    RunMemoryInitializers();
+    const uint8_t* after = Memory::GetPointer(kEarlyRelStart, length);
+    auto& bytes = EarlyRelPatchBytes();
+    bytes.clear();
+    for (size_t i = 0; i < length; ++i) {
+        if (after[i] != before[i]) {
+            bytes.emplace_back(kEarlyRelStart + static_cast<uint32_t>(i), after[i]);
+        }
+    }
+    EarlyRelPatchesPending() = true;
+    g_executableWriteGuardEnabled.store(false, std::memory_order_release);
+    RT_LOG(RT_TAG_MOD) << "early mod memory initializers ran; " << bytes.size()
+                       << " StaticR byte(s) will be re-applied after the REL is linked" << std::endl;
+}
+
+bool EarlyMemoryInitializersRan() {
+    return !EarlyRelPatchBytes().empty();
+}
+
+void ReapplyEarlyRelPatches() {
+    if (!EarlyRelPatchesPending()) {
+        return;
+    }
+    EarlyRelPatchesPending() = false;
+    for (const auto& [address, value] : EarlyRelPatchBytes()) {
+        *Memory::GetPointer(address) = value;
+    }
+    {
+        std::lock_guard<std::mutex> lock(ModMutex());
+        if (!ExecutableRanges().empty()) {
+            g_executableWriteGuardEnabled.store(true, std::memory_order_release);
+        }
+    }
+    RT_LOG(RT_TAG_MOD) << "re-applied " << EarlyRelPatchBytes().size() << " StaticR patch byte(s)" << std::endl;
+}
+
+void RunMemoryInitializers() {
+    std::vector<InitializerFn> pending;
+    {
+        std::lock_guard<std::mutex> lock(ModMutex());
+        if (MemoryInitializersRan()) {
+            return;
+        }
+        MemoryInitializersRan() = true;
+        pending = MemoryInitializers();
+    }
+
+    for (auto* fn : pending) {
+        fn();
+    }
+
+    if (!pending.empty()) {
+        RT_LOG(RT_TAG_MOD) << "Ran " << pending.size() << " recomp mod memory initializer(s)" << std::endl;
+    }
+}
