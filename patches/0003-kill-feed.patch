+// ---------------------------------------------------------------------------------------------
+// Native replacements of the hit-counting leaves
+
+// lwz r0,4(r3); lis r3,0x809c; addi r3,r3,0x2f48; mulli r0,r0,116; add r3,r3,r0; lbz r3,89(r3)
+extern "C" void ItemObjectHitFlag_HLE_807a2234(CpuContext* ctx) {
+    const uint32_t item = ctx->gpr[3];
+    const uint32_t type = Memory::Read32(item + 4);
+    const uint32_t r0 = type * 116u;
+    ctx->gpr[0] = r0;
+    ctx->gpr[3] = Memory::Read8(0x809C2F48u + r0 + 89u);
+    if (ctx->lr == kItemObjectHitLr && type < kItemCount &&
+        std::find(kHiddenItems.begin(), kHiddenItems.end(), static_cast<Item>(type)) == kHiddenItems.end()) {
+        // Called only after Damage::SetDamage accepted the hit. r23 = ItemObj owner, r24 = victim.
+        const uint32_t owner = ctx->gpr[23] & 0xFF, victim = ctx->gpr[24] & 0xFF;
+        Guarded([&] { AddEntry(owner, victim, static_cast<Item>(type)); });
+    }
+}
+
+// IncrementItemStat only changes r0, r3, r4 and cr0; the hooks read the caller's other registers.
+extern "C" void IncrementItemsHitCount_HLE_805918bc(CpuContext* ctx) {
+    const uint32_t proxy = ctx->gpr[3];
+    IncrementItemStat(ctx, 8);
+    Guarded([&] { OnHitDelivered(ctx, proxy); });
+}
+
+extern "C" void IncrementItemsCollisionCount_HLE_805918e0(CpuContext* ctx) {
+    const uint32_t proxy = ctx->gpr[3];
+    IncrementItemStat(ctx, 12);
+    Guarded([&] { OnHitReceived(ctx, proxy); });
+}
+
+PPC_NATIVE_OVERRIDE_VOID(807A2234, ItemObjectHitFlag_HLE_807a2234, (CpuContext* ctx), (ctx));
+PPC_NATIVE_OVERRIDE_VOID(805918BC, IncrementItemsHitCount_HLE_805918bc, (CpuContext* ctx), (ctx));
+PPC_NATIVE_OVERRIDE_VOID(805918E0, IncrementItemsCollisionCount_HLE_805918e0, (CpuContext* ctx), (ctx));
+
