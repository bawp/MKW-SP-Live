+// ---------------------------------------------------------------------------------------------
+// Drawing
+
+ImU32 TintColor(Tint tint, float alpha) {
+    // Valorant: your team teal-green, the enemy red.
+    switch (tint) {
+    case Tint::Ally: return IM_COL32(56, 196, 166, static_cast<int>(alpha * 255));
+    case Tint::Enemy: return IM_COL32(222, 72, 84, static_cast<int>(alpha * 255));
+    default: return IM_COL32(120, 120, 132, static_cast<int>(alpha * 255));
+    }
+}
+
+ImVec2 MeasureText(float size, const std::string& text) {
+    ImFont* font = g_font ? g_font : ImGui::GetFont();
+    return font->CalcTextSizeA(size, FLT_MAX, 0.0f, text.c_str());
+}
+
+void DrawText(ImDrawList* list, float size, ImVec2 pos, float alpha, const std::string& text) {
+    ImFont* font = g_font ? g_font : ImGui::GetFont();
+    if (g_font) list->PushTextureID(g_fontAtlas->TexID);
+    list->AddText(font, size, ImVec2(pos.x + 1.0f, pos.y + 1.5f), IM_COL32(0, 0, 0, static_cast<int>(alpha * 150)), text.c_str());
+    list->AddText(font, size, pos, IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)), text.c_str());
+    if (g_font) list->PopTextureID();
+}
+
+// The rectangle the game image occupies in the window (letter/pillarboxed when its aspect differs).
+void GameRect(ImVec2& origin, ImVec2& size) {
+    const ImGuiIO& io = ImGui::GetIO();
+    u32 renderWidth = 0, renderHeight = 0;
+    AuroraGetRenderSize(&renderWidth, &renderHeight);
+    float aspect = renderWidth && renderHeight ? float(renderWidth) / float(renderHeight)
+                                               : io.DisplaySize.x / std::max(1.0f, io.DisplaySize.y);
+    size = io.DisplaySize;
+    if (size.x / std::max(1.0f, size.y) > aspect) {
+        size.x = size.y * aspect;
+    } else {
+        size.y = size.x / aspect;
+    }
+    origin = ImVec2((io.DisplaySize.x - size.x) * 0.5f, (io.DisplaySize.y - size.y) * 0.5f);
+}
+
+float Smooth(float t) {
+    t = std::clamp(t, 0.0f, 1.0f);
+    return t * t * (3.0f - 2.0f * t);
+}
+
+void DrawEntry(ImDrawList* list, const Entry& entry, float right, float top, float rowHeight, Clock::time_point now) {
+    const float age = std::chrono::duration<float>(now - entry.born).count();
+    const float lifetime = std::chrono::duration<float>(kEntryLifetime).count();
+    const float fade = std::chrono::duration<float>(kFadeOut).count();
+    const float slide = Smooth(age / std::chrono::duration<float>(kSlideIn).count());
+    const float alpha = slide * Smooth((lifetime - age) / fade);
+    if (alpha <= 0.0f) return;
+
+    const float textSize = rowHeight * 0.56f;
+    const float pad = rowHeight * 0.36f;
+    const float iconSize = rowHeight * 0.86f;
+    const float iconSlot = iconSize + pad;
+    const float attackerWidth = entry.hasAttacker ? MeasureText(textSize, entry.attacker.text).x + pad * 2.0f : pad * 0.5f;
+    const float victimWidth = entry.victim.text.empty() ? pad * 0.5f : MeasureText(textSize, entry.victim.text).x + pad * 2.0f;
+    const float width = attackerWidth + iconSlot + victimWidth;
+    const float x0 = right - width + (1.0f - slide) * rowHeight * 2.0f;
+    const float x1 = x0 + width;
+    const float y0 = top, y1 = top + rowHeight;
+    const float split = x0 + attackerWidth + iconSlot * 0.5f;
+
+    list->AddRectFilled(ImVec2(x0, y0), ImVec2(x1, y1), IM_COL32(12, 12, 18, static_cast<int>(alpha * 120)));
+    if (entry.hasAttacker) {
+        list->AddRectFilledMultiColor(ImVec2(x0, y0), ImVec2(split, y1),
+                                      TintColor(entry.attacker.tint, alpha * 0.92f), TintColor(entry.attacker.tint, alpha * 0.40f),
+                                      TintColor(entry.attacker.tint, alpha * 0.40f), TintColor(entry.attacker.tint, alpha * 0.92f));
+    }
+    if (!entry.victim.text.empty()) {
+        list->AddRectFilledMultiColor(ImVec2(split, y0), ImVec2(x1, y1),
+                                      TintColor(entry.victim.tint, alpha * 0.40f), TintColor(entry.victim.tint, alpha * 0.92f),
+                                      TintColor(entry.victim.tint, alpha * 0.92f), TintColor(entry.victim.tint, alpha * 0.40f));
+    }
+    // Your own hits get Valorant's outline and edge marker, in the yellow of MKW's timer/lap digits.
+    if (entry.attacker.local || (!entry.hasAttacker && entry.victim.local)) {
+        const float stroke = std::max(1.0f, rowHeight * 0.05f);
+        list->AddRect(ImVec2(x0, y0), ImVec2(x1, y1), IM_COL32(255, 222, 40, static_cast<int>(alpha * 235)), 0.0f, 0, stroke);
+        list->AddRectFilled(ImVec2(x0, y0), ImVec2(x0 + stroke * 3.0f, y1), IM_COL32(255, 222, 40, static_cast<int>(alpha * 255)));
+    }
+
+    const float textY = y0 + (rowHeight - textSize) * 0.5f - textSize * 0.04f;
+    if (entry.hasAttacker) {
+        DrawText(list, textSize, ImVec2(x0 + pad, textY), alpha, entry.attacker.text);
+    }
+    const float iconX = x0 + attackerWidth + pad * 0.5f;
+    const float iconY = y0 + (rowHeight - iconSize) * 0.5f;
+    const size_t item = static_cast<size_t>(entry.item);
+    if (g_iconTexture && g_iconLoaded[item]) {
+        const float u0 = float(item * kIconSize) / kIconAtlasWidth, u1 = float((item + 1) * kIconSize) / kIconAtlasWidth;
+        list->AddImage(g_iconTexture, ImVec2(iconX, iconY), ImVec2(iconX + iconSize, iconY + iconSize),
+                       ImVec2(u0, 0.0f), ImVec2(u1, 1.0f), IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)));
+    } else {
+        list->AddCircleFilled(ImVec2(iconX + iconSize * 0.5f, iconY + iconSize * 0.5f), iconSize * 0.3f,
+                              IM_COL32(255, 255, 255, static_cast<int>(alpha * 255)));
+    }
+    if (!entry.victim.text.empty()) {
+        DrawText(list, textSize, ImVec2(x0 + attackerWidth + iconSlot + pad, textY), alpha, entry.victim.text);
+    }
+}
