+void InstallSettingEntry() noexcept {
+    try {
+        const uint32_t target = kSettingEntries + kRoomCodeLowSetting * kSettingEntrySize;
+        const uint32_t source = kSettingEntries + kVanillaModeSetting * kSettingEntrySize;
+        auto nameIs = [](uint32_t entry, std::string_view expected) {
+            if (Memory::Read32(entry + 4) != expected.size()) return false;
+            const uint32_t text = Memory::Read32(entry + 8);
+            for (size_t i = 0; i < expected.size(); ++i) {
+                if (Memory::Read8(text + static_cast<uint32_t>(i)) != static_cast<uint8_t>(expected[i])) return false;
+            }
+            return true;
+        };
+        // Layout checks: the converted payload must be the one this was written against.
+        if (Memory::Read32(kDataBlock) != kDataMagic || !nameIs(target, "RoomCodeLow") || Memory::Read32(target + 20) != 0 ||
+            !nameIs(source, "VanillaMode") || Memory::Read32(source + 20) != 2) {
+            std::cout << "[killfeed] MKW-SP settings layout not recognised (block 0x" << std::hex << Memory::Read32(kDataBlock)
+                      << ", slot 54 name len " << Memory::Read32(target + 4) << " count " << Memory::Read32(target + 20)
+                      << ", slot 3 name len " << Memory::Read32(source + 4) << " count " << Memory::Read32(source + 20) << std::dec
+                      << "); Kill Feed has no settings entry (always on)" << std::endl;
+            return;
+        }
+        // RoomCodeLow only served mkw-sp.com friend rooms (offline). Reuse it as an Enable/Disable
+        // Race setting cloned from VanillaMode (same value names and "Disable"/"Enable" texts).
+        for (uint32_t offset = 0; offset < kSettingEntrySize; offset += 4) {
+            Memory::Write32(target + offset, Memory::Read32(source + offset));
+        }
+        Memory::Write32(target + 4, 8);                                  // name: "KillFeed"
+        Memory::Write32(target + 8, kDataBlock + 16);
+        Memory::Write32(target + 12, Memory::Read32(kDataBlock + 12));   // title message
+        Memory::Write32(target + 16, 1);                                 // default: Enable
+        Memory::Write32(target + 36, kDataBlock + 4);                    // value explanations
+        Memory::Write8(target + 44, 0);                                  // no vanilla-mode override
+        Memory::Write8(target + 48, 0);                                  // visible
+        g_settingInstalled = true;
+        std::cout << "[killfeed] Settings > Race > Kill Feed installed (setting slot " << kRoomCodeLowSetting << ")" << std::endl;
+    } catch (const Memory::AccessViolation& e) {
+        std::cout << "[killfeed] could not install the settings entry (guest access at 0x" << std::hex << e.address() << std::dec << ")" << std::endl;
+    }
+}
+
+void Draw() noexcept {
+    // MKWSP_KILLFEED_PREVIEW=1 shows sample rows on any screen (layout checks without a race).
+    static const bool preview = std::getenv("MKWSP_KILLFEED_PREVIEW") != nullptr;
+    if (preview) {
+        std::lock_guard lock(g_mutex);
+        const auto now = Clock::now();
+        if (g_entries.empty() || now - g_entries.back().born > std::chrono::milliseconds(1500)) {
+            struct Sample { const char* attacker; Tint at; bool local; Item item; const char* victim; Tint vt; };
+            static const Sample kSamples[] = {
+                {"Player", Tint::Ally, true, Item::RedShell, "Funky Kong", Tint::Enemy},
+                {"Bowser", Tint::Enemy, false, Item::Banana, "Peach", Tint::Enemy},
+                {"Wario", Tint::Enemy, false, Item::Bomb, "Toad", Tint::Enemy},
+                {"Wario", Tint::Enemy, false, Item::Bomb, "Player", Tint::Ally},
+                {"Player", Tint::Ally, true, Item::Star, "Toad", Tint::Enemy},
+                {"Daisy", Tint::Enemy, false, Item::BlueShell, "Player", Tint::Ally},
+                {"", Tint::Neutral, false, Item::Bomb, "King Boo", Tint::Enemy},
+                {"Luigi", Tint::Enemy, false, Item::Bullet, "Yoshi", Tint::Enemy},
+                {"Rosalina", Tint::Enemy, false, Item::GreenShell, "Mario", Tint::Enemy},
+            };
+            static size_t next = 0;
+            const Sample& s = kSamples[next++ % std::size(kSamples)];
+            Entry entry;
+            entry.id = g_nextId++;
+            entry.item = s.item;
+            entry.born = now;
+            entry.hasAttacker = s.attacker[0] != '\0';
+            entry.attacker = Side{s.attacker, s.at, s.local};
+            entry.victim = Side{s.victim, s.vt, std::string_view(s.victim) == "Player"};
+            g_entries.push_back(std::move(entry));
+        }
+    }
+    uint32_t raceInfo = 0;
+    if (!preview && (!Memory::TryRead32(kRaceInfoInstance, raceInfo) || raceInfo == 0 || !ReadSettingEnabled())) {
+        std::lock_guard lock(g_mutex);
+        g_entries.clear();
+        return;
+    }
+    const auto now = Clock::now();
+    std::lock_guard lock(g_mutex);
+    while (!g_entries.empty() && now - g_entries.front().born >= kEntryLifetime) {
+        g_entries.pop_front();
+    }
+    if (g_entries.empty()) {
+        return;
+    }
+    if (!g_fontTried) LoadFont();
+    if (!g_iconsTried) LoadIcons();
+
+    ImVec2 origin, size;
+    GameRect(origin, size);
+    // MKW's race HUD scales with the screen height and hugs the right edge: the timer's right
+    // edge sits ~0.11 heights from it and the lap counter ends ~0.26 heights down.
+    const float rowHeight = std::round(size.y * 0.036f);
+    const float right = origin.x + size.x - size.y * 0.105f;
+    float top = origin.y + size.y * 0.285f;
+    ImDrawList* list = ImGui::GetBackgroundDrawList();
+    const size_t first = g_entries.size() > kMaxEntries ? g_entries.size() - kMaxEntries : 0;
+    for (size_t i = first; i < g_entries.size(); ++i) {
+        DrawEntry(list, g_entries[i], right, top, rowHeight, now);
+        top += rowHeight * 1.14f;
+    }
+}
