+// Valorant-style kill feed for MKW-SP (see kill_feed.h).
+//
+// Hit detection: the game counts item hits for its license statistics through a few leaf
+// functions, called right where a hit lands. Those are reimplemented natively here (same
+// register effects), and the call site (ctx->lr) plus the caller's registers, which are still in
+// the context at entry, say who hit whom with what:
+//   * 0x807A2234  item-object flag lookup, called by Kart::Collision::CheckItemCollision once
+//                 Damage::SetDamage accepted the hit: r23 = item owner, r24 = victim, r3 = ItemObj
+//                 (shells, bananas, fake boxes, bombs, blue shells, ...).
+//   * 0x805918BC  Kart::Link::IncrementItemsHitCount (attacker side) and
+//   * 0x805918E0  Kart::Link::IncrementItemsCollisionCount (victim side): star / Mega / Bullet
+//                 bumps in CheckKartCollision (lightning, POW, blooper and thunder cloud are left out).
+// Player names, teams and the local player come from RaceConfig; the item silhouettes are cut
+// from the game's own item icons in Scene/UI/Race.szs.
+
+#include "kill_feed.h"
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "runtime_config.h"
+
+#include <aurora/imgui.h>
+#include <dolphin/gx/GXAurora.h>
+#include <imgui.h>
+
+#include <algorithm>
+#include <array>
+#include <cfloat>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <mutex>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+// ---------------------------------------------------------------------------------------------
+// Guest layout (PAL, vanilla REL layout; MKW-SP payload addresses are link address + kPayloadShift,
+// see tools/convert.js)
+
+constexpr uint32_t kRaceConfigInstance = 0x809BD728;   // System::RaceConfig::s_instance
+constexpr uint32_t kRaceInfoInstance = 0x809BD730;     // RaceManager / Raceinfo, null outside races
+constexpr uint32_t kSaveManagerInstance = 0x809BD748;  // System::SaveManager::s_instance
+constexpr uint32_t kRaceConfigPlayers = 0x28;          // RaceConfig::raceScenario.players[]
+constexpr uint32_t kPlayerSize = 0xF0;
+constexpr uint32_t kPlayerCharacter = 0x0C;
+constexpr uint32_t kPlayerType = 0x10;                  // 0 local, 1 CPU, 3 ghost, 4 online, 5 none
+constexpr uint32_t kPlayerMiiName = 0x14 + 0x68;        // Player::mii (System::Mii), Mii::name()
+constexpr uint32_t kPlayerTeam = 0xCC;                  // 2 = no team
+constexpr uint32_t kMaxPlayers = 12;
+constexpr uint32_t kNoTeam = 2;
+
+constexpr uint32_t kPayloadShift = 0x010A0000;
+constexpr uint32_t kSettingEntries = 0x80850048 + kPayloadShift;  // SP::ClientSettings::entries[67]
+constexpr uint32_t kSettingEntrySize = 52;
+constexpr uint32_t kVanillaModeSetting = 3;
+constexpr uint32_t kRoomCodeLowSetting = 54;   // becomes Kill Feed (index in this MKW-SP build)
+constexpr uint32_t kSettingCount = 67;
+// SaveManager: per-license setting values (u32[67] per license), current license, license loaded
+constexpr uint32_t kSaveSettingValues = 0x2500C;
+constexpr uint32_t kSaveCurrentLicense = 0x25654;
+constexpr uint32_t kSaveLicenseLoaded = 0x25655;
+// tools/convert.js "kill feed data block": magic, explanation message IDs[2], title message ID, name
+constexpr uint32_t kDataBlock = 0x81962D80;
+constexpr uint32_t kDataMagic = 0x4B464431;  // 'KFD1'
+
+// ---------------------------------------------------------------------------------------------
+// Items. The order matches the game's ItemObj type IDs (ItemObj+0x4).
+
+enum class Item : uint8_t {
+    GreenShell, RedShell, Banana, Mushroom, Star, BlueShell, Lightning, FakeBox, Mega, Bomb,
+    Blooper, Pow, GoldenMushroom, Bullet, ThunderCloud, Count
+};
+constexpr size_t kItemCount = static_cast<size_t>(Item::Count);
+constexpr std::array<const char*, kItemCount> kIconFiles = {
+    "tt_item_kame_green.tpl", "tt_item_kame_red.tpl", "tt_item_banana.tpl", "tt_item_kinoko.tpl",
+    "tt_item_star.tpl", "tt_item_kame_wing.tpl", "tt_item_thunder.tpl", "tt_item_dummybox.tpl",
+    "fm_item_kinoko_l.tpl", "tt_item_bomb_hei.tpl", "fm_item_gesso.tpl", "fm_item_pow.tpl",
+    "tt_item_GoldenKinoko.tpl", "tt_item_killer.tpl", "fm_item_pikakumo.tpl",
+};
+
+// ---------------------------------------------------------------------------------------------
+// Hit sites (return addresses into the game)
+
+// Kart::Collision::CheckKartCollision: the two karts are r31 and r30+4 (Kart::Link). Which tier
+// the bump came from is fixed per site; the damage type it applies (Damage::SetDamage r4) is
+// 6 = ApplyBulletDamage, 3 = ApplyStarDamage, 13 = ApplyMegaDamage.
+struct KartBumpSite {
+    uint32_t lr;
+    Item item;
+};
+constexpr KartBumpSite kKartBumpSites[] = {
+    {0x8056FF2C, Item::Bullet}, {0x8056FFB0, Item::Bullet},
+    {0x805701FC, Item::Star},   {0x80570390, Item::Star},
+    {0x80570594, Item::Mega},   {0x8057071C, Item::Mega},
+};
+
+// Not shown in the feed: lightning, POW, blooper and thunder cloud (they also count as item hits),
+// plus calls already covered by another hook (the other half of a pair, the item-object path).
+constexpr std::array<Item, 4> kHiddenItems = {Item::Lightning, Item::Pow, Item::Blooper, Item::ThunderCloud};
+constexpr uint32_t kItemObjectHitLr = 0x805727C8;    // CheckItemCollision -> 0x807A2234
+constexpr uint32_t kKnownLrs[] = {
+    0x8057280C,                                                          // item object, victim
+    0x8056FF24, 0x8056FFB8, 0x805701F4, 0x80570398, 0x8057058C, 0x80570724,  // kart bumps, victim
+    0x807B7D60, 0x807987D0,                                              // lightning (hidden)
+    0x807B2458, 0x80581378,                                              // POW (hidden)
+    0x807A948C, 0x80581B04,                                              // blooper ink (hidden)
+    0x807AF724, 0x807AFD74, 0x807AFF18, 0x807AF738, 0x807AFD88, 0x807AFF2C,  // thunder cloud (hidden)
+};
+constexpr uint32_t kHitDeliveredLr = 0x807D19E0;     // 0x807D19C8 (owner's "hit someone" reaction)
+constexpr uint32_t kHitDeliveredItemObjectLr = 0x80572AC8;
+
+// ---------------------------------------------------------------------------------------------
+// Feed state
+
+enum class Tint : uint8_t { Ally, Enemy, Neutral };
+
+struct Side {
+    std::string text;
+    Tint tint = Tint::Neutral;
+    bool local = false;
+};
+
+struct Entry {
+    uint64_t id = 0;
+    Item item = Item::GreenShell;
+    bool hasAttacker = false;
+    Side attacker;
+    Side victim;
+    Clock::time_point born;
+};
+
+constexpr auto kEntryLifetime = std::chrono::milliseconds(6000);
+constexpr auto kFadeOut = std::chrono::milliseconds(500);
+constexpr auto kSlideIn = std::chrono::milliseconds(180);
+constexpr size_t kMaxEntries = 6;
+
+std::mutex g_mutex;
+std::deque<Entry> g_entries;
+uint64_t g_nextId = 1;
+bool g_settingInstalled = false;
+
+// ---------------------------------------------------------------------------------------------
+// Guest helpers
+
+uint32_t ProxyPlayerIdx(uint32_t proxy) {
+    // KartObjectProxy -> accessor -> KartSettings::playerIdx (Kart::Link::GetPlayerIdx)
+    return Memory::Read8(Memory::Read32(Memory::Read32(proxy)) + 0x10);
+}
+
+std::string Utf16BeToUtf8(uint32_t address, size_t maxChars) {
+    std::string out;
+    for (size_t i = 0; i < maxChars; ++i) {
+        uint32_t c = Memory::Read16(address + static_cast<uint32_t>(i * 2));
+        if (c == 0) {
+            break;
+        }
+        if (c >= 0xD800 && c <= 0xDFFF) {
+            c = '?';
+        }
+        if (c < 0x80) {
+            out.push_back(static_cast<char>(c));
+        } else if (c < 0x800) {
+            out.push_back(static_cast<char>(0xC0 | (c >> 6)));
+            out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+        } else {
+            out.push_back(static_cast<char>(0xE0 | (c >> 12)));
+            out.push_back(static_cast<char>(0x80 | ((c >> 6) & 0x3F)));
+            out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+        }
+    }
+    return out;
+}
+
+constexpr std::array<const char*, 24> kCharacterNames = {
+    "Mario", "Baby Peach", "Waluigi", "Bowser", "Baby Daisy", "Dry Bones", "Baby Mario", "Luigi",
+    "Toad", "Donkey Kong", "Yoshi", "Wario", "Baby Luigi", "Toadette", "Koopa Troopa", "Daisy",
+    "Peach", "Birdo", "Diddy Kong", "King Boo", "Bowser Jr.", "Dry Bowser", "Funky Kong", "Rosalina",
+};
+
+struct PlayerInfo {
+    bool valid = false;
+    std::string name;
+    bool local = false;
+    bool cpu = false;
+    uint32_t team = kNoTeam;
+};
+
+PlayerInfo ReadPlayer(uint32_t idx) {
+    PlayerInfo info;
+    if (idx >= kMaxPlayers) {
+        return info;
+    }
+    try {
+        const uint32_t raceConfig = Memory::Read32(kRaceConfigInstance);
+        if (raceConfig == 0) {
+            return info;
+        }
+        const uint32_t player = raceConfig + kRaceConfigPlayers + idx * kPlayerSize;
+        const uint32_t type = Memory::Read32(player + kPlayerType);
+        if (type == 5) {
+            return info;
+        }
+        const uint32_t character = Memory::Read32(player + kPlayerCharacter);
+        info.valid = true;
+        info.local = type == 0;
+        info.cpu = type == 1;
+        info.team = Memory::Read32(player + kPlayerTeam);
+        if (type != 1) {
+            info.name = Utf16BeToUtf8(player + kPlayerMiiName, 10);
+        }
+        if (info.name.empty()) {
+            info.name = character < kCharacterNames.size() ? kCharacterNames[character] : "Mii";
+        }
+    } catch (const Memory::AccessViolation&) {
+        info = PlayerInfo{};
+    }
+    return info;
+}
+
+// "Ally" means a local player or a local player's teammate, as Valorant colours your team.
+std::array<PlayerInfo, kMaxPlayers> ReadRoster(uint32_t& localTeam) {
+    std::array<PlayerInfo, kMaxPlayers> roster;
+    localTeam = kNoTeam;
+    for (uint32_t i = 0; i < kMaxPlayers; ++i) {
+        roster[i] = ReadPlayer(i);
+        if (roster[i].valid && roster[i].local && localTeam == kNoTeam) {
+            localTeam = roster[i].team;
+        }
+    }
+    return roster;
+}
+
+// One local racer and every other racer a CPU (single-player VS / battle).
+bool IsSinglePlayerVsCpus(const std::array<PlayerInfo, kMaxPlayers>& roster) {
+    int locals = 0;
+    for (const PlayerInfo& p : roster) {
+        if (!p.valid) continue;
+        if (p.local) ++locals;
+        else if (!p.cpu) return false;
+    }
+    return locals == 1;
+}
+
+Tint TintFor(const PlayerInfo& player, uint32_t localTeam) {
+    if (player.local || (localTeam != kNoTeam && player.team == localTeam)) {
+        return Tint::Ally;
+    }
+    return Tint::Enemy;
+}
+
+bool ReadSettingEnabled() {
+    if (!g_settingInstalled) {
+        return true;  // no toggle could be installed: keep the feed on
+    }
+    try {
+        const uint32_t entry = kSettingEntries + kRoomCodeLowSetting * kSettingEntrySize;
+        const uint32_t saveManager = Memory::Read32(kSaveManagerInstance);
+        if (saveManager == 0 || Memory::Read8(saveManager + kSaveLicenseLoaded) == 0) {
+            return Memory::Read32(entry + 16) != 0;  // default value
+        }
+        const uint32_t license = Memory::Read8(saveManager + kSaveCurrentLicense);
+        return Memory::Read32(saveManager + kSaveSettingValues + (license * kSettingCount + kRoomCodeLowSetting) * 4) != 0;
+    } catch (const Memory::AccessViolation&) {
+        return true;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Recording (guest thread, from the hooks below). Every hit is its own row: a bomb or blue shell
+// that catches three racers produces three rows with the same attacker.
+
+void AddEntry(uint32_t attacker, uint32_t victim, Item item) {
+    if (!ReadSettingEnabled()) {
+        return;
+    }
+    uint32_t localTeam = kNoTeam;
+    const auto roster = ReadRoster(localTeam);
+    if (victim >= kMaxPlayers || !roster[victim].valid) {
+        return;
+    }
+    // Single player against CPUs: only hits involving you, no CPU-on-CPU rows.
+    if (IsSinglePlayerVsCpus(roster) && !roster[victim].local && !(attacker < kMaxPlayers && roster[attacker].local)) {
+        return;
+    }
+    Entry entry;
+    entry.id = g_nextId++;
+    entry.item = item;
+    entry.born = Clock::now();
+    // A self hit (own banana, own shell bouncing back) shows like a Valorant environment death.
+    entry.hasAttacker = attacker < kMaxPlayers && roster[attacker].valid && attacker != victim;
+    if (entry.hasAttacker) {
+        entry.attacker.text = roster[attacker].name;
+        entry.attacker.tint = TintFor(roster[attacker], localTeam);
+        entry.attacker.local = roster[attacker].local;
+    }
+    entry.victim.text = roster[victim].name;
+    entry.victim.tint = TintFor(roster[victim], localTeam);
+    entry.victim.local = roster[victim].local;
+
+    std::lock_guard lock(g_mutex);
+    g_entries.push_back(std::move(entry));
+    while (g_entries.size() > kMaxEntries * 2) {
+        g_entries.pop_front();
+    }
+}
+
+void LogUnclassified(const char* what, uint32_t lr) {
+    static std::set<uint32_t> logged;
+    if (logged.insert(lr).second) {
+        std::cout << "[killfeed] unclassified " << what << " call from 0x" << std::hex << lr << std::dec
+                  << " (not shown in the feed)" << std::endl;
+    }
+}
+
+bool IsKnownLr(uint32_t lr) {
+    return std::find(std::begin(kKnownLrs), std::end(kKnownLrs), lr) != std::end(kKnownLrs);
+}
+
+void OnHitDelivered(const CpuContext* ctx, uint32_t proxy) {
+    const uint32_t lr = ctx->lr;
+    for (const KartBumpSite& site : kKartBumpSites) {
+        if (site.lr == lr) {
+            const uint32_t victimProxy = proxy == ctx->gpr[31] ? ctx->gpr[30] + 4 : ctx->gpr[31];
+            AddEntry(ProxyPlayerIdx(proxy), ProxyPlayerIdx(victimProxy), site.item);
+            return;
+        }
+    }
+    if (IsKnownLr(lr)) {
+        return;
+    }
+    if (lr == kHitDeliveredLr) {
+        // 0x807D19C8 saved its caller's return address at 20(r1) and has not touched r1 since.
+        const uint32_t outer = Memory::Read32(ctx->gpr[1] + 20);
+        if (outer != kHitDeliveredItemObjectLr) {
+            LogUnclassified("hit-delivered", outer);
+        }
+        return;
+    }
+    LogUnclassified("IncrementItemsHitCount", lr);
+}
+
+void OnHitReceived(const CpuContext* ctx, uint32_t) {
+    if (!IsKnownLr(ctx->lr)) {
+        LogUnclassified("IncrementItemsCollisionCount", ctx->lr);
+    }
+}
+
+void SetCr0Signed(CpuContext* ctx, int32_t value) {
+    uint32_t field = value < 0 ? 0x8 : value > 0 ? 0x4 : 0x2;
+    if (ctx->xer & 0x80000000u) {
+        field |= 0x1;
+    }
+    ctx->cr = (ctx->cr & 0x0FFFFFFFu) | (field << 28);
+}
+
+// Kart::Link::IncrementItemsHitCount / IncrementItemsCollisionCount body:
+//   lwz r3,0(r3); lwz r3,0(r3); lwz r4,56(r3); cmpwi r4,0; beqlr; lwz r3,off(r4); addi r0,r3,1; stw r0,off(r4)
+void IncrementItemStat(CpuContext* ctx, uint32_t offset) {
+    uint32_t r3 = Memory::Read32(Memory::Read32(ctx->gpr[3]));
+    const uint32_t r4 = Memory::Read32(r3 + 56);
+    ctx->gpr[3] = r3;
+    ctx->gpr[4] = r4;
+    SetCr0Signed(ctx, static_cast<int32_t>(r4));
+    if (r4 == 0) {
+        return;
+    }
+    r3 = Memory::Read32(r4 + offset);
+    const uint32_t r0 = r3 + 1;
+    Memory::Write32(r4 + offset, r0);
+    ctx->gpr[3] = r3;
+    ctx->gpr[0] = r0;
+}
+
+template <typename Fn>
+void Guarded(Fn&& fn) noexcept {
+    try {
+        fn();
+    } catch (const Memory::AccessViolation& e) {
+        std::cout << "[killfeed] ignored a hit: guest read failed at 0x" << std::hex << e.address() << std::dec << std::endl;
+    } catch (...) {
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Resources: font atlas and item silhouettes (created lazily on the guest thread inside Draw)
+
+ImFontAtlas* g_fontAtlas = nullptr;
+ImFont* g_font = nullptr;
+bool g_fontTried = false;
+ImTextureID g_iconTexture{};
+bool g_iconsTried = false;
+std::array<bool, kItemCount> g_iconLoaded{};
+constexpr int kIconSize = 64;
+constexpr int kIconAtlasWidth = kIconSize * 16;
+
+void LoadFont() {
+    g_fontTried = true;
+    std::vector<std::filesystem::path> candidates;
+#ifdef _WIN32
+    const char* windir = std::getenv("WINDIR");
+    const std::filesystem::path fonts = std::filesystem::path(windir ? windir : "C:\\Windows") / "Fonts";
+    // Bahnschrift is a DIN face, the closest stock match to Valorant's HUD font.
+    candidates = {fonts / "bahnschrift.ttf", fonts / "segoeuib.ttf", fonts / "arialbd.ttf"};
+#else
+    candidates = {"/System/Library/Fonts/Supplemental/Arial Bold.ttf",
+                  "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"};
+#endif
+    static const ImWchar kRanges[] = {0x0020, 0x00FF, 0x0100, 0x017F, 0x2010, 0x205E, 0};
+    for (const auto& path : candidates) {
+        std::error_code ec;
+        if (!std::filesystem::exists(path, ec)) {
+            continue;
+        }
+        auto* atlas = IM_NEW(ImFontAtlas)();
+        ImFontConfig config;
+        config.OversampleH = 2;
+        config.OversampleV = 2;
+        config.RasterizerMultiply = 1.15f;
+        ImFont* font = atlas->AddFontFromFileTTF(path.string().c_str(), 48.0f, &config, kRanges);
+        unsigned char* pixels = nullptr;
+        int width = 0, height = 0;
+        if (font == nullptr || !atlas->Build()) {
+            IM_DELETE(atlas);
+            continue;
+        }
+        atlas->GetTexDataAsRGBA32(&pixels, &width, &height);
+        const ImTextureID texture = aurora_imgui_add_texture(static_cast<uint32_t>(width), static_cast<uint32_t>(height), pixels);
+        if (!texture) {
+            IM_DELETE(atlas);
+            continue;
+        }
+        atlas->SetTexID(texture);
+        atlas->ClearTexData();
+        g_fontAtlas = atlas;
+        g_font = font;
+        std::cout << "[killfeed] font: " << path.string() << std::endl;
+        return;
+    }
+    std::cout << "[killfeed] no TrueType font found; using the overlay font" << std::endl;
+}
+
+uint32_t Be32(const std::vector<uint8_t>& b, size_t o) {
+    return (uint32_t(b[o]) << 24) | (uint32_t(b[o + 1]) << 16) | (uint32_t(b[o + 2]) << 8) | b[o + 3];
+}
+uint16_t Be16(const std::vector<uint8_t>& b, size_t o) {
+    return static_cast<uint16_t>((b[o] << 8) | b[o + 1]);
+}
+
+bool Yaz0Decompress(const std::vector<uint8_t>& in, std::vector<uint8_t>& out) {
+    if (in.size() < 16 || std::memcmp(in.data(), "Yaz0", 4) != 0) {
+        out = in;
+        return true;
+    }
+    const uint32_t size = Be32(in, 4);
+    out.assign(size, 0);
+    size_t src = 16, dst = 0;
+    while (dst < size) {
+        if (src >= in.size()) {
+            return false;
+        }
+        uint8_t code = in[src++];
+        for (int bit = 0; bit < 8 && dst < size; ++bit, code <<= 1) {
+            if (code & 0x80) {
+                if (src >= in.size()) return false;
+                out[dst++] = in[src++];
+                continue;
+            }
+            if (src + 1 >= in.size()) return false;
+            const uint8_t b1 = in[src++], b2 = in[src++];
+            const size_t dist = (((b1 & 0x0F) << 8) | b2) + 1;
+            size_t length = b1 >> 4;
+            if (length == 0) {
+                if (src >= in.size()) return false;
+                length = in[src++] + 0x12;
+            } else {
+                length += 2;
+            }
+            if (dist > dst) return false;
+            for (size_t k = 0; k < length && dst < size; ++k, ++dst) {
+                out[dst] = out[dst - dist];
+            }
+        }
+    }
+    return true;
+}
+
+// Finds a file by its base name in a U8 archive.
+bool U8Find(const std::vector<uint8_t>& arc, std::string_view name, size_t& offset, size_t& length) {
+    if (arc.size() < 0x20 || Be32(arc, 0) != 0x55AA382D) {
+        return false;
+    }
+    const uint32_t root = Be32(arc, 4);
+    if (root + 12 > arc.size()) return false;
+    const uint32_t count = Be32(arc, root + 8);
+    const size_t strings = root + size_t(count) * 12;
+    if (strings > arc.size()) return false;
+    for (uint32_t i = 1; i < count; ++i) {
+        const size_t node = root + size_t(i) * 12;
+        if (arc[node] != 0) continue;  // directory
+        const size_t nameOffset = strings + ((arc[node + 1] << 16) | (arc[node + 2] << 8) | arc[node + 3]);
+        if (nameOffset >= arc.size()) continue;
+        const char* nodeName = reinterpret_cast<const char*>(arc.data() + nameOffset);
+        if (std::string_view(nodeName, strnlen(nodeName, arc.size() - nameOffset)) == name) {
+            offset = Be32(arc, node + 4);
+            length = Be32(arc, node + 8);
+            return offset + length <= arc.size();
+        }
+    }
+    return false;
+}
+
+// RGB5A3 64x64 TPL -> RGBA8.
+bool DecodeIcon(const std::vector<uint8_t>& arc, size_t offset, size_t length, std::vector<uint8_t>& rgba) {
+    if (length < 0x40 || Be32(arc, offset) != 0x0020AF30) return false;
+    const size_t header = offset + Be32(arc, offset + Be32(arc, offset + 8));
+    const int height = Be16(arc, header), width = Be16(arc, header + 2);
+    const uint32_t format = Be32(arc, header + 4);
+    const size_t data = offset + Be32(arc, header + 8);
+    if (width != kIconSize || height != kIconSize || format != 5 || data + kIconSize * kIconSize * 2 > offset + length) {
+        return false;
+    }
+    rgba.assign(kIconSize * kIconSize * 4, 0);
+    size_t p = data;
+    for (int by = 0; by < kIconSize; by += 4) {
+        for (int bx = 0; bx < kIconSize; bx += 4) {
+            for (int y = 0; y < 4; ++y) {
+                for (int x = 0; x < 4; ++x, p += 2) {
+                    const uint16_t v = Be16(arc, p);
+                    uint8_t r, g, b, a;
+                    if (v & 0x8000) {
+                        r = uint8_t(((v >> 10) & 31) * 255 / 31);
+                        g = uint8_t(((v >> 5) & 31) * 255 / 31);
+                        b = uint8_t((v & 31) * 255 / 31);
+                        a = 255;
+                    } else {
+                        a = uint8_t(((v >> 12) & 7) * 255 / 7);
+                        r = uint8_t(((v >> 8) & 15) * 17);
+                        g = uint8_t(((v >> 4) & 15) * 17);
+                        b = uint8_t((v & 15) * 17);
+                    }
+                    uint8_t* out = &rgba[((by + y) * kIconSize + bx + x) * 4];
+                    out[0] = r; out[1] = g; out[2] = b; out[3] = a;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+// Flat white silhouette from the icon's alpha, Valorant style.
+void Silhouette(const std::vector<uint8_t>& rgba, uint8_t* out, int stride) {
+    for (int y = 0; y < kIconSize; ++y) {
+        for (int x = 0; x < kIconSize; ++x) {
+            uint8_t* px = out + (y * stride + x) * 4;
+            px[0] = px[1] = px[2] = 255;
+            px[3] = rgba[(y * kIconSize + x) * 4 + 3];
+        }
+    }
+}
+
+void LoadIcons() {
+    g_iconsTried = true;
+    const std::filesystem::path root = RuntimeConfigFile::ResolvedDvdRoot();
+    std::vector<uint8_t> file;
+    for (const auto& candidate : {root / "files" / "Scene" / "UI" / "Race.szs", root / "Scene" / "UI" / "Race.szs"}) {
+        std::ifstream in(candidate, std::ios::binary);
+        if (in) {
+            file.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+            break;
+        }
+    }
+    std::vector<uint8_t> arc;
+    if (file.empty() || !Yaz0Decompress(file, arc)) {
+        std::cout << "[killfeed] Scene/UI/Race.szs not found under the dvd_root; item icons disabled" << std::endl;
+        return;
+    }
+    std::vector<uint8_t> atlas(size_t(kIconAtlasWidth) * kIconSize * 4, 0);
+    std::vector<uint8_t> rgba;
+    size_t loaded = 0;
+    for (size_t i = 0; i < kItemCount; ++i) {
+        size_t offset = 0, length = 0;
+        if (!U8Find(arc, kIconFiles[i], offset, length) || !DecodeIcon(arc, offset, length, rgba)) {
+            continue;
+        }
+        Silhouette(rgba, &atlas[i * kIconSize * 4], kIconAtlasWidth);
+        g_iconLoaded[i] = true;
+        ++loaded;
+    }
+    if (loaded != 0) {
+        g_iconTexture = aurora_imgui_add_texture(kIconAtlasWidth, kIconSize, atlas.data());
+    }
+    std::cout << "[killfeed] " << loaded << "/" << kItemCount << " item silhouettes loaded" << std::endl;
+}
